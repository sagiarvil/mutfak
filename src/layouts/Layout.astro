---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <SEO {...seo} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
  </body>
</html>

<style is:global>
  /* Modern CSS Reset & Core Web Vitals Optimizasyon */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    color: #1e293b;
    background-color: #ffffff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.6;
  }

  main {
    flex: 1;
  }

  img, picture, svg, video {
    display: block;
    max-width: 100%;
    height: auto;
  }

  input, button, textarea, select {
    font: inherit;
  }

  h1, h2, h3, h4, h5, h6 {
    overflow-wrap: break-word;
    line-height: 1.25;
    color: #0f172a;
  }

  a {
    color: inherit;
  }

  /* Erişilebilirlik :focus-visible */
  :focus-visible {
    outline: 2px solid #0284c7;
    outline-offset: 2px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
