---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
    
    
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'Plus Jakarta Sans', 'system-ui', 'sans-serif'],
              editorial: ['Playfair Display', 'Georgia', 'serif'],
            }
          }
        }
      }
    </script>

    
    <SEO {...seo} />
  
    <!-- RSS & Atom Feeds -->
    <link rel="alternate" type="application/rss+xml" title="İzmir Mutfak &amp; Banyo RSS Beslemesi" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="İzmir Mutfak &amp; Banyo RSS XML" href="/rss.xml" />

    <!-- AI & LLM Discovery (RFC Standards) -->
    <link rel="help" type="text/markdown" href="/llms.txt" title="LLMs Context" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full AI Knowledge Base" />
    <link rel="service-doc" type="application/json" href="/.well-known/agent-card.json" title="Autonomous Agent Protocol" />

  </head>
  <body class="min-h-screen flex flex-col font-sans bg-white text-stone-900 overflow-x-hidden antialiased">
    <Header />
    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
    <ScrollToTop />
  </body>
</html>

<style is:global>
  /* Global Modern CSS & Zero Layout Drift */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  :focus-visible {
    outline: 2px solid #10b981;
    outline-offset: 2px;
  }
</style>