---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth overflow-x-hidden bg-[#FBF9F5] text-[#262220]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
    
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              cashmere: {
                50: '#FDFCFB',
                100: '#FBF9F5',
                200: '#F5F0E8',
                300: '#EBE2D5',
                border: '#E8E1D5',
              },
              terracotta: {
                DEFAULT: '#B87353',
                light: '#C98A68',
                hover: '#A36244',
              },
              champagne: {
                DEFAULT: '#D4A373',
                light: '#E5C4A2',
                dark: '#B08050',
              },
              espresso: {
                DEFAULT: '#262220',
                soft: '#473E3B',
                muted: '#756A66',
              }
            },
            fontFamily: {
              sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
              serif: ['Playfair Display', 'Cormorant Garamond', 'Georgia', 'serif'],
              display: ['Cormorant Garamond', 'Playfair Display', 'serif'],
            }
          }
        }
      }
    </script>

    <SEO {...seo} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FBF9F5" />

    <link rel="alternate" type="application/rss+xml" title="Cem Yeşilay Mimarlık RSS" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Cem Yeşilay Mimarlık RSS XML" href="/rss.xml" />

    <link rel="help" type="text/markdown" href="/llms.txt" title="LLMs Context" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full AI Knowledge Base" />
    <link rel="service-doc" type="application/json" href="/.well-known/agent-card.json" title="Autonomous Agent Protocol" />

  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#FBF9F5] text-[#262220] overflow-x-hidden antialiased selection:bg-[#D4A373]/30 selection:text-[#B87353]">
    <Header />
    <main id="main-content" class="flex-1 w-full overflow-hidden">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
    <ScrollToTop />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    max-width: 100vw;
    overflow-x: hidden;
    background-color: #FBF9F5;
  }

  :focus-visible {
    outline: 2px solid #B87353;
    outline-offset: 2px;
  }

  /* Yumuşak gölgeler */
  .soft-shadow {
    box-shadow: 0 10px 30px -10px rgba(184, 115, 83, 0.08), 0 4px 12px -2px rgba(38, 34, 32, 0.04);
  }
  .card-hover:hover {
    box-shadow: 0 20px 35px -10px rgba(184, 115, 83, 0.15), 0 6px 16px -2px rgba(38, 34, 32, 0.06);
    transform: translateY(-3px);
  }
</style>
