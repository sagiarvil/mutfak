---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
    
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              gold: {
                DEFAULT: '#C5A880',
                light: '#D8BE9B',
                dark: '#A68860',
              },
              luxury: {
                bg: '#0F0F11',
                card: '#161619',
                border: '#27272A',
                surface: '#1E1E22'
              }
            },
            fontFamily: {
              sans: ['Plus Jakarta Sans', 'Inter', 'system-ui', 'sans-serif'],
              serif: ['Playfair Display', 'Georgia', 'serif'],
              brand: ['Cinzel', 'Playfair Display', 'serif']
            }
          }
        }
      }
    </script>

    <SEO {...seo} />

    <!-- Google Favicon & Web Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0F0F11" />

    <!-- RSS & Atom Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Cem Yeşilay Mimarlık RSS" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Cem Yeşilay Mimarlık RSS XML" href="/rss.xml" />

    <!-- AI & LLM Discovery (RFC Standards) -->
    <link rel="help" type="text/markdown" href="/llms.txt" title="LLMs Context" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full AI Knowledge Base" />
    <link rel="service-doc" type="application/json" href="/.well-known/agent-card.json" title="Autonomous Agent Protocol" />

  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#0F0F11] text-stone-100 overflow-x-hidden antialiased selection:bg-[#C5A880] selection:text-black">
    <Header />
    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
    <ScrollToTop />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  :focus-visible {
    outline: 2px solid #C5A880;
    outline-offset: 2px;
  }
</style>
