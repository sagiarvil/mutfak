---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth overflow-x-hidden bg-[#FAF9F6] text-[#1D1D1F]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
    
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              apple: {
                bg: '#FAF9F6',
                surface: '#F5F5F7',
                card: '#FFFFFF',
                border: '#D2D2D7',
                text: '#1D1D1F',
                secondary: '#86868B',
                dark: '#161617',
                forest: '#1B382F',
                forestHover: '#132821',
                gold: '#8C693E'
              }
            },
            fontFamily: {
              sans: [
                '-apple-system',
                'BlinkMacSystemFont',
                '"SF Pro Display"',
                '"SF Pro Text"',
                '"SF Pro"',
                '"Helvetica Neue"',
                'Helvetica',
                'Arial',
                'sans-serif'
              ],
              serif: [
                'Playfair Display',
                'Georgia',
                'serif'
              ]
            }
          }
        }
      }
    </script>

    <SEO {...seo} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAF9F6" />

    <link rel="alternate" type="application/rss+xml" title="Cem Yeşilay Luxury RSS" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Cem Yeşilay Luxury RSS XML" href="/rss.xml" />

    <link rel="help" type="text/markdown" href="/llms.txt" title="LLMs Context" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full AI Knowledge Base" />
    <link rel="service-doc" type="application/json" href="/.well-known/agent-card.json" title="Autonomous Agent Protocol" />

  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#FAF9F6] text-[#1D1D1F] overflow-x-hidden antialiased selection:bg-[#1B382F] selection:text-white">
    <Header />
    <main id="main-content" class="flex-1 w-full overflow-hidden">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
    <ScrollToTop />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    max-width: 100vw;
    overflow-x: hidden !important;
    background-color: #FAF9F6;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "SF Pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  :focus-visible {
    outline: 2px solid #1B382F;
    outline-offset: 2px;
  }

  /* Apple Glass & Card Elevation */
  .apple-glass {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(210, 210, 215, 0.7);
  }

  .apple-card {
    background: #FFFFFF;
    border: 1px solid #E5DFD5;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apple-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.08);
    border-color: #1B382F;
  }
</style>
