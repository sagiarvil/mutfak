---
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloating from "../components/WhatsAppFloating.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/design-tokens.css";
import "../styles/apple-motion.css";

export interface Props {
  seo: SEOProps;
  activeService?: string;
}

const { seo, activeService } = Astro.props;
---

<!doctype html>
<html lang="tr" class="scroll-smooth overflow-x-hidden bg-[#F8FAFC] text-zinc-900">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Z81B5RJTWM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Z81B5RJTWM');
      gtag('config', 'G-26Y17F0C6Q');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
    <ClientRouter />
    <script src="../scripts/scroll-reveal.client.ts"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.tailwindcss.com" />
    
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              plan: {
                dark: '#23323A',
                darker: '#172127',
                red: '#CB000F',
                redHover: '#b0000d',
                gray: '#F4F6F8',
                text: '#465866'
              },
              apple: {
                bg: '#FAF9F6',
                surface: '#F5F5F7',
                card: '#FFFFFF',
                border: '#D2D2D7',
                text: '#1D1D1F',
                secondary: '#86868B',
                dark: '#161617',
                forest: '#006039',
                forestDeep: '#0B3B2C',
                forestHover: '#00482B',
                rolex: '#006039',
                gold: '#C5A880',
                goldLight: '#E6D7C3',
                crimson: '#8B1E2D'
              }
            },
            fontFamily: {
              montserrat: ['Montserrat', 'sans-serif'],
              sans: [
                'Montserrat',
                '-apple-system',
                'BlinkMacSystemFont',
                'sans-serif'
              ],
              serif: [
                'Montserrat',
                '-apple-system',
                'BlinkMacSystemFont',
                'sans-serif'
              ]
            }
          }
        }
      }
    </script>

    <style is:global>
      /* Kullanıcı Emri: Asla tırnaklı serif veya eğik italik font yok; daima modern, net ve okunaklı sans-serif */
      *, body, h1, h2, h3, h4, h5, h6, p, span, a, button, input, select, textarea, div {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-style: normal !important;
      }
    </style>

    <SEO {...seo} />

    <!-- Favicon & Touch Icons (Google 48px Çoklu Boyut Standardı) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="İzmir Mutfak Banyo" />

    <!-- Mobil & PWA Standartları -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="İzmir Mutfak Banyo" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="theme-color" content="#FAF9F6" />

    <!-- Syndication & Feed Katmanı ($10M Mandate v9.1) -->
    <link rel="alternate" type="application/rss+xml" title="İzmir Mutfak Banyo Luxury RSS" href="/feed.xml" />
    <link rel="alternate" type="application/atom+xml" title="İzmir Mutfak Banyo Luxury Atom" href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title="İzmir Mutfak Banyo Luxury JSON Feed" href="/feed.json" />
    <link rel="alternate" type="application/rss+xml" title="İzmir Mutfak Banyo Mobile Voice Feed" href="/mobile/feed.xml" />

    <!-- Multi-Tier LLMS & AI Agent Hub -->
    <link rel="help" type="text/markdown" href="/llms.txt" title="LLMs Context" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full AI Knowledge Base" />
    <link rel="service-doc" type="application/json" href="/.well-known/agent.json" title="Autonomous Agent Protocol" />

  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#F8FAFC] text-zinc-900 overflow-x-hidden antialiased selection:bg-zinc-900 selection:text-white">
    <Header />
    <main id="main-content" class="flex-1 w-full overflow-hidden">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloating service={activeService} />
    <ScrollToTop />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    max-width: 100vw;
    overflow-x: hidden !important;
    background-color: #F8FAFC;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "SF Pro", "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  :focus-visible {
    outline: 2px solid #C5A880;
    outline-offset: 2px;
  }

  /* Plan Mutfak & Kurumsal Kart Yükseltmeleri */
  .apple-glass {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .apple-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apple-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.12);
    border-color: #18181B;
  }
</style>
