---
import { siteConfig } from "../data/siteConfig";
import { buildWhatsAppUrl, buildTelUrl } from "../utils/whatsapp";

const currentYear = new Date().getFullYear();
---

<!-- ===================================================================== -->
<!-- BÖLÜM XII: KURUMSAL EKOSİSTEM OTORİTE AĞI (FOOTER ÜSTÜ)                 -->
<!-- ===================================================================== -->
<section class="bg-[#111111] text-stone-400 py-10 border-t border-stone-800 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-800/80 pb-6">
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-emerald-400 block">KURUMSAL ŞEFFAFLIK &amp; DOĞRULAMA</span>
        <h4 class="text-base font-bold text-white">İzmir Mutfak &amp; Banyo Dijital Ekosistem Varlıkları</h4>
      </div>
      <div class="flex items-center gap-4 text-xs font-semibold text-stone-300">
        <span>📍 Buca İmalat Atölyesi</span>
        <span>•</span>
        <span>📐 Mimar &amp; İç Mimar Heyeti</span>
        <span>•</span>
        <span>🏛️ 1984'ten Bugüne 42 Yıl</span>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3.5 text-[11.5px]">
      <a href="https://izmirmutfakbanyo.com.tr/sitemap.xml" target="_blank" class="p-2.5 bg-stone-900/60 border border-stone-800 hover:border-emerald-500/60 transition flex items-center justify-between group">
        <span class="group-hover:text-white">XML Site Haritası</span>
        <span class="text-stone-600 group-hover:text-emerald-400">↗</span>
      </a>
      <a href="https://izmirmutfakbanyo.com.tr/robots.txt" target="_blank" class="p-2.5 bg-stone-900/60 border border-stone-800 hover:border-emerald-500/60 transition flex items-center justify-between group">
        <span class="group-hover:text-white">Robots.txt Protokolü</span>
        <span class="text-stone-600 group-hover:text-emerald-400">↗</span>
      </a>
      <a href="https://izmirmutfakbanyo.com.tr/llms.txt" target="_blank" class="p-2.5 bg-stone-900/60 border border-stone-800 hover:border-emerald-500/60 transition flex items-center justify-between group">
        <span class="group-hover:text-white">LLMs.txt Bilgi Grafı</span>
        <span class="text-stone-600 group-hover:text-emerald-400">↗</span>
      </a>
      <a href="https://izmirmutfakbanyo.com.tr/feed.xml" target="_blank" class="p-2.5 bg-stone-900/60 border border-stone-800 hover:border-emerald-500/60 transition flex items-center justify-between group">
        <span class="group-hover:text-white">RSS 2.0 Haber Kaynağı</span>
        <span class="text-stone-600 group-hover:text-emerald-400">↗</span>
      </a>
      <a href="/iletisim/" class="p-2.5 bg-stone-900/60 border border-stone-800 hover:border-emerald-500/60 transition flex items-center justify-between group"><span class="group-hover:text-white">Buca İletişim & Keşif</span><span class="text-stone-600 group-hover:text-emerald-400">↗</span></a>
    </div>
  </div>
</section>

<!-- ===================================================================== -->
<!-- PREMİUM ANA FOOTER (1984'TEN BUGÜNE 42 YIL • BUCA MERKEZ ATÖLYE)   -->
<!-- ===================================================================== -->
<footer class="bg-stone-950 text-stone-400 border-t border-stone-800 py-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 border-b border-stone-800 pb-12">
      
      <!-- Kolon 1: Marka & 1984 Mirası -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="İzmir Mutfak Banyo Logo" class="h-10 w-auto object-contain bg-white p-1 rounded-sm" width="40" height="42" loading="lazy" />
          <div>
            <span class="text-sm font-black tracking-widest text-white uppercase block leading-none">İZMİR MUTFAK &amp; BANYO</span>
            <span class="text-[9px] uppercase tracking-[0.2em] text-emerald-400 font-bold block mt-1">Özel İmalat &amp; Tadilat Atölyesi</span>
          </div>
        </div>
        <p class="text-stone-400 font-light leading-relaxed text-[11.5px]">
          1984 yılından bu yana İzmir Buca mağazamız ve imalat atölyemizde kadrolu mimar ve iç mimarlarımızla mutfak, banyo ve anahtar teslim ev tadilatı üretiyoruz. 2.463'ten fazla teslim edilmiş proje ve resmi sözleşmeli teslimat güvencesi.
        </p>
        <div class="text-[11px] text-stone-300 font-semibold space-y-1">
          <div>📍 <strong>Merkez Atölye:</strong> Buca / İzmir</div>
          <div>📞 <strong>Doğrudan Hat:</strong> <a href="tel:05393333303" class="hover:text-white transition">0539 333 33 03</a></div>
          <div>💬 <strong>WhatsApp Keşif:</strong> <a href="https://wa.me/905393333303" target="_blank" class="text-emerald-400 hover:underline">0539 333 33 03</a></div>
        </div>
      </div>

      <!-- Kolon 2: Mimari Hizmetlerimiz -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Mimari Hizmetler</h4>
        <ul class="space-y-2 text-[11.5px]">
          <li><a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-white transition">Özel Ölçü Mutfak Dolabı İmalatı</a></li>
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-white transition">Komple Mutfak Tadilatı</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-white transition">Banyo Yenileme &amp; Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-white transition">Komple Daire ve Ev Tadilatı</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-white transition">Anahtar Teslim Tadilat İzmir</a></li>
          <li><a href="/hazir-mutfak-modelleri-izmir/" class="hover:text-white transition">Hazır &amp; Modüler Mutfak Modelleri</a></li>
          <li><a href="/2026-mutfak-dolabi-mimari çizimlari/" class="hover:text-white transition">2026 Mutfak Mimari Tasarım Rehberi</a></li>
        </ul>
      </div>

      <!-- Kolon 3: Kalite & Garanti Esasları -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Kalite ve Taahhüt</h4>
        <ul class="space-y-2 text-[11.5px] text-stone-400">
          <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> <span>%100 MDF-Lam Gövde (Sıfır Suntalam)</span></li>
          <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> <span>Blum &amp; Hafele Frenli Donanım Sistemleri</span></li>
          <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> <span>Laminam, Çimstone &amp; Belenco Tezgahlar</span></li>
          <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> <span>Resmi Sözleşmeli ve Mimar Onaylı Sözleşme Garantisi</span></li>
          <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> <span>10 Yıl Gövde ve Mekanizma Güvencesi</span></li>
          <li class="flex items-center gap-2"><span class="text-emerald-400">✓</span> <span>3D Fotogerçekçi Sanal Mekan Deneyimi</span></li>
        </ul>
      </div>

      <!-- Kolon 4: İzmir Hizmet Sahası -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">İzmir Hizmet Ağımız</h4>
        <p class="text-[11px] text-stone-400">Buca atölyemizden İzmir geneline yerinde ücretsiz keşif:</p>
        <div class="flex flex-wrap gap-1.5 pt-1">
          {siteConfig.districts.map(d => (
            <a href={buildWhatsAppUrl({ district: d, service: "Keşif" })} 
               target="_blank" 
               rel="noopener noreferrer" 
               class="px-2 py-1 bg-stone-900 border border-stone-800 text-[10px] text-stone-300 hover:border-emerald-500/50 hover:text-white transition">
              {d}
            </a>
          ))}
        </div>
      </div>

    </div>

    <!-- Alt Telif & Yasal Bilgi -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-stone-500">
      <p>© {currentYear} İzmir Mutfak &amp; Banyo — 1984'ten Bugüne 42 Yıllık Güven. Tüm Hakları Saklıdır.</p>
      <div class="flex items-center gap-4 text-stone-400">
        <span>Resmi Sözleşmeli Teslimat</span>
        <span>•</span>
        <span>Ücretsiz 3D Mimari Keşif</span>
        <span>•</span>
        <span>10 Yıl Garanti</span>
      </div>
    </div>

  </div>
</footer>