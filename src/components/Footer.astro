---
import { siteConfig } from "../data/siteConfig";

const currentYear = new Date().getFullYear();
---

<!-- BÖLÜM: KURUMSAL ŞEFFAFLIK & DOĞRULAMA (FOOTER ÜSTÜ) -->
<section class="bg-[#F8FAFC] text-zinc-600 py-10 border-t border-gray-200 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-6">
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-[#041F14] block">
          ŞEFFAF MİMARİ & DİJİTAL ALTYAPI
        </span>
        <h4 class="text-base font-serif font-semibold text-zinc-900">
          Cem Yeşilay Mimarlık & İç Mekân Tasarımı
        </h4>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-zinc-700 whitespace-nowrap">
        <span>📍 Adatepe İmalat Atölyesi</span>
        <span>•</span>
        <span>📐 3D Lazer Rölöve</span>
        <span>•</span>
        <span>🏛️ 28 Yıllık Tasarım Mirası</span>
      </div>
    </div>
    
    <!-- Linkler -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-[11.5px]">
      <a href="/sitemap.xml" target="_blank" class="p-3 bg-white border border-gray-200 hover:border-[#041F14] transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-[#041F14] text-zinc-700 font-medium">XML Site Haritası</span>
        <span class="text-[#C5A880]">↗</span>
      </a>
      <a href="/robots.txt" target="_blank" class="p-3 bg-white border border-gray-200 hover:border-[#041F14] transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-[#041F14] text-zinc-700 font-medium">Robots.txt İndeksi</span>
        <span class="text-[#C5A880]">↗</span>
      </a>
      <a href="/llms.txt" target="_blank" class="p-3 bg-white border border-gray-200 hover:border-[#041F14] transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-[#041F14] text-zinc-700 font-medium">LLMs.txt Bilgi Grafı</span>
        <span class="text-[#C5A880]">↗</span>
      </a>
      <a href="/feed.xml" target="_blank" class="p-3 bg-white border border-gray-200 hover:border-[#041F14] transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-[#041F14] text-zinc-700 font-medium">RSS 2.0 Yayını</span>
        <span class="text-[#C5A880]">↗</span>
      </a>
      <a href="https://www.instagram.com/cemyesilay.luxury" target="_blank" rel="noopener noreferrer" class="p-3 bg-white border border-gray-200 hover:border-[#041F14] transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-[#041F14] text-zinc-700 font-medium">Instagram @cemyesilay</span>
        <span class="text-[#C5A880]">↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ANA CARTIER & ROLEX LÜKS DARK EMERALD FOOTER -->
<footer class="bg-[#02130C] text-[#C5BBAF] border-t border-[#092B1B] py-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 border-b border-[#08291A] pb-12">
      
      <!-- Kolon 1: Marka & Açıklama -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/logo.png" 
            alt="Cem Yeşilay Logo" 
            class="h-12 w-auto object-contain shrink-0" 
            style="filter: drop-shadow(0 0 10px rgba(0, 255, 102, 0.5));"
            width="48" 
            height="48" 
          />
          <div>
            <span class="text-sm font-serif tracking-wider text-white uppercase block leading-none font-bold">CEM YEŞİLAY</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-[#C5A880] font-semibold block mt-1">LUXURY ATELIER & MIMARLIK</span>
          </div>
        </div>
        <p class="text-[#C5BBAF] font-light leading-relaxed text-[11.5px]">
          Kişiye ve mekânın karakterine özel tasarlanan mutfak dolapları, lüks banyo renovasyonları ve anahtar teslim mimari taahhüt. 28 yıllık tecrübe, 137 tescilli model arşivi.
        </p>
        <div class="text-[11px] text-[#D8D2C7] font-medium space-y-1 pt-1">
          <div>📍 <strong>Atölye:</strong> Adatepe, Özbekistan Cd. no:10/f, 35000 Buca/İzmir</div>
          <div>📞 <strong>Telefon:</strong> <a href="tel:02324411060" class="hover:text-[#C5A880] transition font-bold text-white">0232 441 1060</a></div>
          <div>💬 <strong>WhatsApp:</strong> <a href="https://wa.me/905324261788" target="_blank" class="text-[#00FF66] font-bold hover:underline">0532 426 17 88</a></div>
          <div>📷 <strong>Instagram:</strong> <a href="https://www.instagram.com/cemyesilay.luxury" target="_blank" class="text-[#C5A880] font-bold hover:underline">@cemyesilay.luxury</a></div>
        </div>
      </div>

      <!-- Kolon 2: Mimari Hizmetler -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Mimari Hizmetler</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-[#C5A880] transition">Özel Ölçü Lüks Mutfak Dolabı</a></li>
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#C5A880] transition">Komple Mutfak Renovasyonu</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-[#C5A880] transition">Lüks Banyo Tasarımı & Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-[#C5A880] transition">Komple Daire Renovasyonu</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-[#C5A880] transition">Anahtar Teslim Taahhüt</a></li>
        </ul>
      </div>

      <!-- Kolon 3: Tasarım Koleksiyonu -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Tasarım Koleksiyonu (137)</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/tasarimlar/?kategori=mutfak" class="hover:text-[#C5A880] transition">Mutfak Modelleri (40 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=banyo" class="hover:text-[#C5A880] transition">Lüks Banyo Mobilyaları (25 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=kapilar" class="hover:text-[#C5A880] transition">Özel Tasarım Kapılar (39 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=gomme-dolap" class="hover:text-[#C5A880] transition">Giyinme Odası (33 Model)</a></li>
          <li><a href="/tasarimlar/" class="hover:text-white font-bold transition text-[#C5A880]">Tüm Koleksiyonu İncele (137) →</a></li>
        </ul>
      </div>

      <!-- Kolon 4: Çalışma Saatleri & Keşif -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Atölye & Keşif</h4>
        <p class="text-[11.5px] text-[#C5BBAF] leading-relaxed">
          Pazartesi – Cumartesi: 08:30 – 19:30<br>
          Pazar: Randevu ile Lazer Keşif
        </p>
        <div class="pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-bold rounded transition border border-[#E5C378]"
          >
            <span>Hızlı 3D Keşif İste</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- BÖLÜM: KURUMSAL EKOSİSTEM & OTORİTE AĞI -->
    <div class="pt-2 pb-6 border-b border-[#08291A] text-center space-y-3">
      <span class="text-[10.5px] uppercase font-bold tracking-[0.2em] text-[#C5A880]/90 block">
        Kurumsal Ekosistem & Otorite Ağı
      </span>
      <div class="flex flex-wrap items-center justify-center gap-x-3.5 gap-y-2 text-[11px] text-[#A69B8D]">
        <a href="https://drfin.com.tr/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">drfin.com.tr</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://excelarsiv.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">excelarsiv.com</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://inversioncore.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">inversioncore.com</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://belginkuyumculuk.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">belginkuyumculuk.com</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://saatchi.com.tr/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">saatchi.com.tr</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://dilekceyazdir.com.tr/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">dilekceyazdir.com.tr</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://htmlandhtml.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">htmlandhtml.com</a>
        <span class="text-[#092B1B] select-none">•</span>
        <a href="https://degerlet.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A880] transition underline-offset-4 hover:underline">degerlet.com</a>
      </div>
    </div>

    <!-- Alt Telif & Bilgi -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#8C8377]">
      <p>© {currentYear} Cem Yeşilay Luxury Mimarlık & Atölye İmalatı. Tüm hakları saklıdır.</p>
      <div class="flex items-center gap-4">
        <span>İzmir / Buca</span>
        <span>•</span>
        <span>Mutfak, Banyo, Kapı & Anahtar Teslim Renovasyon</span>
      </div>
    </div>

  </div>
</footer>
