---
import { siteConfig } from "../data/siteConfig";

const currentYear = new Date().getFullYear();
---

<!-- BÖLÜM: DİJİTAL DOĞRULAMA & PROTOKOLLER -->
<section class="bg-[#0B0B0C] text-stone-400 py-10 border-t border-stone-800 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-800/80 pb-6">
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-[#C5A880] block">MİMARİ ŞEFFAFLIK & GÜVENİLİRLİK</span>
        <h4 class="text-base font-serif text-white tracking-wide">Cem Yeşilay Mimarlık & İç Mekan Tasarımı Dijital Varlıkları</h4>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-stone-300">
        <span>📍 İzmir Tasarım Stüdyoları & Atölye</span>
        <span>•</span>
        <span>📐 3D Render & Rölöve</span>
        <span>•</span>
        <span>🏛️ 28 Yıllık Tasarım Mirası</span>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-[11.5px]">
      <a href="/sitemap.xml" target="_blank" class="p-3 bg-white/5 border border-stone-800 hover:border-[#C5A880] transition flex items-center justify-between group rounded-xs">
        <span class="group-hover:text-white">XML Site Haritası</span>
        <span class="text-stone-600 group-hover:text-[#C5A880]">↗</span>
      </a>
      <a href="/robots.txt" target="_blank" class="p-3 bg-white/5 border border-stone-800 hover:border-[#C5A880] transition flex items-center justify-between group rounded-xs">
        <span class="group-hover:text-white">Robots Protokolü</span>
        <span class="text-stone-600 group-hover:text-[#C5A880]">↗</span>
      </a>
      <a href="/llms.txt" target="_blank" class="p-3 bg-white/5 border border-stone-800 hover:border-[#C5A880] transition flex items-center justify-between group rounded-xs">
        <span class="group-hover:text-white">LLMs.txt Bilgi Grafı</span>
        <span class="text-stone-600 group-hover:text-[#C5A880]">↗</span>
      </a>
      <a href="/feed.xml" target="_blank" class="p-3 bg-white/5 border border-stone-800 hover:border-[#C5A880] transition flex items-center justify-between group rounded-xs">
        <span class="group-hover:text-white">RSS Proje Yayını</span>
        <span class="text-stone-600 group-hover:text-[#C5A880]">↗</span>
      </a>
      <a href="/iletisim/" class="p-3 bg-white/5 border border-stone-800 hover:border-[#C5A880] transition flex items-center justify-between group rounded-xs">
        <span class="group-hover:text-white">İletişim & Keşif</span>
        <span class="text-stone-600 group-hover:text-[#C5A880]">↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ANA FOOTER -->
<footer class="bg-[#080809] text-stone-400 border-t border-stone-800/80 py-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 border-b border-stone-800/80 pb-12">
      
      <!-- Kolon 1 -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-sm bg-stone-900 border border-[#C5A880]/50 flex items-center justify-center text-[#C5A880] font-serif font-bold text-lg">
            CY
          </div>
          <div>
            <span class="text-sm font-serif tracking-widest text-white uppercase block leading-none font-bold">CEM YEŞİLAY</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-[#C5A880] font-semibold block mt-1">MİMARLIK & İÇ MEKAN TASARIMI</span>
          </div>
        </div>
        <p class="text-stone-400 font-light leading-relaxed text-[11.5px]">
          Kişiye ve mekanın ruhuna özel üretilmiş mutfak dolapları, lüks ıslak hacimler ve anahtar teslim mimari renovasyon çözümleri. 2.850'den fazla tamamlanmış proje, şeffaf bütçe garantisi ve resmi taahhüt.
        </p>
        <div class="text-[11px] text-stone-300 font-medium space-y-1 pt-1">
          <div>📍 <strong>Tasarım Stüdyoları:</strong> İzmir / Türkiye</div>
          <div>📞 <strong>İletişim:</strong> <a href="tel:{siteConfig.phoneRaw}" class="hover:text-white transition">{siteConfig.phoneFormatted}</a></div>
          <div>💬 <strong>WhatsApp Randevu:</strong> <a href="{siteConfig.whatsappUrl}" target="_blank" class="text-[#C5A880] hover:underline">{siteConfig.phoneFormatted}</a></div>
        </div>
      </div>

      <!-- Kolon 2 -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Mimari Hizmetler</h4>
        <ul class="space-y-2 text-[11.5px]">
          <li><a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-[#C5A880] transition">Özel Ölçü Lüks Mutfak Dolabı</a></li>
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#C5A880] transition">Komple Mutfak Renovasyonu</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-[#C5A880] transition">Lüks Banyo Tasarımı & Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-[#C5A880] transition">Komple Daire Renovasyonu</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-[#C5A880] transition">Anahtar Teslim Villa & Konut Taahhüt</a></li>
        </ul>
      </div>

      <!-- Kolon 3 -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Tasarım Koleksiyonu (137)</h4>
        <ul class="space-y-2 text-[11.5px]">
          <li><a href="/tasarimlar/?kategori=mutfak" class="hover:text-[#C5A880] transition">Mutfak Modelleri (40 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=kapilar" class="hover:text-[#C5A880] transition">Özel Tasarım İç Kapılar (39 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=gomme-dolap" class="hover:text-[#C5A880] transition">Giyinme Odası & Gömme Dolap (33 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=banyo" class="hover:text-[#C5A880] transition">Lüks Banyo Mobilyaları (25 Model)</a></li>
          <li><a href="/tasarimlar/" class="hover:text-[#C5A880] font-bold transition text-[#C5A880]">✦ Tüm Koleksiyonu İncele (137)</a></li>
        </ul>
      </div>

      <!-- Kolon 4: Hizmet Verilen Bölgeler -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Hizmet Alanlarımız</h4>
        <p class="text-[11px] text-stone-400 font-light leading-relaxed">
          Çeşme, Urla, Güzelbahçe, Karşıyaka, Bostanlı, Mavişehir, Alsancak, Bornova, Narlıdere, Balçova, Bayraklı ve tüm Ege bölgesinde mimari rölöve ve anahtar teslim uygulama hizmeti sunuyoruz.
        </p>
        <div class="pt-2">
          <a href="{siteConfig.whatsappUrl}?text=Merhaba%20Cem%20Bey,%20projem%20için%20ücretsiz%20mimari%20keşif%20talep%20ediyorum." target="_blank" class="inline-block w-full text-center py-2.5 px-4 bg-[#C5A880] text-black font-bold uppercase tracking-wider text-[11px] rounded-xs hover:bg-white transition">
            Ücretsiz Mimari Keşif İste
          </a>
        </div>
      </div>

    </div>

    <!-- Telif ve Yasal -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-stone-400 pt-2">
      <div>
        &copy; {currentYear} Cem Yeşilay Mimarlık & İç Mekan Tasarımı. Tüm hakları saklıdır.
      </div>
      <div class="flex items-center gap-6">
        <a href="/" class="hover:text-stone-300 transition">Ana Sayfa</a>
        <a href="/projeler/" class="hover:text-stone-300 transition">Projeler</a>
        <a href="/tasarimlar/" class="hover:text-stone-300 transition">Koleksiyon</a>
        <a href="/iletisim/" class="hover:text-stone-300 transition">İletişim</a>
      </div>
    </div>

  </div>
</footer>
