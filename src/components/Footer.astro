---
import { siteConfig } from "../data/siteConfig";

const currentYear = new Date().getFullYear();
---

<!-- ===================================================================== -->
<!-- PLAN MUTFAK BİREBİR FOOTER YAPISI & RENKLERİ (#23323A + #172127)      -->
<!-- ===================================================================== -->
<footer id="footer" class="bg-[#23323A] text-[#9AA7AF] font-['Open_Sans',sans-serif] text-xs pt-16 border-t-4 border-[#CB000F]">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    
    <!-- 4 KOLONLU PLAN MUTFAK DÜZENİ -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pb-12 border-b border-[#2D3E48]">
      
      <!-- KOLON 1: LOGO + FİRMA TANITIMI -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3">
          <img 
            src="/logo.png" 
            alt="İzmir Mutfak Banyo" 
            class="h-12 w-auto object-contain bg-white rounded p-1" 
            width="48" 
            height="48" 
          />
          <div>
            <span class="font-['Montserrat',sans-serif] text-sm font-extrabold text-white uppercase block leading-none">
              İZMİR MUTFAK BANYO
            </span>
            <span class="text-[9px] uppercase tracking-wider text-[#CB000F] font-bold block mt-1">
              TASARIM &amp; İMALAT
            </span>
          </div>
        </a>
        <p class="text-xs text-[#B2BFC7] font-normal leading-relaxed">
          İzmir Mutfak Banyo sahip olduğu 28 yıllık deneyimi ile yenilikçi mutfak tasarımları ve anahtar teslim dekorasyon üzerine hizmet vermektedir. Doğrudan Buca İzmir imalat atölyemizden birinci el üretim ve profesyonel montaj garantisi sunuyoruz.
        </p>
      </div>

      <!-- KOLON 2: MODELLERİMİZ -->
      <div class="space-y-3">
        <h4 class="font-['Montserrat',sans-serif] text-sm font-bold uppercase tracking-wider text-white border-b-2 border-[#CB000F] pb-2 inline-block">
          Modellerimiz
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/modern-mutfak-modelleri/" class="hover:text-white hover:translate-x-1 inline-block transition">Modern Mutfak Modelleri</a></li>
          <li><a href="/klasik-country-mutfak-modelleri/" class="hover:text-white hover:translate-x-1 inline-block transition">Klasik &amp; Country Mutfak</a></li>
          <li><a href="/hazir-mutfak-modelleri-izmir/" class="hover:text-white hover:translate-x-1 inline-block transition">Akrilik &amp; Lake Dolaplar</a></li>
          <li><a href="/yasam-alanlari-mutfak-modelleri/" class="hover:text-white hover:translate-x-1 inline-block transition">Ada Mutfak &amp; Yaşam Alanları</a></li>
          <li><a href="/tasarimlar/?kategori=banyo" class="hover:text-white hover:translate-x-1 inline-block transition">Lüks Banyo Tasarımları</a></li>
          <li><a href="/tasarimlar/?kategori=kapilar" class="hover:text-white hover:translate-x-1 inline-block transition">İç Mimari Kapılar</a></li>
        </ul>
      </div>

      <!-- KOLON 3: HİZMETLERİMİZ & MALİYET -->
      <div class="space-y-3">
        <h4 class="font-['Montserrat',sans-serif] text-sm font-bold uppercase tracking-wider text-white border-b-2 border-[#CB000F] pb-2 inline-block">
          Tadilat &amp; Hesaplama
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-white hover:translate-x-1 inline-block transition">Komple Mutfak Tadilatı</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-white hover:translate-x-1 inline-block transition">Banyo Yenileme &amp; Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-white hover:translate-x-1 inline-block transition">Komple Daire Tadilatı</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-white hover:translate-x-1 inline-block transition">Anahtar Teslim Taahhüt</a></li>
          <li>
            <a href="/maliyet-hesapla/" class="text-[#CB000F] hover:text-white font-bold inline-flex items-center gap-1 transition">
              <span>🧮 Canlı Maliyet Hesapla</span> <span>→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- KOLON 4: İLETİŞİM & ATÖLYE -->
      <div class="space-y-3">
        <h4 class="font-['Montserrat',sans-serif] text-sm font-bold uppercase tracking-wider text-white border-b-2 border-[#CB000F] pb-2 inline-block">
          İletişim Bilgileri
        </h4>
        <div class="space-y-2.5 text-xs text-[#B2BFC7]">
          <div>
            <strong class="text-white block font-['Montserrat',sans-serif]">Telefon:</strong>
            <a href="tel:05393333303" class="text-white hover:text-[#CB000F] font-bold text-sm transition">0539 333 33 03</a>
          </div>
          <div>
            <strong class="text-white block font-['Montserrat',sans-serif]">WhatsApp Destek:</strong>
            <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-[#25D366] hover:underline font-bold transition">0539 333 33 03</a>
          </div>
          <div class="pt-1">
            <span class="text-[11px] text-[#7F8C8D]">İzmir Geneli Ücretsiz Yerinde Keşif • Pzt - Cmt: 09:00 - 19:30</span>
          </div>
        </div>
      </div>

    </div>

  </div>

  <!-- LOWER FOOTER (TELİF ALANI) -->
  <div id="lower-footer" class="bg-[#172127] py-4 text-[#7F8C8D] text-xs">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div>
        <span>Copyright © {currentYear} </span>
        <a href="/" class="text-white hover:text-[#CB000F] font-bold transition">İzmir Mutfak Banyo</a>
        <span> Tüm Hakları Saklıdır.</span>
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <a href="/sitemap.xml" class="hover:text-white transition">Site Haritası</a>
        <span>•</span>
        <a href="/hakkimizda/" class="hover:text-white transition">Hakkımızda</a>
        <span>•</span>
        <a href="/iletisim/" class="hover:text-white transition">İletişim</a>
      </div>
    </div>
  </div>

</footer>
