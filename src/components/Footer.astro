---
import { siteConfig } from "../data/siteConfig";

const currentYear = new Date().getFullYear();
---

<!-- BÖLÜM: KURUMSAL ŞEFFAFLIK & DOĞRULAMA (FOOTER ÜSTÜ) -->
<section class="bg-zinc-100 text-zinc-600 py-10 border-t border-zinc-200 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-6">
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-amber-700 block">
          ŞEFFAF MİMARİ & DİJİTAL ALTYAPI
        </span>
        <h4 class="text-base font-serif font-semibold text-zinc-900">
          Cem Yeşilay Mimarlık & İç Mekân Tasarımı
        </h4>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-zinc-700 whitespace-nowrap">
        <span>📍 Adatepe İmalat Atölyesi</span>
        <span>•</span>
        <span>📐 3D Lazer Rölöve</span>
        <span>•</span>
        <span>🏛️ 28 Yıllık Tasarım Mirası</span>
      </div>
    </div>
    
    <!-- Linkler -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-[11.5px]">
      <a href="/sitemap.xml" target="_blank" class="p-3 bg-white border border-zinc-200 hover:border-zinc-900 transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-zinc-900 text-zinc-700 font-medium">XML Site Haritası</span>
        <span class="text-amber-600">↗</span>
      </a>
      <a href="/robots.txt" target="_blank" class="p-3 bg-white border border-zinc-200 hover:border-zinc-900 transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-zinc-900 text-zinc-700 font-medium">Robots.txt İndeksi</span>
        <span class="text-amber-600">↗</span>
      </a>
      <a href="/llms.txt" target="_blank" class="p-3 bg-white border border-zinc-200 hover:border-zinc-900 transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-zinc-900 text-zinc-700 font-medium">LLMs.txt Bilgi Grafı</span>
        <span class="text-amber-600">↗</span>
      </a>
      <a href="/feed.xml" target="_blank" class="p-3 bg-white border border-zinc-200 hover:border-zinc-900 transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-zinc-900 text-zinc-700 font-medium">RSS 2.0 Yayını</span>
        <span class="text-amber-600">↗</span>
      </a>
      <a href="https://www.instagram.com/cemyesilay.luxury" target="_blank" rel="noopener noreferrer" class="p-3 bg-white border border-zinc-200 hover:border-zinc-900 transition flex items-center justify-between group rounded shadow-xs">
        <span class="group-hover:text-zinc-900 text-zinc-700 font-medium">Instagram @cemyesilay</span>
        <span class="text-amber-600">↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ANA PLAN MUTFAK STİLİ PREMİUM FOOTER -->
<footer class="bg-[#18181B] text-zinc-400 border-t border-zinc-800 py-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 border-b border-zinc-800 pb-12">
      
      <!-- Kolon 1: Marka & Açıklama -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/logo.png" 
            alt="Cem Yeşilay Logo" 
            class="h-12 w-auto object-contain shrink-0" 
            style="filter: drop-shadow(0 0 10px rgba(0, 255, 102, 0.4));"
            width="48" 
            height="48" 
          />
          <div>
            <span class="text-sm font-serif tracking-wider text-white uppercase block leading-none font-bold">CEM YEŞİLAY</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-amber-500 font-semibold block mt-1">MİMARLIK & ATÖLYE İMALATI</span>
          </div>
        </div>
        <p class="text-zinc-400 font-light leading-relaxed text-[11.5px]">
          Kişiye ve mekânın karakterine özel tasarlanan mutfak dolapları, lüks banyo renovasyonları ve anahtar teslim mimari taahhüt. 2.850'den fazla tamamlanan proje, 137 tescilli model arşivi.
        </p>
        <div class="text-[11px] text-zinc-300 font-medium space-y-1 pt-1">
          <div>📍 <strong>Atölye:</strong> Adatepe, Özbekistan Cd. no:10/f, 35000 Buca/İzmir</div>
          <div>📞 <strong>Telefon:</strong> <a href="tel:05353748329" class="hover:text-amber-400 transition font-bold text-white">0535 374 83 29</a></div>
          <div>💬 <strong>WhatsApp:</strong> <a href="https://wa.me/905353748329" target="_blank" class="text-emerald-400 font-bold hover:underline">0535 374 83 29</a></div>
          <div>📷 <strong>Instagram:</strong> <a href="https://www.instagram.com/cemyesilay.luxury" target="_blank" class="text-amber-400 font-bold hover:underline">@cemyesilay.luxury</a></div>
        </div>
      </div>

      <!-- Kolon 2: Mimari Hizmetler -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Mimari Hizmetler</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-amber-400 transition">Özel Ölçü Lüks Mutfak Dolabı</a></li>
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-amber-400 transition">Komple Mutfak Renovasyonu</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-amber-400 transition">Lüks Banyo Tasarımı & Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-amber-400 transition">Komple Daire Renovasyonu</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-amber-400 transition">Anahtar Teslim Taahhüt</a></li>
        </ul>
      </div>

      <!-- Kolon 3: Tasarım Koleksiyonu -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Tasarım Koleksiyonu (137)</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/tasarimlar/?kategori=mutfak" class="hover:text-amber-400 transition">Mutfak Modelleri (40 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=banyo" class="hover:text-amber-400 transition">Lüks Banyo Mobilyaları (25 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=kapilar" class="hover:text-amber-400 transition">Özel Tasarım Kapılar (39 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=gomme-dolap" class="hover:text-amber-400 transition">Giyinme Odası (33 Model)</a></li>
          <li><a href="/tasarimlar/" class="hover:text-amber-400 font-bold transition text-amber-500">Tüm Koleksiyonu İncele (137) →</a></li>
        </ul>
      </div>

      <!-- Kolon 4: Çalışma Saatleri & Keşif -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white">Atölye & Keşif</h4>
        <p class="text-[11.5px] text-zinc-400 leading-relaxed">
          Pazartesi – Cumartesi: 08:30 – 19:30<br>
          Pazar: Randevu ile Lazer Keşif
        </p>
        <div class="pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-white font-semibold rounded border border-zinc-700 transition"
          >
            <span>Hızlı 3D Keşif İste</span>
            <span class="text-amber-400">→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Alt Telif & Bilgi -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-zinc-400">
      <p>© {currentYear} Cem Yeşilay Mimarlık & Atölye İmalatı. Tüm hakları saklıdır.</p>
      <div class="flex items-center gap-4">
        <span>İzmir / Buca</span>
        <span>•</span>
        <span>Mutfak, Banyo, Kapı & Anahtar Teslim Renovasyon</span>
      </div>
    </div>

  </div>
</footer>
