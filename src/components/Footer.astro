---
import { siteConfig } from "../data/siteConfig";

const currentYear = new Date().getFullYear();
---

<!-- BÖLÜM: KURUMSAL ŞEFFAFLIK & DOĞRULAMA (FOOTER ÜSTÜ) -->
<section class="bg-[#F4F1EA] text-[#6E675F] py-10 border-t border-[#E5DFD5] text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#E5DFD5] pb-6">
      <div class="space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-[#C5A880] block">
          ŞEFFAF MİMARİ & DİJİTAL ALTYAPI
        </span>
        <h4 class="text-base font-serif font-semibold text-[#1A1918]">
          Yeşilay Mutfak & İç Mekân Tasarımı
        </h4>
      </div>
      <div class="flex items-center gap-4 text-xs font-medium text-[#282421] whitespace-nowrap">
        <span>📍 Adatepe İmalat Atölyesi</span>
        <span>•</span>
        <span>📐 3D Lazer Rölöve</span>
        <span>•</span>
        <span>🏛️ 28 Yıllık Tasarım Mirası</span>
      </div>
    </div>
    
    <!-- Linkler -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-[11.5px]">
      <a href="/sitemap.xml" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">XML Site Haritası</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="/robots.txt" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">Robots.txt İndeksi</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="/llms.txt" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">LLMs.txt Bilgi Grafı</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="/feed.xml" target="_blank" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">RSS 2.0 Yayını</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
      <a href="https://www.instagram.com/yesilaymutfak" target="_blank" rel="noopener noreferrer" class="p-3 bg-white border border-[#E5DFD5] hover:border-[#006039] transition flex items-center justify-between group rounded-xs shadow-2xs">
        <span class="group-hover:text-[#006039] text-[#282421] font-medium">Instagram @yesilaymutfak</span>
        <span class="text-[#C5A880] group-hover:text-[#006039]">↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ANA AÇIK RENK PREMİUM FOOTER -->
<footer class="bg-[#FAF9F6] text-[#6E675F] border-t border-[#E5DFD5] py-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 border-b border-[#E5DFD5] pb-12">
      
      <!-- Kolon 1: Marka & Açıklama -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="Yeşilay Mutfak Logo" class="h-11 w-auto object-contain shrink-0" width="44" height="44" />
          <div>
            <span class="text-sm font-serif tracking-wider text-[#1A1918] uppercase block leading-none font-bold">YEŞİLAY MUTFAK</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-[#C5A880] font-semibold block mt-1">MİMARLIK & İÇ MEKÂN TASARIMI</span>
          </div>
        </div>
        <p class="text-[#282421] font-light leading-relaxed text-[11.5px]">
          Kişiye ve mekânın karakterine özel tasarlanan mutfak dolapları, lüks banyo renovasyonları ve anahtar teslim mimari taahhüt. 2.850'den fazla tamamlanan proje, 137 tescilli model arşivi.
        </p>
        <div class="text-[11px] text-[#282421] font-medium space-y-1 pt-1">
          <div>📍 <strong>Mağaza & Atölye:</strong> Gaziler Mahallesi 1084/2 Sokak No: 1/A Buca/İzmir</div>
          <div>📞 <strong>Telefon:</strong> <a href="tel:02324411060" class="hover:text-[#006039] transition font-bold">0232 441 10 60</a></div>
          <div>💬 <strong>WhatsApp:</strong> <a href="https://wa.me/905324261788" target="_blank" class="text-[#006039] font-bold hover:underline">0532 426 17 88</a></div>
          <div>📷 <strong>Instagram:</strong> <a href="https://www.instagram.com/yesilaymutfak" target="_blank" class="text-[#C5A880] font-bold hover:underline">@yesilaymutfak</a></div>
        </div>
      </div>

      <!-- Kolon 2: Mimari Hizmetler -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#1A1918]">Mimari Hizmetler</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-[#006039] transition">Özel Ölçü Lüks Mutfak Dolabı</a></li>
          <li><a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#006039] transition">Komple Mutfak Renovasyonu</a></li>
          <li><a href="/izmir-banyo-yenileme-seramik/" class="hover:text-[#006039] transition">Lüks Banyo Tasarımı & Seramik</a></li>
          <li><a href="/izmir-komple-daire-tadilati/" class="hover:text-[#006039] transition">Komple Daire Renovasyonu</a></li>
          <li><a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-[#006039] transition">Anahtar Teslim Taahhüt</a></li>
        </ul>
      </div>

      <!-- Kolon 3: Tasarım Koleksiyonu -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#1A1918]">Tasarım Koleksiyonu (137)</h4>
        <ul class="space-y-2.5 text-[11.5px]">
          <li><a href="/tasarimlar/?kategori=mutfak" class="hover:text-[#006039] transition">Mutfak Modelleri (40 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=banyo" class="hover:text-[#006039] transition">Lüks Banyo Mobilyaları (25 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=kapilar" class="hover:text-[#006039] transition">Özel Tasarım Kapılar (39 Model)</a></li>
          <li><a href="/tasarimlar/?kategori=gomme-dolap" class="hover:text-[#006039] transition">Giyinme Odası (33 Model)</a></li>
          <li><a href="/tasarimlar/" class="hover:text-[#006039] font-bold transition text-[#006039]">Tüm Koleksiyonu İncele (137) →</a></li>
        </ul>
      </div>

      <!-- Kolon 4: Hızlı Keşif Formu / Çağrısı -->
      <div class="space-y-3 bg-white p-5 border border-[#E5DFD5] rounded-xs shadow-2xs">
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#1A1918]">Mimari Keşif Randevusu</h4>
        <p class="text-[11px] text-[#6E675F] font-light leading-relaxed">
          Adatepe atölyemizden uzman mimarımız yerinde lazer rölöve alır ve mekanınıza özel fotogerçekçi 3D mimari çizim hazırlar.
        </p>
        <div class="pt-2">
          <a href="https://wa.me/905324261788" target="_blank" rel="noopener noreferrer" class="block w-full text-center py-3 px-4 bg-[#006039] hover:bg-[#00482B] text-white font-bold uppercase tracking-wider text-[11px] rounded-xs border border-[#C5A880]/30 shadow-xs transition">
            Ücretsiz 3D Keşif Al
          </a>
        </div>
      </div>

    </div>

    <!-- Telif ve Alt Linkler -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#6E675F] whitespace-nowrap pt-8 border-t border-[#E5DFD5]">
      <div>
        &copy; {currentYear} Yeşilay Mutfak & İç Mekân Tasarımı. Tüm hakları saklıdır.
      </div>
      <div class="flex items-center gap-6">
        <a href="/" class="hover:text-[#006039] transition">Ana Sayfa</a>
        <a href="/hakkimizda/" class="hover:text-[#006039] transition">Hakkımızda</a>
        <a href="/tasarimlar/" class="hover:text-[#006039] transition">Koleksiyon (137)</a>
        <a href="/projeler/" class="hover:text-[#006039] transition">Projeler</a>
        <a href="/iletisim/" class="hover:text-[#006039] transition">İletişim & Atölye</a>
      </div>
    </div>

  </div>
</footer>
