---
import { siteConfig } from "../data/siteConfig";

export interface Props {
  service?: string;
}

const { service } = Astro.props;
const defaultMsg = encodeURIComponent("Merhaba, Adatepe atölyenizden mimari keşif ve 3D mutfak/banyo projelendirmesi için görüşmek istiyorum.");
const waUrl = `${siteConfig.whatsappUrl}?text=${defaultMsg}`;
---

<div class="fixed bottom-6 right-5 sm:right-7 z-50 flex flex-col items-end gap-2.5 font-sans" aria-label="Hızlı Mimari İletişim">
  
  <!-- Hızlı Telefon Butonu (Apple Glass Titanyum Kapsül) -->
  <a 
    href="tel:02324411060" 
    class="group flex items-center gap-2.5 py-2 px-3.5 bg-white/90 hover:bg-white text-[#1D1D1F] rounded-full border border-[#D2D2D7]/80 shadow-[0_4px_16px_rgba(0,0,0,0.08)] backdrop-blur-xl transition-all duration-300 hover:scale-105 active:scale-95" 
    aria-label="Doğrudan Ara: 0232 441 10 60"
  >
    <span class="w-7 h-7 rounded-full bg-[#F5F5F7] border border-[#E5DFD5] flex items-center justify-center text-[#1D1D1F] text-xs transition group-hover:bg-[#006039] group-hover:text-white">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    </span>
    <span class="text-[12px] font-semibold tracking-tight text-[#1D1D1F] pr-1">Hemen Ara</span>
  </a>

  <!-- WhatsApp Premium Butonu (Atelier Rolex Green & Altın Vurgu) -->
  <a 
    href={waUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="relative group flex items-center gap-3 py-3 px-5 bg-gradient-to-r from-[#006039] to-[#083020] hover:from-[#083020] hover:to-[#006039] text-white rounded-full shadow-[0_8px_24px_rgba(0,96,57,0.35)] border border-[#C5A880]/50 backdrop-blur-xl transition-all duration-300 hover:scale-105 active:scale-95" 
    aria-label="WhatsApp Mimari Danışma"
  >
    <!-- Canlı Nabız Halkası -->
    <span class="absolute -inset-1 rounded-full bg-[#006039]/25 animate-ping pointer-events-none"></span>

    <!-- WhatsApp SVG İkonu -->
    <span class="w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center shrink-0 text-white">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-1.115-.06-.275-.088-.63-.223-1.096-.425-1.986-.86-3.274-2.871-3.373-3.003-.099-.133-.804-1.072-.804-2.044 0-.972.508-1.45.69-1.65.182-.2.398-.25.53-.25.133 0 .265.001.382.007.123.006.288-.047.45.344.167.404.57 1.391.62 1.492.05.101.083.22.016.353-.066.133-.1.216-.199.332-.099.117-.208.261-.297.351-.099.099-.202.207-.087.404.116.198.514.849 1.103 1.374.757.675 1.396.884 1.595.983.199.099.315.083.431-.05.116-.134.498-.58.63-.779.133-.199.265-.166.448-.099.182.066 1.157.546 1.356.645.199.1.332.15.381.233.05.083.05.479-.094.884z"/>
      </svg>
    </span>

    <div class="flex flex-col text-left leading-none">
      <span class="text-[9px] uppercase tracking-[0.16em] text-[#C5A880] font-semibold">MİMARİ DANIŞMA</span>
      <span class="text-[13px] font-bold tracking-tight text-white mt-1">WhatsApp Keşif</span>
    </div>
  </a>

</div>
