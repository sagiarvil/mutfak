---
import { siteConfig } from "../data/siteConfig";

export interface Props {
  service?: string;
}

const { service } = Astro.props;
const defaultMsg = encodeURIComponent("Merhaba Cem Bey, Adatepe atölyenizden mimari keşif ve 3D mutfak/banyo projelendirmesi için görüşmek istiyorum.");
const waUrl = `${siteConfig.whatsappUrl}?text=${defaultMsg}`;
---

<div 
  id="floatingContactDock" 
  class="fixed bottom-6 right-5 sm:right-7 z-50 flex flex-col items-end gap-2.5 font-sans opacity-0 translate-y-6 pointer-events-none transition-all duration-300" 
  aria-label="Hızlı Mimari İletişim"
>
  
  <!-- Hızlı Telefon Butonu -->
  <a 
    href="tel:02324411060" 
    class="group flex items-center gap-2 py-2 px-3.5 bg-[#041F14]/95 hover:bg-[#062B1C] text-white rounded-full border border-[#C5A880]/30 shadow-xl backdrop-blur-xl transition-all duration-300 hover:scale-105 active:scale-95" 
    aria-label="Doğrudan Ara: 0232 441 1060"
  >
    <span class="w-6 h-6 rounded-full bg-[#02140D] text-[#C5A880] flex items-center justify-center text-xs">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    </span>
    <span class="text-xs font-bold text-white pr-1">0232 441 1060</span>
  </a>

  <!-- WhatsApp Butonu (Rolex Zümrüt & Cartier Altın) -->
  <a 
    href={waUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="relative group flex items-center gap-3 py-3 px-5 bg-[#041F14]/95 hover:bg-[#062B1C] text-white rounded-full shadow-2xl border border-[#C5A880]/40 backdrop-blur-xl transition-all duration-300 hover:scale-105 active:scale-95" 
    aria-label="WhatsApp Mimari Danışma"
  >
    <!-- WhatsApp SVG İkonu -->
    <span class="w-8 h-8 rounded-full bg-[#02140D] border border-[#C5A880]/40 flex items-center justify-center shrink-0 text-[#00FF66]">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-1.115-.06-.275-.088-.63-.223-1.096-.425-1.986-.86-3.274-2.871-3.373-3.003-.099-.133-.804-1.072-.804-2.044 0-.972.508-1.45.69-1.65.182-.2.398-.25.53-.25.133 0 .265.001.382.007.123.006.288-.047.45.344.167.404.57 1.391.62 1.492.05.101.083.22.016.353-.066.133-.1.216-.199.332-.099.117-.208.261-.297.351-.099.099-.202.207-.087.404.116.198.514.849 1.103 1.374.757.675 1.396.884 1.595.983.199.099.315.083.431-.05.116-.134.498-.58.63-.779.133-.199.265-.166.448-.099.182.066 1.157.546 1.356.645.199.1.332.15.381.233.05.083.05.479-.094.884z"/>
      </svg>
    </span>

    <div class="flex flex-col text-left leading-none">
      <span class="text-[9px] uppercase tracking-[0.16em] text-[#C5A880] font-bold">MİMARİ DANIŞMA</span>
      <span class="text-xs font-bold tracking-tight text-white mt-1">WhatsApp 3D Keşif</span>
    </div>
  </a>

</div>

<script is:inline>
  function handleFloatingDock() {
    const dock = document.getElementById('floatingContactDock');
    if (!dock) return;
    // Hero alanını (ilk 450px) geçince göster, tepedeyken heroyu engellemesin
    if (window.scrollY > 420) {
      dock.classList.remove('opacity-0', 'translate-y-6', 'pointer-events-none');
      dock.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    } else {
      dock.classList.add('opacity-0', 'translate-y-6', 'pointer-events-none');
      dock.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
    }
  }

  window.addEventListener('scroll', handleFloatingDock, { passive: true });
  document.addEventListener('DOMContentLoaded', handleFloatingDock);
</script>
