---
// src/components/BeforeAfter.astro
// evdekortadilat.com referanslı interaktif Öncesi / Sonrası Dönüşüm Bileşeni (Cartier Gold & Deep Dark)
---

<section id="oncesi-sonrasi" class="py-20 bg-[#081812] text-white relative overflow-hidden border-b border-[#0E2E20]">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
    
    <!-- Başlık & Açıklama (Rafine, Az Metin, Maksimum Etki) -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-[#051F14] text-[#C5A880] rounded-full border border-[#C5A880]/30 text-[11px] font-bold tracking-widest uppercase">
        <span>★ GERÇEK DÖNÜŞÜM ÖRNEĞİ</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-serif">
        Her Detayıyla Yenilenen Mekanlar
      </h2>
      <p class="text-[#D8D2C7] text-xs sm:text-sm font-light">
        Adatepe atölyemizin zanaatıyla eski ve yıpranmış mekanların kusursuz lüks yaşam alanına dönüşümü.
      </p>
    </div>

    <!-- İnteraktif Öncesi / Sonrası Slider Alanı -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Sol: İnteraktif Before/After Karşılaştırma Kutusu (8 Sütun) -->
      <div class="lg:col-span-8">
        <div class="relative w-full overflow-hidden rounded-2xl shadow-2xl border border-[#C5A880]/30 bg-black select-none aspect-[16/10] sm:aspect-[16/9]" id="beforeAfterContainer">
          
          <!-- Sonra Görseli (Altta tam genişlik) -->
          <img 
            src="/media/oncesi_sonrasi_sonra.webp" 
            alt="Mutfak Renovasyonu Sonrası" 
            class="absolute inset-0 w-full h-full object-cover" 
            loading="lazy" 
          />
          <div class="absolute bottom-4 right-4 px-3 py-1 bg-black/80 backdrop-blur-md text-[#00FF66] border border-[#00FF66]/40 rounded text-[11px] font-extrabold tracking-wider pointer-events-none uppercase">
            SONRA (TESLİMAT)
          </div>

          <!-- Önce Görseli (Üstte kırpılan katman) -->
          <div class="absolute inset-0 overflow-hidden" id="beforeLayer" style="width: 50%;">
            <img 
              src="/media/oncesi_sonrasi_once.webp" 
              alt="Mutfak Renovasyonu Öncesi" 
              class="absolute inset-0 w-full h-full object-cover max-w-none" 
              id="beforeImg"
              loading="lazy" 
            />
            <div class="absolute bottom-4 left-4 px-3 py-1 bg-black/80 backdrop-blur-md text-[#C5A880] border border-[#C5A880]/40 rounded text-[11px] font-extrabold tracking-wider pointer-events-none uppercase">
              ÖNCE (ESKİ HALİ)
            </div>
          </div>

          <!-- Sürgü Çizgisi ve Butonu (Divider / Handle) -->
          <div class="absolute top-0 bottom-0 w-1 bg-white shadow-[0_0_12px_rgba(255,255,255,0.9)] cursor-ew-resize z-20" id="sliderHandle" style="left: 50%;">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-11 h-11 bg-white text-[#041F14] rounded-full shadow-2xl flex items-center justify-center font-bold text-sm border-2 border-[#C5A880] transition-transform active:scale-95">
              <svg class="w-5 h-5 text-[#041F14]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l-4 3 4 3m8-6l4 3-4 3"/>
              </svg>
            </div>
          </div>

        </div>
        <div class="text-center text-xs text-[#C5BBAF] mt-3 font-medium flex items-center justify-center gap-1.5">
          <span>👈</span>
          <span>Sürgüyü kaydırarak dönüşümü canlı görün</span>
          <span>👉</span>
        </div>
      </div>

      <!-- Sağ: 3 Adımlı Rafine Dönüşüm Süreci -->
      <div class="lg:col-span-4 space-y-3.5">
        
        <div class="p-5 bg-[#051F14]/80 border border-[#0D3826] rounded-xl space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-[#C5A880] text-[#041F14] flex items-center justify-center font-extrabold text-xs">1</span>
            <h3 class="text-sm font-bold text-white">Lazer Rölöve & 3D Planlama</h3>
          </div>
          <p class="text-xs text-[#D8D2C7] leading-relaxed pl-9">
            Milimetrik lazer ölçüsü ile alan kapasitesi ve ışık optimizasyonu sağlandı.
          </p>
        </div>

        <div class="p-5 bg-[#051F14]/80 border border-[#0D3826] rounded-xl space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-[#C5A880] text-[#041F14] flex items-center justify-center font-extrabold text-xs">2</span>
            <h3 class="text-sm font-bold text-white">Altyapı & Su İzolasyonu</h3>
          </div>
          <p class="text-xs text-[#D8D2C7] leading-relaxed pl-9">
            Tüm tesisat yenilenerek %100 neme dayanıklı E1 MDF-Lam gövde uygulandı.
          </p>
        </div>

        <div class="p-5 bg-[#051F14]/80 border border-[#0D3826] rounded-xl space-y-1.5">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-[#C5A880] text-[#041F14] flex items-center justify-center font-extrabold text-xs">3</span>
            <h3 class="text-sm font-bold text-white">İpek Mat Lake & Blum Konfor</h3>
          </div>
          <p class="text-xs text-[#D8D2C7] leading-relaxed pl-9">
            Leke tutmayan İtalyan lake kapaklar ve sessiz frenli ray mekanizmaları monte edildi.
          </p>
        </div>

        <div class="pt-2">
          <a 
            href="https://wa.me/905324261788?text=Merhaba%20Cem%20Bey,%20mutfağımda%20öncesi/sonrası%20dönüşüm%20için%20ücretsiz%203D%20keşif%20istiyorum." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-extrabold text-center rounded block uppercase text-xs tracking-wider transition shadow-lg"
          >
            Mekanınız İçin Keşif Alın →
          </a>
        </div>

      </div>

    </div>

  </div>

</section>

<!-- İnteraktif Before / After Sürgü Scripti -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("beforeAfterContainer");
    const beforeLayer = document.getElementById("beforeLayer");
    const beforeImg = document.getElementById("beforeImg");
    const sliderHandle = document.getElementById("sliderHandle");

    if (!container || !beforeLayer || !sliderHandle) return;

    let isDragging = false;

    const setPosition = (x) => {
      const rect = container.getBoundingClientRect();
      let offsetX = x - rect.left;
      if (offsetX < 0) offsetX = 0;
      if (offsetX > rect.width) offsetX = rect.width;
      
      const percentage = (offsetX / rect.width) * 100;
      beforeLayer.style.width = `${percentage}%`;
      sliderHandle.style.left = `${percentage}%`;

      if (beforeImg) {
        beforeImg.style.width = `${rect.width}px`;
        beforeImg.style.height = `${rect.height}px`;
      }
    };

    const updateDimensions = () => {
      const rect = container.getBoundingClientRect();
      if (beforeImg) {
        beforeImg.style.width = `${rect.width}px`;
        beforeImg.style.height = `${rect.height}px`;
      }
    };

    window.addEventListener("resize", updateDimensions);
    updateDimensions();

    const startDrag = (e) => {
      isDragging = true;
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      setPosition(clientX);
    };

    const stopDrag = () => {
      isDragging = false;
    };

    const onMove = (e) => {
      if (!isDragging) return;
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      setPosition(clientX);
    };

    container.addEventListener("mousedown", startDrag);
    window.addEventListener("mouseup", stopDrag);
    window.addEventListener("mousemove", onMove);

    container.addEventListener("touchstart", startDrag, { passive: true });
    window.addEventListener("touchend", stopDrag);
    window.addEventListener("touchmove", onMove, { passive: true });
  });
</script>
