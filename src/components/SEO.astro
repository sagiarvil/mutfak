---
import { siteConfig } from "../data/siteConfig";
import { SEO_REGISTRY, DOMAIN } from "../seo/registry";
import { buildCompleteJsonLdGraph } from "../seo/schema-builder";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqList?: Array<{ question: string; answer: string }>;
  serviceName?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  image = "/android-chrome-512x512.png",
  type = "website",
  breadcrumbs = [],
  faqList = [],
  serviceName,
  publishedTime = "2024-01-15T09:00:00+03:00",
  modifiedTime = "2026-10-17T23:40:00+03:00"
} = Astro.props;

const siteUrl = siteConfig.siteUrl.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const normalizedRoute = currentPath === "" ? "/" : `${currentPath}/`;
const canonicalUrl = canonical || `${siteUrl}${normalizedRoute}`;
const imageUrl = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? image : "/" + image}`;

const fullTitle = title.includes("|") ? title : `${title} | Yeşilay Mutfak`;

// SSOT Registry kontrolü
const registeredPage = SEO_REGISTRY[normalizedRoute];

let jsonLd = "";
if (registeredPage) {
  jsonLd = buildCompleteJsonLdGraph(registeredPage, DOMAIN);
} else {
  // Dinamik oluşturucu
  const dynamicRecord = {
    route: normalizedRoute,
    locale: "tr-TR",
    role: "service" as const,
    indexDirective: "index, follow" as const,
    canonicalRoute: normalizedRoute,
    title: fullTitle,
    metaDescription: description,
    h1: title,
    primaryIntent: title,
    primaryEntity: {
      id: `${siteUrl}/#organization`,
      name: siteConfig.name,
      type: "HomeAndConstructionBusiness" as const,
      sameAs: [siteConfig.whatsappUrl, "https://www.instagram.com/yesilaymutfak"]
    },
    semanticTriples: [
      { subject: "Yeşilay Mutfak", predicate: "providesService", object: title }
    ],
    heroAnswerEngine: description,
    publishedAt: publishedTime,
    modifiedAt: modifiedTime,
    llmSubGraphRoute: `/llms/pages/${currentPath || "home"}.md`,
    mobileSubGraphRoute: `/llms/mobile/${currentPath || "home"}.md`,
    breadcrumbs: breadcrumbs.map(b => ({ name: b.name, item: b.url })),
    mobile: {
      viewport: "width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5",
      primaryAction: "call" as const,
      bottomNavEnabled: true,
      thumbZonePosition: "bottom-center" as const,
      touchTargetsValidated: true,
      horizontalScrollFree: true,
      thumbSafeHeroAnswer: true,
      voiceQueryPatterns: [],
      speakableSelectors: ["#hero-answer-engine", "h1"],
      pwaInstallable: true
    },
    mobileCwvBudget: {
      lcpMs: 1600,
      inpMs: 80,
      cls: 0.02,
      ttfbMs: 140,
      htmlKb: 45
    }
  };
  jsonLd = buildCompleteJsonLdGraph(dynamicRecord, DOMAIN);
}

// Eğer FAQ verisi varsa şemaya ekle
if (faqList.length > 0) {
  try {
    const parsed = JSON.parse(jsonLd);
    parsed["@graph"].push({
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqList.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    });
    jsonLd = JSON.stringify(parsed);
  } catch (e) {
    // pass
  }
}
---

<!-- Title & Temel SEO Meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content="Yeşilay Mutfak" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Geo Etiketleri -->
<meta name="geo.region" content="TR-35" />
<meta name="geo.placename" content="İzmir" />
<meta name="geo.position" content={`${siteConfig.geo.latitude};${siteConfig.geo.longitude}`} />
<meta name="ICBM" content={`${siteConfig.geo.latitude}, ${siteConfig.geo.longitude}`} />

<!-- LLMs & Autonomous AI Agent Discovery -->
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLMs.txt Manifest" />
<link rel="alternate" type="text/markdown" href="/llm.txt" title="LLM.txt Manifest" />
<link rel="alternate" type="text/markdown" href="/llms-full.txt" title="LLMs Full Knowledge Base" />
<link rel="agent" type="application/json" href="/.well-known/agent.json" />

<!-- Schema.org 14KB First-Packet JSON-LD -->
<script type="application/ld+json" set:html={jsonLd} />
