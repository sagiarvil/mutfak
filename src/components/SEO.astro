---
import { siteConfig } from "../data/siteConfig";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  keywords?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqList?: Array<{ question: string; answer: string }>;
  serviceName?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  image = "/android-chrome-512x512.png",
  type = "website",
  keywords = [],
  breadcrumbs = [],
  faqList = [],
  serviceName,
  publishedTime,
  modifiedTime = new Date().toISOString()
} = Astro.props;

const siteUrl = siteConfig.siteUrl.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const canonicalUrl = canonical || `${siteUrl}${currentPath}/`;
const imageUrl = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? image : "/" + image}`;

const fullTitle = title.includes("|") ? title : `${title} | ${siteConfig.name}`;

// -----------------------------------------------------------------------------
// SCHEMA.ORG @graph MIMARISI (AEO, LLM Atif & Google Rich Results)
// -----------------------------------------------------------------------------
const organizationNode = {
  "@type": "HomeAndConstructionBusiness",
  "@id": `${siteUrl}/#organization`,
  "name": siteConfig.name,
  "alternateName": siteConfig.legalName,
  "url": `${siteUrl}/`,
  "logo": `${siteUrl}/logo.png`,
  "image": imageUrl,
  "telephone": `+${siteConfig.phoneRaw}`,
  "priceRange": "Özel Mimari Tasarım",
  "foundingDate": String(siteConfig.foundingYear),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": siteConfig.ratingValue || "4.96",
    "reviewCount": "2850",
    "ratingCount": "2850",
    "bestRating": "5",
    "worstRating": "1"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.streetAddress,
    "addressLocality": siteConfig.address.addressLocality,
    "addressRegion": siteConfig.address.addressRegion,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": siteConfig.address.addressCountry
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": Number(siteConfig.geo.latitude),
    "longitude": Number(siteConfig.geo.longitude)
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:00",
      "closes": "19:30"
    }
  ],
  "areaServed": siteConfig.districts.map(d => ({ "@type": "AdministrativeArea", "name": d })),
  "sameAs": [siteConfig.whatsappUrl]
};

const serviceNode = serviceName ? {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  "name": serviceName,
  "provider": { "@id": `${siteUrl}/#organization` },
  "serviceType": serviceName,
  "areaServed": { "@id": `${siteUrl}/#organization` },
  "description": description,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "TRY",
    "availability": "https://schema.org/InStock"
  }
} : null;

const breadcrumbNode = breadcrumbs.length > 0 ? {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Ana Sayfa",
      "item": `${siteUrl}/`
    },
    ...breadcrumbs.map((b, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": b.name,
      "item": b.url.startsWith("http") ? b.url : `${siteUrl}${b.url}`
    }))
  ]
} : null;

const faqNode = faqList.length > 0 ? {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

const graph = [
  organizationNode,
  serviceNode,
  breadcrumbNode,
  faqNode
].filter(Boolean);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph
});
---

<!-- Title & Temel Meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content={siteConfig.name} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Geo Etiketleri -->
<meta name="geo.region" content="TR-35" />
<meta name="geo.placename" content="İzmir" />
<meta name="geo.position" content="38.4237;27.1428" />
<meta name="ICBM" content="38.4237, 27.1428" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={jsonLd} />
