---
import { siteConfig } from "../data/siteConfig";
---

<!-- ===================================================================== -->
<!-- PLAN MUTFAK BİREBİR HEADER YAPISI & RENKLERİ (#FFFFFF + #23323A + #CB000F) -->
<!-- ===================================================================== -->
<header id="header" class="w-full bg-white z-50 sticky top-0 shadow-md">
  
  <!-- 1. ÜST HEADER (#main-header: BEYAZ ZEMİN, LOGO + BİZE ULAŞIN TELEFON) -->
  <div id="main-header" class="border-b border-gray-100 bg-white py-3.5 sm:py-4">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 flex items-center justify-between">
      
      <!-- LOGO (Plan Mutfak Düzeni) -->
      <div class="logo flex items-center gap-3">
        <a href="/" title="Yamashi Mutfak" class="flex items-center gap-3 sm:gap-4 group">
          <img 
            src="/logo.png" 
            alt="İzmir Mutfak Banyo" 
            class="h-14 sm:h-16 lg:h-[72px] w-auto object-contain transition-transform group-hover:scale-105" 
            width="72" 
            height="72"
          />
          <img 
            src="/media/branding/yamashi-mutfak-red-badge.png" 
            alt="Yamashi Mutfak" 
            class="h-6 sm:h-7 lg:h-8 w-auto object-contain transition-opacity group-hover:opacity-90 shadow-sm rounded-[1px]"
            width="240"
            height="25"
            loading="eager"
          />
        </a>
      </div>

      <!-- SAĞ İLETİŞİM ALANI (Bize Ulaşın : 0539 333 33 03) -->
      <div class="flex items-center gap-4 sm:gap-6">
        <div class="text-right">
          <a 
            href="tel:05393333303" 
            class="font-['Montserrat',sans-serif] text-sm sm:text-lg font-bold text-[#23323A] hover:text-[#CB000F] transition flex items-center gap-2"
          >
            <span class="text-xs sm:text-sm text-[#7F8C8D] font-normal hidden md:inline">Bize Ulaşın :</span>
            <span class="font-extrabold tracking-tight">0539 333 33 03</span>
          </a>
        </div>

        <!-- WhatsApp İletişim Butonu -->
        <a 
          href={siteConfig.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-3.5 py-2 bg-[#25D366] hover:bg-[#20ba59] text-white rounded font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider transition flex items-center gap-1.5 shadow-xs"
          title="WhatsApp ile İletişim"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </a>

        <!-- Mobil Menü Toggle Butonu -->
        <button 
          id="mobileMenuBtn" 
          type="button" 
          class="lg:hidden p-2 text-[#23323A] hover:text-[#CB000F] focus:outline-none" 
          aria-label="Menüyü Aç"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- 2. ALT HEADER (#lower-header: KOYU ANTRASİT #23323A + KIRMIZI #CB000F VURGU) -->
  <div id="lower-header" class="bg-[#23323A] border-t border-[#1C282F] text-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <nav id="main-nav" class="hidden lg:flex items-center font-['Montserrat',sans-serif] text-[13px] font-bold tracking-wider uppercase">
        
        <!-- ANA SAYFA -->
        <a 
          href="/" 
          class="px-5 py-3.5 bg-[#CB000F] text-white hover:bg-[#b0000d] transition duration-150 border-r border-[#2d3e48]"
        >
          ANA SAYFA
        </a>

        <!-- HAKKIMIZDA -->
        <a 
          href="/hakkimizda/" 
          class="px-5 py-3.5 hover:bg-[#1c282f] hover:text-[#CB000F] text-gray-200 transition duration-150 border-r border-[#2d3e48]"
        >
          HAKKIMIZDA
        </a>

        <!-- MODELLER DROPDOWN (Plan Mutfak Menü Modeli) -->
        <div class="relative group">
          <a 
            href="/tasarimlar/" 
            class="px-5 py-3.5 hover:bg-[#1c282f] hover:text-[#CB000F] text-gray-200 transition duration-150 flex items-center gap-1.5 border-r border-[#2d3e48]"
          >
            <span>MODELLER</span>
            <svg class="w-3 h-3 text-gray-400 group-hover:text-[#CB000F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-0 w-64 bg-[#23323A] border-t-2 border-[#CB000F] shadow-2xl hidden group-hover:block z-50 divide-y divide-[#2d3e48]">
            <a href="/modern-mutfak-modelleri/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Klasik &amp; Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Akrilik &amp; Lake Dolaplar
            </a>
            <a href="/yasam-alanlari-mutfak-modelleri/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Ada Mutfak &amp; Yaşam Alanları
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Banyo Modelleri
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              İç Mimari Kapılar
            </a>
            <a href="/tasarimlar/" class="block px-5 py-3 text-xs text-[#CB000F] bg-[#1c282f] font-bold">
              Tüm 137 Model Kataloğu →
            </a>
          </div>
        </div>

        <!-- TADİLAT DROPDOWN -->
        <div class="relative group">
          <a 
            href="/izmir-anahtar-teslim-tadilat/" 
            class="px-5 py-3.5 hover:bg-[#1c282f] hover:text-[#CB000F] text-gray-200 transition duration-150 flex items-center gap-1.5 border-r border-[#2d3e48]"
          >
            <span>TADİLAT</span>
            <svg class="w-3 h-3 text-gray-400 group-hover:text-[#CB000F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-0 w-60 bg-[#23323A] border-t-2 border-[#CB000F] shadow-2xl hidden group-hover:block z-50 divide-y divide-[#2d3e48]">
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Komple Mutfak Tadilatı
            </a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Banyo Yenileme &amp; Seramik
            </a>
            <a href="/izmir-komple-daire-tadilati/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Komple Daire Tadilatı
            </a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-5 py-3 text-xs text-gray-200 hover:bg-[#1c282f] hover:text-[#CB000F] transition">
              Anahtar Teslim Taahhüt
            </a>
          </div>
        </div>

        <!-- MALİYET HESAPLA (ÖZEL VURGULU PLAN MUTFAK BUTONU) -->
        <a 
          href="/maliyet-hesapla/" 
          class="px-5 py-3.5 bg-[#CB000F]/90 hover:bg-[#CB000F] text-white transition duration-150 border-r border-[#2d3e48] flex items-center gap-1.5"
        >
          <span>MALİYET HESAPLA</span>
        </a>

        <!-- YAPILAN İŞLER -->
        <a 
          href="/yapilan-isler/" 
          class="px-5 py-3.5 hover:bg-[#1c282f] hover:text-[#CB000F] text-gray-200 transition duration-150 border-r border-[#2d3e48]"
        >
          YAPILAN İŞLER
        </a>

        <!-- İLETİŞİM -->
        <a 
          href="/iletisim/" 
          class="px-5 py-3.5 hover:bg-[#1c282f] hover:text-[#CB000F] text-gray-200 transition duration-150"
        >
          İLETİŞİM
        </a>

      </nav>

    </div>
  </div>

  <!-- MOBİL MENÜ ÇEKMECESİ -->
  <div id="mobileMenu" class="hidden lg:hidden bg-[#23323A] border-t border-[#1C282F] font-['Montserrat',sans-serif] text-xs font-bold uppercase divide-y divide-[#2d3e48]">
    <a href="/" class="block px-6 py-3 text-white bg-[#CB000F]">ANA SAYFA</a>
    <a href="/hakkimizda/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">HAKKIMIZDA</a>
    <a href="/tasarimlar/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">MODELLER (137 ADET)</a>
    <a href="/izmir-komple-mutfak-tadilati/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">MUTFAK TADİLATI</a>
    <a href="/izmir-banyo-yenileme-seramik/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">BANYO YENİLEME</a>
    <a href="/izmir-anahtar-teslim-tadilat/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">ANAHTAR TESLİM</a>
    <a href="/maliyet-hesapla/" class="block px-6 py-3 text-yellow-300 font-extrabold bg-[#1c282f]">🧮 MALİYET HESAPLA</a>
    <a href="/yapilan-isler/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">YAPILAN İŞLER</a>
    <a href="/iletisim/" class="block px-6 py-3 text-gray-200 hover:text-[#CB000F]">İLETİŞİM</a>
    <div class="p-4 bg-[#1c282f]">
      <a href="tel:05393333303" class="block w-full py-2.5 bg-[#CB000F] text-white text-center rounded font-bold">
        0539 333 33 03 - BİZİ ARAYIN
      </a>
    </div>
  </div>

</header>

<script is:inline>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
