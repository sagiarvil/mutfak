        </a>
      </div>
    </div>
  </div>

  <!-- ANA HEADER (KURUMSAL BEYAZ & NET ANTRESİT) -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 py-3 flex items-center justify-between gap-6">
    
    <!-- SOL: TEMİZ MİMARİ MARKA & LOGO -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="İzmir Mutfak Banyo Anasayfa">
      <img 
        src="/logo.png" 
        alt="İzmir Mutfak Banyo Logo" 
        class="w-10 h-10 sm:w-11 sm:h-11 object-contain rounded-lg p-0.5 bg-white border border-slate-200 shadow-xs group-hover:scale-105 transition"
        width="44"
        height="44"
      />
      <div class="flex flex-col">
        <span class="font-sans tracking-[0.14em] text-slate-900 text-base sm:text-lg md:text-xl font-extrabold uppercase leading-none group-hover:text-slate-700 transition">
          İZMİR MUTFAK BANYO
        </span>
        <span class="text-[9px] uppercase tracking-[0.22em] text-slate-500 font-bold mt-1">
          MİMARLIK &amp; ÖZEL İMALAT ATÖLYESİ
        </span>
      </div>
    </a>

    <!-- ORTA: PLAN MUTFAK MİMARİSİNDE NAVİGASYON -->
    <nav class="hidden xl:flex items-center space-x-6 2xl:space-x-8 text-[12px] font-bold text-slate-800 tracking-[0.05em] uppercase whitespace-nowrap">
      
      <!-- ANA SAYFA -->
      <a href="/" class="py-2 hover:text-slate-500 transition duration-150">
        ANA SAYFA
      </a>

      <!-- HAKKIMIZDA -->
      <a href="/hakkimizda/" class="py-2 hover:text-slate-500 transition duration-150">
        HAKKIMIZDA
      </a>

      <!-- MODELLER DROPDOWN -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1 hover:text-slate-500 transition duration-150 focus:outline-none">
          <span>MODELLER</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-72 min-w-[280px] hidden group-hover:block transition duration-150 z-50">
          <div class="bg-white rounded-xl shadow-xl border border-slate-200 py-2 divide-y divide-slate-100">
            <div class="px-4 py-1.5 text-[10px] font-bold text-slate-400 tracking-wider uppercase bg-slate-50">
              Mutfak Modelleri
            </div>
            <a href="/modern-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Klasik &amp; Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-5 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Akrilik &amp; Lake Hazır Dolaplar
            </a>
            <a href="/yasam-alanlari-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Ada Mutfak &amp; Yaşam Alanları
            </a>
            
            <div class="px-4 py-1.5 text-[10px] font-bold text-slate-400 tracking-wider uppercase bg-slate-50">
              Banyo &amp; Kapı Modelleri
            </div>
            <a href="/tasarimlar/?kategori=banyo" class="block px-5 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Özel Banyo Tasarımları
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-5 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              İç Mimari Oda Kapıları
            </a>
            <a href="/tasarimlar/" class="block px-5 py-2.5 text-xs text-slate-950 hover:bg-slate-50 font-bold transition">
              Tüm 137 Model Kataloğu →
            </a>
          </div>
        </div>
      </div>

      <!-- TADİLAT DROPDOWN -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1 hover:text-slate-500 transition duration-150 focus:outline-none">
          <span>TADİLAT</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-64 hidden group-hover:block transition duration-150 z-50">
          <div class="bg-white rounded-xl shadow-xl border border-slate-200 py-2 divide-y divide-slate-100">
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Komple Mutfak Tadilatı
            </a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Banyo Yenileme &amp; Seramik
            </a>
            <a href="/izmir-komple-daire-tadilati/" class="block px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Komple Daire Tadilatı
            </a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition font-medium">
              Anahtar Teslim Taahhüt
            </a>
          </div>
        </div>
      </div>

      <!-- MALİYET HESAPLA (KURUMSAL MİMARİ BUTON) -->
      <a 
        href="/maliyet-hesapla/" 
        class="py-1.5 px-3.5 rounded-lg border border-slate-300 bg-slate-100/80 hover:bg-slate-900 hover:text-white hover:border-slate-900 text-slate-900 font-bold transition flex items-center gap-1.5 text-[11.5px]"
      >
        <span>Maliyet Hesapla</span>
        <span class="text-[10px] text-emerald-600 font-mono font-bold">2026</span>
      </a>

      <!-- YAPILAN İŞLER -->
      <a href="/yapilan-isler/" class="py-2 hover:text-slate-500 transition duration-150">
        YAPILAN İŞLER
      </a>

      <!-- ÖNCESİ / SONRASI -->
      <a href="/#oncesi-sonrasi" class="py-2 hover:text-slate-500 transition duration-150">
        ÖNCESİ / SONRASI
      </a>

      <!-- İLETİŞİM -->
      <a href="/iletisim/" class="py-2 hover:text-slate-500 transition duration-150">
        İLETİŞİM
      </a>

    </nav>

    <!-- SAĞ: SİYAH MİMARİ KEŞİF BUTONU & MOBİL MENÜ -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="https://wa.me/905393333303?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20ve%20fiyat%20teklifi%20almak%20istiyorum." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-black text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-all shadow-xs"
      >
        <span>Ücretsiz Keşif Al</span>
        <span>→</span>
      </a>

      <!-- Mobil Menü Butonu -->
      <button 
        type="button" 
        id="btnToggleMobileMenu" 
        class="xl:hidden p-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 focus:outline-none transition"
        aria-label="Menüyü Aç/Kapat"
      >
        <svg id="iconMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="iconMenuClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

  </div>

  <!-- MOBİL MENÜ -->
  <div id="mobileMenuPanel" class="hidden xl:hidden bg-white border-t border-slate-200 px-5 py-6 shadow-xl max-h-[85vh] overflow-y-auto">
    <nav class="flex flex-col space-y-3 text-xs font-bold text-slate-800 uppercase tracking-wider">
      
      <a href="/maliyet-hesapla/" class="py-3 px-4 rounded-lg bg-slate-900 text-white font-bold flex items-center justify-between">
        <span>TADİLAT MALİYETİ HESAPLA</span>
        <span>→</span>
      </a>

      <a href="/" class="py-2 px-3 rounded hover:bg-slate-100 transition">ANA SAYFA</a>
      <a href="/hakkimizda/" class="py-2 px-3 rounded hover:bg-slate-100 transition">HAKKIMIZDA</a>
      
      <div class="py-2 px-3 bg-slate-50 rounded-lg">
        <span class="text-[10px] text-slate-500 font-bold block mb-1.5 uppercase">MODELLERİMİZ</span>
        <div class="pl-3 border-l-2 border-slate-200 space-y-2 text-[11px] font-medium text-slate-700">
          <a href="/modern-mutfak-modelleri/" class="block py-1 hover:text-black">Modern Mutfak Modelleri</a>
          <a href="/klasik-country-mutfak-modelleri/" class="block py-1 hover:text-black">Klasik &amp; Country Mutfak</a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="block py-1 hover:text-black">Akrilik &amp; Lake Dolaplar</a>
          <a href="/yasam-alanlari-mutfak-modelleri/" class="block py-1 hover:text-black">Ada Mutfak &amp; Yaşam Alanı</a>
          <a href="/tasarimlar/?kategori=banyo" class="block py-1 hover:text-black">Banyo Tasarımları</a>
          <a href="/tasarimlar/?kategori=kapilar" class="block py-1 hover:text-black">İç Oda Kapıları</a>
          <a href="/tasarimlar/" class="block py-1 text-slate-900 font-bold">Tüm Modeller (137 Model) →</a>
        </div>
      </div>

      <div class="py-2 px-3 bg-slate-50 rounded-lg">
        <span class="text-[10px] text-slate-500 font-bold block mb-1.5 uppercase">TADİLAT &amp; YENİLEME</span>
        <div class="pl-3 border-l-2 border-slate-200 space-y-2 text-[11px] font-medium text-slate-700">
          <a href="/izmir-komple-mutfak-tadilati/" class="block py-1 hover:text-black">Komple Mutfak Tadilatı</a>
          <a href="/izmir-banyo-yenileme-seramik/" class="block py-1 hover:text-black">Banyo Yenileme &amp; Seramik</a>
          <a href="/izmir-komple-daire-tadilati/" class="block py-1 hover:text-black">Komple Daire Tadilatı</a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="block py-1 hover:text-black">Anahtar Teslim Taahhüt</a>
        </div>
      </div>

      <a href="/yapilan-isler/" class="py-2 px-3 rounded hover:bg-slate-100 transition">YAPILAN İŞLER</a>
      <a href="/#oncesi-sonrasi" class="py-2 px-3 rounded hover:bg-slate-100 transition">ÖNCESİ / SONRASI</a>
      <a href="/2026-mutfak-dolabi-fiyatlari/" class="py-2 px-3 rounded hover:bg-slate-100 transition">FİYATLAR</a>
      <a href="/iletisim/" class="py-2 px-3 rounded hover:bg-slate-100 transition">İLETİŞİM</a>
      
      <div class="pt-3 border-t border-slate-200 space-y-2">
        <a 
          href="tel:05393333303" 
          class="w-full py-2.5 bg-slate-100 text-slate-900 border border-slate-300 font-bold text-center rounded-lg block uppercase text-xs tracking-wider"
        >
          0539 333 33 03 - Bizi Arayın
        </a>
        <a 
          href="https://wa.me/905393333303?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20almak%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-3 bg-slate-900 text-white font-bold text-center rounded-lg block uppercase text-xs tracking-wider"
        >
          WhatsApp ile Ücretsiz Keşif Al →
        </a>
      </div>
    </nav>
  </div>

</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnToggle = document.getElementById("btnToggleMobileMenu");
    const menuPanel = document.getElementById("mobileMenuPanel");
    const iconOpen = document.getElementById("iconMenuOpen");
    const iconClose = document.getElementById("iconMenuClose");

    if (btnToggle && menuPanel) {
      btnToggle.addEventListener("click", () => {
        const isHidden = menuPanel.classList.contains("hidden");
        if (isHidden) {
          menuPanel.classList.remove("hidden");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
        } else {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        }
      });

      menuPanel.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        });
      });
    }
  });
</script>
