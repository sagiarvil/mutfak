---
import { siteConfig } from "../data/siteConfig";

export interface Props {
  activeService?: string;
}

const { activeService } = Astro.props;

// Hizmete göre dinamik ve güvenli WhatsApp mesajı belirleme
let dynamicWaText = "Merhaba, Yeşilay Mutfak'tan keşif ve teklif almak istiyorum.";
if (activeService) {
  const norm = activeService.toLowerCase();
  if (norm.includes("hazır mutfak") || norm.includes("modüler") || norm.includes("hazir")) {
    dynamicWaText = "Merhaba, hazır mutfak modelleriniz ve teslim seçenekleriniz hakkında bilgi almak istiyorum.";
  } else if (norm.includes("mutfak dolabı") || norm.includes("komple mutfak") || norm.includes("mutfak")) {
    dynamicWaText = "Merhaba, mutfak dolabı veya komple mutfak tadilatı için teklif almak istiyorum.";
  } else if (norm.includes("banyo")) {
    dynamicWaText = "Merhaba, banyo yenileme için keşif ve teklif almak istiyorum.";
  } else if (norm.includes("ev tadilatı") || norm.includes("anahtar teslim") || norm.includes("daire")) {
    dynamicWaText = "Merhaba, komple ev tadilatı için keşif görüşmesi istiyorum.";
  } else if (norm.includes("ticari") || norm.includes("projelendirme") || norm.includes("ofis") || norm.includes("fit-out")) {
    dynamicWaText = "Merhaba, iş yerim için mimari proje ve uygulama teklifi almak istiyorum.";
  }
}

const waCtaUrl = `https://wa.me/905324261788?text=${encodeURIComponent(dynamicWaText)}`;
---

<!-- ===================================================================== -->
<!-- PREMİUM AÇIK RENK MİMARİ HEADER & NAVİGASYON (MANDATE STANDARTLARI)   -->
<!-- Renk Paleti: Arka Plan #FAF9F6 | Metin #15231C | Vurgu #C5A880        -->
<!-- Ayrım Çizgisi #E5E2DA | Masaüstü ~78px | Mobil ~68px                   -->
<!-- ===================================================================== -->
<header 
  class="sticky top-0 z-50 w-full bg-[#FAF9F6]/95 backdrop-blur-md border-b border-[#E5E2DA] shadow-[0_2px_12px_rgba(21,35,28,0.04)] text-[#15231C] transition-all duration-200" 
  id="siteHeader"
  x-data="{ mobileOpen: false, openMenu: null }"
  @keydown.escape="mobileOpen = false; openMenu = null"
>
  
  <!-- 1. ÜST YARDIMCI MİMARİ BİLGİ ŞERİDİ (Buca Showroom & Doğrudan Telefon) -->
  <div class="w-full bg-[#F3EFEA] border-b border-[#E5E2DA] text-[11px] text-[#4A443D] py-1 px-4 sm:px-6 lg:px-8 hidden md:block">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/iletisim/" class="hover:text-[#15231C] flex items-center gap-1.5 transition font-medium">
          <span class="text-[#C5A880]">📍</span>
          <span>Buca Showroom & İmalat Atölyesi</span>
          <span class="text-[#C5A880] text-[9px] font-bold">→ İletişim & Harita</span>
        </a>
        <span class="text-[#D0CAC0]">•</span>
        <span class="text-[#756E65]">Pzt - Cmt: 09:00 - 19:30</span>
      </div>
      <div class="flex items-center gap-4 font-medium">
        <span class="text-[#756E65]">Mimari Danışma Hattı:</span>
        <a 
          href="tel:+902324411060" 
          class="text-[#15231C] hover:text-[#C5A880] font-bold tracking-tight transition flex items-center gap-1.5"
          data-track="contact_start"
          data-category="telefon"
          data-type="header_top_phone"
        >
          <svg class="w-3 h-3 text-[#C5A880] fill-current" viewBox="0 0 24 24">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.44-5.15-3.75-6.59-6.59l1.97-1.57c.28-.27.36-.67.25-1.02A11.36 11.36 0 019 4.31a1 1 0 00-1-1H4.5c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"/>
          </svg>
          <span>0232 441 10 60</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. ANA NAVİGASYON ŞERİDİ (Masaüstü: ~76-82px | Mobil: ~66px) -->
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-4">
    
    <!-- SOL: YEŞİLAY MUTFAK LOGO (Açık Zemin Üzerinde Kusursuz Kontrast) -->
    <a href="/" class="flex items-center group shrink-0 py-0.5" aria-label="Yeşilay Mutfak Anasayfa" data-track="nav_click" data-category="brand" data-label="logo">
      <img 
        src="/logo.png" 
        alt="Yeşilay Mutfak Logo" 
        class="h-12 sm:h-14 lg:h-16 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02] drop-shadow-sm"
        width="140" 
        height="64" 
        loading="eager" 
      />
    </a>

    <!-- ORTA: TEK SIRA YENİ STRÜKTÜREL MENÜ (MUTFAK | BANYO | EV TADİLATI | MODELLER | YAPILAN İŞLER | TİCARİ PROJELER) -->
    <nav 
      class="hidden xl:flex items-center space-x-1.5 2xl:space-x-3 text-[13px] 2xl:text-[13.5px] font-semibold text-[#15231C] tracking-[0.03em] whitespace-nowrap"
      aria-label="Masaüstü Ana Menü"
    >
      
      <!-- 1. MUTFAK DROPDOWN -->
      <div 
        class="relative py-2" 
        @mouseenter="openMenu = 'mutfak'" 
        @mouseleave="openMenu = null"
      >
        <button 
          type="button" 
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-md hover:text-[#C5A880] hover:bg-[#F3EFEA]/60 transition duration-200 focus:outline-none focus:ring-2 focus:ring-[#C5A880]/50"
          :aria-expanded="openMenu === 'mutfak'"
          aria-haspopup="true"
          @click="openMenu = openMenu === 'mutfak' ? null : 'mutfak'"
          data-track="nav_click"
          data-category="mutfak"
          data-label="dropdown_trigger"
        >
          <span>MUTFAK</span>
          <svg class="w-3.5 h-3.5 text-[#C5A880] transition-transform duration-200" :class="openMenu === 'mutfak' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <!-- Dropdown Paneli -->
        <div 
          x-show="openMenu === 'mutfak'"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute left-0 top-full pt-1.5 min-w-[280px] w-max z-50"
          style="display: none;"
          role="menu"
        >
          <div class="bg-white rounded-lg shadow-[0_12px_36px_rgba(21,35,28,0.12)] border border-[#E5E2DA] py-2 divide-y divide-[#F3EFEA]">
            <a href="/mutfak-dolabi/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="mutfak" data-label="mutfak_dolabi_imalati">
              Mutfak Dolabı İmalatı
            </a>
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="mutfak" data-label="komple_mutfak_tadilati">
              Komple Mutfak Tadilatı
            </a>
            <a href="/modern-mutfak-modelleri/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="mutfak" data-label="modern_mutfak_modelleri">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="mutfak" data-label="klasik_country_mutfak">
              Klasik & Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="mutfak" data-label="hazir_moduler_mutfak">
              Hazır & Modüler Mutfak
            </a>
          </div>
        </div>
      </div>

      <!-- 2. BANYO DROPDOWN -->
      <div 
        class="relative py-2" 
        @mouseenter="openMenu = 'banyo'" 
        @mouseleave="openMenu = null"
      >
        <button 
          type="button" 
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-md hover:text-[#C5A880] hover:bg-[#F3EFEA]/60 transition duration-200 focus:outline-none focus:ring-2 focus:ring-[#C5A880]/50"
          :aria-expanded="openMenu === 'banyo'"
          aria-haspopup="true"
          @click="openMenu = openMenu === 'banyo' ? null : 'banyo'"
          data-track="nav_click"
          data-category="banyo"
          data-label="dropdown_trigger"
        >
          <span>BANYO</span>
          <svg class="w-3.5 h-3.5 text-[#C5A880] transition-transform duration-200" :class="openMenu === 'banyo' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <!-- Dropdown Paneli -->
        <div 
          x-show="openMenu === 'banyo'"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute left-0 top-full pt-1.5 min-w-[260px] w-max z-50"
          style="display: none;"
          role="menu"
        >
          <div class="bg-white rounded-lg shadow-[0_12px_36px_rgba(21,35,28,0.12)] border border-[#E5E2DA] py-2 divide-y divide-[#F3EFEA]">
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="banyo" data-label="komple_banyo_tadilati">
              Komple Banyo Tadilatı & Seramik
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="banyo" data-label="banyo_dolabi_modelleri">
              Banyo Dolabı Modelleri (25 Model)
            </a>
          </div>
        </div>
      </div>

      <!-- 3. EV TADİLATI (Doğrudan Link) -->
      <a 
        href="/izmir-anahtar-teslim-tadilat/" 
        class="px-2.5 py-1.5 rounded-md hover:text-[#C5A880] hover:bg-[#F3EFEA]/60 transition duration-200"
        data-track="nav_click"
        data-category="ev_tadilati"
        data-label="anahtar_teslim_ev_tadilati"
      >
        EV TADİLATI
      </a>

      <!-- 4. MODELLER DROPDOWN -->
      <div 
        class="relative py-2" 
        @mouseenter="openMenu = 'modeller'" 
        @mouseleave="openMenu = null"
      >
        <button 
          type="button" 
          class="flex items-center gap-1 px-2.5 py-1.5 rounded-md hover:text-[#C5A880] hover:bg-[#F3EFEA]/60 transition duration-200 focus:outline-none focus:ring-2 focus:ring-[#C5A880]/50"
          :aria-expanded="openMenu === 'modeller'"
          aria-haspopup="true"
          @click="openMenu = openMenu === 'modeller' ? null : 'modeller'"
          data-track="nav_click"
          data-category="modeller"
          data-label="dropdown_trigger"
        >
          <span>MODELLER</span>
          <svg class="w-3.5 h-3.5 text-[#C5A880] transition-transform duration-200" :class="openMenu === 'modeller' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <!-- Dropdown Paneli -->
        <div 
          x-show="openMenu === 'modeller'"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          class="absolute left-0 top-full pt-1.5 min-w-[270px] w-max z-50"
          style="display: none;"
          role="menu"
        >
          <div class="bg-white rounded-lg shadow-[0_12px_36px_rgba(21,35,28,0.12)] border border-[#E5E2DA] py-2 divide-y divide-[#F3EFEA]">
            <a href="/tasarimlar/" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-bold transition tracking-normal flex items-center justify-between" role="menuitem" data-track="nav_click" data-category="modeller" data-label="tum_modeller">
              <span>Tüm Modeller Arşivi</span>
              <span class="px-1.5 py-0.5 bg-[#F3EFEA] text-[#15231C] text-[10px] rounded font-semibold">137 Model</span>
            </a>
            <a href="/tasarimlar/?kategori=mutfak" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="modeller" data-label="mutfak_modelleri">
              Mutfak Modelleri (40 Model)
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="modeller" data-label="banyo_modelleri">
              Banyo Modelleri (25 Model)
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="modeller" data-label="ic_kapi_modelleri">
              İç Kapı Modelleri (39 Model)
            </a>
            <a href="/tasarimlar/?kategori=gomme-dolap" class="block px-4 py-2.5 text-xs text-[#15231C] hover:bg-[#FAF9F6] hover:text-[#006039] font-medium transition tracking-normal" role="menuitem" data-track="nav_click" data-category="modeller" data-label="gomme_dolap_modelleri">
              Gömme Dolap & Giyinme Odası (33 Model)
            </a>
          </div>
        </div>
      </div>

      <!-- 5. YAPILAN İŞLER (Gerçek Tamamlanmış Müşteri Projeleri) -->
      <a 
        href="/yapilan-isler/" 
        class="px-2.5 py-1.5 rounded-md hover:text-[#C5A880] hover:bg-[#F3EFEA]/60 transition duration-200"
        data-track="nav_click"
        data-category="referanslar"
        data-label="yapilan_isler"
      >
        YAPILAN İŞLER
      </a>

      <!-- 6. TİCARİ PROJELER (Ofis, Klinik, Mağaza B2B Fit-Out) -->
      <a 
        href="/projelendirme/" 
        class="px-2.5 py-1.5 rounded-md text-[#15231C] hover:text-[#C5A880] hover:bg-[#F3EFEA]/60 transition duration-200 flex items-center gap-1.5 font-bold"
        data-track="nav_click"
        data-category="ticari"
        data-label="ticari_projeler_b2b"
      >
        <span>TİCARİ PROJELER</span>
        <span class="px-1.5 py-0.2 bg-[#C5A880]/20 border border-[#C5A880]/60 text-[#8F7249] text-[9.5px] rounded font-bold">B2B</span>
      </a>

    </nav>

    <!-- SAĞ: BİRİNCİL DÖNÜŞÜM BUTONU (KEŞİF & TEKLİF AL) & MOBİL BUTONLARI -->
    <div class="flex items-center gap-2.5 shrink-0">
      
      <!-- Masaüstü Doğrudan Telefon Butonu (Kompakt) -->
      <a 
        href="tel:+902324411060" 
        class="hidden sm:inline-flex xl:hidden items-center gap-1.5 px-3 py-2 text-xs font-bold text-[#15231C] border border-[#E5E2DA] rounded-lg hover:bg-[#F3EFEA] transition"
        aria-label="Showroom Telefonu"
        data-track="contact_start"
        data-category="telefon"
        data-type="header_compact_phone"
      >
        <span class="text-[#C5A880]">📞</span>
        <span>0232 441 10 60</span>
      </a>

      <!-- BİRİNCİL CTA: KEŞİF & TEKLİF AL (WhatsApp & Akıllı Teklif Hattı) -->
      <a 
        href={waCtaUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2.5 bg-[#006039] hover:bg-[#00482B] text-white font-bold text-xs sm:text-[12.5px] tracking-[0.04em] uppercase rounded-lg border border-[#C5A880]/50 transition-all duration-200 shadow-[0_4px_14px_rgba(0,96,57,0.25)] hover:shadow-[0_6px_20px_rgba(0,96,57,0.35)] whitespace-nowrap"
        data-track="cta_click"
        data-category="primary_cta"
        data-type="kesif_teklif_al"
      >
        <span>KEŞİF & TEKLİF AL</span>
        <span class="text-[#C5A880]">→</span>
      </a>

      <!-- Mobil Menü Butonu (Touch target min 44x44px) -->
      <button 
        type="button" 
        class="xl:hidden w-11 h-11 flex items-center justify-center rounded-lg bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#15231C] border border-[#E5E2DA] focus:outline-none focus:ring-2 focus:ring-[#C5A880]"
        aria-label="Menüyü Aç/Kapat"
        :aria-expanded="mobileOpen"
        @click="mobileOpen = !mobileOpen"
        data-track="nav_click"
        data-category="mobile_toggle"
      >
        <svg x-show="!mobileOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg x-show="mobileOpen" class="w-5 h-5" style="display: none;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

    </div>

  </div>

  <!-- ===================================================================== -->
  <!-- 3. MOBİL AÇILIR ACCORDION MENÜ (Erişilebilir, Touch-Friendly, Açık Tema) -->
  <!-- ===================================================================== -->
  <div 
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="xl:hidden bg-[#FAF9F6] border-t border-[#E5E2DA] px-4 py-5 shadow-2xl max-h-[calc(100vh-80px)] overflow-y-auto"
    style="display: none;"
    id="mobileMenuPanel"
    x-data="{ accMutfak: false, accBanyo: false, accModeller: false }"
  >
    <nav class="flex flex-col space-y-2 text-sm font-semibold text-[#15231C]">
      
      <!-- Ana Sayfa -->
      <a 
        href="/" 
        class="py-2.5 px-3 rounded-lg hover:bg-[#F3EFEA] hover:text-[#006039] transition"
        @click="mobileOpen = false"
      >
        ANA SAYFA
      </a>

      <!-- MUTFAK Accordion -->
      <div class="border-b border-[#E5E2DA]/80 pb-1.5">
        <button 
          type="button" 
          class="w-full flex items-center justify-between py-2.5 px-3 rounded-lg hover:bg-[#F3EFEA] text-left"
          @click="accMutfak = !accMutfak"
          :aria-expanded="accMutfak"
        >
          <span class="font-bold">MUTFAK HİZMETLERİ</span>
          <svg class="w-4 h-4 text-[#C5A880] transition-transform duration-200" :class="accMutfak ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div x-show="accMutfak" class="pl-4 pr-2 py-1.5 space-y-1.5 text-xs text-[#4A443D] border-l-2 border-[#C5A880] ml-3 mt-1" style="display: none;">
          <a href="/mutfak-dolabi/" class="block py-2 px-2 hover:bg-[#F3EFEA] rounded hover:text-[#006039]" @click="mobileOpen = false">Mutfak Dolabı İmalatı</a>
          <a href="/izmir-komple-mutfak-tadilati/" class="block py-2 px-2 hover:bg-[#F3EFEA] rounded hover:text-[#006039]" @click="mobileOpen = false">Komple Mutfak Tadilatı</a>
          <a href="/modern-mutfak-modelleri/" class="block py-2 px-2 hover:bg-[#F3EFEA] rounded hover:text-[#006039]" @click="mobileOpen = false">Modern Mutfak Modelleri</a>
          <a href="/klasik-country-mutfak-modelleri/" class="block py-2 px-2 hover:bg-[#F3EFEA] rounded hover:text-[#006039]" @click="mobileOpen = false">Klasik & Country Mutfak</a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="block py-2 px-2 hover:bg-[#F3EFEA] rounded hover:text-[#006039]" @click="mobileOpen = false">Hazır & Modüler Mutfak</a>
        </div>
