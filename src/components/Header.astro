---
import { siteConfig } from "../data/siteConfig";
---

<!-- ===================================================================== -->
<!-- İZMİR MUTFAK BANYO — PLAN MUTFAK STANDARTLARINDA MİMARİ HEADER       -->
<!-- ===================================================================== -->
<header class="sticky top-0 z-50 w-full bg-white border-b border-slate-200 shadow-xs" id="siteHeader">
  
  <!-- ÜST İLETİŞİM ŞERİDİ (Plan Mutfak & Elit Dekorasyon Stili) -->
  <div class="bg-slate-50 border-b border-slate-200/80 text-[11.5px] text-slate-600 py-1.5 hidden md:block">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-2 font-medium text-slate-700">
          <svg class="w-3.5 h-3.5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          İzmir Geneli Özel İmalat &amp; Ücretsiz Yerinde Keşif
        </span>
        <span class="text-slate-300">•</span>
        <span class="text-slate-500">Pzt - Cmt: 09:00 - 19:30</span>
      </div>
      <div class="flex items-center gap-6 font-semibold">
        <a href="tel:05393333303" class="hover:text-slate-900 transition flex items-center gap-1.5 text-slate-800">
          <svg class="w-3.5 h-3.5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          0539 333 33 03
        </a>
        <span class="text-slate-300">|</span>
        <a href="https://wa.me/905393333303?text=Merhaba,%20ücretsiz%20keşif%20ve%20fiyat%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:text-emerald-800 transition flex items-center gap-1.5 font-bold">
