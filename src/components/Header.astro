---
import { siteConfig } from "../data/siteConfig";
---

<!-- ===================================================================== -->
<!-- İZMİR MUTFAK BANYO — ÇAĞDAŞ MİMARİ HEADER (PLAN MUTFAK & ELİT DEKOR)   -->
<!-- ===================================================================== -->
<header class="sticky top-0 z-50 w-full bg-slate-900 border-b border-slate-800 shadow-lg text-white" id="siteHeader">
  
  <!-- ÜST BİLGİ ŞERİDİ (Ferah & Kurumsal) -->
  <div class="bg-slate-950 border-b border-slate-800/80 text-[11.5px] text-slate-300 py-1.5 hidden md:block">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5 text-slate-200">
          <span class="text-sky-400">📍</span> İzmir Geneli Atölye İmalatı & Ücretsiz Yerinde Keşif
        </span>
        <span class="text-slate-600">•</span>
        <span class="flex items-center gap-1.5">
          <span class="text-amber-400">⏱️</span> Pzt - Cmt: 09:00 - 19:30
        </span>
      </div>
      <div class="flex items-center gap-5 font-medium">
        <a href="tel:02324411060" class="hover:text-sky-400 transition flex items-center gap-1.5">
          <span class="text-sky-400">📞</span> <strong>0232 441 1060</strong>
        </a>
        <span class="text-slate-700">|</span>
        <a href="https://wa.me/905324261788?text=Merhaba,%20ücretsiz%20keşif%20ve%20fiyat%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1.5 transition">
          <span>💬</span> WhatsApp Keşif Hattı
        </a>
      </div>
    </div>
  </div>

  <!-- ANA HEADER ŞERİDİ -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 py-3 flex items-center justify-between gap-4">
    
    <!-- SOL: LOGO & MARKA İSMİ -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="İzmir Mutfak Banyo Anasayfa">
      <div class="relative">
        <img 
          src="/logo.png" 
          alt="İzmir Mutfak Banyo Logo" 
          class="h-12 sm:h-14 md:h-16 w-auto object-contain transition-all duration-300 group-hover:scale-105"
          style="filter: drop-shadow(0 0 12px rgba(14, 165, 233, 0.45));"
          width="70" 
          height="70" 
          loading="eager" 
        />
      </div>
      <div class="flex flex-col">
        <span class="font-sans tracking-[0.12em] text-white text-lg sm:text-xl md:text-2xl font-black uppercase leading-none group-hover:text-sky-400 transition">
          İZMİR MUTFAK BANYO
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.24em] text-amber-400 font-bold mt-1">
          TASARIM • İMALAT • TADİLAT
        </span>
      </div>
    </a>

    <!-- ORTA: PROFESYONEL MİMARİ MENÜ (PLAN MUTFAK + MALİYET HESAPLA) -->
    <nav class="hidden xl:flex items-center space-x-5 2xl:space-x-7 text-[12.5px] font-semibold text-slate-100 tracking-[0.04em] uppercase whitespace-nowrap">
      
      <!-- 1. ANA SAYFA -->
      <a href="/" class="relative py-2 hover:text-sky-400 transition duration-200">
        ANA SAYFA
      </a>

      <!-- 2. HAKKIMIZDA -->
      <a href="/hakkimizda/" class="relative py-2 hover:text-sky-400 transition duration-200">
        HAKKIMIZDA
      </a>

      <!-- 3. MODELLER (Açılır Menü - Plan Mutfak Referansı) -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1.5 hover:text-sky-400 transition duration-200 focus:outline-none">
          <span>MODELLER</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-72 min-w-[280px] hidden group-hover:block transition duration-200 z-50">
          <div class="bg-slate-900/98 backdrop-blur-2xl rounded-xl shadow-2xl border border-slate-700/80 py-2 divide-y divide-slate-800">
            <div class="px-4 py-1.5 text-[10px] font-bold text-sky-400 tracking-wider uppercase bg-slate-950/70">
              Mutfak Modelleri
            </div>
            <a href="/modern-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium whitespace-nowrap">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium whitespace-nowrap">
              Klasik & Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-5 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium whitespace-nowrap">
              Akrilik & Lake Hazır Dolaplar
            </a>
            <a href="/yasam-alanlari-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium whitespace-nowrap">
              Ada Mutfak & Açık Yaşam Alanı
            </a>
            
            <div class="px-4 py-1.5 text-[10px] font-bold text-sky-400 tracking-wider uppercase bg-slate-950/70">
              Banyo & Kapı Modelleri
            </div>
            <a href="/tasarimlar/?kategori=banyo" class="block px-5 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium whitespace-nowrap">
              Lüks Banyo Dolapları & Tasarımlar
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-5 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium whitespace-nowrap">
              İç Mekân & Oda Kapıları
            </a>
            <a href="/tasarimlar/" class="block px-5 py-2.5 text-xs text-amber-400 hover:bg-slate-800 font-bold transition whitespace-nowrap">
              Tüm 137 Model Kataloğu →
            </a>
          </div>
        </div>
      </div>

      <!-- 4. TADİLAT & RENOVASYON (Açılır Menü - Ev Dekor & Elit Dekorasyon Referansı) -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1.5 hover:text-sky-400 transition duration-200 focus:outline-none">
          <span>TADİLAT</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-64 hidden group-hover:block transition duration-200 z-50">
          <div class="bg-slate-900/98 backdrop-blur-2xl rounded-xl shadow-2xl border border-slate-700/80 py-2 divide-y divide-slate-800">
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium">
              Komple Mutfak Tadilatı
            </a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium">
              Banyo Yenileme & Seramik
            </a>
            <a href="/izmir-komple-daire-tadilati/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium">
              Komple Daire Tadilatı
            </a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-4 py-2.5 text-xs text-slate-200 hover:bg-slate-800 hover:text-sky-400 transition font-medium">
              Anahtar Teslim Taahhüt
            </a>
          </div>
        </div>
      </div>

      <!-- 5. MALİYET HESAPLA (YENİ VE ÖZEL VURGULU!) -->
      <a 
        href="/maliyet-hesapla/" 
        class="relative py-1.5 px-3 rounded-lg bg-sky-500/15 border border-sky-400/40 text-sky-300 hover:bg-sky-500 hover:text-slate-950 transition font-bold flex items-center gap-1.5 shadow-sm"
      >
        <span>🧮</span>
        <span>MALİYET HESAPLA</span>
      </a>

      <!-- 6. YAPILAN İŞLER (Referanslar) -->
      <a href="/yapilan-isler/" class="relative py-2 hover:text-sky-400 transition duration-200">
        YAPILAN İŞLER
      </a>

      <!-- 7. ÖNCESİ / SONRASI -->
      <a href="/#oncesi-sonrasi" class="relative py-2 text-amber-400 hover:text-white transition duration-200 font-bold">
        ÖNCESİ / SONRASI
      </a>

      <!-- 8. İLETİŞİM -->
      <a href="/iletisim/" class="relative py-2 hover:text-sky-400 transition duration-200">
        İLETİŞİM
      </a>

    </nav>

    <!-- SAĞ: HIZLI KEŞİF BUTONU & MOBİL TOGGLE -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="https://wa.me/905324261788?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20ve%20fiyat%20teklifi%20almak%20istiyorum." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-sky-500 hover:bg-sky-400 text-slate-950 font-black text-xs uppercase tracking-wider rounded-xl transition-all duration-300 shadow-md shadow-sky-500/20"
      >
        <span>Ücretsiz Keşif Al</span>
        <span>→</span>
      </a>

      <!-- Mobil Menü Butonu -->
      <button 
        type="button" 
        id="btnToggleMobileMenu" 
        class="xl:hidden p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 focus:outline-none transition"
        aria-label="Menüyü Aç/Kapat"
      >
        <svg id="iconMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="iconMenuClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- MOBİL & TABLET AÇILIR MENÜ (MODERN ANTRASİT) -->
  <div id="mobileMenuPanel" class="hidden xl:hidden bg-slate-900 border-t border-slate-800 px-5 py-6 shadow-2xl max-h-[85vh] overflow-y-auto">
    <nav class="flex flex-col space-y-3.5 text-xs font-bold text-white uppercase tracking-wider">
      
      <!-- Maliyet Hesapla (Mobilde En Üstte Vurgulu) -->
      <a href="/maliyet-hesapla/" class="py-3 px-4 rounded-xl bg-sky-500 text-slate-950 font-black flex items-center justify-between shadow-md">
        <span class="flex items-center gap-2"><span>🧮</span> MALİYET HESAPLAMA MOTORU</span>
        <span>→</span>
      </a>

      <a href="/" class="py-2 px-3 rounded hover:bg-slate-800 hover:text-sky-400 transition">ANA SAYFA</a>
      <a href="/hakkimizda/" class="py-2 px-3 rounded hover:bg-slate-800 hover:text-sky-400 transition">HAKKIMIZDA</a>
      
      <!-- Modeller Grubu -->
      <div class="py-1 px-3 bg-slate-950/60 rounded-xl">
        <span class="text-[10px] text-sky-400 font-bold block mb-1.5 uppercase">MODELLER (MUTFAK • BANYO • KAPI)</span>
        <div class="pl-3 border-l-2 border-slate-800 space-y-2 text-[11px] font-normal text-slate-300">
          <a href="/modern-mutfak-modelleri/" class="block py-1 hover:text-sky-400">Modern Mutfak Modelleri</a>
          <a href="/klasik-country-mutfak-modelleri/" class="block py-1 hover:text-sky-400">Klasik & Country Mutfak</a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="block py-1 hover:text-sky-400">Akrilik & Lake Hazır Dolaplar</a>
          <a href="/yasam-alanlari-mutfak-modelleri/" class="block py-1 hover:text-sky-400">Ada & Açık Yaşam Alanı</a>
          <a href="/tasarimlar/?kategori=banyo" class="block py-1 hover:text-sky-400">Lüks Banyo Tasarımları</a>
          <a href="/tasarimlar/?kategori=kapilar" class="block py-1 hover:text-sky-400">İç Mekân Kapıları</a>
          <a href="/tasarimlar/" class="block py-1 text-amber-400 font-bold">Tüm Modeller (137 Model) →</a>
        </div>
      </div>

      <!-- Tadilat Grubu -->
      <div class="py-1 px-3 bg-slate-950/60 rounded-xl">
        <span class="text-[10px] text-sky-400 font-bold block mb-1.5 uppercase">TADİLAT & RENOVASYON</span>
        <div class="pl-3 border-l-2 border-slate-800 space-y-2 text-[11px] font-normal text-slate-300">
          <a href="/izmir-komple-mutfak-tadilati/" class="block py-1 hover:text-sky-400">Komple Mutfak Tadilatı</a>
          <a href="/izmir-banyo-yenileme-seramik/" class="block py-1 hover:text-sky-400">Banyo Yenileme & Seramik</a>
          <a href="/izmir-komple-daire-tadilati/" class="block py-1 hover:text-sky-400">Komple Daire Tadilatı</a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="block py-1 hover:text-sky-400">Anahtar Teslim Taahhüt</a>
        </div>
      </div>

      <a href="/yapilan-isler/" class="py-2 px-3 rounded hover:bg-slate-800 hover:text-sky-400 transition flex items-center justify-between">
        <span>YAPILAN İŞLER (REFERANSLAR)</span>
        <span class="px-2 py-0.5 bg-emerald-500 text-slate-950 text-[10px] rounded-md font-black">96 Proje</span>
      </a>

      <a href="/#oncesi-sonrasi" class="py-2 px-3 rounded bg-slate-800 text-amber-400 transition font-bold">
        ★ ÖNCESİ / SONRASI DÖNÜŞÜM
      </a>

      <a href="/2026-mutfak-dolabi-fiyatlari/" class="py-2 px-3 rounded hover:bg-slate-800 hover:text-sky-400 transition">FİYATLAR</a>
      <a href="/iletisim/" class="py-2 px-3 rounded hover:bg-slate-800 hover:text-sky-400 transition">İLETİŞİM</a>
      
      <div class="pt-3 border-t border-slate-800 space-y-2">
        <a 
          href="tel:02324411060" 
          class="w-full py-2.5 bg-slate-800 text-white border border-slate-700 font-bold text-center rounded-xl block uppercase text-xs tracking-wider"
        >
          📞 0232 441 1060 - Bizi Arayın
        </a>
        <a 
          href="https://wa.me/905324261788?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20almak%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-3 bg-emerald-500 text-slate-950 font-bold text-center rounded-xl block uppercase text-xs tracking-wider"
        >
          WhatsApp ile Ücretsiz Keşif Al →
        </a>
      </div>
    </nav>
  </div>

</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnToggle = document.getElementById("btnToggleMobileMenu");
    const menuPanel = document.getElementById("mobileMenuPanel");
    const iconOpen = document.getElementById("iconMenuOpen");
    const iconClose = document.getElementById("iconMenuClose");

    if (btnToggle && menuPanel) {
      btnToggle.addEventListener("click", () => {
        const isHidden = menuPanel.classList.contains("hidden");
        if (isHidden) {
          menuPanel.classList.remove("hidden");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
        } else {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        }
      });

      menuPanel.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        });
      });
    }
  });
</script>
