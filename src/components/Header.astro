---
import { siteConfig } from "../data/siteConfig";
---

<!-- ===================================================================== -->
<!-- PLAN MUTFAK & MODERN KURUMSAL MİMARLIK HEADER YAPISI                  -->
<!-- ===================================================================== -->
<header class="sticky top-0 z-50 w-full bg-white border-b border-gray-200 shadow-sm" id="siteHeader">
  
  <!-- 1. ÜST İLETİŞİM & PRESTİJ BARI (TOP BAR) -->
  <div class="bg-[#18181B] text-gray-300 text-xs py-2 px-4 sm:px-8 border-b border-zinc-800">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Sol: İletişim & Lokasyon Bilgileri -->
      <div class="flex items-center gap-4 sm:gap-6 truncate">
        <a href="tel:05353748329" class="flex items-center gap-1.5 text-white hover:text-amber-400 font-semibold transition shrink-0">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
          </svg>
          <span class="tracking-wide">Bize Ulaşın: 0535 374 83 29</span>
        </a>
        <span class="hidden md:inline-flex items-center gap-1.5 text-gray-400 text-[11.5px] truncate">
          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Adatepe Mah. Özbekistan Cd. No:10/F • Buca / İzmir
        </span>
      </div>

      <!-- Sağ: Instagram & Sosyal Medya -->
      <div class="flex items-center gap-4 shrink-0 text-xs">
        <a href="https://www.instagram.com/cemyesilay.luxury" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 text-gray-300 hover:text-amber-400 transition">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>@cemyesilay.luxury</span>
        </a>
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-zinc-200 hover:text-white transition font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>WhatsApp Hattı</span>
        </a>
      </div>

    </div>
  </div>

  <!-- 2. ANA HEADER ŞERİDİ (LOGO + STANDART MODERN MENÜ + BUTON) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3 sm:py-4 flex items-center justify-between gap-6">
    
    <!-- SOL: BÜYÜTÜLMÜŞ CANLI LOGO (NEON YEŞİL IŞILTI & PRESTİJ) -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="Cem Yeşilay Anasayfa">
      <div class="relative">
        <img 
          src="/logo.png" 
          alt="Cem Yeşilay Mutfak & Mimarlık Logo" 
          class="h-12 sm:h-14 md:h-16 w-auto object-contain transition-all duration-300 group-hover:scale-105"
          style="filter: drop-shadow(0 0 14px rgba(0, 255, 102, 0.5));"
          width="64" 
          height="64" 
          loading="eager" 
        />
      </div>
      <div class="flex flex-col">
        <span class="font-serif tracking-[0.14em] text-zinc-900 text-lg sm:text-xl md:text-2xl font-extrabold uppercase leading-none group-hover:text-zinc-700 transition">
          CEM YEŞİLAY
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.24em] text-amber-700 font-bold mt-1">
          MİMARLIK & ATÖLYE İMALATI
        </span>
      </div>
    </a>

    <!-- ORTA: PLAN MUTFAK STANDART MODERN MASAÜSTÜ MENÜSÜ -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-[13px] xl:text-[13.5px] font-bold text-zinc-800 tracking-wide uppercase">
      
      <a href="/" class="hover:text-amber-600 transition py-2 border-b-2 border-transparent hover:border-amber-600">
        ANA SAYFA
      </a>

      <a href="/hakkimizda/" class="hover:text-amber-600 transition py-2 border-b-2 border-transparent hover:border-amber-600">
        HAKKIMIZDA
      </a>

      <!-- MODELLER DROPDOWN -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1 hover:text-amber-600 transition focus:outline-none">
          <span>MODELLER</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <!-- Dropdown Panel -->
        <div class="absolute left-0 top-full pt-2 w-56 hidden group-hover:block transition duration-200 z-50">
          <div class="bg-white rounded-lg shadow-xl border border-gray-200 py-2 divide-y divide-gray-100">
            <a href="/modern-mutfak-modelleri/" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Klasik & Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Lüks Akrilik & Lake Dolaplar
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Özel Banyo Tasarımları
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              İç Mimari Kapılar
            </a>
          </div>
        </div>
      </div>

      <a href="/tasarimlar/" class="hover:text-amber-600 transition py-2 border-b-2 border-transparent hover:border-amber-600 flex items-center gap-1.5">
        <span>TASARIMLAR</span>
        <span class="px-1.5 py-0.5 bg-zinc-900 text-white text-[10px] rounded font-bold">137</span>
      </a>

      <!-- ÖNCESİ & SONRASI (EVDEKOR TADİLAT REFERANSI) -->
      <a href="/#oncesi-sonrasi" class="text-amber-700 hover:text-amber-800 transition py-2 border-b-2 border-transparent hover:border-amber-700 font-extrabold flex items-center gap-1">
        <span>ÖNCESİ / SONRASI</span>
      </a>

      <!-- TADİLAT & RENOVASYON DROPDOWN -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1 hover:text-amber-600 transition focus:outline-none">
          <span>TADİLAT & UYGULAMA</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-64 hidden group-hover:block transition duration-200 z-50">
          <div class="bg-white rounded-lg shadow-xl border border-gray-200 py-2 divide-y divide-gray-100">
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Komple Mutfak Renovasyonu
            </a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Lüks Banyo & Seramik Yenileme
            </a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-amber-600 transition font-semibold">
              Anahtar Teslim Daire & Villa
            </a>
          </div>
        </div>
      </div>

      <a href="/mutfak-dolabi-fiyatlari/" class="hover:text-amber-600 transition py-2 border-b-2 border-transparent hover:border-amber-600">
        FİYATLAR
      </a>

      <a href="/iletisim/" class="hover:text-amber-600 transition py-2 border-b-2 border-transparent hover:border-amber-600">
        İLETİŞİM
      </a>

    </nav>

    <!-- SAĞ: 3D KEŞİF BUTONU (PLAN MUTFAK TARZI ŞIK ANTRASİT / GOLD BUTON) & MOBİL HAMBURGER -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="https://wa.me/905353748329?text=Merhaba%20Cem%20Bey,%20ücretsiz%203D%20mimari%20keşif%20ve%20fiyat%20almak%20istiyorum." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-white font-bold text-xs uppercase tracking-wider rounded-md border border-zinc-700 transition shadow-md"
      >
        <span>3D Keşif Al</span>
        <span class="text-amber-400">→</span>
      </a>

      <!-- Mobil Menü Hamburger Butonu -->
      <button 
        type="button" 
        id="btnToggleMobileMenu" 
        class="lg:hidden p-2 rounded-md bg-zinc-100 hover:bg-zinc-200 text-zinc-800 focus:outline-none"
        aria-label="Menüyü Aç/Kapat"
      >
        <svg id="iconMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="iconMenuClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- 3. MOBİL AÇILIR MENÜ (STANDART, TEMİZ VE HIZLI) -->
  <div id="mobileMenuPanel" class="hidden lg:hidden bg-white border-t border-gray-200 px-4 py-5 shadow-lg">
    <nav class="flex flex-col space-y-3 text-sm font-bold text-zinc-800 uppercase tracking-wide">
      <a href="/" class="py-2 px-3 rounded hover:bg-zinc-100 hover:text-amber-600 transition">ANA SAYFA</a>
      <a href="/hakkimizda/" class="py-2 px-3 rounded hover:bg-zinc-100 hover:text-amber-600 transition">HAKKIMIZDA</a>
      
      <div class="py-1 px-3">
        <span class="text-xs text-zinc-400 font-semibold block mb-1">MODELLERİMİZ</span>
        <div class="pl-3 border-l-2 border-zinc-200 space-y-2 text-xs font-medium">
          <a href="/modern-mutfak-modelleri/" class="block py-1 text-zinc-700 hover:text-amber-600">Modern Mutfak Modelleri</a>
          <a href="/klasik-country-mutfak-modelleri/" class="block py-1 text-zinc-700 hover:text-amber-600">Klasik & Country Mutfak</a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="block py-1 text-zinc-700 hover:text-amber-600">Lüks Akrilik & Lake Dolaplar</a>
          <a href="/tasarimlar/?kategori=banyo" class="block py-1 text-zinc-700 hover:text-amber-600">Özel Banyo Tasarımları</a>
          <a href="/tasarimlar/?kategori=kapilar" class="block py-1 text-zinc-700 hover:text-amber-600">İç Mimari Kapılar</a>
        </div>
      </div>

      <a href="/tasarimlar/" class="py-2 px-3 rounded hover:bg-zinc-100 hover:text-amber-600 transition flex items-center justify-between">
        <span>TASARIMLAR ARŞİVİ</span>
        <span class="px-2 py-0.5 bg-zinc-900 text-white text-[10px] rounded font-bold">137 Model</span>
      </a>

      <a href="/#oncesi-sonrasi" class="py-2 px-3 rounded bg-amber-50 text-amber-800 hover:bg-amber-100 transition font-extrabold">
        ★ ÖNCESİ / SONRASI DÖNÜŞÜM
      </a>

      <div class="py-1 px-3">
        <span class="text-xs text-zinc-400 font-semibold block mb-1">TADİLAT & RENOVASYON</span>
        <div class="pl-3 border-l-2 border-zinc-200 space-y-2 text-xs font-medium">
          <a href="/izmir-komple-mutfak-tadilati/" class="block py-1 text-zinc-700 hover:text-amber-600">Komple Mutfak Renovasyonu</a>
          <a href="/izmir-banyo-yenileme-seramik/" class="block py-1 text-zinc-700 hover:text-amber-600">Lüks Banyo & Seramik Yenileme</a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="block py-1 text-zinc-700 hover:text-amber-600">Anahtar Teslim Daire & Villa</a>
        </div>
      </div>

      <a href="/mutfak-dolabi-fiyatlari/" class="py-2 px-3 rounded hover:bg-zinc-100 hover:text-amber-600 transition">FİYATLAR</a>
      <a href="/iletisim/" class="py-2 px-3 rounded hover:bg-zinc-100 hover:text-amber-600 transition">İLETİŞİM</a>
      
      <div class="pt-3 border-t border-zinc-100">
        <a 
          href="https://wa.me/905353748329?text=Merhaba%20Cem%20Bey,%20ücretsiz%203D%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-3 bg-zinc-900 text-white font-bold text-center rounded-md block uppercase text-xs tracking-wider"
        >
          WhatsApp ile 3D Keşif İste →
        </a>
      </div>
    </nav>
  </div>

</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnToggle = document.getElementById("btnToggleMobileMenu");
    const menuPanel = document.getElementById("mobileMenuPanel");
    const iconOpen = document.getElementById("iconMenuOpen");
    const iconClose = document.getElementById("iconMenuClose");

    if (btnToggle && menuPanel) {
      btnToggle.addEventListener("click", () => {
        const isHidden = menuPanel.classList.contains("hidden");
        if (isHidden) {
          menuPanel.classList.remove("hidden");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
        } else {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        }
      });

      menuPanel.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        });
      });
    }
  });
</script>
