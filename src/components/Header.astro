---
import { siteConfig } from "../data/siteConfig";
---

<header class="sticky top-0 z-50 bg-[#0F0F11]/95 backdrop-blur-md border-b border-stone-800 transition-all duration-300 w-full text-white" id="mainHeader">
  <!-- Üst Lüks Şerit -->
  <div class="bg-black/90 text-stone-300 text-[11px] font-medium py-1.5 px-4 sm:px-8 border-b border-white/5">
    <div class="w-full max-w-7xl mx-auto flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 truncate">
        <span class="flex items-center gap-2 text-stone-200 whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880] animate-pulse shrink-0"></span>
          <span class="text-[#C5A880] font-semibold tracking-wider uppercase text-[10px]">ÖZEL İÇ MİMARİ & İMALAT</span> • 28 Yıllık Tasarım Mirası
        </span>
        <span class="hidden lg:inline text-stone-600">|</span>
        <span class="hidden lg:inline text-stone-400 truncate">137 Tescilli Model • Fotogerçekçi 3D Modelleme • Lazerli Rölöve</span>
      </div>
      <div class="flex items-center gap-4 shrink-0 text-xs">
        <a href="{siteConfig.whatsappUrl}" target="_blank" rel="noopener noreferrer" class="text-[#C5A880] hover:text-white font-bold transition flex items-center gap-1.5">
          <span>💬</span> <span class="tracking-wide">{siteConfig.phoneFormatted}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Ana Menü -->
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between gap-4">
    
    <!-- Sol: Marka Logo -->
    <a href="/" class="flex items-center gap-3.5 shrink-0 group py-0.5" aria-label="Cem Yeşilay Ana Sayfaya Git">
      <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-sm bg-gradient-to-br from-[#1C1A17] to-[#2B2620] border border-[#C5A880]/40 flex items-center justify-center text-[#C5A880] font-serif text-xl font-bold tracking-tighter shadow-inner group-hover:border-[#C5A880] transition duration-300">
        CY
      </div>
      <div class="flex flex-col justify-center">
        <span class="font-serif tracking-[0.2em] text-white text-base sm:text-lg md:text-xl uppercase leading-none font-medium group-hover:text-[#C5A880] transition duration-300">CEM YEŞİLAY</span>
        <span class="text-[9px] sm:text-[9.5px] uppercase tracking-[0.3em] text-[#C5A880] font-semibold whitespace-nowrap mt-1">MİMARLIK & İÇ MEKAN TASARIMI</span>
      </div>
    </a>

    <!-- Orta: Masaüstü Navigasyon -->
    <nav class="hidden lg:flex items-center gap-7 xl:gap-9 text-xs font-semibold uppercase tracking-[0.14em] text-stone-200">

      <!-- TASARIM KOLEKSİYONU -->
      <div class="relative group py-1">
        <a href="/tasarimlar/" class="inline-flex items-center gap-2 text-white hover:text-[#C5A880] transition pb-0.5">
          <span>Tasarım Koleksiyonu</span>
          <span class="px-2 py-0.5 bg-[#C5A880] text-black text-[10px] font-black rounded-xs">137 Model</span>
          <svg class="w-3.5 h-3.5 text-stone-400 group-hover:text-[#C5A880] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <!-- Açılır Kategori Menüsü -->
        <div class="absolute top-full left-0 mt-3 w-72 bg-[#141416] border border-stone-800 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 rounded-xs">
          <div class="p-2.5 space-y-1 text-[11.5px]">
            <a href="/tasarimlar/" class="block px-3 py-2.5 font-bold text-white bg-white/5 hover:bg-[#C5A880] hover:text-black transition rounded-xs border-b border-stone-800">
              ✦ Tüm Koleksiyon (137 Model)
            </a>
            <a href="/tasarimlar/?kategori=mutfak" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">
              🍳 Mutfak Tasarımları (40 Model)
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">
              🚪 Masif & Lake Kapılar (39 Model)
            </a>
            <a href="/tasarimlar/?kategori=gomme-dolap" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">
              👔 Gömme Dolap & Giyinme Odası (33 Model)
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">
              🚿 Lüks Banyo Mobilyaları (25 Model)
            </a>
          </div>
        </div>
      </div>

      <div class="relative group py-1">
        <a href="/izmir-mutfak-dolabi-imalati/" class="inline-flex items-center gap-1.5 text-stone-200 hover:text-[#C5A880] transition">
          <span>Hizmetlerimiz</span>
          <svg class="w-3 h-3 text-stone-400 group-hover:text-[#C5A880] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>
        <div class="absolute top-full left-0 mt-3 w-64 bg-[#141416] border border-stone-800 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 rounded-xs">
          <div class="p-2 space-y-1 text-[11.5px]">
            <a href="/izmir-mutfak-dolabi-imalati/" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">Özel Mutfak Dolabı İmalatı</a>
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">Komple Mutfak Renovasyonu</a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">Lüks Banyo & Seramik</a>
            <a href="/izmir-komple-daire-tadilati/" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">Komple Daire Renovasyonu</a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-3 py-2 text-stone-300 hover:text-white hover:bg-white/5 transition rounded-xs">Anahtar Teslim Taahhüt</a>
          </div>
        </div>
      </div>

      <a href="/projeler/" class="hover:text-[#C5A880] transition py-1">
        Projelerimiz
      </a>

      <a href="/iletisim/" class="hover:text-[#C5A880] transition py-1">
        İletişim & Stüdyo
      </a>
    </nav>

    <!-- Sağ: CTA -->
    <div class="flex items-center gap-3 shrink-0 whitespace-nowrap">
      <a href="/tasarimlar/" class="inline-flex lg:hidden items-center justify-center px-2.5 py-1.5 bg-[#C5A880] text-black text-[11px] font-bold uppercase tracking-wider rounded-xs shadow-sm">
        Koleksiyon (137)
      </a>

      <a href="{siteConfig.whatsappUrl}?text=Merhaba%20Cem%20Bey,%20mimari%20keşif%20ve%203D%20projelendirme%20için%20görüşmek%20istiyorum." target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 bg-[#C5A880] text-black hover:bg-white text-xs font-bold uppercase tracking-widest transition duration-300 shadow-md shrink-0 rounded-xs">
        Mimari Keşif Al
      </a>

      <!-- Sandviç Menü Butonu -->
      <button type="button" id="btnToggleMobileMenu" class="p-2 sm:p-2.5 text-stone-300 hover:text-white hover:bg-white/10 transition rounded shrink-0 cursor-pointer flex items-center gap-1.5 border border-stone-800" aria-label="Menüyü Aç">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <span class="text-xs font-bold uppercase tracking-wider text-stone-200">MENÜ</span>
      </button>
    </div>
  </div>

  <!-- Açılır Mega / Mobil Menü Çekmecesi -->
  <div id="mobileMenuDrawer" class="hidden bg-[#141416] border-b border-stone-800 px-6 sm:px-8 py-8 space-y-6 shadow-2xl max-h-[85vh] overflow-y-auto text-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Kolon 1: TASARIM KOLEKSİYONU -->
      <div class="space-y-4 bg-white/5 p-5 border border-stone-800 rounded-xs">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] block">CEM YEŞİLAY KOLEKSİYONU</span>
          <span class="px-2 py-0.5 bg-[#C5A880] text-black text-[10px] font-black rounded-xs">137 Model</span>
        </div>
        <nav class="flex flex-col space-y-1.5 text-xs text-stone-200">
          <a href="/tasarimlar/" class="py-2.5 px-3 bg-white/10 hover:bg-[#C5A880] hover:text-black border border-stone-700 flex items-center justify-between font-bold text-white transition rounded-xs">
            <span>✦ Tüm Tasarım Arşivi</span> <span>137 Model →</span>
          </a>
          <a href="/tasarimlar/?kategori=mutfak" class="py-2 px-3 hover:bg-white/5 flex items-center justify-between text-stone-300 transition">
            <span>🍳 Mutfak Tasarımları</span> <span>40 Model →</span>
          </a>
          <a href="/tasarimlar/?kategori=kapilar" class="py-2 px-3 hover:bg-white/5 flex items-center justify-between text-stone-300 transition">
            <span>🚪 Masif & Lake Kapılar</span> <span>39 Model →</span>
          </a>
          <a href="/tasarimlar/?kategori=gomme-dolap" class="py-2 px-3 hover:bg-white/5 flex items-center justify-between text-stone-300 transition">
            <span>👔 Gömme Dolap & Giyinme Odası</span> <span>33 Model →</span>
          </a>
          <a href="/tasarimlar/?kategori=banyo" class="py-2 px-3 hover:bg-white/5 flex items-center justify-between text-stone-300 transition">
            <span>🚿 Lüks Banyo Mobilyaları</span> <span>25 Model →</span>
          </a>
        </nav>
      </div>

      <!-- Kolon 2: HİZMETLER -->
      <div class="space-y-4">
        <span class="text-[11px] font-bold uppercase tracking-widest text-[#C5A880] block">MİMARİ HİZMETLERİMİZ</span>
        <nav class="flex flex-col space-y-2 text-xs uppercase tracking-wider text-stone-300">
          <a href="/izmir-mutfak-dolabi-imalati/" class="py-2 hover:text-[#C5A880] border-b border-white/5 flex items-center justify-between transition">
            <span>Özel Mutfak Dolabı İmalatı</span> <span>→</span>
          </a>
          <a href="/izmir-komple-mutfak-tadilati/" class="py-2 hover:text-[#C5A880] border-b border-white/5 flex items-center justify-between transition">
            <span>Komple Mutfak Renovasyonu</span> <span>→</span>
          </a>
          <a href="/izmir-banyo-yenileme-seramik/" class="py-2 hover:text-[#C5A880] border-b border-white/5 flex items-center justify-between transition">
            <span>Lüks Banyo Tasarımı & Seramik</span> <span>→</span>
          </a>
          <a href="/izmir-komple-daire-tadilati/" class="py-2 hover:text-[#C5A880] border-b border-white/5 flex items-center justify-between transition">
            <span>Komple Daire Renovasyonu</span> <span>→</span>
          </a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="py-2 hover:text-[#C5A880] border-b border-white/5 flex items-center justify-between transition">
            <span>Anahtar Teslim Taahhüt</span> <span>→</span>
          </a>
          <a href="/iletisim/" class="py-2 hover:text-[#C5A880] border-b border-white/5 flex items-center justify-between transition">
            <span>İletişim & Stüdyo Randevusu</span> <span>→</span>
          </a>
        </nav>
      </div>

      <!-- Kolon 3: MİMARİ STÜDYO BİLGİLERİ -->
      <div class="space-y-4 bg-white/5 p-5 border border-stone-800 flex flex-col justify-between rounded-xs">
        <div class="space-y-3">
          <span class="text-[11px] font-bold uppercase tracking-widest text-[#C5A880] block">CEM YEŞİLAY MİMARLIK STÜDYOSU</span>
          <p class="text-xs text-stone-300 font-light leading-relaxed">
            28 yılı aşkın mimari ve imalat tecrübesiyle; konut, villa ve lüks mekanlara özel anahtar teslim renovasyon ve mobilya üretimi yapıyoruz.
          </p>
          <div class="text-xs text-stone-300 space-y-1.5 pt-2">
            <div>📞 <strong>Telefon:</strong> {siteConfig.phoneFormatted}</div>
            <div>📍 <strong>Lokasyon:</strong> İzmir / Türkiye</div>
            <div>📐 <strong>Hizmet:</strong> Lazer Rölöve & 3D Fotogerçekçi Render</div>
          </div>
        </div>
        <div class="pt-4">
          <a href="{siteConfig.whatsappUrl}?text=Merhaba%20Cem%20Bey,%20projemiz%20hakkında%20bilgi%20ve%203D%20keşif%20randevusu%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="block text-center py-3 px-4 bg-[#C5A880] text-black text-xs font-bold uppercase tracking-wider rounded-xs shadow-md hover:bg-white transition">
            💬 WhatsApp ile Doğrudan Ulaşın
          </a>
        </div>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("btnToggleMobileMenu");
    const drawer = document.getElementById("mobileMenuDrawer");
    btn?.addEventListener("click", () => {
      drawer?.classList.toggle("hidden");
    });
  });
</script>
