---
import { siteConfig } from "../data/siteConfig";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-stone-200 transition-all duration-300 w-full overflow-hidden" id="mainHeader">
  <!-- Üst İnce Bilgi & İletişim Şeridi -->
  <div class="bg-stone-900 text-stone-300 text-[11px] font-medium py-1.5 px-3 sm:px-6 border-b border-stone-800">
    <div class="w-full max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 sm:gap-3 truncate">
        <span class="flex items-center gap-1.5 text-stone-200 whitespace-nowrap">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
          İzmir Buca İmalat Atölyesi Atölyesi • 1984'ten Bugüne 42 Yıllık Güven
        </span>
        <span class="hidden lg:inline text-stone-600">|</span>
        <span class="hidden lg:inline text-stone-400 truncate">Kadrolu Mimar &amp; İç Mimar • 3D Sanal Mekan Deneyimi • Tüm İzmir'e Hizmet</span>
      </div>
      <div class="flex items-center gap-3 shrink-0 text-xs">
        <a href="/iletisim/" class="hover:text-white transition hidden sm:inline-flex items-center gap-1">
          
        </a>
        <span class="hidden sm:inline text-stone-600">|</span>
        <a href="https://wa.me/905393333303" target="_blank" rel="noopener noreferrer" class="text-emerald-400 font-bold hover:underline flex items-center gap-1">
          <span>💬</span> <span>0539 333 33 03</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Ana Menü Çubuğu: Logo + Butonlar + Sandviç Menü (Tam Ana Sayfa Birebir Görünümü) -->
  <div class="w-full max-w-7xl mx-auto px-3 sm:px-5 lg:px-6 py-2.5 sm:py-3 flex items-center justify-between gap-2 sm:gap-4">
    
    <!-- Sol: Logo & Marka -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3.5 shrink-0 group min-w-0 py-0.5" aria-label="Ana Sayfaya Git">
      <img src="/logo.png" alt="İzmir Mutfak Banyo Tadilat Logo" class="h-11 sm:h-12 md:h-14 w-auto object-contain transition duration-200 group-hover:opacity-90 shrink-0" width="56" height="58" loading="eager" />
      <div class="flex flex-col min-w-0 justify-center">
        <span class="font-black tracking-wider text-stone-950 text-sm sm:text-base md:text-lg uppercase leading-none whitespace-nowrap" style="letter-spacing: 0.08em;">İZMİR MUTFAK &amp; BANYO</span>
        <span class="text-[9.5px] sm:text-[10.5px] md:text-xs uppercase tracking-[0.22em] text-stone-500 font-bold whitespace-nowrap mt-1">Özel İmalat &amp; Tadilat</span>
      </div>
    </a>

    <!-- Sağ: Aksiyon Butonları & Sandviç Menü Butonu (Birebir Ana Sayfa Standardı) -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0 whitespace-nowrap">
      <a href="/#projelendirme-basvuru" class="inline-flex items-center justify-center px-3 sm:px-4 py-2 border border-stone-900 text-stone-900 text-[10.5px] sm:text-xs font-bold uppercase tracking-wider hover:bg-stone-900 hover:text-white transition duration-200 shrink-0">
        Mutfağını Tasarla
      </a>
      <a href="https://wa.me/905393333303?text=Merhaba,%20mutfak%20ve%20banyo%20için%20ücretsiz%203D%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-3 sm:px-4 py-2 bg-stone-900 text-white text-[10.5px] sm:text-xs font-bold uppercase tracking-wider hover:bg-stone-800 transition duration-200 shadow-sm shrink-0">
        Ücretsiz Keşif
      </a>
      <!-- Sandviç Menü İkonu (Her ekranda görünür) -->
      <button type="button" id="btnToggleMobileMenu" class="p-1.5 sm:p-2 text-stone-900 hover:bg-stone-100 transition rounded shrink-0 cursor-pointer" aria-label="Kategoriler ve Menüyü Aç">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Sandviç Menü Çekmecesi (Tüm Ekranlar İçin Zengin Mimari Menü) -->
  <div id="mobileMenuDrawer" class="hidden bg-white border-b border-stone-200 px-6 sm:px-8 py-6 space-y-6 shadow-2xl max-h-[85vh] overflow-y-auto">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Kolon 1: Hizmet Hubları -->
      <div class="space-y-3">
        <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-700 block">MİMARİ HİZMETLERİMİZ</span>
        <nav class="flex flex-col space-y-2 text-xs font-bold uppercase tracking-wider text-stone-800">
          <a href="/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Ana Sayfa</span> <span>→</span>
          </a>
          <a href="/izmir-mutfak-dolabi-imalati/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Özel Ölçü Mutfak Dolabı İmalatı</span> <span>→</span>
          </a>
          <a href="/izmir-komple-mutfak-tadilati/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Komple Mutfak Tadilatı</span> <span>→</span>
          </a>
          <a href="/izmir-banyo-yenileme-seramik/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Banyo Yenileme &amp; Seramik Döşeme</span> <span>→</span>
          </a>
          <a href="/izmir-komple-daire-tadilati/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Komple Ev &amp; Daire Tadilatı</span> <span>→</span>
          </a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Anahtar Teslim Sözleşmeli Tadilat</span> <span>→</span>
          </a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Hazır &amp; Modüler Mutfak Modelleri</span> <span>→</span>
          </a>
          <a href="/2026-mutfak-dolabi-fiyatlari/" class="py-2 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>2026 Mutfak Mimari Projelendirme</span> <span>→</span>
          </a>
        </nav>
      </div>

      <!-- Kolon 2: Özel Tasarım Koleksiyonları & Kurumsal -->
      <div class="space-y-3">
        <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-700 block">ÖZEL TASARIM KOLEKSİYONLARI</span>
        <nav class="flex flex-col space-y-1.5 text-xs font-bold uppercase tracking-wider text-stone-800">
          <a href="/yapilan-isler/" class="py-1.5 text-emerald-900 bg-emerald-50/80 px-2 rounded-xs hover:text-emerald-700 border-b border-stone-200 flex items-center justify-between font-black">
            <span>🏆 Yapılan İşler (50+ Proje)</span> <span>→</span>
          </a>
          <a href="/modern-mutfak-modelleri/" class="py-1.5 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between text-emerald-800">
            <span>01. Modern Mutfak Modelleri</span> <span>→</span>
          </a>
          <a href="/klasik-country-mutfak-modelleri/" class="py-1.5 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between text-amber-800">
            <span>02. Klasik &amp; Country Mutfaklar</span> <span>→</span>
          </a>
          <a href="/yasam-alanlari-mutfak-modelleri/" class="py-1.5 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between text-blue-800">
            <span>03. Yaşam Alanları &amp; Ada Mutfak</span> <span>→</span>
          </a>
          <a href="/iletisim/" class="py-1.5 hover:text-emerald-700 border-b border-stone-100 flex items-center justify-between">
            <span>Buca İletişim &amp; Keşif</span> <span>→</span>
          </a>
        </nav>
      </div>

      <!-- Kolon 3: Hızlı İletişim & Keşif -->
      <div class="space-y-3 bg-stone-50 p-5 border border-stone-200 flex flex-col justify-between">
        <div class="space-y-2">
          <span class="text-[10px] font-bold uppercase tracking-widest text-stone-900 block">BUCA İMALAT ATÖLYESİ</span>
          <p class="text-xs text-stone-600 font-light leading-relaxed">
            1984'ten bu yana İzmir geneline kadrolu mimarlarımızla yerinde ücretsiz keşif yapıyoruz.
          </p>
          <div class="text-xs text-stone-800 space-y-1 pt-2 font-medium">
            <div>📞 <strong>Telefon:</strong> 0539 333 33 03</div>
            <div>📍 <strong>Atölye:</strong> Buca / İZMİR</div>
          </div>
        </div>
        <div class="pt-3">
          <a href="https://wa.me/905393333303" target="_blank" rel="noopener noreferrer" class="block text-center py-3 px-4 bg-[#25D366] text-white text-xs font-bold uppercase tracking-wider rounded-sm shadow-sm hover:bg-emerald-600 transition">
            💬 WhatsApp: 0539 333 33 03
          </a>
        </div>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("btnToggleMobileMenu");
    const drawer = document.getElementById("mobileMenuDrawer");
    btn?.addEventListener("click", () => {
      drawer?.classList.toggle("hidden");
    });
  });
</script>
