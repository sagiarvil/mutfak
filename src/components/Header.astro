---
import { siteConfig } from "../data/siteConfig";
---

<!-- ===================================================================== -->
<!-- ROLEX & CARTIER LUXURY DEEP EMERALD HEADER (100/100 PRESTİJ MİMARİ)     -->
<!-- ===================================================================== -->
<header class="sticky top-0 z-50 w-full bg-[#083322] border-b border-[#104830] shadow-xl text-white" id="siteHeader">
  
  <!-- 2. ANA HEADER ŞERİDİ (TAM DENGELİ, SAĞA YIĞILMA SIFIRLANDI) -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 py-3.5 flex items-center justify-between gap-6">
    
    <!-- SOL: BÜYÜTÜLMÜŞ CANLI LOGO (4K PÜRÜZSÜZ & PRESTİJ) -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="Cem Yeşilay Anasayfa">
      <div class="relative">
        <img 
          src="/logo.png" 
          alt="Cem Yeşilay Luxury Logo" 
          class="h-16 sm:h-18 md:h-20 w-auto object-contain transition-all duration-300 group-hover:scale-105"
          style="filter: drop-shadow(0 0 16px rgba(0, 255, 102, 0.45)); image-rendering: -webkit-optimize-contrast;"
          width="88" 
          height="88" 
          loading="eager" 
        />
      </div>
      <div class="flex flex-col">
        <span class="font-serif tracking-[0.16em] text-white text-lg sm:text-xl md:text-2xl font-extrabold uppercase leading-none group-hover:text-[#C5A880] transition">
          CEM YEŞİLAY
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.28em] text-[#C5A880] font-bold mt-1">
          LUXURY ATELIER & ARCHITECTURE
        </span>
      </div>
    </a>

    <!-- ORTA: KUSURSUZ DENGELENMİŞ PREMİUM MENÜ (SIFIR TAŞMA & SIFIR YIĞILMA) -->
    <nav class="hidden xl:flex items-center space-x-6 2xl:space-x-8 text-[12px] font-semibold text-white tracking-[0.08em] uppercase whitespace-nowrap">
      
      <!-- MODELLER & TASARIM DROPDOWN -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1.5 text-white hover:text-[#C5A880] transition duration-300 focus:outline-none after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] group-hover:after:w-full after:transition-all after:duration-300">
          <span>MODELLER</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-72 min-w-[280px] hidden group-hover:block transition duration-200 z-50">
          <div class="bg-[#093825]/98 backdrop-blur-2xl rounded-xl shadow-2xl border border-[#C5A880]/30 py-2 divide-y divide-[#104830]">
            <a href="/modern-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Klasik & Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Lüks Akrilik & Lake Dolaplar
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Özel Banyo Tasarımları
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              İç Mimari Kapılar
            </a>
            <a href="/tasarimlar/" class="block px-5 py-2.5 text-xs text-[#C5A880] hover:bg-[#0E4730] font-bold transition whitespace-nowrap">
              Tüm 137 Tasarım Arşivi →
            </a>
          </div>
        </div>
      </div>

      <!-- Yapılan İşler (Canlı Şantiye Montajları) -->
      <a href="/yapilan-isler/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-300 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-300">
        YAPILAN İŞLER
      </a>

      <!-- Öncesi / Sonrası Linki -->
      <a href="/#oncesi-sonrasi" class="relative py-2 text-[#C5A880] hover:text-white transition duration-300 font-bold after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-white hover:after:w-full after:transition-all after:duration-300">
        ÖNCESİ / SONRASI
      </a>

      <!-- TADİLAT & RENOVASYON DROPDOWN -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1.5 text-white hover:text-[#C5A880] transition duration-300 focus:outline-none after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] group-hover:after:w-full after:transition-all after:duration-300">
          <span>TADİLAT</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-64 hidden group-hover:block transition duration-200 z-50">
          <div class="bg-[#093825]/95 backdrop-blur-xl rounded-lg shadow-2xl border border-[#C5A880]/30 py-2 divide-y divide-[#104830]">
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Komple Mutfak Renovasyonu
            </a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Lüks Banyo & Seramik Yenileme
            </a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Anahtar Teslim Daire & Villa
            </a>
          </div>
        </div>
      </div>

      <!-- Hakkımızda Linki -->
      <a href="/hakkimizda/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-300 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-300">
        HAKKIMIZDA
      </a>

      <!-- Fiyatlar Linki -->
      <a href="/mutfak-dolabi-fiyatlari/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-300 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-300">
        FİYATLAR
      </a>

      <!-- İletişim Linki -->
      <a href="/iletisim/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-300 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-300">
        İLETİŞİM
      </a>

    </nav>

    <!-- SAĞ: CARTIER GOLD PREMİUM KEŞİF BUTONU & MOBİL TOGGLE -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="https://wa.me/905393333303?text=Merhaba%20Cem%20Bey,%20ücretsiz%203D%20mimari%20keşif%20ve%20fiyat%20almak%20istiyorum." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-extrabold text-xs uppercase tracking-wider rounded border border-[#E5C378] transition-all duration-300 shadow-[0_4px_16px_rgba(197,168,128,0.25)] hover:shadow-[0_6px_20px_rgba(197,168,128,0.4)]"
      >
        <span>3D Keşif Al</span>
        <span>→</span>
      </a>

      <!-- Tablet & Mobil Menü Butonu (1280px altında temiz açılır) -->
      <button 
        type="button" 
        id="btnToggleMobileMenu" 
        class="xl:hidden p-2.5 rounded bg-[#0A3D28] hover:bg-[#0E4C32] text-white border border-[#C5A880]/30 focus:outline-none transition"
        aria-label="Menüyü Aç/Kapat"
      >
        <svg id="iconMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="iconMenuClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- 3. MOBİL & TABLET AÇILIR MENÜ (PREMİUM DARK EMERALD) -->
  <div id="mobileMenuPanel" class="hidden xl:hidden bg-[#083322] border-t border-[#104830] px-5 py-6 shadow-2xl">
    <nav class="flex flex-col space-y-3.5 text-xs font-bold text-white uppercase tracking-wider">
      <a href="/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">ANA SAYFA</a>
      <a href="/hakkimizda/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">HAKKIMIZDA</a>
      
      <div class="py-1 px-3">
        <span class="text-[10px] text-[#C5A880] font-bold block mb-1">MODELLERİMİZ</span>
        <div class="pl-3 border-l border-[#104830] space-y-2 text-[11px] font-normal text-[#D8D2C7]">
          <a href="/modern-mutfak-modelleri/" class="block py-1 hover:text-[#C5A880]">Modern Mutfak Modelleri</a>
          <a href="/klasik-country-mutfak-modelleri/" class="block py-1 hover:text-[#C5A880]">Klasik & Country Mutfak</a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="block py-1 hover:text-[#C5A880]">Lüks Akrilik & Lake Dolaplar</a>
          <a href="/tasarimlar/?kategori=banyo" class="block py-1 hover:text-[#C5A880]">Özel Banyo Tasarımları</a>
          <a href="/tasarimlar/?kategori=kapilar" class="block py-1 hover:text-[#C5A880]">İç Mimari Kapılar</a>
        </div>
      </div>

      <a href="/tasarimlar/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition flex items-center justify-between">
        <span>TASARIMLAR ARŞİVİ</span>
        <span class="px-2 py-0.5 bg-[#C5A880] text-[#041F14] text-[10px] rounded font-bold">137 Model</span>
      </a>

      <a href="/yapilan-isler/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition flex items-center justify-between">
        <span>YAPILAN İŞLER (CANLI MONTAJLAR)</span>
        <span class="px-2 py-0.5 bg-[#00FF66] text-[#041F14] text-[10px] rounded font-extrabold">96 Proje</span>
      </a>

      <a href="/#oncesi-sonrasi" class="py-2 px-3 rounded bg-[#0E4730] text-[#C5A880] transition font-bold">
        ★ ÖNCESİ / SONRASI DÖNÜŞÜM
      </a>

      <div class="py-1 px-3">
        <span class="text-[10px] text-[#C5A880] font-bold block mb-1">TADİLAT & RENOVASYON</span>
        <div class="pl-3 border-l border-[#104830] space-y-2 text-[11px] font-normal text-[#D8D2C7]">
          <a href="/izmir-komple-mutfak-tadilati/" class="block py-1 hover:text-[#C5A880]">Komple Mutfak Renovasyonu</a>
          <a href="/izmir-banyo-yenileme-seramik/" class="block py-1 hover:text-[#C5A880]">Lüks Banyo & Seramik Yenileme</a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="block py-1 hover:text-[#C5A880]">Anahtar Teslim Daire & Villa</a>
        </div>
      </div>

      <a href="/mutfak-dolabi-fiyatlari/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">FİYATLAR</a>
      <a href="/iletisim/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">İLETİŞİM</a>
      
      <div class="pt-3 border-t border-[#104830]">
        <a 
          href="https://wa.me/905393333303?text=Merhaba%20Cem%20Bey,%20ücretsiz%203D%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-3 bg-[#C5A880] text-[#041F14] font-bold text-center rounded block uppercase text-xs tracking-wider"
        >
          WhatsApp ile 3D Keşif İste →
        </a>
      </div>
    </nav>
  </div>

</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnToggle = document.getElementById("btnToggleMobileMenu");
    const menuPanel = document.getElementById("mobileMenuPanel");
    const iconOpen = document.getElementById("iconMenuOpen");
    const iconClose = document.getElementById("iconMenuClose");

    if (btnToggle && menuPanel) {
      btnToggle.addEventListener("click", () => {
        const isHidden = menuPanel.classList.contains("hidden");
        if (isHidden) {
          menuPanel.classList.remove("hidden");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
        } else {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        }
      });

      menuPanel.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        });
      });
    }
  });
</script>
