---
import { siteConfig } from "../data/siteConfig";
---

<header class="sticky top-0 z-50 bg-[#FBF9F5]/95 backdrop-blur-md border-b border-[#E8E1D5] transition-all duration-300 w-full" id="mainHeader">
  
  <!-- Üst İnce Şık Şerit (Tek Satır, Taşmasız) -->
  <div class="bg-[#F5F0E8] text-[#756A66] text-[11px] font-medium py-1 px-4 sm:px-8 border-b border-[#E8E1D5]/60 overflow-hidden">
    <div class="w-full max-w-7xl mx-auto flex items-center justify-between gap-3 text-nowrap">
      <div class="flex items-center gap-2.5 truncate">
        <span class="inline-flex items-center gap-1.5 text-[#262220] font-semibold text-[10.5px]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B87353] animate-pulse shrink-0"></span>
          CEM YEŞİLAY ATÖLYESİ
        </span>
        <span class="hidden sm:inline text-[#B5A89E]">•</span>
        <span class="hidden sm:inline text-[#756A66] text-[10.5px]">28 Yıllık Tasarım Mirası & 137 Tescilli Model</span>
      </div>
      <div class="flex items-center gap-3 shrink-0 text-xs">
        <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-[#B87353] hover:text-[#262220] font-bold transition flex items-center gap-1.5">
          <span class="text-sm">💬</span> <span class="font-semibold">{siteConfig.phoneFormatted}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Ana Menü Çubuğu (Kusursuz Tek Satır, Kırılmasız Flex) -->
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-8 py-3 flex items-center justify-between gap-4">
    
    <!-- Sol: Marka Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0 group py-0.5 text-nowrap" aria-label="Cem Yeşilay Mimarlık">
      <div class="w-10 h-10 rounded-sm bg-gradient-to-br from-[#FAF6F0] to-[#EFE6D8] border border-[#D4A373]/50 flex items-center justify-center text-[#B87353] font-serif text-lg font-bold shadow-xs group-hover:border-[#B87353] transition duration-300">
        CY
      </div>
      <div class="flex flex-col justify-center">
        <span class="font-serif tracking-[0.16em] text-[#262220] text-base sm:text-lg font-semibold uppercase leading-none group-hover:text-[#B87353] transition duration-300">
          CEM YEŞİLAY
        </span>
        <span class="text-[9px] uppercase tracking-[0.25em] text-[#B87353] font-medium whitespace-nowrap mt-1">
          MİMARLIK & İÇ MEKÂN TASARIMI
        </span>
      </div>
    </a>

    <!-- Orta: Masaüstü Navigasyon (Tek Satır, Taşmasız) -->
    <nav class="hidden xl:flex items-center gap-7 text-[12px] font-semibold uppercase tracking-[0.12em] text-[#473E3B] text-nowrap">
      
      <!-- Tasarım Koleksiyonu Dropdown -->
      <div class="relative group py-1">
        <a href="/tasarimlar/" class="inline-flex items-center gap-1.5 text-[#262220] hover:text-[#B87353] transition">
          <span>Koleksiyon</span>
          <span class="px-2 py-0.5 bg-[#B87353] text-white text-[9.5px] font-bold rounded-full">137 Model</span>
          <svg class="w-3.5 h-3.5 text-[#756A66] group-hover:text-[#B87353] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <div class="absolute top-full left-0 mt-2 w-72 bg-white border border-[#E8E1D5] shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 rounded-sm">
          <div class="p-2 space-y-1 text-xs">
            <a href="/tasarimlar/" class="block px-3 py-2.5 font-bold text-[#B87353] bg-[#FAF8F5] rounded-xs">
              ✦ Tüm Koleksiyon (137 Model)
            </a>
            <a href="/tasarimlar/?kategori=mutfak" class="block px-3 py-2 text-[#473E3B] hover:text-[#B87353] hover:bg-[#FAF8F5] transition rounded-xs">
              🍳 Mutfak Tasarımları (40 Model)
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-3 py-2 text-[#473E3B] hover:text-[#B87353] hover:bg-[#FAF8F5] transition rounded-xs">
              🚪 Özel Lake & Ahşap Kapılar (39 Model)
            </a>
            <a href="/tasarimlar/?kategori=gomme-dolap" class="block px-3 py-2 text-[#473E3B] hover:text-[#B87353] hover:bg-[#FAF8F5] transition rounded-xs">
              👔 Giyinme Odası & Gömme Dolap (33 Model)
            </a>
            <a href="/tasarimlar/?kategori=banyo" class="block px-3 py-2 text-[#473E3B] hover:text-[#B87353] hover:bg-[#FAF8F5] transition rounded-xs">
              🚿 Lüks Banyo Mobilyaları (25 Model)
            </a>
          </div>
        </div>
      </div>

      <a href="/izmir-mutfak-dolabi-imalati/" class="hover:text-[#B87353] transition py-1">Mutfak Dolabı</a>
      <a href="/izmir-komple-mutfak-tadilati/" class="hover:text-[#B87353] transition py-1">Mutfak Renovasyonu</a>
      <a href="/izmir-banyo-yenileme-seramik/" class="hover:text-[#B87353] transition py-1">Banyo & Seramik</a>
      <a href="/izmir-anahtar-teslim-tadilat/" class="hover:text-[#B87353] transition py-1">Anahtar Teslim</a>
      <a href="/iletisim/" class="hover:text-[#B87353] transition py-1">İletişim</a>
    </nav>

    <!-- Sağ: CTA & Yeni Nesil Sandviç Menü Tetikleyici -->
    <div class="flex items-center gap-3 shrink-0 text-nowrap">
      
      <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center justify-center px-5 py-2.5 bg-gradient-to-r from-[#B87353] to-[#C98A68] hover:from-[#A36244] hover:to-[#B87353] text-white text-xs font-bold uppercase tracking-wider rounded-sm shadow-sm transition duration-300">
        3D Keşif Randevusu
      </a>

      <!-- Yeni Nesil Sandviç Menü Butonu (Modern Minimalist Buton) -->
      <button 
        type="button" 
        id="btnOpenNav" 
        class="inline-flex items-center gap-2 px-3 py-2 bg-white hover:bg-[#F5F0E8] border border-[#E8E1D5] rounded-sm text-[#262220] transition cursor-pointer shadow-2xs group"
        aria-label="Menüyü Aç"
      >
        <span class="flex flex-col gap-1 w-4">
          <span class="w-full h-0.5 bg-[#B87353] rounded-full transition group-hover:w-3"></span>
          <span class="w-full h-0.5 bg-[#262220] rounded-full transition"></span>
          <span class="w-full h-0.5 bg-[#B87353] rounded-full transition group-hover:w-2"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-[#262220]">MENÜ</span>
      </button>

    </div>
  </div>

  <!-- YENİ NESİL SLIDE-OVER SANDVİÇ MENÜ ÇEKMECESİ -->
  <div id="navDrawerOverlay" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-300"></div>

  <div id="navDrawer" class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-[#FBF9F5] z-50 shadow-2xl border-l border-[#E8E1D5] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between overflow-y-auto">
    
    <!-- Çekmece Üstü -->
    <div class="p-6 border-b border-[#E8E1D5] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-sm bg-[#FAF6F0] border border-[#D4A373]/50 flex items-center justify-center text-[#B87353] font-serif font-bold text-sm">
          CY
        </div>
        <div>
          <span class="font-serif font-semibold text-sm tracking-wider text-[#262220] block leading-none">CEM YEŞİLAY</span>
          <span class="text-[9px] uppercase tracking-widest text-[#B87353] font-medium block mt-0.5">MİMARLIK & TASARIM</span>
        </div>
      </div>
      <button type="button" id="btnCloseNav" class="w-9 h-9 rounded-sm bg-white hover:bg-[#F5F0E8] border border-[#E8E1D5] flex items-center justify-center text-[#262220] text-lg font-bold transition cursor-pointer" aria-label="Menüyü Kapat">
        ✕
      </button>
    </div>

    <!-- Çekmece Menü Listesi -->
    <div class="p-6 space-y-6 flex-1">
      
      <!-- Tasarım Modelleri (Öne Çıkan Kart) -->
      <div class="p-4 bg-white border border-[#E8E1D5] rounded-sm space-y-3 soft-shadow">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-widest text-[#B87353]">ÖZEL TASARIM ARŞİVİ</span>
          <span class="px-2 py-0.5 bg-[#B87353] text-white text-[10px] font-bold rounded-full">137 Model</span>
        </div>
        <p class="text-[11.5px] text-[#756A66] font-light">
          İzmir geneli uyguladığımız en yeni modern ve country modellerimizi keşfedin.
        </p>
        <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
          <a href="/tasarimlar/?kategori=mutfak" class="p-2.5 bg-[#FBF9F5] hover:bg-[#F5F0E8] text-[#262220] rounded-xs border border-[#E8E1D5] flex items-center gap-1.5 transition">
            <span>🍳</span> <span>Mutfak (40)</span>
          </a>
          <a href="/tasarimlar/?kategori=banyo" class="p-2.5 bg-[#FBF9F5] hover:bg-[#F5F0E8] text-[#262220] rounded-xs border border-[#E8E1D5] flex items-center gap-1.5 transition">
            <span>🚿</span> <span>Banyo (25)</span>
          </a>
          <a href="/tasarimlar/?kategori=kapilar" class="p-2.5 bg-[#FBF9F5] hover:bg-[#F5F0E8] text-[#262220] rounded-xs border border-[#E8E1D5] flex items-center gap-1.5 transition">
            <span>🚪</span> <span>Kapılar (39)</span>
          </a>
          <a href="/tasarimlar/?kategori=gomme-dolap" class="p-2.5 bg-[#FBF9F5] hover:bg-[#F5F0E8] text-[#262220] rounded-xs border border-[#E8E1D5] flex items-center gap-1.5 transition">
            <span>👔</span> <span>Giyinme (33)</span>
          </a>
        </div>
        <a href="/tasarimlar/" class="block text-center py-2.5 bg-[#FAF8F5] hover:bg-[#F5F0E8] text-xs font-bold text-[#B87353] border border-[#E8E1D5] rounded-xs transition">
          ✦ Tüm Koleksiyonu İncele (137 Model) →
        </a>
      </div>

      <!-- Mimari Hizmetler Linkleri -->
      <nav class="space-y-1.5 text-xs font-semibold uppercase tracking-wider text-[#473E3B]">
        <a href="/izmir-mutfak-dolabi-imalati/" class="p-3 bg-white hover:bg-[#FAF8F5] border border-[#E8E1D5] rounded-xs flex items-center justify-between transition">
          <span>Özel Mutfak Dolabı İmalatı</span> <span class="text-[#B87353]">→</span>
        </a>
        <a href="/izmir-komple-mutfak-tadilati/" class="p-3 bg-white hover:bg-[#FAF8F5] border border-[#E8E1D5] rounded-xs flex items-center justify-between transition">
          <span>Komple Mutfak Renovasyonu</span> <span class="text-[#B87353]">→</span>
        </a>
        <a href="/izmir-banyo-yenileme-seramik/" class="p-3 bg-white hover:bg-[#FAF8F5] border border-[#E8E1D5] rounded-xs flex items-center justify-between transition">
          <span>Lüks Banyo Tasarımı & Seramik</span> <span class="text-[#B87353]">→</span>
        </a>
        <a href="/izmir-anahtar-teslim-tadilat/" class="p-3 bg-white hover:bg-[#FAF8F5] border border-[#E8E1D5] rounded-xs flex items-center justify-between transition">
          <span>Anahtar Teslim Taahhüt</span> <span class="text-[#B87353]">→</span>
        </a>
        <a href="/iletisim/" class="p-3 bg-white hover:bg-[#FAF8F5] border border-[#E8E1D5] rounded-xs flex items-center justify-between transition">
          <span>İletişim & Stüdyo Randevusu</span> <span class="text-[#B87353]">→</span>
        </a>
      </nav>

    </div>

    <!-- Çekmece Altı (Hızlı WhatsApp İletişim) -->
    <div class="p-6 bg-white border-t border-[#E8E1D5] space-y-3">
      <div class="text-xs text-[#756A66] space-y-1">
        <div>📞 <strong>Doğrudan Hat:</strong> {siteConfig.phoneFormatted}</div>
        <div>📍 <strong>Hizmet:</strong> İzmir İçi Ücretsiz Lazerli Rölöve</div>
      </div>
      <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="block w-full text-center py-3.5 px-4 bg-gradient-to-r from-[#B87353] to-[#C98A68] text-white text-xs font-bold uppercase tracking-widest rounded-sm shadow-md hover:opacity-95 transition">
        💬 WhatsApp ile 3D Keşif İste
      </a>
    </div>

  </div>

</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnOpen = document.getElementById("btnOpenNav");
    const btnClose = document.getElementById("btnCloseNav");
    const drawer = document.getElementById("navDrawer");
    const overlay = document.getElementById("navDrawerOverlay");

    function openDrawer() {
      overlay?.classList.remove("hidden");
      setTimeout(() => overlay?.classList.remove("opacity-0"), 10);
      drawer?.classList.remove("translate-x-full");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      overlay?.classList.add("opacity-0");
      drawer?.classList.add("translate-x-full");
      setTimeout(() => {
        overlay?.classList.add("hidden");
        document.body.style.overflow = "";
      }, 300);
    }

    btnOpen?.addEventListener("click", openDrawer);
    btnClose?.addEventListener("click", closeDrawer);
    overlay?.addEventListener("click", closeDrawer);
  });
</script>
