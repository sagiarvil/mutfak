---
import { siteConfig } from "../data/siteConfig";
---

<!-- ===================================================================== -->
<!-- İZMİR MUTFAK BANYO — PREMİUM & MODERN HEADER (PLAN MUTFAK REFERANSLI)  -->
<!-- ===================================================================== -->
<header class="sticky top-0 z-50 w-full bg-[#083322] border-b border-[#104830] shadow-xl text-white" id="siteHeader">
  
  <!-- ÜST BİLGİ ŞERİDİ (Bize Ulaşın / Hızlı İletişim) -->
  <div class="bg-[#052317] border-b border-[#0d3b27] text-[11px] text-[#C5BBAF] py-1.5 hidden md:block">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5 text-[#EAE6DF]">
          <span class="text-[#C5A880]">📍</span> İzmir Geneli Atölye İmalatı & Ücretsiz Yerinde Keşif
        </span>
        <span class="text-zinc-500">•</span>
        <span class="flex items-center gap-1.5">
          <span class="text-[#C5A880]">⏰</span> Pzt - Cmt: 09:00 - 19:30
        </span>
      </div>
      <div class="flex items-center gap-5 font-semibold">
        <a href="tel:02324411060" class="hover:text-[#C5A880] transition flex items-center gap-1">
          <span class="text-[#C5A880]">📞</span> 0232 441 1060
        </a>
        <span class="text-zinc-600">|</span>
        <a href="https://wa.me/905324261788?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20ve%20fiyat%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="text-[#00FF66] hover:underline flex items-center gap-1">
          <span>💬</span> WhatsApp Keşif Hattı
        </a>
      </div>
    </div>
  </div>

  <!-- ANA HEADER ŞERİDİ -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-8 xl:px-12 py-3.5 flex items-center justify-between gap-4">
    
    <!-- SOL: LOGO & MARKA İSMİ -->
    <a href="/" class="flex items-center gap-3.5 group shrink-0" aria-label="İzmir Mutfak Banyo Anasayfa">
      <div class="relative">
        <img 
          src="/logo.png" 
          alt="İzmir Mutfak Banyo Logo" 
          class="h-14 sm:h-16 md:h-18 w-auto object-contain transition-all duration-300 group-hover:scale-105"
          style="filter: drop-shadow(0 0 14px rgba(0, 255, 102, 0.4)); image-rendering: -webkit-optimize-contrast;"
          width="80" 
          height="80" 
          loading="eager" 
        />
      </div>
      <div class="flex flex-col">
        <span class="font-serif tracking-[0.14em] text-white text-lg sm:text-xl md:text-2xl font-extrabold uppercase leading-none group-hover:text-[#C5A880] transition">
          İZMİR MUTFAK BANYO
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.26em] text-[#C5A880] font-bold mt-1">
          ÖZEL İMALAT & MİMARİ TADİLAT
        </span>
      </div>
    </a>

    <!-- ORTA: PLAN MUTFAK REFERANSLI PROFESYONEL MENÜ -->
    <nav class="hidden xl:flex items-center space-x-5 2xl:space-x-7 text-[12.5px] font-semibold text-white tracking-[0.06em] uppercase whitespace-nowrap">
      
      <!-- 1. ANA SAYFA -->
      <a href="/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-200">
        ANA SAYFA
      </a>

      <!-- 2. HAKKIMIZDA -->
      <a href="/hakkimizda/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-200">
        HAKKIMIZDA
      </a>

      <!-- 3. MODELLER (Açılır Menü - Mutfak, Banyo, Kapı) -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1.5 text-white hover:text-[#C5A880] transition duration-200 focus:outline-none after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] group-hover:after:w-full after:transition-all after:duration-200">
          <span>MODELLER</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-72 min-w-[280px] hidden group-hover:block transition duration-200 z-50">
          <div class="bg-[#093825]/98 backdrop-blur-2xl rounded-xl shadow-2xl border border-[#C5A880]/30 py-2 divide-y divide-[#104830]">
            <div class="px-4 py-2 text-[10px] font-bold text-[#C5A880] tracking-wider uppercase bg-[#052719]">
              Mutfak Modelleri
            </div>
            <a href="/modern-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Modern Mutfak Modelleri
            </a>
            <a href="/klasik-country-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Klasik & Country Mutfak
            </a>
            <a href="/hazir-mutfak-modelleri-izmir/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Akrilik & Lake Hazır Dolaplar
            </a>
            <a href="/yasam-alanlari-mutfak-modelleri/" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Ada & Açık Yaşam Alanı Mutfaklar
            </a>
            
            <div class="px-4 py-2 text-[10px] font-bold text-[#C5A880] tracking-wider uppercase bg-[#052719]">
              Banyo & Kapı Modelleri
            </div>
            <a href="/tasarimlar/?kategori=banyo" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              Lüks Banyo Tasarımları & Dolaplar
            </a>
            <a href="/tasarimlar/?kategori=kapilar" class="block px-5 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium whitespace-nowrap">
              İç Mekân & Oda Kapıları
            </a>
            <a href="/tasarimlar/" class="block px-5 py-2.5 text-xs text-[#C5A880] hover:bg-[#0E4730] font-bold transition whitespace-nowrap">
              Tüm 137 Model Kataloğu →
            </a>
          </div>
        </div>
      </div>

      <!-- 4. TADİLAT & RENOVASYON (Açılır Menü) -->
      <div class="relative group py-2">
        <button type="button" class="flex items-center gap-1.5 text-white hover:text-[#C5A880] transition duration-200 focus:outline-none after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] group-hover:after:w-full after:transition-all after:duration-200">
          <span>TADİLAT</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-64 hidden group-hover:block transition duration-200 z-50">
          <div class="bg-[#093825]/98 backdrop-blur-2xl rounded-xl shadow-2xl border border-[#C5A880]/30 py-2 divide-y divide-[#104830]">
            <a href="/izmir-komple-mutfak-tadilati/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Komple Mutfak Tadilatı
            </a>
            <a href="/izmir-banyo-yenileme-seramik/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Banyo Yenileme & Seramik
            </a>
            <a href="/izmir-komple-daire-tadilati/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Komple Daire Tadilatı
            </a>
            <a href="/izmir-anahtar-teslim-tadilat/" class="block px-4 py-2.5 text-xs text-[#EAE6DF] hover:bg-[#0E4730] hover:text-[#C5A880] transition font-medium">
              Anahtar Teslim Taahhüt
            </a>
          </div>
        </div>
      </div>

      <!-- 5. YAPILAN İŞLER (Referanslar) -->
      <a href="/yapilan-isler/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-200">
        YAPILAN İŞLER
      </a>

      <!-- 6. ÖNCESİ / SONRASI -->
      <a href="/#oncesi-sonrasi" class="relative py-2 text-[#C5A880] hover:text-white transition duration-200 font-bold after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-white hover:after:w-full after:transition-all after:duration-200">
        ÖNCESİ / SONRASI
      </a>

      <!-- 7. FİYATLAR -->
      <a href="/2026-mutfak-dolabi-fiyatlari/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-200">
        FİYATLAR
      </a>

      <!-- 8. İLETİŞİM -->
      <a href="/iletisim/" class="relative py-2 text-white hover:text-[#C5A880] transition duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A880] hover:after:w-full after:transition-all after:duration-200">
        İLETİŞİM
      </a>

    </nav>

    <!-- SAĞ: ÜCRETSİZ KEŞİF BUTONU & MOBİL TOGGLE -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="https://wa.me/905324261788?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20ve%20fiyat%20teklifi%20almak%20istiyorum." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-extrabold text-xs uppercase tracking-wider rounded border border-[#E5C378] transition-all duration-300 shadow-[0_4px_16px_rgba(197,168,128,0.25)] hover:shadow-[0_6px_20px_rgba(197,168,128,0.4)]"
      >
        <span>Ücretsiz Keşif Al</span>
        <span>→</span>
      </a>

      <!-- Tablet & Mobil Menü Butonu -->
      <button 
        type="button" 
        id="btnToggleMobileMenu" 
        class="xl:hidden p-2.5 rounded bg-[#0A3D28] hover:bg-[#0E4C32] text-white border border-[#C5A880]/30 focus:outline-none transition"
        aria-label="Menüyü Aç/Kapat"
      >
        <svg id="iconMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="iconMenuClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- MOBİL & TABLET AÇILIR MENÜ (PLAN MUTFAK DÜZENİ) -->
  <div id="mobileMenuPanel" class="hidden xl:hidden bg-[#083322] border-t border-[#104830] px-5 py-6 shadow-2xl max-h-[85vh] overflow-y-auto">
    <nav class="flex flex-col space-y-3.5 text-xs font-bold text-white uppercase tracking-wider">
      <a href="/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">ANA SAYFA</a>
      <a href="/hakkimizda/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">HAKKIMIZDA</a>
      
      <!-- Modeller Grubu -->
      <div class="py-1 px-3 bg-[#052719] rounded-lg">
        <span class="text-[10px] text-[#C5A880] font-bold block mb-1.5 uppercase">MODELLER (MUTFAK • BANYO • KAPI)</span>
        <div class="pl-3 border-l-2 border-[#104830] space-y-2 text-[11px] font-normal text-[#D8D2C7]">
          <a href="/modern-mutfak-modelleri/" class="block py-1 hover:text-[#C5A880]">Modern Mutfak Modelleri</a>
          <a href="/klasik-country-mutfak-modelleri/" class="block py-1 hover:text-[#C5A880]">Klasik & Country Mutfak</a>
          <a href="/hazir-mutfak-modelleri-izmir/" class="block py-1 hover:text-[#C5A880]">Akrilik & Lake Hazır Dolaplar</a>
          <a href="/yasam-alanlari-mutfak-modelleri/" class="block py-1 hover:text-[#C5A880]">Ada & Açık Yaşam Alanı</a>
          <a href="/tasarimlar/?kategori=banyo" class="block py-1 hover:text-[#C5A880]">Lüks Banyo Tasarımları</a>
          <a href="/tasarimlar/?kategori=kapilar" class="block py-1 hover:text-[#C5A880]">İç Mekân Kapıları</a>
          <a href="/tasarimlar/" class="block py-1 text-[#C5A880] font-bold">Tüm Modeller (137 Model) →</a>
        </div>
      </div>

      <!-- Tadilat Grubu -->
      <div class="py-1 px-3 bg-[#052719] rounded-lg">
        <span class="text-[10px] text-[#C5A880] font-bold block mb-1.5 uppercase">TADİLAT & RENOVASYON</span>
        <div class="pl-3 border-l-2 border-[#104830] space-y-2 text-[11px] font-normal text-[#D8D2C7]">
          <a href="/izmir-komple-mutfak-tadilati/" class="block py-1 hover:text-[#C5A880]">Komple Mutfak Tadilatı</a>
          <a href="/izmir-banyo-yenileme-seramik/" class="block py-1 hover:text-[#C5A880]">Banyo Yenileme & Seramik</a>
          <a href="/izmir-komple-daire-tadilati/" class="block py-1 hover:text-[#C5A880]">Komple Daire Tadilatı</a>
          <a href="/izmir-anahtar-teslim-tadilat/" class="block py-1 hover:text-[#C5A880]">Anahtar Teslim Taahhüt</a>
        </div>
      </div>

      <a href="/yapilan-isler/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition flex items-center justify-between">
        <span>YAPILAN İŞLER (REFERANSLAR)</span>
        <span class="px-2 py-0.5 bg-[#00FF66] text-[#041F14] text-[10px] rounded font-extrabold">96 Proje</span>
      </a>

      <a href="/#oncesi-sonrasi" class="py-2 px-3 rounded bg-[#0E4730] text-[#C5A880] transition font-bold">
        ★ ÖNCESİ / SONRASI DÖNÜŞÜM
      </a>

      <a href="/2026-mutfak-dolabi-fiyatlari/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">FİYATLAR</a>
      <a href="/iletisim/" class="py-2 px-3 rounded hover:bg-[#0E4730] hover:text-[#C5A880] transition">İLETİŞİM</a>
      
      <div class="pt-3 border-t border-[#104830] space-y-2">
        <a 
          href="tel:02324411060" 
          class="w-full py-2.5 bg-[#0A3D28] text-white border border-[#C5A880]/40 font-bold text-center rounded block uppercase text-xs tracking-wider"
        >
          📞 0232 441 1060 - Bizi Arayın
        </a>
        <a 
          href="https://wa.me/905324261788?text=Merhaba,%20İzmir%20Mutfak%20Banyo%20ücretsiz%20keşif%20almak%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-3 bg-[#C5A880] text-[#041F14] font-bold text-center rounded block uppercase text-xs tracking-wider"
        >
          WhatsApp ile Ücretsiz Keşif Al →
        </a>
      </div>
    </nav>
  </div>

</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btnToggle = document.getElementById("btnToggleMobileMenu");
    const menuPanel = document.getElementById("mobileMenuPanel");
    const iconOpen = document.getElementById("iconMenuOpen");
    const iconClose = document.getElementById("iconMenuClose");

    if (btnToggle && menuPanel) {
      btnToggle.addEventListener("click", () => {
        const isHidden = menuPanel.classList.contains("hidden");
        if (isHidden) {
          menuPanel.classList.remove("hidden");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
        } else {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        }
      });

      menuPanel.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          menuPanel.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
        });
      });
    }
  });
</script>
