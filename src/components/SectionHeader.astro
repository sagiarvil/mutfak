---
export interface Props {
  watermark: string;      // Arka plandaki dev açık gri filigran metin
  title: string;          // Ön plandaki ana başlık
  subtitle?: string;       // Açıklama alt metni
  tag?: string;           // Üst kırmızı rozet etiketi (opsiyonel)
  theme?: "light" | "dark";
  align?: "center" | "left";
  className?: string;
}

const {
  watermark,
  title,
  subtitle,
  tag,
  theme = "light",
  align = "center",
  className = ""
} = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
---

<div class={`relative py-12 sm:py-16 md:py-20 select-none overflow-hidden ${isCenter ? "text-center" : "text-left"} ${className}`}>
  
  <!-- 1. DEV AÇIK GRİ WATERMARK (Referans Standartı: Devasa Punto, Açık Gri, Kusursuz Derinlik) -->
  {watermark && (
    <div 
      class={`absolute inset-0 flex items-center ${isCenter ? "justify-center" : "justify-start"} pointer-events-none select-none z-0`}
      aria-hidden="true"
    >
      <span class={`font-['Montserrat',sans-serif] text-7xl sm:text-8xl md:text-9xl lg:text-[140px] xl:text-[170px] font-black tracking-tighter leading-none whitespace-nowrap antialiased select-none ${
        isDark ? "text-white/[0.09]" : "text-[#172127]/[0.07]"
      }`}>
        {watermark}
      </span>
    </div>
  )}

  <!-- 2. ÖN PLAN BAŞLIK VE METİN (Kristal Netliğinde, Kusursuz Okunur) -->
  <div class="relative z-10 space-y-2.5">
    {tag && (
      <span class="inline-block text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-[#CB000F] font-['Montserrat',sans-serif]">
        {tag}
      </span>
    )}
    
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl xl:text-[40px] font-extrabold tracking-tight font-['Montserrat',sans-serif] leading-tight ${
      isDark ? "text-white" : "text-[#172127]"
    }`}>
      {title}
    </h2>

    {subtitle && (
      <p class={`text-xs sm:text-sm md:text-base font-normal max-w-2xl ${isCenter ? "mx-auto" : ""} leading-relaxed ${
        isDark ? "text-gray-300" : "text-neutral-500"
      }`}>
        {subtitle}
      </p>
    )}
  </div>

</div>
