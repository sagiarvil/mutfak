---
export interface Props {
  watermark: string;      // Üstte dinamik ölçeklenen soft dev filigran metin
  title: string;          // Altındaki ana başlık
  subtitle?: string;       // Açıklama alt metni
  tag?: string;           // Üst kırmızı rozet etiketi (opsiyonel)
  theme?: "light" | "dark";
  align?: "center" | "left";
  className?: string;
}

const {
  watermark,
  title,
  subtitle,
  tag,
  theme = "light",
  align = "center",
  className = ""
} = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
---

<div class={`select-none ${isCenter ? "text-center" : "text-left"} ${className}`}>
  
  <!-- 1. GHOST / WATERMARK TYPOGRAPHY (Üstte, Ekrana Dinamik Oto Boyutlanan, Asla Kırılmayan/Kesilmeyen Soft Vektörel Katman) -->
  {watermark && (
    <div class={`w-full overflow-hidden pointer-events-none select-none flex ${isCenter ? "justify-center" : "justify-start"} mb-1 sm:mb-2`}>
      <svg 
        viewBox={isCenter ? "0 0 1000 120" : "0 0 800 120"} 
        class={`w-full h-auto select-none pointer-events-none ${isCenter ? "max-w-[700px] sm:max-w-[850px]" : "max-w-[500px] sm:max-w-[650px]"}`}
        preserveAspectRatio={isCenter ? "xMidYMid meet" : "xMinYMid meet"}
        aria-hidden="true"
      >
        <text 
          x={isCenter ? "500" : "0"} 
          y="88" 
          text-anchor={isCenter ? "middle" : "start"} 
          font-family="'Montserrat', sans-serif" 
          font-weight="900" 
          font-size="100" 
          letter-spacing="-1.5"
          class={`select-none antialiased ${
            isDark ? "fill-white/[0.07]" : "fill-[#172127]/[0.055]"
          }`}
        >
          {watermark}
        </text>
      </svg>
    </div>
  )}

  <!-- 2. ALT BAŞLIK & METİN GRUBU (Asla Watermark Üstüne Basmayan, Bağımsız, Ferah ve Jilet Netliğinde Katman) -->
  <div class="space-y-2">
    {tag && (
      <span class="inline-block text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-[#CB000F] font-['Montserrat',sans-serif]">
        {tag}
      </span>
    )}
    
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight font-['Montserrat',sans-serif] leading-tight ${
      isDark ? "text-white" : "text-[#172127]"
    }`}>
      {title}
    </h2>

    {subtitle && (
      <p class={`text-xs sm:text-sm md:text-base font-normal max-w-2xl ${isCenter ? "mx-auto" : ""} leading-relaxed ${
        isDark ? "text-gray-300" : "text-neutral-500"
      }`}>
        {subtitle}
      </p>
    )}
  </div>

</div>