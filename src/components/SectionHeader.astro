---
export interface Props {
  watermark: string;      // Mimari dev üst filigran metin
  title: string;          // Ön plandaki ana başlık
  subtitle?: string;       // Açıklama alt metni
  tag?: string;           // Üst kırmızı rozet etiketi (opsiyonel)
  theme?: "light" | "dark";
  align?: "center" | "left";
  className?: string;
}

const {
  watermark,
  title,
  subtitle,
  tag,
  theme = "light",
  align = "center",
  className = ""
} = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
---

<div class={`select-none ${isCenter ? "text-center" : "text-left"} ${className}`}>
  
  <!-- 1. MİMARÎ DEV FİLİGRAN METİN (Asla Başlığı Ezmeyen, Üstte Yükselen Kristal Netliğinde Katman) -->
  {watermark && (
    <div class="pointer-events-none select-none pb-1 sm:pb-2 overflow-hidden leading-none" aria-hidden="true">
      <span class={`inline-block font-['Montserrat',sans-serif] text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase tracking-wider antialiased select-none ${
        isDark ? "text-white/20" : "text-slate-900/[0.12]"
      }`}>
        {watermark}
      </span>
    </div>
  )}

  <!-- 2. ROZET, ANA BAŞLIK VE AÇIKLAMA METNİ (Sıfır Ezilme, Ferah ve Jilet Netliğinde Hiyerarşi) -->
  <div class="space-y-2">
    {tag && (
      <span class="inline-block text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-[#CB000F] font-['Montserrat',sans-serif]">
        {tag}
      </span>
    )}
    
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight font-['Montserrat',sans-serif] leading-tight ${
      isDark ? "text-white" : "text-[#172127]"
    }`}>
      {title}
    </h2>

    {subtitle && (
      <p class={`text-xs sm:text-sm font-normal max-w-2xl ${isCenter ? "mx-auto" : ""} leading-relaxed ${
        isDark ? "text-gray-300" : "text-neutral-500"
      }`}>
        {subtitle}
      </p>
    )}
  </div>

</div>
