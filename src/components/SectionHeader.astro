---
export interface Props {
  watermark: string;      // Üstte sayfayı enlemesine dolduran lüks dev filigran
  title: string;          // Altındaki ana başlık
  subtitle?: string;       // Açıklama alt metni
  tag?: string;           // Üst kırmızı rozet etiketi (opsiyonel)
  theme?: "light" | "dark";
  align?: "center" | "left";
  className?: string;
}

const {
  watermark,
  title,
  subtitle,
  tag,
  theme = "light",
  align = "center",
  className = ""
} = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
const gradId = `wm-grad-${Math.random().toString(36).substring(2, 7)}`;
---

<div class={`w-full select-none ${isCenter ? "text-center" : "text-left"} ${className}`}>
  
  <!-- 1. DEV GHOST / WATERMARK BACKDROP (Sayfayı Enlemesine Dolduran, İsviçre Tipografi Standartında Prestijli Vektörel Katman) -->
  {watermark && (
    <div class={`w-full overflow-hidden pointer-events-none select-none flex ${isCenter ? "justify-center" : "justify-start"} -mb-2 sm:-mb-5`}>
      <svg 
        viewBox="0 0 1200 155" 
        class="w-full h-auto select-none pointer-events-none"
        preserveAspectRatio={isCenter ? "xMidYMid meet" : "xMinYMid meet"}
        aria-hidden="true"
      >
        <defs>
          <linearGradient id={gradId} x1="0%" y1="0%" x2="100%" y2="0%">
            {isDark ? (
              <>
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.04" />
                <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.09" />
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.04" />
              </>
            ) : (
              <>
                <stop offset="0%" stop-color="#172127" stop-opacity="0.04" />
                <stop offset="50%" stop-color="#172127" stop-opacity="0.075" />
                <stop offset="100%" stop-color="#172127" stop-opacity="0.04" />
              </>
            )}
          </linearGradient>
        </defs>
        <text 
          x={isCenter ? "600" : "0"} 
          y="118" 
          text-anchor={isCenter ? "middle" : "start"} 
          font-family="'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" 
          font-weight="900" 
          font-size="140" 
          letter-spacing="-3.5"
          fill={`url(#${gradId})`}
          class="select-none antialiased"
        >
          {watermark}
        </text>
      </svg>
    </div>
  )}

  <!-- 2. ALT BAŞLIK & METİN GRUBU (Watermark'ın Altında, Sıfır Ezilme, Kristal Netliğinde Mimarî Düzen) -->
  <div class="relative z-10 space-y-2">
    {tag && (
      <span class="inline-block text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-[#CB000F] font-['Montserrat',sans-serif]">
        {tag}
      </span>
    )}
    
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl xl:text-[42px] font-extrabold tracking-tight font-['Montserrat',sans-serif] leading-tight ${
      isDark ? "text-white" : "text-[#172127]"
    }`}>
      {title}
    </h2>

    {subtitle && (
      <p class={`text-xs sm:text-sm md:text-base font-normal max-w-2xl ${isCenter ? "mx-auto" : ""} leading-relaxed ${
        isDark ? "text-gray-300" : "text-neutral-500"
      }`}>
        {subtitle}
      </p>
    )}
  </div>

</div>