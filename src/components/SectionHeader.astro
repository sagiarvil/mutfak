---
export interface Props {
  watermark: string;      // Arka plandaki dev filigran metin
  title: string;          // Ön plandaki ana başlık
  subtitle?: string;       // Açıklama alt metni
  tag?: string;           // Üst kırmızı rozet etiketi (opsiyonel)
  theme?: "light" | "dark";
  align?: "center" | "left";
  className?: string;
}

const {
  watermark,
  title,
  subtitle,
  tag,
  theme = "light",
  align = "center",
  className = ""
} = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
---

<div class={`relative py-8 sm:py-12 select-none ${isCenter ? "text-center" : "text-left"} ${className}`}>
  
  <!-- 1. GHOST / WATERMARK TYPOGRAPHY (Ferah, Geniş, Asla Ezilmeyen Arka Plan Katmanı) -->
  <div 
    class={`absolute inset-x-0 -top-2 sm:-top-4 flex items-center ${isCenter ? "justify-center" : "justify-start"} pointer-events-none select-none z-0`}
    aria-hidden="true"
  >
    <span class={`text-4xl sm:text-6xl md:text-7xl lg:text-[80px] font-black tracking-tight leading-none uppercase whitespace-nowrap ${
      isDark ? "text-white/[0.06]" : "text-slate-900/[0.06]"
    }`}>
      {watermark}
    </span>
  </div>

  <!-- 2. ÖN PLAN BAŞLIK VE METİN (Foreground Title & Subtitle) -->
  <div class="relative z-10 space-y-2.5 pt-2 sm:pt-4">
    {tag && (
      <span class="inline-block text-[10px] sm:text-[11px] font-black uppercase tracking-[0.25em] text-[#CB000F] font-['Montserrat',sans-serif]">
        {tag}
      </span>
    )}
    
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight font-['Montserrat',sans-serif] leading-tight ${
      isDark ? "text-white" : "text-[#172127]"
    }`}>
      {title}
    </h2>

    {subtitle && (
      <p class={`text-xs sm:text-sm font-normal max-w-2xl ${isCenter ? "mx-auto" : ""} leading-relaxed ${
        isDark ? "text-gray-300" : "text-neutral-500"
      }`}>
        {subtitle}
      </p>
    )}
  </div>

</div>
