---
export interface Props {
  watermark: string;      // Üstte sayfayı enlemesine dolduran dev dinamik filigran
  title: string;          // Altındaki ana başlık
  subtitle?: string;       // Açıklama alt metni
  tag?: string;           // Üst kırmızı rozet etiketi (opsiyonel)
  theme?: "light" | "dark";
  align?: "center" | "left";
  className?: string;
}

const {
  watermark,
  title,
  subtitle,
  tag,
  theme = "light",
  align = "center",
  className = ""
} = Astro.props;

const isDark = theme === "dark";
const isCenter = align === "center";
---

<div class={`w-full select-none ${isCenter ? "text-center" : "text-left"} ${className}`}>
  
  <!-- 1. DEV GHOST / WATERMARK BACKDROP (Sayfayı Enlemesine Dolduran, Asla Taşmayan & Kırılmayan Vektörel Mimari) -->
  {watermark && (
    <div class={`w-full overflow-hidden pointer-events-none select-none flex ${isCenter ? "justify-center" : "justify-start"} -mb-2 sm:-mb-4`}>
      <svg 
        viewBox={isCenter ? "0 0 1000 135" : "0 0 1000 135"} 
        class="w-full h-auto select-none pointer-events-none"
        preserveAspectRatio={isCenter ? "xMidYMid meet" : "xMinYMid meet"}
        aria-hidden="true"
      >
        <text 
          x={isCenter ? "500" : "0"} 
          y="100" 
          text-anchor={isCenter ? "middle" : "start"} 
          font-family="'Montserrat', sans-serif" 
          font-weight="900" 
          font-size="120" 
          letter-spacing="-3"
          class={`select-none antialiased ${
            isDark ? "fill-white/[0.07]" : "fill-[#172127]/[0.055]"
          }`}
        >
          {watermark}
        </text>
      </svg>
    </div>
  )}

  <!-- 2. ALT BAŞLIK & METİN GRUBU (Watermark'ın Altında, Sıfır Ezilme, Kristal Netliğinde) -->
  <div class="relative z-10 space-y-2">
    {tag && (
      <span class="inline-block text-[11px] sm:text-xs font-black uppercase tracking-[0.25em] text-[#CB000F] font-['Montserrat',sans-serif]">
        {tag}
      </span>
    )}
    
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight font-['Montserrat',sans-serif] leading-tight ${
      isDark ? "text-white" : "text-[#172127]"
    }`}>
      {title}
    </h2>

    {subtitle && (
      <p class={`text-xs sm:text-sm md:text-base font-normal max-w-2xl ${isCenter ? "mx-auto" : ""} leading-relaxed ${
        isDark ? "text-gray-300" : "text-neutral-500"
      }`}>
        {subtitle}
      </p>
    )}
  </div>

</div>