                  id="ym-email" 
                  name="email" 
                  type="email" 
                  autocomplete="email" 
                  maxlength="140" 
                  placeholder="ornek@sirketiniz.com"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[#D0CAC0] bg-[#FAF9F6] text-xs text-[#15231C] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006039]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="ym-sector" class="block text-xs font-bold text-[#15231C] mb-1">İşletme türü *</label>
                <select 
                  id="ym-sector" 
                  name="sector" 
                  required
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[#D0CAC0] bg-[#FAF9F6] text-xs text-[#15231C] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006039]"
                >
                  <option value="">Seçin</option>
                  <option value="magaza">Mağaza / Showroom</option>
                  <option value="ofis">Ofis</option>
                  <option value="kafe_restoran">Kafe / Restoran</option>
                  <option value="klinik">Klinik</option>
                  <option value="otel">Otel</option>
                  <option value="kuyumcu">Kuyumcu</option>
                  <option value="optik">Optik</option>
                  <option value="zincir">Zincir mağaza</option>
                  <option value="diger">Diğer</option>
                </select>
              </div>

              <div>
                <label for="ym-district" class="block text-xs font-bold text-[#15231C] mb-1">İlçe / konum *</label>
                <input 
                  id="ym-district" 
                  name="district" 
                  required 
                  maxlength="80" 
                  placeholder="Örn: İzmir, Bayraklı"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[#D0CAC0] bg-[#FAF9F6] text-xs text-[#15231C] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006039]"
                />
              </div>

              <div>
                <label for="ym-area" class="block text-xs font-bold text-[#15231C] mb-1">Tahmini alan (m²)</label>
                <input 
                  id="ym-area" 
                  name="area_m2" 
                  type="number" 
                  inputmode="decimal" 
                  min="1" 
                  max="1000000" 
                  step="any" 
                  placeholder="Örn: 150"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-[#D0CAC0] bg-[#FAF9F6] text-xs text-[#15231C] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006039]"
                />
              </div>
            </div>

            <div>
              <label for="ym-timeline" class="block text-xs font-bold text-[#15231C] mb-1">Planlanan başlangıç *</label>
              <select 
                id="ym-timeline" 
                name="timeline" 
                required
                class="w-full px-3.5 py-2.5 rounded-lg border border-[#D0CAC0] bg-[#FAF9F6] text-xs text-[#15231C] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006039]"
              >
                <option value="">Seçin</option>
                <option value="hemen">En kısa sürede</option>
                <option value="1-3-ay">1–3 ay</option>
                <option value="3-6-ay">3–6 ay</option>
                <option value="arastirma">Henüz araştırıyorum</option>
              </select>
            </div>

            <div>
              <label for="ym-notes" class="block text-xs font-bold text-[#15231C] mb-1">Proje özeti</label>
              <textarea 
                id="ym-notes" 
                name="description" 
                maxlength="1200" 
                rows="3" 
                placeholder="Yeni açılış mı, mevcut alan yenilemesi mi? İhtiyaçlarınızı kısaca özetleyin..."
                class="w-full px-3.5 py-2.5 rounded-lg border border-[#D0CAC0] bg-[#FAF9F6] text-xs text-[#15231C] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#006039]"
              ></textarea>
            </div>

            <!-- Honeypot -->
            <div class="hidden" aria-hidden="true">
              <label for="ym-website">Web sitesi</label>
              <input id="ym-website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <!-- KVKK ve Rıza -->
            <div class="space-y-2 pt-2 text-xs text-[#4A443D]">
              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" name="privacy_ack" required class="mt-0.5 rounded text-[#006039] focus:ring-[#006039]" />
                <span>
                  <a href="/kvkk-aydinlatma-metni/" target="_blank" rel="noopener" class="text-[#006039] underline font-semibold">Kişisel veri aydınlatma metnini</a> okudum. *
                </span>
              </label>

              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" name="marketing_opt_in" class="mt-0.5 rounded text-[#006039] focus:ring-[#006039]" />
                <span>Kampanya ve duyurular hakkında ayrıca ileti almayı tercih ediyorum (isteğe bağlı).</span>
              </label>
            </div>

            <!-- Turnstile Widget Container -->
            <div class="pt-2 flex justify-center">
              <div class="cf-turnstile" data-sitekey="0x4AAAAAAAxxxxxxREPLACE" data-action="projelendirme_lead"></div>
            </div>

            <!-- Submit Butonu -->
            <div class="pt-2">
              <button 
                type="submit" 
                class="w-full py-4 bg-[#006039] hover:bg-[#00482B] text-white font-bold text-xs sm:text-sm uppercase tracking-wider rounded-xl shadow-[0_4px_16px_rgba(0,96,57,0.25)] transition-all duration-200 border border-[#C5A880]/50 flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>PROJE GÖRÜŞMESİ TALEP ET</span>
                <span class="text-[#C5A880] text-base">→</span>
              </button>
            </div>

            <p id="ym-form-message" role="status" aria-live="polite" class="text-center text-xs font-semibold min-h-[1.5em] mt-2"></p>

            <noscript>
              <p class="text-xs text-red-600 text-center mt-2">
                Form güvenli gönderim için JavaScript gerektirir. Alternatif olarak <a href="tel:+902324411060" class="underline font-bold">0232 441 10 60</a> numaralı telefondan bize ulaşabilirsiniz.
              </p>
            </noscript>

          </form>

          <!-- WhatsApp Alternatifi -->
          <div class="mt-8 pt-6 border-t border-[#E5E2DA] text-center">
            <p class="text-xs text-[#5A544C] mb-3">Veya beklemeden doğrudan mimarımızla yazışın:</p>
            <a 
              href="https://wa.me/905324261788?text=Merhaba,%20ticari%20mekan%20projelendirmesi%20icin%20gorusmek%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-[#F3EFEA] border border-[#D0CAC0] text-xs font-bold text-[#15231C] shadow-xs transition-all"
            >
              <span class="text-[#006039] text-base">💬</span>
              <span>WhatsApp ile Hızlı Görüşme Başlat (0532 426 17 88)</span>
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- Cloudflare Turnstile & Form Scriptleri -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="/assets/lead-form.js" defer></script>

    <!-- ===================================================================== -->
    <!-- İNTERAKTİF PROJE DETAY MODALI (LIGHTBOX - ALPINE.JS)                   -->
    <!-- ===================================================================== -->
    <div 
      x-show="modalOpen" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-sm"
      style="display: none;"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @click.self="closeModal()"
    >
      <div 
        class="relative w-full max-w-4xl bg-white rounded-2xl overflow-hidden shadow-2xl border border-[#E5E2DA] max-h-[90vh] flex flex-col"
        x-show="modalOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
      >
        <!-- Kapat Butonu -->
        <button 
          type="button" 
          class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-black/60 text-white hover:bg-black flex items-center justify-center transition-colors text-lg"
          @click="closeModal()"
          aria-label="Kapat"
        >
          ✕
        </button>

        <!-- Modal İçeriği (Kaydırılabilir) -->
        <div class="overflow-y-auto">
          <template x-if="selectedProject">
            <div>
              <!-- Büyük Görsel -->
              <div class="relative w-full aspect-[16/10] bg-black">
                <img 
                  :src="selectedProject.image" 
                  :alt="selectedProject.title" 
                  class="w-full h-full object-contain"
                />
              </div>

              <!-- Detaylar -->
              <div class="p-6 sm:p-8 bg-white">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded bg-[#006039]/10 text-[#006039] text-xs font-bold uppercase tracking-wider" x-text="selectedProject.categoryLabel"></span>
                  <span class="text-xs text-[#756E65]" x-text="selectedProject.location"></span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-[#15231C]" x-text="selectedProject.title"></h3>

                <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                  Bu proje; mimari tasarım, detay çözümleri, CNC mobilya imalatı ve anahtar teslim şantiye yönetimi kapsamında uluslararası kalite standartlarında tamamlanmıştır.
                </p>

                <!-- CTA -->
                <div class="mt-6 pt-5 border-t border-[#E5E2DA] flex flex-wrap items-center justify-between gap-4">
                  <div class="text-xs text-[#15231C]">
                    Benzer bir mekan mı projelendirmek istiyorsunuz?
                  </div>
                  <a 
                    :href="'https://wa.me/905324261788?text=' + encodeURIComponent('Merhaba, ' + selectedProject.title + ' projenize benzer bir proje için teklif almak istiyorum.')"
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="px-5 py-2.5 bg-[#006039] hover:bg-[#00482B] text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-sm flex items-center gap-2"
                  >
                    <span>BENZER PROJE İÇİN TEKLİF ALIN</span>
                    <span>→</span>
                  </a>
                </div>

              </div>
            </div>
          </template>
        </div>

      </div>
    </div>

  </main>
</Layout>
