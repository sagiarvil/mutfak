---
import Layout from "../../layouts/Layout.astro";
import { 
  manifestoProjects, 
  projectCategories, 
  meartPhases, 
  meartAboutData, 
  meartClients 
} from "../../data/projelendirmeData";

const seo = {
  title: "İzmir Ticari Mekân Projelendirme & Fit-Out | Yeşilay Mutfak",
  description: "İzmir'de mağaza, ofis ve kafe-restoran için mimari projelendirme, 3D tasarım ve anahtar teslim fit-out çözümleri. Projeniz için görüşme talep edin.",
  canonical: "https://yesilaymutfak.com/projelendirme/"
};
---

<Layout seo={seo} activeService="projelendirme">
  <link rel="stylesheet" href="/assets/lead-form.css" />
  <main 
    class="w-full text-[#15231C] bg-[#FAF9F6] font-sans antialiased selection:bg-[#006039] selection:text-white"
    x-data="{
      activeFilter: 'all',
      modalOpen: false,
      selectedProject: null,
      openModal(project) {
        this.selectedProject = project;
        this.modalOpen = true;
        document.body.classList.add('overflow-hidden');
      },
      closeModal() {
        this.modalOpen = false;
        document.body.classList.remove('overflow-hidden');
      }
    }"
    @keydown.escape="closeModal()"
  >

    <!-- ===================================================================== -->
    <!-- BÖLÜM 1: MANIFESTO & MEART ORTAK PRESTİJ HERO                         -->
    <!-- Mimari Zarafet, Türkiye Çapında Taahhüt Ağı ve Başarı Metrikleri      -->
    <!-- ===================================================================== -->
    <section class="relative w-full pt-10 pb-16 sm:pt-14 sm:pb-20 border-b border-[#E5E2DA] overflow-hidden bg-gradient-to-b from-[#FAF9F6] via-[#F3EFEA] to-[#FAF9F6]">
      
      <!-- Arka Plan Mimari Dinamik Vektörel Watermark (Kural: Dinamik SVG, Üstte ve Taşmayan) -->
      <div class="absolute inset-x-0 top-0 h-44 overflow-hidden pointer-events-none select-none opacity-40">
        <svg viewBox="0 0 1200 140" class="w-full h-full text-[#ECEAE5] fill-current" preserveAspectRatio="xMidYMid meet">
          <text x="50%" y="65%" text-anchor="middle" font-size="88" font-weight="900" letter-spacing="0.18em" font-family="system-ui, sans-serif">PROJELENDİRME</text>
        </svg>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Üst Kategori Etiketi -->
        <div class="flex items-center justify-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold tracking-widest uppercase bg-[#C5A880]/15 text-[#8F7249] border border-[#C5A880]/40">
            <span class="w-1.5 h-1.5 rounded-full bg-[#006039] animate-pulse"></span>
            YEŞİLAY MİMARLIK · PROJELENDİRME, TASARIM & FIT-OUT TAAHHÜT
          </span>
        </div>

        <!-- H1 Başlık (Manifesto Mimari Standardı) -->
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#15231C] leading-[1.12]">
            İzmir Ticari Mekân Projelendirme ve Anahtar Teslim Fit-Out
          </h1>
          <p class="mt-5 text-base sm:text-lg md:text-xl text-[#5A544C] leading-relaxed max-w-3xl mx-auto font-normal">
            Mağaza, ofis veya kafe-restoran açmayı ya da mevcut iş yerinizi yenilemeyi mi planlıyorsunuz? Mekânınızın işlevini, markanızın ihtiyaçlarını ve uygulama kapsamını birlikte netleştirelim. Yeşilay Mutfak bünyesinde mimari tasarım ve uygulama hizmetlerinin kapsamını proje özelinde belirliyoruz.
          </p>
        </div>

        <!-- Eylemler (CTA) -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
          <a 
            href="#proje-gorusmesi" 
            class="px-6 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-[0_4px_16px_rgba(0,96,57,0.22)] transition-all duration-200 flex items-center gap-2 border border-[#C5A880]/50"
          >
            <span>TİCARİ PROJEM İÇİN GÖRÜŞME TALEP ET</span>
            <span class="text-[#C5A880]">↓</span>
          </a>
          <a 
            href="#projelendirme-sureci" 
            class="px-6 py-3.5 bg-white hover:bg-[#F3EFEA] text-[#15231C] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg border border-[#D0CAC0] shadow-sm transition-all duration-200 flex items-center gap-2"
          >
            <span>PROJELENDİRME SÜRECİNİ İNCELE</span>
            <span class="text-[#006039]">→</span>
          </a>
          <a 
            href="https://wa.me/905324261788?text=Merhaba,%20ticari%20mekan%20projelendirmesi%20icin%20gorusmek%20istiyorum." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-6 py-3.5 bg-white hover:bg-[#F3EFEA] text-[#15231C] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg border border-[#D0CAC0] shadow-sm transition-all duration-200 flex items-center gap-2"
          >
            <span class="text-[#006039]">💬</span>
            <span>WHATSAPP İLE GÖRÜŞME BAŞLAT</span>
          </a>
        </div>

        <!-- MeArt İstatistik & Türkiye Harita Bloğu (Bileşke) -->
        <div class="mt-14 bg-white rounded-2xl border border-[#E5E2DA] shadow-[0_12px_40px_rgba(21,35,28,0.06)] overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
            
            <!-- Sol: İstatistikler -->
            <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-[#E5E2DA] bg-[#FAF9F6]/50">
              <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">GÜÇLÜ KURUMSAL TAAHHÜT</span>
              <h2 class="text-xl sm:text-2xl font-bold text-[#15231C] mt-1.5 leading-snug">
                Güzel Türkiye'mizin Hemen Her Şehrinde Mükemmel Projelere İmzamızı Attık
              </h2>
              <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                1998 yılından itibaren holding merkezlerinden lüks perakende zincirlerine, otellerden franchise mekanlara kadar yüzlerce projeyi tam zamanında başarı ile tamamladık.
              </p>

              <!-- 4 Metrik Kartı -->
              <div class="grid grid-cols-2 gap-3 sm:gap-4 mt-6">
                {meartAboutData.stats.map(st => (
                  <div class="p-3.5 rounded-xl bg-white border border-[#E5E2DA] shadow-sm">
                    <div class="text-2xl sm:text-3xl font-extrabold text-[#006039] tracking-tight">{st.value}</div>
                    <div class="text-xs font-bold text-[#15231C] mt-0.5">{st.label}</div>
                    <div class="text-[10px] text-[#756E65] mt-0.5">{st.sub}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Sağ: Türkiye Proje Haritası (MeArt Orijinal Görseli) -->
            <div class="lg:col-span-7 p-4 sm:p-6 lg:p-8 flex flex-col items-center justify-center bg-white">
              <div class="relative w-full max-w-xl">
                <img 
                  src="https://static.wixstatic.com/media/990e90_73a7a98912a1427a89dce7e048450c69~mv2.png" 
                  alt="Türkiye Proje Dağılım Haritası - Yeşilay & MeArt" 
                  class="w-full h-auto object-contain drop-shadow-md rounded-lg"
                  loading="eager"
                  width="948"
                  height="542"
                />
              </div>
              <p class="mt-3 text-[11px] text-[#756E65] text-center font-medium">
                📍 İstanbul, İzmir, Ankara, Bursa, Antalya, Gaziantep, Bodrum ve 81 ilde anahtar teslim şantiye koordinasyonu
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BÖLÜM 2A: İŞLETMENİZE UYGUN TİCARİ MEKÂN ÇÖZÜMLERİ                    -->
    <!-- Mağaza, Ofis, Kafe/Restoran ve Diğer Ticari Projeler                   -->
    <!-- ===================================================================== -->
    <section class="py-16 sm:py-20 bg-white border-b border-[#E5E2DA]" id="ticari-cozumler">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">SEKTÖREL MİMARİ MÜHENDİSLİK</span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#15231C] tracking-tight mt-1.5">
            İşletmenize Uygun Ticari Mekân Çözümleri
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5A544C]">
            İzmir ve Ege Bölgesi'nde ticari mekânın işlevini, müşteri sirkülasyonunu ve marka kimliğini bir bütün olarak planlıyoruz.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Çözüm 1: Mağaza ve Showroom -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] hover:border-[#006039]/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🛍️
              </div>
              <h3 class="text-lg font-bold text-[#15231C] leading-snug">
                Mağaza ve Showroom Projelendirme
              </h3>
              <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Bir mağazanın yerleşimi yalnızca görsel beğeni meselesi değildir. Müşteri dolaşımı, ürün teşhiri, vitrin, kasa, stok alanı ve aydınlatma birlikte planlanır. Mevcut alanınız ve marka ihtiyaçlarınız üzerinden proje kapsamı ve uygulanabilir seçenekler değerlendirilir.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-semibold text-[#8F7249]">
              Dolaşım & Vitrin Mimarisi
            </div>
          </div>

          <!-- Çözüm 2: Ofis ve Yönetim -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] hover:border-[#006039]/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🏢
              </div>
              <h3 class="text-lg font-bold text-[#15231C] leading-snug">
                Ofis ve Yönetim Alanları Tasarımı
              </h3>
              <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Çalışma alanlarının fonksiyonunu; toplantı gizliliği, akustik, depolama, kablolama, misafir karşılama ve büyüme ihtiyacına göre ele alıyoruz. Yönetim ofisi, hukuk bürosu veya danışmanlık ofisi için yerleşim kararlarını teknik ölçülere dayandırıyoruz.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-semibold text-[#8F7249]">
              Akustik & Fonksiyonel Ofis
            </div>
          </div>

          <!-- Çözüm 3: Kafe ve Restoran -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] hover:border-[#006039]/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🍽️
              </div>
              <h3 class="text-lg font-bold text-[#15231C] leading-snug">
                Kafe ve Restoran İç Mekân Tasarımı
              </h3>
              <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Müşteri oturma alanı, servis rotası, mutfak-yemek hazırlık ilişkisi, aydınlatma, temizlik ve bakım erişimini aynı projede ele almak işletme sürecini kolaylaştırır. Projelendirme sırasında teknik altyapı ve gerekli izinlere ilişkin sorumluluklar yazılı kapsamda ayrıştırılır.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-semibold text-[#8F7249]">
              Servis & Mutfak Akışı
            </div>
          </div>

          <!-- Çözüm 4: Diğer Ticari Projeler -->
          <div class="p-6 rounded-2xl bg-[#FAF9F6] border border-[#E5E2DA] hover:border-[#006039]/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#006039]/10 text-[#006039] flex items-center justify-center font-bold text-lg mb-4">
                🩺
              </div>
              <h3 class="text-lg font-bold text-[#15231C] leading-snug">
                Diğer Ticari Projeler
              </h3>
              <p class="mt-3 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Klinik, butik otel, optik mağazası, kuyumcu mağazası ve çok şubeli ticari projelerde hizmetin kapsamı; teknik gereklilikler, ilgili yetkiler, mevcut ekip kapasitesi ve işin yerine göre ayrıca değerlendirilir. <strong class="text-[#15231C]">Sektöre özgü yasal standartlara otomatik uyum garantisi verilmez.</strong>
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#E5E2DA] text-[11px] font-semibold text-[#8F7249]">
              Özel Kapsam Değerlendirmesi
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BÖLÜM 2B: PROJELENDİRME VE UYGULAMA NASIL İLERLİYOR? (4 ADIM)         -->
    <!-- ===================================================================== -->
    <section class="py-16 sm:py-20 bg-[#FAF9F6] border-b border-[#E5E2DA]" id="projelendirme-sureci">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">ŞEFFAF SÜREÇ YÖNETİMİ</span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#15231C] tracking-tight mt-1.5">
            Projelendirme ve Uygulama Nasıl İlerliyor?
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5A544C]">
            İyi bir ticari proje; gerçek ölçülere, tesisatın durumuna, kullanım yoğunluğuna, malzeme erişimine, onaylanmış kapsam ve maliyet planına dayanır.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Adım 1 -->
          <div class="p-6 rounded-2xl bg-white border border-[#E5E2DA] shadow-xs flex flex-col justify-between">
            <div>
              <div class="text-3xl font-black text-[#006039] mb-3">01</div>
              <h3 class="text-base font-bold text-[#15231C]">Ön Görüşme ve İhtiyaç Analizi</h3>
              <p class="mt-2 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                İşletme türü, konum, alan, açılış hedefi, mevcut durum, karar verici ve bütçe beklentisi belirlenir.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[10px] text-[#8F7249] font-bold uppercase">
              İlk Temas & Değerlendirme
            </div>
          </div>

          <!-- Adım 2 -->
          <div class="p-6 rounded-2xl bg-white border border-[#E5E2DA] shadow-xs flex flex-col justify-between">
            <div>
              <div class="text-3xl font-black text-[#006039] mb-3">02</div>
              <h3 class="text-base font-bold text-[#15231C]">Yerinde İnceleme ve Rölöve</h3>
              <p class="mt-2 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Uygun görülen projelerde ölçüler, mevcut tesisat ve kullanılabilir alan netleştirilir. Keşif ücreti ve kapsamı görüşmede açıklanır.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[10px] text-[#8F7249] font-bold uppercase">
              Saha Tespiti & Ölçüm
            </div>
          </div>

          <!-- Adım 3 -->
          <div class="p-6 rounded-2xl bg-white border border-[#E5E2DA] shadow-xs flex flex-col justify-between">
            <div>
              <div class="text-3xl font-black text-[#006039] mb-3">03</div>
              <h3 class="text-base font-bold text-[#15231C]">Mimari Seçenek, Metraj ve Teklif</h3>
              <p class="mt-2 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Teknik yerleşim, gerekiyorsa 3D sunum, malzeme/işçilik kapsamı, dahil-hariç işler ve uygulanabilir termin yazılı teklifin temelini oluşturur.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[10px] text-[#8F7249] font-bold uppercase">
              Yazılı Kapsam & Bütçe
            </div>
          </div>

          <!-- Adım 4 -->
          <div class="p-6 rounded-2xl bg-white border border-[#E5E2DA] shadow-xs flex flex-col justify-between">
            <div>
              <div class="text-3xl font-black text-[#006039] mb-3">04</div>
              <h3 class="text-base font-bold text-[#15231C]">Sözleşme, Uygulama ve Kabul</h3>
              <p class="mt-2 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
                Taraflar şartlarda mutabık kaldığında iş programı, sorumlular ve kontrol noktaları yazılı hâle getirilir. Kapsam değişiklikleri ayrıca onaylanır.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#F3EFEA] text-[10px] text-[#8F7249] font-bold uppercase">
              Kontrollü Teslimat
            </div>
          </div>

        </div>

        <!-- Mimaride Önemli Olan & Teklif İçin Gerekli Bilgiler Kutusu -->
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 bg-white p-6 sm:p-8 rounded-2xl border border-[#E5E2DA]">
          <div>
            <h4 class="text-sm sm:text-base font-bold text-[#15231C] flex items-center gap-2">
              <span class="text-[#006039]">📋</span>
              <span>Teklifinizi Doğru Hazırlamak İçin Hangi Bilgiler Gerekli?</span>
            </h4>
            <p class="mt-2 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
              İşletmenizin bulunduğu ilçe, yaklaşık alanı (m²), planladığınız açılış zamanı, yapılacak işin yeni kurulum veya yenileme oluşu ve varsa fotoğraf/plan bilgisi ilk değerlendirmeyi hızlandırır. Bu bilgiler keşif öncesi değerlendirme içindir; <strong>kesin fiyat veya teslim garantisi oluşturmaz</strong>.
            </p>
          </div>
          <div>
            <h4 class="text-sm sm:text-base font-bold text-[#15231C] flex items-center gap-2">
              <span class="text-[#006039]">📐</span>
              <span>Mimaride Önemli Olan Yalnızca Görünüş Değil, Uygulanabilirlik</span>
            </h4>
            <p class="mt-2 text-xs sm:text-sm text-[#5A544C] leading-relaxed">
              İyi bir ticari proje; gerçek ölçülere, tesisatın durumuna, kullanım yoğunluğuna, malzeme erişimine, onaylanmış kapsam ve maliyet planına dayanır. Projeyi sözleşme aşamasına taşımadan önce işin kim tarafından, hangi iş kalemleriyle ve hangi kontrol noktalarında yürütüleceği yazılı hale getirilir.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- BÖLÜM 2: MEART "NELER YAPARIZ" 3 AŞAMALI MİMARİ SÜREÇ                 -->
    <!-- Tasarım -> Proje & Planlama -> Uygulama                                -->
    <!-- ===================================================================== -->
    <section class="py-16 sm:py-20 bg-[#FAF9F6] border-b border-[#E5E2DA]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
          <span class="text-[11px] font-bold text-[#8F7249] tracking-widest uppercase">MİMARİ METODOLOJİ</span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#15231C] tracking-tight mt-1.5">
            Neler Yaparız?
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5A544C]">
            Beraber hayal edip, doğru çizgilerle buluşturuyoruz. Hikâyeniz, senaryonuz ve şantiyeniz hazır…
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          {meartPhases.map((phase) => (
            <div class="relative bg-white rounded-2xl p-6 sm:p-8 border border-[#E5E2DA] shadow-[0_4px_20px_rgba(21,35,28,0.04)] hover:shadow-[0_12px_32px_rgba(21,35,28,0.08)] transition-all duration-300 flex flex-col justify-between group">
              
              <!-- Üst Step & İkon -->
              <div>
                <div class="flex items-center justify-between mb-5">
                  <span class="text-3xl sm:text-4xl font-black text-[#C5A880]/40 group-hover:text-[#006039] transition-colors">
                    {phase.step}
                  </span>
                  <span class="px-2.5 py-1 text-[11px] font-bold rounded-md bg-[#F3EFEA] text-[#15231C] border border-[#E5E2DA]">
                    {phase.subtitle}
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-[#15231C] tracking-tight group-hover:text-[#006039] transition-colors">
                  {phase.title}
                </h3>

