---
import Layout from "../../layouts/Layout.astro";

// 20 Ticari Proje / Mağaza Konsept Görsel Verisi
const commercialProjects = [
  { no: 1, marka: "VELUNOR", kategori: "MİMARİ YAŞAM", baslik: "Velunor Mimari Yaşam Mağazası", konum: "Alsancak, İzmir", dosya: "/images/ticari-projeler/01_velunor_magaza.jpg" },
  { no: 2, marka: "CASTERA", kategori: "TASARIM ATÖLYESİ", baslik: "Castera Tasarım Atölyesi & Showroom", konum: "Bayraklı, İzmir", dosya: "/images/ticari-projeler/02_castera_magaza.jpg" },
  { no: 3, marka: "KORVEX", kategori: "TEKNİK MARKET", baslik: "Korvex Profesyonel Teknik Market", konum: "Bornova, İzmir", dosya: "/images/ticari-projeler/03_korvex_magaza.jpg" },
  { no: 4, marka: "PİKORA", kategori: "KONSEPT MAĞAZA", baslik: "Pikora Renkli Dünya Konsept Mağazası", konum: "Mavişehir, İzmir", dosya: "/images/ticari-projeler/04_pikora_magaza.jpg" },
  { no: 5, marka: "LUMORİ", kategori: "LIFESTYLE STORE", baslik: "Lumori Yaşam & Aydınlatma Mağazası", konum: "Urla, İzmir", dosya: "/images/ticari-projeler/05_lumori_magaza.jpg" },
  { no: 6, marka: "BEBYORA", kategori: "ANNE & BEBEK", baslik: "Bebyora Premium Bebek & Yaşam Alanı", konum: "Karşıyaka, İzmir", dosya: "/images/ticari-projeler/06_bebyora_magaza.jpg" },
  { no: 7, marka: "NİVERA", kategori: "ÇOCUK & YAŞAM", baslik: "Nivera Çocuk Deneyim Mağazası", konum: "Konak, İzmir", dosya: "/images/ticari-projeler/07_nivera_magaza.jpg" },
  { no: 8, marka: "KİDAVO", kategori: "MODA MAĞAZASI", baslik: "Kidavo Konsept Moda & Giyim", konum: "Bostanlı, İzmir", dosya: "/images/ticari-projeler/08_kidavo_magaza.jpg" },
  { no: 9, marka: "MİNORA", kategori: "OYUN & TASARIM", baslik: "Minora Deneyimsel Oyun & Tasarım Alanı", konum: "Güzelbahçe, İzmir", dosya: "/images/ticari-projeler/09_minora_magaza.jpg" },
  { no: 10, marka: "AVENORA", kategori: "MODA ATÖLYESİ", baslik: "Avenora Lüks Giyim & Terzilik Stüdyosu", konum: "Alsancak, İzmir", dosya: "/images/ticari-projeler/10_avenora_magaza.jpg" },
  { no: 11, marka: "MİRAVİ", kategori: "YAŞAM & TASARIM", baslik: "Miravi Ev Dekorasyonu & Aksesuar", konum: "Çeşme, İzmir", dosya: "/images/ticari-projeler/11_miravi_magaza.jpg" },
  { no: 12, marka: "MONELİ", kategori: "KOZMETİK & BAKIM", baslik: "Moneli Doğal Kozmetik & Bakım Mağazası", konum: "Buca, İzmir", dosya: "/images/ticari-projeler/12_moneli_magaza.jpg" },
  { no: 13, marka: "ARVİSA", kategori: "İŞ VE OFİS", baslik: "Arvisa Kurumsal Çözümler Showroomu", konum: "Gaziemir, İzmir", dosya: "/images/ticari-projeler/13_arvisa_magaza.jpg" },
  { no: 14, marka: "LORİNA", kategori: "KIDS CONCEPT", baslik: "Lorina Çocuk Mobilya & Dekorasyon", konum: "Balçova, İzmir", dosya: "/images/ticari-projeler/14_lorina_magaza.jpg" },
  { no: 15, marka: "EVONARA", kategori: "EV & YAŞAM", baslik: "Evonara Mobilya & İç Mekan Mağazası", konum: "Bayraklı, İzmir", dosya: "/images/ticari-projeler/15_evonara_magaza.jpg" },
  { no: 16, marka: "KİVORA", kategori: "CONCEPT STORE", baslik: "Kivora Butik Aksesuar & Tasarım Mağazası", konum: "Alaçatı, İzmir", dosya: "/images/ticari-projeler/16_kivora_magaza.jpg" },
  { no: 17, marka: "OYUNİVA", kategori: "OYUNCAK DÜNYASI", baslik: "Oyuniva Eğitici Oyuncak & Hobi Mağazası", konum: "Karşıyaka, İzmir", dosya: "/images/ticari-projeler/17_oyuniva_magaza.jpg" },
  { no: 18, marka: "FİORİSA", kategori: "KONSEPT MAĞAZA", baslik: "Fiorisa Çiçek Tasarım & Botanik Mağazası", konum: "Urla, İzmir", dosya: "/images/ticari-projeler/18_fiorisa_magaza.jpg" },
  { no: 19, marka: "VALERON", kategori: "MODA & SHOWROOM", baslik: "Valeron Tekstil & İç Mekan Showroomu", konum: "Torbalı, İzmir", dosya: "/images/ticari-projeler/19_valeron_magaza.jpg" },
  { no: 20, marka: "MOVENİA", kategori: "HAREKET STÜDYOSU", baslik: "Movenia Sağlıklı Yaşam & Pilates Stüdyosu", konum: "Narlıdere, İzmir", dosya: "/images/ticari-projeler/20_movenia_magaza.jpg" }
];

// OSO Mimarlık Formatında Yeni Nesil 10 Mimari Hero Slider
const heroSlides = [
  {
    baslik: "Vadi Vista Yönetim Merkezi",
    kategori: "KURUMSAL OFİS & FIT-OUT",
    resim: "/images/projelendirme/hero/hero_01.webp",
    aciklama: "Büyük ölçekli genel merkez ve yönetim binalarında çağdaş mimari, akustik konfor ve anahtar teslim şantiye yönetimi."
  },
  {
    baslik: "Natura Modern Yaşam Showroomu",
    kategori: "KONSEPT MAĞAZA TASARIMI",
    resim: "/images/projelendirme/hero/hero_02.webp",
    aciklama: "Perakende sektöründe müşteri deneyimini ve marka prestijini zirveye taşıyan fonksiyonel mağaza mimarisi."
  },
  {
    baslik: "Kuzey Plaza Yönetim Katı",
    kategori: "İÇ MİMARİ & UYGULAMA",
    resim: "/images/projelendirme/hero/hero_03.webp",
    aciklama: "Açık ofis ergonomisi, entegre altyapı ve mimari detay mühendisliği ile üretkenliği artıran çalışma alanları."
  },
  {
    baslik: "Aura Concept Store",
    kategori: "LÜKS MAĞAZACILIK & SHOWROOM",
    resim: "/images/projelendirme/hero/hero_04.webp",
    aciklama: "Doğru aydınlatma, akıcı dolaşım rotaları ve özel imalat sergileme üniteleri ile ticari başarı odaklı tasarımlar."
  },
  {
    baslik: "Ege Global Lojistik Merkezi",
    kategori: "TİCARİ KOMPLEKS & OFİS",
    resim: "/images/projelendirme/hero/hero_05.webp",
    aciklama: "Yüksek hacimli ticari merkezlerde operasyonel verimlilik ve kurumsal kimliği bütünleştiren mimari yaklaşım."
  },
  {
    baslik: "Armada Lounge & Bistro",
    kategori: "CAFE-RESTORAN TASARIMI",
    resim: "/images/projelendirme/hero/hero_06.webp",
    aciklama: "Gastronomi mekanlarında ambiyansı, akustik dengeyi ve operasyonel mutfak-servis akışını kusursuzlaştıran mimari."
  },
  {
    baslik: "Monolit İş Kulesi Ofisleri",
    kategori: "YENİLİKÇİ ÇALIŞMA ALANLARI",
    resim: "/images/projelendirme/hero/hero_07.webp",
    aciklama: "Yeni nesil hibrit çalışma kültürüne uygun, teknolojik entegrasyonu yüksek prestijli ofis mekanları."
  },
  {
    baslik: "Boutique Privee Mücevherat",
    kategori: "ÖZEL PERAKENDE MİMARİSİ",
    resim: "/images/projelendirme/hero/hero_08.webp",
    aciklama: "Seçkin markalar için özel güvenlikli, yüksek katma değerli ve zamansız vitrin & mağaza uygulamaları."
  },
  {
    baslik: "Kolektif İnovasyon Kampüsü",
    kategori: "MİMARİ PROJELENDİRME",
    resim: "/images/projelendirme/hero/hero_09.webp",
    aciklama: "3D rölöve ve fotogerçekçi görselleştirmeden fit-out teslime kadar sıfır toleranslı mimari süreç."
  },
  {
    baslik: "Terrace Cafe & Brasserie",
    kategori: "YEME-İÇME & YAŞAM ALANI",
    resim: "/images/projelendirme/hero/hero_10.webp",
    aciklama: "Açık ve kapalı alan entegrasyonu, doğal malzeme uyumu ve unutulmaz müşteri deneyimi sunan gastro mekanlar."
  }
];

const seo = {
  title: "Projelendirme | Mimarlık Ofisi ve Ticari Mekan FIT-Out Uygulama Hizmetleri | Yeşilay Mimarlık",
  description: "İzmir mimarlık ve iç mimarlık ofisi. Ofis, mağaza, cafe-restoran ve kurumsal ticari projelerde mimari tasarım, 3D görselleştirme ve anahtar teslim (fit-out) uygulama hizmetleri.",
  canonical: "https://yesilaymutfak.com/projelendirme/"
};
---

<Layout seo={seo} activeService="projelendirme">
  <main class="w-full text-slate-800 font-sans antialiased selection:bg-amber-600 selection:text-white">

    <!-- BÖLÜM 1: OSO MİMARLIK FORMATINDA TAM EKRAN MİMARİ HERO SLIDER -->
    <section class="relative w-full bg-slate-900 text-white overflow-hidden" x-data="{
      activeSlide: 0,
      totalSlides: 10,
      timer: null,
      startAuto() {
        this.timer = setInterval(() => {
          this.activeSlide = (this.activeSlide + 1) % this.totalSlides;
        }, 5000);
      },
      stopAuto() {
        if (this.timer) clearInterval(this.timer);
      }
    }" x-init="startAuto()" @mouseenter="stopAuto()" @mouseleave="startAuto()">

      <!-- Slide Görselleri -->
      <div class="relative w-full h-[580px] md:h-[680px] lg:h-[760px]">
        {heroSlides.map((slide, index) => (
          <div
            class="absolute inset-0 transition-opacity duration-1000 ease-in-out"
            x-show={`activeSlide === ${index}`}
            x-transition:enter="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="opacity-100"
            x-transition:leave-end="opacity-0"
          >
            <img
              src={slide.resim}
              alt={slide.baslik}
              class="w-full h-full object-cover object-center transform scale-100 transition-transform duration-7000 ease-out"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <!-- Gradient Overlay: OSO Mimarlık Saf Minimalist Gradyan -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/40"></div>

            <!-- Mimari Başlık & Tipografi Grubu (Alt Sol / Merkez) -->
            <div class="absolute inset-0 flex items-end">
              <div class="max-w-7xl mx-auto px-6 lg:px-12 pb-16 md:pb-24 w-full">
                <div class="max-w-3xl space-y-4">
                  <div class="inline-flex items-center gap-3">
                    <span class="w-8 h-[2px] bg-amber-500"></span>
                    <span class="text-xs md:text-sm font-semibold tracking-[0.25em] uppercase text-amber-400">
                      {slide.kategori}
                    </span>
                  </div>
                  <h2 class="text-3xl md:text-5xl lg:text-6xl font-light text-white tracking-tight leading-tight">
                    {slide.baslik}
                  </h2>
                  <p class="text-sm md:text-base text-slate-300 font-normal leading-relaxed max-w-2xl">
                    {slide.aciklama}
                  </p>
                  <div class="pt-4 flex flex-wrap items-center gap-4">
                    <a
                      href="#ticari-projeler"
                      class="inline-flex items-center gap-2 px-6 py-3 bg-white text-slate-900 text-xs md:text-sm font-semibold tracking-wider uppercase hover:bg-amber-500 hover:text-white transition-colors duration-200"
                    >
                      <span>Projeyi İncele</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>
                    <a
                      href="#kurumsal-teklif"
                      class="inline-flex items-center gap-2 px-6 py-3 border border-white/40 text-white text-xs md:text-sm font-semibold tracking-wider uppercase hover:bg-white/10 hover:border-white transition-colors duration-200"
                    >
                      <span>Projenizi Başlatın</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Slider Kontrolleri (Oklar & Göstergeler) -->
      <div class="absolute bottom-8 right-6 md:right-12 z-20 flex items-center gap-3">
        <button
          type="button"
          @click="activeSlide = (activeSlide - 1 + totalSlides) % totalSlides"
          class="w-10 h-10 rounded-full border border-white/30 bg-black/40 hover:bg-white hover:text-slate-900 text-white flex items-center justify-center transition-all duration-200 backdrop-blur-sm"
          aria-label="Önceki Proje"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <span class="text-xs font-mono tracking-widest text-white/80">
          <span x-text="String(activeSlide + 1).padStart(2, 0)"></span> / 10
        </span>
        <button
          type="button"
          @click="activeSlide = (activeSlide + 1) % totalSlides"
          class="w-10 h-10 rounded-full border border-white/30 bg-black/40 hover:bg-white hover:text-slate-900 text-white flex items-center justify-center transition-all duration-200 backdrop-blur-sm"
          aria-label="Sonraki Proje"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

      <!-- Çizgisel Slide İlerleme Çubukları -->
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-white/10 flex">
        {heroSlides.map((_, i) => (
          <div class="flex-1 h-full bg-white/20 relative overflow-hidden">
            <div
              class="h-full bg-amber-500 transition-all duration-300"
              :class={`activeSlide === ${i} ? w-full : w-0`}
            ></div>
          </div>
        ))}
      </div>
    </section>

    <!-- BÖLÜM 2: OSO MİMARLIK BİREBİR MANİFESTO VE ANA BAŞLIK -->
    <section class="py-20 md:py-24 border-b border-slate-200/80">
      <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
        <span class="inline-block text-xs font-semibold tracking-[0.3em] uppercase text-amber-700 bg-amber-50 border border-amber-200/60 px-4 py-1.5 rounded-full">
          MİMARİ TASARIM & FIT-OUT YÖNETİMİ
        </span>
        <h1 class="text-3xl md:text-5xl font-light text-slate-900 tracking-tight leading-snug">
          Mimarlık Ofisi ve İç Mimarlık Alanında <strong class="font-semibold text-slate-950">FIT-OUT Uygulama</strong> Hizmetleri
        </h1>
        <div class="w-16 h-1 bg-amber-500 mx-auto"></div>
        <p class="text-base md:text-lg text-slate-600 font-normal leading-relaxed text-justify md:text-center">
          Yeşilay Mimarlık; modern ve çağdaş mimarlık anlayışını estetik, işlevsel ve yaratıcı çözümlerle birleştirerek her ölçekte yenilikçi mekânlar tasarlar. Firmamız mimari – iç mimari tasarım ve projelendirme ile anahtar teslim (fit-out) uygulama hizmetleri sunar. Tasarımdan uygulamaya uzanan tüm süreçlerde detay odaklı yaklaşımı ve teknik uzmanlığıyla; ofis, mağaza, konut ve cafe-restoran gibi tüm ticari ve yaşam alanlarını konforlu, prestijli ve yüksek verimli hâle getiriyoruz.
        </p>
      </div>
    </section>

    <!-- BÖLÜM 3: 4 TEMEL DİREK (SIFIR KIRILMA, TAM HİZALI MİMARİ STANDART) -->
    <section class="py-20 md:py-28 bg-[#FAF9F6] border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8">

          <!-- 1. OFİS TASARIMLARI -->
          <div class="flex flex-col items-center text-center group">
            <div class="h-8 flex items-center justify-center mb-4">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 tracking-[0.1em] uppercase whitespace-nowrap">
                OFİS TASARIMLARI
              </h3>
            </div>
            
            <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full p-1 bg-white border border-slate-200 shadow-sm group-hover:shadow-md transition-all duration-300 flex items-center justify-center mb-6 shrink-0">
              <img 
                src="/images/projelendirme/icon-ofis.webp" 
                alt="Ofis Tasarımları" 
                class="w-full h-full object-contain rounded-full p-1"
                width="144"
                height="144"
                loading="lazy"
              />
            </div>

            <div class="h-12 flex items-center justify-center mb-4 px-2">
              <h4 class="text-[11px] font-bold text-slate-800 tracking-[0.12em] uppercase leading-tight">
                YENİLİKÇİ ÇALIŞMA ALANLARI
              </h4>
            </div>

            <div class="text-xs text-slate-600 leading-relaxed text-justify space-y-3 font-normal px-1">
              <p>Günümüz ofislerinde, mekânın şirket kurumsal kimliği ile uyumu ve çalışanların yüksek motivasyonu, verimlilik açısından büyük önem taşır. Bu doğrultuda modern çalışma kültürüne; estetik, işlevsellik ve kullanıcı memnuniyeti kazandırarak, yenilikçi ofis mekânları tasarlıyoruz.</p>
              <p>Aydınlatma, akustik konfor, malzeme seçimi ve yeni nesil ofis ihtiyaçlarını titizlikle ele alarak üretkenliği destekleyen bütüncül çözümler sunuyoruz.</p>
            </div>
          </div>

          <!-- 2. MAĞAZA TASARIMLARI -->
          <div class="flex flex-col items-center text-center group">
            <div class="h-8 flex items-center justify-center mb-4">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 tracking-[0.1em] uppercase whitespace-nowrap">
                MAĞAZA TASARIMLARI
              </h3>
            </div>
            
            <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full p-1 bg-white border border-slate-200 shadow-sm group-hover:shadow-md transition-all duration-300 flex items-center justify-center mb-6 shrink-0">
              <img 
                src="/images/projelendirme/icon-magaza.webp" 
                alt="Mağaza Tasarımları" 
                class="w-full h-full object-contain rounded-full p-1"
                width="144"
                height="144"
                loading="lazy"
              />
            </div>

            <div class="h-12 flex items-center justify-center mb-4 px-2">
              <h4 class="text-[11px] font-bold text-slate-800 tracking-[0.12em] uppercase leading-tight">
                MARKA KİMLİĞİNİ GÜÇLENDİREN ÇÖZÜMLER
              </h4>
            </div>

            <div class="text-xs text-slate-600 leading-relaxed text-justify space-y-3 font-normal px-1">
              <p>Perakende ve mağaza projelerinde tasarım; yalnızca ürün sergileme alanı oluşturmak değil, markanın hikâyesini ve değerlerini müşteriye hissettiren bir mekânsal deneyim kurgulamaktır. Doğru aydınlatma ve akıcı müşteri dolaşım hatlarıyla satış potansiyelini artıran çözümler üretiyoruz.</p>
              <p>Özel sergileme üniteleri ve işlevsel depolama kurgularıyla hem işletme verimliliğini hem de ziyaretçi bağlılığını en üst noktaya taşıyoruz.</p>
            </div>
          </div>

          <!-- 3. KONUT TASARIMLARI -->
          <div class="flex flex-col items-center text-center group">
            <div class="h-8 flex items-center justify-center mb-4">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 tracking-[0.1em] uppercase whitespace-nowrap">
                KONUT TASARIMLARI
              </h3>
            </div>
            
            <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full p-1 bg-white border border-slate-200 shadow-sm group-hover:shadow-md transition-all duration-300 flex items-center justify-center mb-6 shrink-0">
              <img 
                src="/images/projelendirme/icon-konut.webp" 
                alt="Konut Tasarımları" 
                class="w-full h-full object-contain rounded-full p-1"
                width="144"
                height="144"
                loading="lazy"
              />
            </div>

            <div class="h-12 flex items-center justify-center mb-4 px-2">
              <h4 class="text-[11px] font-bold text-slate-800 tracking-[0.12em] uppercase leading-tight">
                YAŞAM TARZINI YANSITAN ZAMANSIZ İÇ MEKÂNLAR
              </h4>
            </div>

            <div class="text-xs text-slate-600 leading-relaxed text-justify space-y-3 font-normal px-1">
              <p>Konut ve villa projelerinde, kullanıcıların kişisel zevklerini, yaşam alışkanlıklarını ve konfor beklentilerini tasarımın odağına yerleştiriyoruz. Her mekânın kendine özgü potansiyelini estetik ve fonksiyonellikle dengeliyoruz.</p>
              <p>Doğal ışık kullanımı, birinci sınıf malzeme dengesi ve özel imalat sabit mobilyalarla yaşam alanlarını uzun yıllar değerini koruyan yuvalara dönüştürüyoruz.</p>
            </div>
          </div>

          <!-- 4. CAFE-RESTORAN TASARIMLARI -->
          <div class="flex flex-col items-center text-center group">
            <div class="h-8 flex items-center justify-center mb-4">
              <h3 class="text-xs sm:text-sm font-bold text-slate-900 tracking-[0.1em] uppercase whitespace-nowrap">
                CAFE-RESTORAN TASARIMLARI
              </h3>
            </div>
            
            <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full p-1 bg-white border border-slate-200 shadow-sm group-hover:shadow-md transition-all duration-300 flex items-center justify-center mb-6 shrink-0">
              <img 
                src="/images/projelendirme/icon-cafe.webp" 
                alt="Cafe-Restoran Tasarımları" 
                class="w-full h-full object-contain rounded-full p-1"
                width="144"
