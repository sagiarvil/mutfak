---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İç Mimarlık Ofisi, Ticari Projelendirme & Fit-Out Uygulama | Yeşilay Mimarlık",
  description: "Ofis, mağaza, cafe-restoran ve lüks konutlar için mimari iç mekân tasarımı, 3D modelleme ve anahtar teslim fit-out uygulama hizmetleri. 3D tasarım ile şantiye teslimi arasında birebir uyum.",
  canonical: "https://yesilaymutfak.com/projelendirme/",
  serviceName: "Ticari Projelendirme ve Fit-Out İç Mimarlık",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Projelendirme & Fit-Out", url: "/projelendirme/" }
  ],
  faqList: [
    {
      question: "Ticari projelendirme ve fit-out uygulama süreci neleri kapsar?",
      answer: "Rölöve alımı, ihtiyaç programı analizi, konsept tasarım, fotogerçekçi 3D çizimler, elektrik-mekanik uygulama projeleri, kendi atölyemizde özel mobilya imalatı ve şantiyede anahtar teslim montajı kapsar."
    },
    {
      question: "AVM, plaza ve iş merkezlerinin gece çalışma kurallarına uyuluyor mu?",
      answer: "Evet. AVM ve kurumsal plazaların yangın yönetmelikleri, İSG mevzuatı ve mesai dışı gece çalışma kurallarına tam uyumlu sertifikalı ekiplerimizle kesintisiz şantiye yönetimi gerçekleştiriyoruz."
    },
    {
      question: "3D render çizimleri ile sahada tamamlanan gerçek mekân arasında fark olur mu?",
      answer: "Hayır. '3D Render vs Fit-Out' portföyümüzde kanıtlandığı üzere; kendi CNC ve boyahane atölyemizin üretim gücü sayesinde onaylanan 3D mimari model sahada birebir sadakatle hayata geçirilir."
    },
    {
      question: "Ticari projelerde sabit bütçe ve kesin teslim tarihi garantisi veriyor musunuz?",
      answer: "Evet. Noter onaylı resmi sözleşmemizde malzeme şartnamesi, sabit fiyat ve teslimatın geciktiği her gün için cezai nakit tazminat maddesi yer almaktadır."
    }
  ]
};

