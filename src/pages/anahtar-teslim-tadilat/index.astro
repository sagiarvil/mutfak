---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Anahtar Teslim Tadilat & İç Mimari Uygulama | 1984'ten Bugüne",
  description: "İzmir anahtar teslim daire ve villa tadilatı. Kadrolu mimar ve iç mimarlarımızla 3D sanal canlandırma, resmi sözleşmeli sabit fiyat, gecikme cezalı teslimat güvencesi.",
  canonical: "https://izmirmutfakbanyo.com.tr/anahtar-teslim-tadilat/",
  serviceName: "Anahtar Teslim Tadilat",
  breadcrumbs: [
    { name: "Anahtar Teslim Tadilat", url: "/anahtar-teslim-tadilat/" }
  ],
  faqList: [
    {
      question: "Anahtar teslim tadilatta hangi işler kapsama dahildir?",
      answer: "Kırım ve hafriyat, elektrik ve sıhhi tesisat yenileme, şap, su yalıtımı, asma tavan, alçı boya, seramik, lamine/derzli parke, özel imalat mutfak ve banyo dolapları, oda kapıları ve ince temizlik dahil oturuma hazır teslim edilir."
    },
    {
      question: "Sözleşmede gecikme cezası var mı?",
      answer: "Evet. 1984 yılından gelen kurumsal disiplinimizle imzaladığımız noter onaylı şeffaf sözleşmede teslim tarihi açıkça belirtilir. Mücbir sebepler haricindeki her gecikme günü için sözleşmede cezai şart taahhüt edilir."
    },
    {
      question: "İzmir'in hangi bölgelerinde anahtar teslim tadilat yapıyorsunuz?",
      answer: "Buca merkez showroom ve atölyemizden Konak, Bornova, Karşıyaka, Bayraklı, Karabağlar, Çiğli, Urla, Çeşme, Güzelbahçe dahil tüm 30 İzmir ilçesine yerinde ücretsiz mimari keşif ve anahtar teslim hizmeti veriyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Anahtar Teslim">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Anahtar Teslim Tadilat</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1984'TEN BUGÜNE 42 YILLIK TECRÜBE • 2.463+ TESLİM EDİLMİŞ PROJE
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İzmir Anahtar Teslim Tadilat, <br /><span class="font-normal italic">Tek Muhatap &amp; Sözleşmeli Güvence</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        1984'ten bu yana İzmir Buca showroomumuz ve imalat atölyemizle daire, villa ve iş yerlerini anahtar teslim yeniliyoruz. Kadrolu mimar ve iç mimarlarımızın hazırladığı 3D sanal canlandırma simülasyonuyla sürpriz riskini sıfırlıyor; şeffaf sözleşme, sabit fiyat ve gecikme cezası garantisiyle tek elden teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Keşif İste</span>
        </a>
        <a href="tel:05393333303" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0539 333 33 03
        </a>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1984</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">42 Yıllık Tecrübe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla konut ve villa projesinde resmi sözleşmeli teslimat.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar &amp; İç Mimar Yönetimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta arama stresine son; tüm şantiye kadrolu mimarımız tarafından yönetilir.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Mekan Deneyimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizi üretime girmeden fotogerçekçi canlandırmayla görüp sıfır riskle karar verin.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Showroom &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca merkez mağazamızdan tüm İzmir'e ücretsiz yerinde keşif ve ekspertiz.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GERÇEK UYGULAMA GALERİSİ -->
  <section class="py-20 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">TAMAMLANAN ANAHTAR TESLİM REFERANSLAR</span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          İzmir'de Teslim Ettiğimiz <br /><span class="font-normal italic">Komple Konut Dönüşümleri</span>
        </h2>
        <div class="w-12 h-0.5 bg-stone-900"></div>
        <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
          Kırım, tesisat, şap, elektrik, özel imalat mutfak/banyo mobilyaları ve dekoratif aydınlatmalarla A'dan Z'ye tamamlanan gerçek projelerimiz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80" alt="Urla Komple Villa Tadilatı" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Villa Renovasyonu</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Urla Kekliktepe Komple Villa Dönüşümü</h3>
            <p class="text-xs text-stone-500 font-light">3 katlı villada tesisat yenileme, ada mutfak, 4 banyo, şömine kaplama ve masif parke uygulaması.</p>
          </div>
        </div>

        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1000&q=80" alt="Bostanlı Daire Tadilatı" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Daire Renovasyonu</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Karşıyaka Bostanlı 3+1 Daire Tadilatı</h3>
            <p class="text-xs text-stone-500 font-light">Salon-mutfak birleştirme, lake iç kapılar, gizli LED tavan bandı ve ebeveyn banyo yenilemesi.</p>
          </div>
        </div>

        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1000&q=80" alt="Bornova Daire Yenileme" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Anahtar Teslim</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Bornova Evka-3 4+1 Daire Yenilemesi</h3>
            <p class="text-xs text-stone-500 font-light">Isıtma tesisatı, akrilik mutfak, 2 banyo seramik uygulaması ve 28 günde anahtar teslim.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3D CANLANDIRMA VE ŞEFFAF AŞAMALAR -->
  <section class="py-20 sm:py-24 bg-stone-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 block">SÜRECİNİZ ADIM ADIM GÜVENDE</span>
        <h2 class="text-3xl sm:text-4xl font-light tracking-tight font-editorial">
          Anahtar Teslim Tadilatta <br /><span class="font-normal italic">5 Adımlı Kusursuz Yönetim</span>
        </h2>
        <div class="w-12 h-0.5 bg-emerald-500"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        <div class="p-6 bg-stone-950 border border-stone-800 space-y-2">
          <span class="text-2xl font-black text-emerald-400">01</span>
          <h3 class="font-bold text-sm text-white">Yerinde Keşif &amp; Rölöve</h3>
          <p class="text-xs text-stone-400 font-light">Mimarımız evinize gelir, lazer metreyle milimetrik ölçüleri alır, ihtiyaçları listeler.</p>
        </div>
        <div class="p-6 bg-stone-950 border border-stone-800 space-y-2">
          <span class="text-2xl font-black text-emerald-400">02</span>
          <h3 class="font-bold text-sm text-white">3D Sanal Canlandırma</h3>
          <p class="text-xs text-stone-400 font-light">Evinizin bitmiş halini 3 boyutlu fotogerçekçi simülasyonla görür, renk ve malzemeleri seçersiniz.</p>
        </div>
        <div class="p-6 bg-stone-950 border border-stone-800 space-y-2">
          <span class="text-2xl font-black text-emerald-400">03</span>
          <h3 class="font-bold text-sm text-white">Resmi Sözleşme &amp; Sabit Fiyat</h3>
          <p class="text-xs text-stone-400 font-light">Tüm malzeme markaları, teslim tarihi ve gecikme cezası sözleşmeyle kilitlenir.</p>
        </div>
        <div class="p-6 bg-stone-950 border border-stone-800 space-y-2">
          <span class="text-2xl font-black text-emerald-400">04</span>
          <h3 class="font-bold text-sm text-white">Atölye İmalatı &amp; Şantiye</h3>
          <p class="text-xs text-stone-400 font-light">Kendi Buca atölyemizde dolaplar üretilirken mimarımız şantiye ustalarını her gün denetler.</p>
        </div>
        <div class="p-6 bg-stone-950 border border-stone-800 space-y-2">
          <span class="text-2xl font-black text-emerald-400">05</span>
          <h3 class="font-bold text-sm text-white">Temiz &amp; Eksiksiz Teslimat</h3>
          <p class="text-xs text-stone-400 font-light">Detaylı temizlik yapılır, mimari kabul tutanağı ile anahtarlarınız teslim edilir.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Anahtar Teslim Tadilat Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Evinizi Güvenle Yenilemek İçin Ücretsiz Keşif Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        Buca Showroomumuza bekliyoruz veya WhatsApp üzerinden iletişime geçin; kadrolu mimarımız adresinizde keşif ve 3D simülasyon randevunuzu oluştursun.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0539 333 33 03)
        </a>
      </div>
    </div>
  </section>

</Layout>
