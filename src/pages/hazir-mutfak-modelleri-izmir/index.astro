---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Hazır & Modüler Mutfak Modelleri İzmir | Ada Mutfaklar",
  description: "2026 hazır ve modüler mutfak dolabı modelleri. Ada mutfak, L ve U yerleşimler, gizli kulp tasarımları. İzmir Buca imalat atölyemizden hızlı teslimat ve bütçe dostu fabrika modelleri ve mimari tasarımları.",
  canonical: "https://yesilaymutfak.com/hazir-mutfak-modelleri-izmir/",
  serviceName: "Hazır ve Modüler Mutfak Modelleri",
  breadcrumbs: [
    { name: "Hazır Mutfak Modelleri", url: "/hazir-mutfak-modelleri-izmir/" }
  ],
  faqList: [
    {
      question: "Küçük veya ada mutfaklar için modüler hazır mutfak dolabı ölçü ve modelleri nasıldır?",
      answer: "Standart 40, 60 ve 80 cm modüllerimizle küçük mekanlarda maksimum depolama alanı sağlıyoruz. Ada mutfaklarda ise entegre kahvaltı barı ve kiler çekmeceleriyle estetik ve fonksiyonelliği birleştiriyoruz."
    },
    {
      question: "Hazır mutfak dolapları kaç günde teslim edilir?",
      answer: "Standart modüler dolaplarımız 3 ila 5 iş günü içerisinde hazırlanır ve adresinizde 1 günde monte edilir."
    },
    {
      question: "Hazır mutfaklarda hangi ray ve menteşe sistemleri kullanılır?",
      answer: "Hazır mutfaklarımızda dahi 1. sınıf MDF-Lam gövde ve Samet / Blum frenli menteşe-ray sistemleri kullanılmaktadır."
    }
  ]
};
---

<Layout seo={seo} activeService="Hazır Mutfak Modelleri">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, IŞIL IŞIL & AKRİLİK/LAKE LÜKS VİTRİN) -->
  <section class="relative bg-[#F8FAFC] border-b border-[#E2E8F0] py-12 sm:py-20 overflow-hidden">
    <!-- Kristal Ferahlık Işığı -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#EFF6FF]/50 to-transparent pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AKRİLİK & LAKE ZENGİNLİĞİ (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#041F14] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#1E3A8A] font-bold">Lüks Akrilik &amp; Lake Dolaplar</span>
          </nav>

          <!-- Prestij Rozeti -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#93C5FD] rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#2563EB]"></span>
            <span class="text-xs font-bold tracking-[0.16em] uppercase text-[#1E3A8A] font-sans">
              ÇİZİLMEZ AKRİLİK • PARLAK AYNA EFEKTİ &amp; MAT LAKE
            </span>
          </div>

          <!-- Ana Başlık (Işıltılı, Fonksiyonel & Temizliği Kolay Mutfaklar) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-extrabold text-[#0F172A] leading-[1.12] tracking-tight">
            Işıl Işıl Ayna Parlaklığı, <br />
            <span class="text-[#1E3A8A] font-serif font-normal italic">Çizilmeye Dirençli Akrilik &amp;</span> <br />
            <span class="text-[#041F14]">Fırınlanmış Lüks Lake Dolaplar.</span>
          </h1>

          <!-- Net & İkna Edici Açıklama -->
          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Mutfakta ferahlık arayanlar için derinlik katan cam gibi pürüzsüz yüzeyler. Yağ tutmaz, nemden kabarmaz, sararmaz ve silindiğinde anında ilk günkü pırıltısına döner. Buca atölyemizden hızlı teslimat ve montaj.
          </p>

          <!-- Kadınların Beğendiği 3 Fonksiyonel Özellik -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#E2E8F0] shadow-xs">
              <span class="text-[#1E3A8A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Çizilmez Antibakteriyel Yüzey</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#E2E8F0] shadow-xs">
              <span class="text-[#1E3A8A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Sıfır Nem &amp; Buhar Etkisi</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#E2E8F0] shadow-xs">
              <span class="text-[#1E3A8A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">15 İş Gününde Hızlı Montaj</span>
            </div>
          </div>

          <!-- Aksiyon Butonları -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905324261788?text=Merhaba%20Cem%20Bey,%20akrilik%20ve%20lake%20mutfak%20dolabı%20modelleriniz%20hakkında%20bilgi%20ve%20fiyat%20almak%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Hızlı Fiyat &amp; Çizim İste</span>
              <span>→</span>
            </a>
            <a 
              href="tel:02324411060" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#CBD5E1] text-[#0F172A] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>0232 441 1060</span>
            </a>
          </div>

        </div>

        <!-- SAĞ: AYDINLIK & YANSIYAN LÜKS AKRİLİK KARESI (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(30,58,138,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-16.webp" 
              alt="İzmir Lüks Akrilik & Lake Mutfak Dolabı Montajı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <!-- Zarif Alt Bilgi Şeridi -->
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] uppercase font-bold tracking-widest text-[#C5A880] block">CANLI MONTAJ REFERANSI</span>
              <p class="text-sm font-semibold text-white mt-0.5">Karşıyaka Mavişehir • Ultra Gloss Akrilik &amp; Kuvars Tezgah</p>
            </div>
            <!-- Rozet -->
            <div class="absolute top-4 right-4 px-3 py-1 bg-white/95 backdrop-blur-md rounded-full shadow-md border border-[#E2E8F0] text-[11px] font-bold text-[#1E3A8A]">
              1. Sınıf İtalyan Akrilik
            </div>
          </div>
        </div>

      </div>

      <!-- Alt Güvence Şeridi -->
      <div class="mt-12 pt-8 border-t border-[#E2E8F0] grid grid-cols-2 md:grid-cols-4 gap-6 text-center sm:text-left">
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#1E3A8A] font-sans">Ultra Parlak</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Işığı Yansıtan Genişletici Etki</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#041F14] font-sans">Kolay Temizlik</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Nemli Bezle Anında Tertemiz</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#C5A880] font-sans">Akıllı Kiler</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Maksimum Depolama Hacmi</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#006039] font-sans">Direkt Atölye</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Aracısız İmalatçı Fiyatı</span>
        </div>
      </div>

    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#006039] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880]">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Hazır &amp; Modüler Mutfak Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Modül Ölçüleri</strong>
          <p class="text-stone-600">Standart 40, 60, 80 cm Alt ve Üst Dolap Modülleri + Boy Kiler Dolabı.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Gövde &amp; Kapak</strong>
          <p class="text-stone-600">18 mm E1 Beyaz MDF-Lam Gövde, High-Gloss ve Membran Kapak Seçenekleri.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Menteşe ve Ray Sistemleri</strong>
          <p class="text-stone-600">Frenli Tandem Raylar ve Çift Yaylı Frenli Menteşeler.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Stoktan Hazırlık 3-5 İş Günü | 1 Günde Hızlı Montaj.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Binlerce modüler mutfak imalatı ve montaj tecrübesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">⚡</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3-5 Günde Teslimat</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Acil taşınma ve kiralık daireler için süper hızlı kurulum.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🛠️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Frenli Sağlam Mekanizma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Hazır mutfakta dahi 1. sınıf neme dayanıklı MDF gövde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca'dan 30 İlçeye</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden doğrudan nakliye ve montaj ekibi.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Hazır Mutfak Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#041F14]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Hızlı ve Ekonomik Çözüm İçin Bize Ulaşın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        Ölçülerinizi gönderin, mevcut modüllerimizi ve özel üretim mimari çözümlerimizi dakikalar içinde öğrenin.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20hazır%20mutfak%20modelleri%20hakkında%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile İletişime Geçin (0532 426 17 88)
        </a>
      </div>
    </div>
  </section>

</Layout>