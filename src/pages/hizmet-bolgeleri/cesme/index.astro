---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../data/siteConfig";

const seo = {
  title: "Çeşme & Alaçatı Villa Mutfak Tadilatı | Yeşilay Mutfak",
  description: "Çeşme, Alaçatı, Ilıca ve Dalyan'daki lüks villalara özel marin gövde mutfak dolapları, porselen tezgah ve komple yazlık tadilatı. Sezon öncesi gün garantili teslimat.",
  canonical: "https://yesilaymutfak.com/hizmet-bolgeleri/cesme/",
  serviceName: "Çeşme Villa Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Hizmet Bölgeleri", url: "/hizmet-bolgeleri/buca/" },
    { name: "Çeşme", url: "/hizmet-bolgeleri/cesme/" }
  ],
  faqList: [
    {
      question: "Çeşme ve Alaçatı'da yaz sezonu öncesi kesin teslimat garantisi veriyor musunuz?",
      answer: "Evet. Noter onaylı resmi sözleşmemizde teslim günü net olarak belirlenir ve gecikilen her takvim günü için müşterimize cezai nakit tazminat ödenir. Sezonu kaçırma riski sıfırdır."
    },
    {
      question: "Çeşme'deki yüksek deniz tuzu ve neme karşı hangi malzemeler kullanılır?",
      answer: "Gövdede %100 çift yüz neme dayanımlı yeşil marin MDF, menteşelerde korozyona dayanıklı Avusturya Blum donanım ve sararmayan UV filtreli fırın lake kapaklar kullanılır."
    },
    {
      question: "Çeşme'deki villamız için kırım, havuz başı banyo ve komple tadilat yapıyor musunuz?",
      answer: "Evet. Kırım, moloz tahliyesi, su yalıtımı, 60x120 ve 120x240 porselen seramik kaplama, banyo dolabı ve mutfak montajı tek elden iç mimar kontrolünde yürütülür."
    }
  ]
};
---

<Layout seo={seo} activeService="Çeşme Mutfak Tadilatı">
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('/media/real/yesilay-showroom-ic-mekan.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/hizmet-bolgeleri/cesme/" class="text-emerald-400">Çeşme & Alaçatı</a>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        ALAÇATI, ILICA, DALYAN & OVACIK VİLLA YENİLEME VE İMALAT
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Çeşme & Alaçatı Villa Mutfak Tadilatı: <br /><span class="font-normal italic">Sezon Öncesi Gün Garantili Lüks Renovasyon</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Alaçatı taş evleri ve Çeşme müstakil villaları için tuzlu sahil havasına dayanıklı yeşil marin MDF gövdeler, sararmayan fırın lake dolaplar ve gecikme tazminatlı sözleşmeyle anahtar teslim tadilat.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20Çeşme'deki%20villam%20için%20mutfak%20tadilatı%20keşfi%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Çeşme Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- TEKNİK KANIT VE BÖLGESEL ÇÖZÜMLER -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Çeşme Yarımadası Mühendislik Kriterleri</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Yüksek Nem ve Tuzlu Rüzgara <span class="font-bold italic">Mukavim Donanım</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Çeşme ikliminde kış aylarında kapalı kalan yazlıkların en büyük sorunu rutubet ve ahşap şişmesidir. Yeşilay Mutfak olarak gövdede çift yüzlü yeşil neme dayanımlı MDF ve fırın poliüretan lake kullanarak mutfaklarınızı 10 yıl boyunca ilk günkü formunda tutuyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">⏳</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Sezon Öncesi Kesin Teslim</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Yaz tatilinizi riske atmayan, resmi sözleşmede gün bazlı gecikme cezası içeren garantili şantiye takvimi.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🌊</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Korozyonsuz Blum Donanım</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Tuzlu deniz havasında paslanma yapmayan özel kaplamalı Avusturya Blum menteşe ve ray sistemleri.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">☀️</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Sararmayan UV Lake</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Çeşme'nin yoğun güneş ışığına karşı renk değiştirmeyen, sararmayan ve solmayan fırın lake teknolojisi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-light text-[#1D1D1F]" style="font-family: 'Playfair Display', Georgia, serif;">
          Çeşme Villa Mutfak Tadilatı <span class="font-bold">Sıkça Sorulan Sorular</span>
        </h2>
        <p class="text-xs text-[#6E675F]">Alaçatı ve Çeşme villa sahiplerinin en çok merak ettiği operasyonel detaylar.</p>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="p-5 bg-white border border-[#E5DFD5] space-y-2">
            <h3 class="text-sm font-bold text-[#1D1D1F]">{faq.question}</h3>
            <p class="text-xs text-[#6E675F] leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
