---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../data/siteConfig";

const seo = {
  title: "Buca Mutfak Tadilatı & Özel Ölçü Dolap İmalatı | Yeşilay Mutfak",
  description: "Buca'da kendi Adatepe atölyemizde imal edilen özel ölçü mutfak dolapları ve anahtar teslim mutfak-banyo tadilatı. Şirinyer, Buca Koop ve Gaziler'e doğrudan üretici fiyatı.",
  canonical: "https://yesilaymutfak.com/hizmet-bolgeleri/buca/",
  serviceName: "Buca Mutfak Tadilatı ve Dolap İmalatı",
  breadcrumbs: [
    { name: "Hizmet Bölgeleri", url: "/hizmet-bolgeleri/buca/" },
    { name: "Buca", url: "/hizmet-bolgeleri/buca/" }
  ],
  faqList: [
    {
      question: "Buca'da mutfak tadilatı ve yerinde keşif ücretsiz mi?",
      answer: "Evet. Buca Adatepe imalat atölyemiz ve Gaziler showroomumuz ilçemizde yer aldığından, tüm Buca mahallelerinde (Şirinyer, Buca Koop, Yıldız, Efeler vb.) lazer rölöve ve 3D iç mimari modelleme keşfi tamamen ücretsizdir."
    },
    {
      question: "Buca'daki eski apartman dairelerinde tesisat ve kırım dahil komple tadilat yapıyor musunuz?",
      answer: "Evet. Kırım, moloz atımı, sıhhi tesisat ve elektrik kablolama yenilemesi, seramik döşeme, porselen tezgah ve dolap montajı dahil anahtar teslim olarak yürütülür."
    },
    {
      question: "Buca'da dolap imalatında hangi gövde ve menteşe malzemesi kullanılır?",
      answer: "%100 18mm çift yüz E1 neme dayanıklı MDF-Lam gövde ve orijinal Avusturya Blum sessiz frenli mekanizmalar standart olarak kullanılır. Asla yonga levha (sunta) kullanılmaz."
    }
  ]
};
---

<Layout seo={seo} activeService="Buca Mutfak Tadilatı">
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('/media/real/yesilay-showroom-gece-cephe.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/hizmet-bolgeleri/buca/" class="text-emerald-400">Buca Mutfak & Tadilat</a>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        BUCA ADATEPE İMALAT ATÖLYESİ & GAZİLER SHOWROOM • DOĞRUDAN ÜRETİCİ
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Buca Mutfak Tadilatı & <br /><span class="font-normal italic">Özel Ölçü Lüks Mutfak Dolabı İmalatı</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        1998'den bu yana Buca'nın kendi yerli imalatçısı olarak, Şirinyer, Buca Koop, Gaziler ve tüm mahallelerdeki daireler için aracı komisyonsuz, doğrudan fabrika fiyatıyla özel ölçü mutfak dolabı ve anahtar teslim renovasyon hizmeti sunuyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20Buca'daki%20evim%20için%20mutfak%20tadilatı%20keşfi%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Buca Ücretsiz Keşif</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- TEKNİK KANIT VE BÖLGESEL ÇÖZÜMLER -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Bölgesel Mühendislik & Zanaat</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Buca'nın Yapı Stoğuna Özel <span class="font-bold italic">Akıllı Mekân Çözümleri</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Buca'daki 20-35 yıllık konutlarda karşılaşılan dar mutfak planları, taşıyıcı kolon/kiriş çıkıntıları ve eskiyen sıhhi tesisatlar için milimetrik lazer rölöve alıyor; kör noktaları 180 derece döner sepetler ve raylı kiler sistemleriyle değerlendiriyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🏭</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Adatepe İmalat Atölyesi</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Mobilyalarınız dışarıda fason ürettirilmez. Doğrudan Buca Adatepe'deki kendi CNC ve fırın boyahanemizde üretilerek birinci elden monte edilir.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">📐</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Fotogerçekçi 3D Çizim</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Eski mutfağınız kırılmadan önce, yeni dolaplarınızın, tezgahınızın ve zemin seramiklerinizin bitmiş halini 3 boyutlu sanal render ile görürsünüz.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">📝</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Resmi Sözleşme & Sabit Fiyat</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Teslim tarihi ve malzeme listesi resmi sözleşmeyle kilitlenir. Gecikilen her gün için cezai tazminat ödenir; sonradan ek maliyet çıkarılmaz.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-light text-[#1D1D1F]" style="font-family: 'Playfair Display', Georgia, serif;">
          Buca Mutfak Tadilatı <span class="font-bold">Sıkça Sorulan Sorular</span>
        </h2>
        <p class="text-xs text-[#6E675F]">Buca sakinlerinin en çok merak ettiği operasyonel detaylar.</p>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="p-5 bg-white border border-[#E5DFD5] space-y-2">
            <h3 class="text-sm font-bold text-[#1D1D1F]">{faq.question}</h3>
            <p class="text-xs text-[#6E675F] leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
