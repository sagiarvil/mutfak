---
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../data/siteConfig";

const seo = {
  title: "Urla Mutfak Tadilatı & Taş Ev Villa Mutfak Dolabı | Yeşilay Mutfak",
  description: "Urla, Kekliktepe ve İskele'de taş ev ve lüks villalara özel ahşap kaplama, lake mutfak dolapları ve komple ev tadilatı. 28 yıllık atölye zanaatı ve mimari taahhüt.",
  canonical: "https://yesilaymutfak.com/hizmet-bolgeleri/urla/",
  serviceName: "Urla Mutfak Tadilatı ve Dolap İmalatı",
  breadcrumbs: [
    { name: "Hizmet Bölgeleri", url: "/hizmet-bolgeleri/buca/" },
    { name: "Urla", url: "/hizmet-bolgeleri/urla/" }
  ],
  faqList: [
    {
      question: "Urla taş ev ve bağ villalarında hangi tarz mutfaklar önerilir?",
      answer: "Doğal meşe/ceviz kaplamalı masif detaylar, rustik country lake kapaklar ve porselen tezgahların harmanlandığı sıcak Ege mimarisine uygun mutfak tasarımları uyguluyoruz."
    },
    {
      question: "Urla'da kışın kapalı kalan evlerde rutubet ve neme karşı hangi gövde kullanılır?",
      answer: "Kışın havalandırılmayan veya denize yakın Urla konutlarında neme ve rutubete dayanıklı çift yüzlü yeşil marin MDF gövde ve paslanmaz menteşe donanımları kullanıyoruz."
    },
    {
      question: "Urla'da komple anahtar teslim taş ev renovasyonu yapıyor musunuz?",
      answer: "Evet. Taş duvar derz temizliği, sıhhi ve elektrik altyapısı, şömine çevresi ahşap giydirme, banyo ve mutfak dahil komple mimari renovasyon taahhüt ediyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Urla Mutfak Tadilatı">
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('/media/real/yesilay-showroom-ic-mekan.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <a href="/hizmet-bolgeleri/urla/" class="text-emerald-400">Urla & Kekliktepe</a>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        KEKLİKTEPE, İSKELE & ÇAMLIÇAY VİLLA VE TAŞ EV MİMARİSİ
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Urla Mutfak Tadilatı & <br /><span class="font-normal italic">Taş Ev ve Bağ Villası Özel İmalatı</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Urla'nın doğal dokusuna saygılı doğal ahşap kaplama, neoklasik lake ve geniş ada tezgah tasarımları. Kendi atölyemizde üretilen E1 marin MDF gövde ve Avusturya Blum donanımlarla Ege'nin havasına dayanıklı mutfaklar.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20Urla'daki%20evim%20için%20mutfak%20tadilatı%20keşfi%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Urla Keşif İste</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- TEKNİK KANIT VE BÖLGESEL ÇÖZÜMLER -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="text-[11px] font-black uppercase tracking-[0.2em] text-[#006039]">Urla Bölgesi Zanaat Standartları</div>
        <h2 class="text-2xl sm:text-4xl font-light text-[#1D1D1F] tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Doğal Taş ve Ahşabın <span class="font-bold italic">Kusursuz Uyumu</span>
        </h2>
        <p class="text-sm text-[#6E675F] leading-relaxed">
          Kekliktepe, Kalabak ve İskele bölgelerindeki müstakil yapılarda, yüksek tavanlar ve taş duvar boşluklarına özel milimetrik gömme kütüphane dolapları, ada mutfak üniteleri ve seramik döşemeler üretiyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🌿</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Doğal Ahşap & Meşe Kaplama</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Urla'nın rustik ve sakin atmosferine uygun doğal meşe hareleri, fırın mat koruyucu vernik ve parmak izi bırakmayan yüzeyler.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">💧</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Neme Dayanımlı Marin Gövde</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Kış mevsiminde kapalı kalan yazlıklarda rutubet kaynaklı şişme yapmayan çift kat E1 yeşil MDF gövde garantisi.
          </p>
        </div>
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] space-y-3">
          <div class="text-2xl">🔨</div>
          <h3 class="text-base font-bold text-[#1D1D1F]">Tek Elden Mimari Taahhüt</h3>
          <p class="text-xs text-[#6E675F] leading-relaxed">
            Elektrik-su tesisatı, zemin seramiği, mutfak ve banyo montajının tek muhatap iç mimar kontrolünde yürütülmesi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="py-16 bg-[#FAF9F6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-light text-[#1D1D1F]" style="font-family: 'Playfair Display', Georgia, serif;">
          Urla Mutfak Tadilatı <span class="font-bold">Sıkça Sorulan Sorular</span>
        </h2>
        <p class="text-xs text-[#6E675F]">Urla ve Kekliktepe konut sahiplerinin en çok sorduğu sorular.</p>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="p-5 bg-white border border-[#E5DFD5] space-y-2">
            <h3 class="text-sm font-bold text-[#1D1D1F]">{faq.question}</h3>
            <p class="text-xs text-[#6E675F] leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
