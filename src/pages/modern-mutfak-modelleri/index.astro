---
import Layout from "../../layouts/Layout.astro";

const seo = {
  title: "İzmir Modern Mutfak Modelleri | Kulpsuz & Gola Profil İmalat",
  description: "İzmir'de aracı olmadan doğrudan atölyeden modern mutfak dolabı imalatı. Kulpsuz gola profiller, monoblok mat lake ve akrilik kapaklar, Blum çekmeceler ve ücretsiz 3D sanal mekan çizimi.",
  canonical: "https://izmirmutfakbanyo.com.tr/modern-mutfak-modelleri/",
  serviceName: "Modern Mutfak Modelleri İmalatı",
  breadcrumbs: [
    { name: "Koleksiyonlar", url: "/#stretcher-section" },
    { name: "Modern Mutfak Modelleri", url: "/modern-mutfak-modelleri/" }
  ],
  faqList: [
    {
      question: "Kulpsuz gola profil mutfak dolapları kullanışlı mıdır?",
      answer: "Evet, elektrostatik fırın boyalı alüminyum C ve L tipi gola profiller parmak izi bırakmaz, dolap kapaklarının üst veya yan kısmından ergonomik kavrama sağlar ve mutfakta kesintisiz minimalist bir derinlik yaratır."
    },
    {
      question: "Modern mutfak dolaplarında hangi kapak malzemeleri kullanılır?",
      answer: "Çizilmeye dayanıklı İtalyan akrilik, parmak izi tutmayan ipek mat poliüretan lake ve doğal mat ahşap hareli kaplamalar tercih edilir. Tüm yüzeyler E1 normunda suya ve neme dirençli 18 mm MDF-Lam gövde üzerine işlenir."
    },
    {
      question: "Modern ada mutfak için minimum kaç metrekare alan gerekir?",
      answer: "Ada tipi bir mutfak yerleşimi için en az 12-14 m² alan önerilir. Ada etrafında rahat sirkülasyon sağlanabilmesi için dolaplar ile ada arasında minimum 90-110 cm geçiş mesafesi bırakılır."
    },
    {
      question: "İzmir genelinde ücretsiz keşif ve 3D çizim hizmetiniz var mı?",
      answer: "Evet, Buca'daki merkez mağazamızdan Karşıyaka, Bornova, Çeşme, Urla, Güzelbahçe dahil tüm 30 İzmir ilçesine kadrolu iç mimarlarımızla yerinde lazer ölçü ve fotogerçekçi 3D sanal canlandırma hizmeti sunuyoruz."
    }
  ]
};

const models = [
  {
    id: "aura-minimal",
    title: "Ege Aurası İpek Kaşmir Lake",
    badge: "En Çok Tercih Edilen",
    tag: "İpek Mat Lake & Füme Cam",
        img: "/media/projeler/proje-07.webp",
    desc: "Sıcak kaşmir gri tonların doğal meşe detaylarla buluştuğu monoblok tasarım. Gizli lineer LED aydınlatmalar ve füme reflekte camlı kiler modülüyle modern zarafetin zirvesi.",
    features: ["Antrasit C Gola Profil", "Blum Legrabox Frenli Çekmeceler", "Calacatta Kuvars Tezgah Entegre", "Gizli Bas-Aç Kiler"]
  },
  {
    id: "vetro-antrasit",
    title: "İmbat Mat Füme & Alüminyum Çerçeve",
    badge: "İtalyan Tasarım",
    tag: "Çizilmez Akrilik & Mat Siyah",
        img: "/media/projeler/proje-08.webp",
    desc: "Derin mat antrasit tonlar, parmak izi bırakmayan nano yüzey teknolojisi ve siyah eloksallı gola kulpsuz hatlar. Geniş pişirme adası ve tavan tipi ada davlumbaz entegrasyonu.",
    features: ["Çift Yüz Akrilik Kapak", "Hettich AvanTech You Raylar", "Porselen Monolit Ada Masası", "Entegre Çöp ve Geri Dönüşüm Ünitesi"]
  },
  {
    id: "calacatta-monolith",
    title: "Kordon Monoblok Porselen Ada Mutfak",
    badge: "Lüks Mimari Seri",
    tag: "Laminam Porselen & Doğal Ahşap",
        img: "/media/projeler/proje-09.webp",
    desc: "Tezgah ve ada yan panellerinin tek parça 12 mm İtalyan porselen ile sarıldığı yekpare monolit heykel formu. Gizli evye ve tezgaha sıfır indüksiyonlu ocak çözümü.",
    features: ["12 mm Isıya ve Çizilmeye Sıfır Porselen", "Elektrikli Servo-Drive Çekmeceler", "Akustik Ahşap Arka Panel", "Tavana Kadar 260 cm Boy Dolaplar"]
  },
  {
    id: "nordic-loft",
    title: "Yalı Doğal Meşe Minimalist Mutfak",
    badge: "Ferah & Doğal",
    tag: "Doğal Meşe Haresi & Mat Kar Beyaz",
        img: "/media/projeler/proje-10.webp",
    desc: "İskandinav sadeliğini İzmir'in aydınlık yaşam tarzıyla harmanlayan model. Doğal meşe kaplama alt dolaplar, tavana uzanan kesintisiz mat beyaz üst modüller.",
    features: ["Doğal Budaksız Meşe Kaplama", "Gizli LED Aydınlatma Kanalları", "Belenco Beyaz Kuvars Tezgah", "Kör Köşe Fasulye Mekanizması"]
  },
  {
    id: "graphite-pure",
    title: "Karşıyaka Mat Grafit Gola Mutfak",
    badge: "Yalın Geometri",
    tag: "Ultra Mat Grafit & Çelik Detaylar",
        img: "/media/projeler/proje-11.webp",
    desc: "Hiçbir kulp veya çıkıntının gözü yormadığı, fırın ve kahve makinelerinin boy dolap içine gömülü ankastre dizilimle çözüldüğü tam entegre mutfak mimarisi.",
    features: ["Anti-Fingerprint Lake Boya", "Tam Boy Kiler Boy Dolabı", "Gizli Evye Bataryası", "Blum Aventos HK Üst Kapak Mekanizması"]
  },
  {
    id: "linear-platinum",
    title: "Alsancak Boydan Boya Açık Plan Mutfak",
    badge: "Yeni 2026 Trendi",
    tag: "Çizgili Lake Panel & Ada Bar",
        img: "/media/projeler/proje-12.webp",
    desc: "Özel CNC dikey çizgili ada önü panelleri, geniş 4 kişilik yemek yeme ve oturma barı. Modern salonlarla doğrudan konuşan ferah ve akıcı yaşam hacmi.",
    features: ["CNC Dikey Oluklu Ada Paneli", "Entegre Priz ve USB Şarj Yuvaları", "Şarap ve Kadeh Askılık Modülü", "Kuvars Şelale Yan Dönüş Paneli"]
  }
];
---

<Layout seo={seo} activeService="Modern Mutfak Modelleri">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & KADINLARIN KALBİNİ FETHEDEN LÜKS SPLIT VİTRİN) -->
  <section class="relative bg-[#FBF9F5] border-b border-[#EAE5DC] py-12 sm:py-20 overflow-hidden">
    <!-- Yumuşak Aydınlık Arka Plan Işığı -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F5EFE6]/60 to-transparent pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, 5 SANİYEDE ANLAŞILIR, BÜYÜLEYİCİ MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#041F14] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#006039] font-bold">Modern Mutfak Modelleri</span>
          </nav>

          <!-- Prestij Rozeti -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#C5A880]/50 rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span class="text-xs font-bold tracking-[0.16em] uppercase text-[#041F14] font-sans">
              28 YILLIK ATÖLYE İMALATI • KULPSUZ GOLA & ADA MİMARİSİ
            </span>
          </div>

          <!-- Ana Başlık (Net, Okunabilir & Heyecan Uyandıran Lüks Tipografi) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-extrabold text-[#041F14] leading-[1.12] tracking-tight">
            Hayalinizdeki Ada Mutfak, <br />
            <span class="text-[#006039] font-serif font-normal italic">İpek Lake &amp; Porselen Zarafetiyle</span> <br />
            <span class="text-[#2B231D]">Evinizin Kalbi Oluyor.</span>
          </h1>

          <!-- Net & İkna Edici Açıklama -->
          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Kulpların yarattığı kalabalığı unutturan fırınlanmış gola profiller, parmak izi bırakmayan nanoteknolojik mat lake ve fısıltı sessizliğinde Blum çekmeceler. Buca Adatepe imalat atölyemizden aracısız, doğrudan evinize özel 3D projelendirme.
          </p>

          <!-- Kadınların En Çok Önemsediği 3 Kritik Detay -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#EAE5DC] shadow-xs">
              <span class="text-[#006039] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Leke &amp; Parmak İzi Tutmaz</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#EAE5DC] shadow-xs">
              <span class="text-[#006039] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Sessiz Blum Fren Sistemleri</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#EAE5DC] shadow-xs">
              <span class="text-[#006039] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">10 Yıl Sözleşmeli Garanti</span>
            </div>
          </div>

          <!-- Aksiyon Butonları (Cartier Altın & Prestij Zümrüt) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905324261788?text=Merhaba%20Cem%20Bey,%20modern%20ada%20mutfak%20modelleriniz%20hakkında%20bilgi%20ve%20ücretsiz%203D%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Ücretsiz 3D Keşif İste</span>
              <span>→</span>
            </a>
            <a 
              href="#modeller" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#041F14] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>Modelleri İncele ↓</span>
            </a>
          </div>

        </div>

        <!-- SAĞ: BÜYÜLEYİCİ, AYDINLIK & IŞIL IŞIL GERÇEK ADA MUTFAK SAHNESİ (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.15)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-05.webp" 
              alt="İzmir Modern Ada Mutfak ve Porselen Tezgah İmalatı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <!-- Zarif Alt Bilgi Şeridi -->
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] uppercase font-bold tracking-widest text-[#C5A880] block">CANLI MONTAJ REFERANSI</span>
              <p class="text-sm font-semibold text-white mt-0.5">Urla Kekliktepe • İpek Kaşmir Lake Ada Mutfak</p>
            </div>
            <!-- Canlı İmalat Rozeti -->
            <div class="absolute top-4 right-4 px-3 py-1 bg-white/95 backdrop-blur-md rounded-full shadow-md border border-[#EAE5DC] text-[11px] font-bold text-[#041F14]">
              %100 Öz Atölye Üretimi
            </div>
          </div>
        </div>

      </div>

      <!-- Alt Güvence Şeridi (4 Sütun Net İstatistik) -->
      <div class="mt-12 pt-8 border-t border-[#EAE5DC] grid grid-cols-2 md:grid-cols-4 gap-6 text-center sm:text-left">
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#006039] font-sans">28 Yıl</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Buca Atölye Tecrübesi</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#041F14] font-sans">Blum</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Orijinal Avusturya Donanım</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#C5A880] font-sans">3D Simülasyon</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Üretime Geçmeden Birebir Çizim</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#041F14] font-sans">Sözleşmeli</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Gecikme Cezalı Sabit Fiyat</span>
        </div>
      </div>

    </div>
  </section>

  <!-- TEKNİK PARAMETRELER VE MALZEME STANDARTLARI (AEO / LLM GROUNDING - PRO PREMİUM VİTRİN) -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="border-l-4 border-[#006039] pl-4 space-y-1.5">
        <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#C5A880]">MİMARİ SPESİFİKASYON</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#041F14] tracking-tight">Modern Mutfak İmalat Standartları &amp; Donanım Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <div class="flex items-center justify-between border-b border-[#EAE5DC] pb-2.5">
            <strong class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#041F14] group-hover:text-[#006039] transition">
              Kulpsuz Gola Sistemi
            </strong>
            <span class="w-2 h-2 rounded-full bg-[#00FF66] opacity-60 group-hover:opacity-100 transition"></span>
          </div>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">
            Eloksallı alüminyum yatay (C/L) ve boy dolaplar için dikey gola profilleri. Kapak arkasından ergonomik açılım sağlar, kulp gevşemesi ve çarpma riskini sıfırlar.
          </p>
        </div>

        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <div class="flex items-center justify-between border-b border-[#EAE5DC] pb-2.5">
            <strong class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#041F14] group-hover:text-[#006039] transition">
              Gövde &amp; Kapak Kalitesi
            </strong>
            <span class="w-2 h-2 rounded-full bg-[#00FF66] opacity-60 group-hover:opacity-100 transition"></span>
          </div>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">
            18 mm neme ve buhara dayanıklı E1 standardı MDF-Lam gövde. Kapaklarda UV ışınlarına karşı solmayan İtalyan Akrilik ve 4 kat fırınlı ipek mat poliüretan lake.
          </p>
        </div>

        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <div class="flex items-center justify-between border-b border-[#EAE5DC] pb-2.5">
            <strong class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#041F14] group-hover:text-[#006039] transition">
              Mekanizma &amp; Taşıma
            </strong>
            <span class="w-2 h-2 rounded-full bg-[#00FF66] opacity-60 group-hover:opacity-100 transition"></span>
          </div>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">
            Blum Legrabox ve Antaro 65 kg taşıma kapasiteli tam açılır senkronize raylar. Üst dolaplarda yukarı kalkan katlanır Aventos HF/HK mekanizmaları.
          </p>
        </div>

        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <div class="flex items-center justify-between border-b border-[#EAE5DC] pb-2.5">
            <strong class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#041F14] group-hover:text-[#006039] transition">
              Tezgah Entegrasyonu
            </strong>
            <span class="w-2 h-2 rounded-full bg-[#00FF66] opacity-60 group-hover:opacity-100 transition"></span>
          </div>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">
            Belenco, Çimstone, Silestone kuvars yüzeyler veya 12 mm sıfır gözenekli Laminam / Dekton porselen tezgahlar ile monolitik kusursuz birleşim.
          </p>
        </div>

        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <div class="flex items-center justify-between border-b border-[#EAE5DC] pb-2.5">
            <strong class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#041F14] group-hover:text-[#006039] transition">
              Aydınlatma &amp; Akustik
            </strong>
            <span class="w-2 h-2 rounded-full bg-[#00FF66] opacity-60 group-hover:opacity-100 transition"></span>
          </div>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">
            Dolap altı ve gola profili içine gömülü 3000K-4000K gizli lineer LED kanalları. Çekmecelerde sessiz hava freni sönümleyicileri.
          </p>
        </div>

        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <div class="flex items-center justify-between border-b border-[#EAE5DC] pb-2.5">
            <strong class="text-xs sm:text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#041F14] group-hover:text-[#006039] transition">
              Teslimat &amp; Montaj Taahhüdü
            </strong>
            <span class="w-2 h-2 rounded-full bg-[#00FF66] opacity-60 group-hover:opacity-100 transition"></span>
          </div>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">
            İzmir içi 15-21 iş gününde atölye imalatı, kendi kadrolu montaj ekibimizle 1-2 iş gününde tozsuz, temiz teslimat ve gecikme cezalı sözleşme.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ÖNE ÇIKAN MODELLER GALERİSİ -->
  <section class="py-20 sm:py-28 bg-white" id="modeller">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-emerald-600 block">2026 ÖZEL TASARIM SERİSİ</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          İlham Veren <span class="font-normal italic">Modern Mutfak Koleksiyonumuz</span>
        </h2>
        <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">
          Her biri İzmir evlerinin ışık ve mekan yapısına göre özel projelendirilen, mekanınızı genişleten ve yaşam kalitenizi artıran 6 özel model serimizi keşfedin.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {models.map((m) => (
          <div class="bg-stone-50 border border-stone-200 overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
            <div class="relative h-64 sm:h-72 overflow-hidden bg-stone-900">
              <img 
                src={m.img} 
                alt={`${m.title} - İzmir Modern Mutfak Modelleri`} 
                class="w-full h-full object-cover transition duration-700 group-hover:scale-105" 
                loading="lazy" 
                decoding="async"
                width="600"
                height="400"
              />
              <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                <span class="px-2.5 py-1 bg-stone-950/85 text-emerald-400 text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
