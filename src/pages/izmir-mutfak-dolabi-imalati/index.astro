---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Mutfak Dolabı İmalatı | Atölyeden Özel Ölçü",
  description: "İzmir'de aracı olmadan doğrudan Buca atölyemizden özel ölçü mutfak dolabı imalatı. 1. sınıf MDF-Lam gövde, Lake, Akrilik ve Ahşap kapaklar, Blum frenli raylar ve ücretsiz 3D çizim.",
  canonical: "https://yesilaymutfak.com/izmir-mutfak-dolabi-imalati/",
  serviceName: "Özel Ölçü Mutfak Dolabı İmalatı",
  breadcrumbs: [
    { name: "Mutfak Dolabı İmalatı", url: "/izmir-mutfak-dolabi-imalati/" }
  ],
  faqList: [
    {
      question: "İzmir'de mutfak dolabı imalatı ne kadar sürer?",
      answer: "Lazer ölçü alımı ve 3D projelendirmenin onaylanmasının ardından atölye üretim sürecimiz ortalama 15-21 iş günüdür. Montaj işlemi ise 1-2 gün içinde tamamlanır."
    },
    {
      question: "Mutfak dolabı özel imalat ve metretül ölçülendirmesi nasıl yapılır?",
      answer: "Tasarım detayları ve malzeme seçimi kapak türüne (Lake, Akrilik, Membran), ray/menteşe donanımına (frenli Blum sistemleri) ve tezgah malzemesine (Porselen, Belenco, Çimstone) göre metretül bazında hesaplanır."
    },
    {
      question: "Aracısız doğrudan atölye imalatı avantajı nedir?",
      answer: "Buca'daki kendi imalat atölyemizde ürettiğimiz için aracı komisyonu ödemezsiniz. 28 yıllık mimari ve tasarım ustalıkla en kaliteli malzemeleri en şeffaf mimari çizimlarla sunuyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Mutfak Dolabı İmalatı">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & CANLI SPLIT VİTRİN - DARK HERO YOK) -->
  <section class="relative bg-[#FBF9F5] border-b border-[#EAE5DC] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F5EFE6]/60 to-transparent pointer-events-none"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AYDINLIK & GÜVEN VEREN MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#083322] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#8C6D3F] font-bold">Mutfak Dolabı İmalatı</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#C5A880]/50 text-[#083322] text-[11px] font-bold tracking-[0.16em] uppercase rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span>28 YILLIK TECRÜBE • DOĞRUDAN ATÖLYEDEN İMALAT</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#083322] leading-[1.14] tracking-tight">
            İzmir'de Atölyeden Doğrudan <br />
            <span class="text-[#8C6D3F] font-serif font-normal italic">Özel Ölçü Mutfak Dolabı:</span> <br />
            <span class="text-[#2B231D]">İpek Lake &amp; Akrilik Zarafeti.</span>
          </h1>

          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            1998'den bu yana İzmir Buca Adatepe imalat atölyemizde kadrolu mimarlarımızla mutfak dolapları üretiyoruz. Lazerli rölöve, fotogerçekçi 3D mimari simülasyon ve resmi sözleşmeli net bütçe taahhüdü.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">İtalyan ICA Antibakteriyel Lake</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Orijinal Avusturya Blum Ray</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">10 Yıl Mekanik Garanti</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905324261788?text=Merhaba,%20özel%20ölçü%20mutfak%20dolabı%20için%20ücretsiz%203D%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile 3D Keşif İste</span>
              <span>→</span>
            </a>
            <a 
              href="tel:02324411060" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#083322] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              0232 441 1060
            </a>
          </div>
        </div>

        <!-- SAĞ: AYDINLIK İMALAT GÖRSELİ (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-01.webp" 
              alt="İzmir Özel Ölçü Lake Mutfak Dolabı İmalatı ve Montajı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#C5A880] block">ÖZEL ÖLÇÜ ÜRETİM</span>
              <p class="text-sm font-serif font-bold text-white mt-0.5">Buca Adatepe Atölyesi • Mat Lake & Ada Tezgah Çözümü</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
  </section>

  <!-- ===================================================================== -->
  <!-- AEO / LLM GROUNDING: İLK 14KB İÇİ TEKNİK PARAMETRE VE STANDARTLAR     -->
  <!-- ===================================================================== -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#006039] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880]">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Mutfak Dolabı İmalatı Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Gövde Malzemesi</strong>
          <p class="text-stone-600">E1 Normunda 18 mm Neme Dayanıklı Beyaz / Antrasit MDF-Lam (%100 Yoğun Mukavemet).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Kapak Seçenekleri</strong>
          <p class="text-stone-600">İtalyan Çizilmez Akrilik, Çift Yüz Poliüretan Lake Boya, Doğal Ahşap Meşe Kaplama, Membran.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Menteşe ve Ray Sistemleri</strong>
          <p class="text-stone-600">Blum Clip-Top / Hettich Frenli Ray Sistemleri (Ömür Boyu Paslanmazlık ve Çalışma Garantisi).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca (Tüm 30 İzmir İlçesi).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">İmalat 15-21 İş Günü | Yerinde Montaj 1-2 İş Günü (Taahhütlü ve Gecikme Cezalı).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme &amp; Deneyim</strong>
          <p class="text-stone-600">Kadrolu Mimar Eşliğinde Ücretsiz Yerinde Lazer Ölçü ve 3D Fotogerçekçi Simülasyon.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Ustalık</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş mutfak dolabı projesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📐</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar &amp; İç Mimar Kadrosu</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Milimetrik rölöve, ergonomik yerleşim ve sıfır boşluk.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Mekan Deneyimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Üretime girmeden önce fotogerçekçi canlandırmayla tam görsel kontrol.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Atölye &amp; Atölye</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Aracısız doğrudan atölye imalat güvencesiyle tüm 30 ilçeye ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GERÇEK FOTOĞRAFLAR GALERİSİ -->
  <section class="py-20 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">GERÇEK İMALAT VE UYGULAMA GALERİSİ</span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          İzmir Evlerinde Teslim Ettiğimiz <br /><span class="font-normal italic">Özel Mutfak Dolabı Projeleri</span>
        </h2>
        <div class="w-12 h-0.5 bg-stone-900"></div>
        <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
          Kendi atölyemizde ürettiğimiz lake, akrilik ve masif mutfakların kırım, tesisat, tezgah ve dolap montaj aşamalarından gerçek fotoğraflar.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1000&q=75&fm=webp" alt="Mavişehir Akrilik Ada Mutfak Dolabı" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-[#041F14]">Ada Mutfak &amp; Akrilik</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-[#041F14] text-sm">Karşıyaka Mavişehir Akrilik Ada Mutfak</h3>
            <p class="text-xs text-stone-500 font-light">Çizilmez akrilik kapak, Blum Legrabox raylar ve porselen ada tezgah.</p>
          </div>
        </div>

        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1556909212-d5b604d0c90d?auto=format&fit=crop&w=1000&q=75&fm=webp" alt="Alsancak İpek Mat Lake Mutfak" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-[#041F14]">İpek Mat Lake</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-[#041F14] text-sm">Alsancak Özel İmalat İpek Mat Lake</h3>
            <p class="text-xs text-stone-500 font-light">Poliüretan çift kat lake, pirinç kulp detayları ve gizli kiler dolabı.</p>
          </div>
        </div>

        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=75&fm=webp" alt="Urla Masif Meşe Mutfak" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-[#041F14]">Doğal Ahşap</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-[#041F14] text-sm">Urla Kekliktepe Doğal Meşe Kaplama</h3>
            <p class="text-xs text-stone-500 font-light">Marin kontrplak gövde, doğal damarlı meşe kapak ve Çimstone tezgah.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Özel İmalat Mutfak Dolabı Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#041F14]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Evinize Özel Mutfak Çizimini Ücretsiz Hazırlayalım</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp'tan yazın; kadrolu mimarımız evinize gelerek rölöve ve 3D çizim analizini hazırlasın.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20özel%20ölçü%20mutfak%20dolabı%20için%20ücretsiz%203D%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0532 426 17 88)
        </a>
      </div>
    </div>
  </section>

</Layout>