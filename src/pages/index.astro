---
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli
const featuredModels = tasarimlar.slice(0, 8);

const seo = {
  title: "Cem Yeşilay — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir Buca Adatepe atölyemizden kişiye ve mekâna özel projelendirilen akrilik, lake mutfak dolapları, lüks banyo renovasyonu ve anahtar teslim konut taahhüdü. 28 yıllık tecrübe, 137 tescilli model arşivi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "cem yeşilay luxury",
    "cem yeşilay mimarlık",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Koleksiyonumuzda özel nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklar kullanıyoruz. Yüzeyler parmak izi tutmaz, nemli mikro fiber bezle tek hamlede kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Mimarımız yerinde lazer rölöve aldıktan sonra evinizin ışık açısına uygun fotogerçekçi 3D mimari çizim hazırlar. Tezgah, kulp, zemin ve kapak renk uyumunu üretime geçmeden önce ekranınızda birebir görürsünüz."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya menşeili Blum ve Almanya menşeili Häfele entegre sessiz frenli raylar ve kiler sistemleri kullanıyoruz. Çekmeceler tek dokunuşla sessizce kapanır ve 10 yıl garantilidir."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken Cem Yeşilay'ı tercih etmenin somut avantajı nedir?",
      answer: "Aracı veya komisyoncu showroom olmadan doğrudan Buca Adatepe imalat atölyemizden birinci el fiyat alırsınız. Gövdede standart olarak neme mukavemetli 18mm E1 MDF-Lam ve Avusturya Blum mekanizma kullanılır. Resmi sözleşmemizde taahhüt edilen teslim tarihine sadakat garantisi ve gecikilen her takvim günü için cezai şart güvencesi sunulur."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi resmi noter onaylı gecikme cezalı sözleşmeyle yürütüyoruz. İmalat ve montaj ekibimiz montaj bitiminde detaylı temizlik yaparak alanınızı kullanıma hazır teslim eder."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. CANLI SİNEMATİK VİDEO HERO ALANI (SOLUK DEĞİL, PARLAK & CANLI)     -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-zinc-950 border-b border-zinc-800" style="min-height: 85vh;">
    
    <!-- Referans Video Arka Planı (Solukluk Giderildi, Canlılık Filtresi Eklendi) -->
    <div class="absolute inset-0 w-full h-full overflow-hidden">
      <video
        id="heroBgVideo"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster="/media/cinematic/home_video_photo.webp"
        class="w-full h-full object-cover scale-102 transition-transform duration-1000"
        style="filter: saturate(1.35) contrast(1.15) brightness(1.05);"
      >
        <source src="/media/cinematic/home_video.mp4" type="video/mp4" />
      </video>
      
      <!-- İnce ve Şık Kontrast Karartması (Videoyu boğmadan metni okutan modern mimari gradyan) -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-black/40"></div>
    </div>

    <!-- Hero İçerik (Koyu Cam Panel İle Kristal Netlikte Tipografi) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-16 sm:py-24 flex flex-col justify-center items-start min-h-[85vh] z-10">
      
      <div class="max-w-2xl bg-zinc-950/70 backdrop-blur-md p-6 sm:p-9 rounded-2xl border border-white/10 shadow-2xl space-y-6">
        
        <!-- Üst Rozet -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-zinc-900/90 text-amber-400 border border-amber-500/40 rounded-full shadow-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-bold tracking-[0.15em] uppercase font-sans">
            ADATEPE İMALAT ATÖLYESİ • <span class="text-white">28 YILLIK TECRÜBE</span>
          </span>
        </div>

        <!-- Ana Başlık (Plan Mutfak & Kurumsal Mimarlık Font Skalası) -->
        <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold text-white leading-[1.12] tracking-tight">
          Hayalinizdeki Mutfağı, <br />
          <span class="text-amber-400 font-serif font-normal italic">Kişiye Özel Çizgilerle</span> <br />
          <span class="text-zinc-100">Gerçeğe Dönüştürüyoruz.</span>
        </h1>

        <!-- Açıklama Metni -->
        <p class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed max-w-xl">
          Leke tutmayan nanoteknolojik ipek mat kapaklar, Avusturya Blum sessiz raylar, porselen tezgahlar ve kusursuz 3D mimari projelendirme. İzmir genelinde ücretsiz lazer keşif.
        </p>

        <!-- CTA Butonları (Yeşil Yerine Plan Mutfak Tarzı Koyu & Altın Kontrast) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-amber-600 hover:bg-amber-500 text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-md border border-amber-400 shadow-xl transition duration-200 flex items-center justify-center gap-2"
          >
            <span>WhatsApp ile 3D Keşif İste</span>
            <span>→</span>
          </a>
          <a 
            href="/tasarimlar/" 
            class="px-8 py-3.5 bg-white/10 hover:bg-white/20 text-white border border-white/30 text-xs sm:text-sm font-bold uppercase tracking-wider rounded-md backdrop-blur-sm transition duration-200 flex items-center justify-center gap-2"
          >
            <span>137 Tasarım Modelini İncele</span>
          </a>
        </div>

      </div>

      <!-- Sayaç Kartı (Ezilme ve Taşma Giderildi, Sağlam Grid) -->
      <div class="mt-8 sm:mt-10 w-full max-w-4xl bg-zinc-900/90 backdrop-blur-md border border-zinc-700 rounded-xl p-5 sm:p-6 shadow-2xl relative z-10 text-white">
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
          
          <!-- Sayaç 1: 137 Model -->
          <div class="space-y-1 sm:border-r border-zinc-700/80 pr-2">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-sans" data-target="137">0</span>
              <span class="text-xs sm:text-sm font-bold text-amber-400">Model</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-amber-400 font-bold">Özgün Koleksiyon</div>
            <p class="text-[11px] text-zinc-400 leading-snug hidden sm:block">Mutfak, banyo ve kapı arşivi.</p>
          </div>

          <!-- Sayaç 2: 28 Yıl -->
          <div class="space-y-1 md:border-r border-zinc-700/80 pr-2">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-amber-400 font-sans" data-target="28">0</span>
              <span class="text-xs sm:text-sm font-bold text-amber-400">Yıl</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-white font-bold">Atölye Mirası</div>
            <p class="text-[11px] text-zinc-400 leading-snug hidden sm:block">1998'den bu yana doğrudan imalat.</p>
          </div>

          <!-- Sayaç 3: 10 Yıl -->
          <div class="space-y-1 sm:border-r border-zinc-700/80 pr-2">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-sans" data-target="10">0</span>
              <span class="text-xs sm:text-sm font-bold text-amber-400">Yıl</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-amber-400 font-bold">Gövde Garantisi</div>
            <p class="text-[11px] text-zinc-400 leading-snug hidden sm:block">E1 sertifikalı çift yüz MDF.</p>
          </div>

          <!-- Sayaç 4: 2.850+ -->
          <div class="space-y-1">
            <div class="flex items-baseline gap-0.5">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-sans" data-target="2850" data-format="comma">0</span>
              <span class="text-xl sm:text-2xl font-extrabold text-amber-400">+</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-white font-bold">Tamamlanan Proje</div>
            <p class="text-[11px] text-zinc-400 leading-snug hidden sm:block">İzmir genelinde mutlu müşteri.</p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. ÖNCESİ & SONRASI (EVDEKOR TADİLAT REFERANSI İNTERAKTİF BÖLÜMÜ)     -->
  <!-- ===================================================================== -->
  <BeforeAfter />

  <!-- ===================================================================== -->
  <!-- 3. PLAN MUTFAK STİLİ 4-SÜTUNLU MİMARİ AVANTAJ KARTLARI               -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-slate-100 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700">MİMARİ KALİTE STANDARDI</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900">Neden Cem Yeşilay Mutfak?</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-10 h-10 rounded-lg bg-zinc-900 text-amber-400 flex items-center justify-center text-sm font-bold shadow-md">
            01
          </div>
          <h3 class="text-base font-bold text-zinc-900 tracking-tight">Leke Tutmayan Mat Yüzeyler</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake ve akrilik teknolojisi.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-10 h-10 rounded-lg bg-zinc-900 text-amber-400 flex items-center justify-center text-sm font-bold shadow-md">
            02
          </div>
          <h3 class="text-base font-bold text-zinc-900 tracking-tight">Kadife Sessizliğinde Blum Ray</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Avusturya menşeili entegre frenli mekanizmalar ile dolap kapakları ve çekmeceler daima sessizce kapanır.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-10 h-10 rounded-lg bg-zinc-900 text-amber-400 flex items-center justify-center text-sm font-bold shadow-md">
            03
          </div>
          <h3 class="text-base font-bold text-zinc-900 tracking-tight">3D Çizimle Birebir Önizleme</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Evinizin ölçülerine özel fotogerçekçi 3D mimari modelleme ile renkleri ve kulpları önceden görün.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-10 h-10 rounded-lg bg-zinc-900 text-amber-400 flex items-center justify-center text-sm font-bold shadow-md">
            04
          </div>
          <h3 class="text-base font-bold text-zinc-900 tracking-tight">Sözleşmeli Süre & Sabit Fiyat</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Sürpriz masraf çıkarmayan resmi sözleşme, gecikme cezası garantisi ve temiz, tertipli montaj teslimi.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. SEÇKİN MODEL KOLEKSİYONU (PLAN MUTFAK MODEL VİTRİNİ)              -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- Başlık & Buton -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-gray-200 pb-6">
        <div class="space-y-1.5">
          <span class="text-xs uppercase font-bold tracking-[0.14em] text-amber-700 block">
            ÖZEL İMALAT KOLEKSİYONU
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight">
            Öne Çıkan Mimari Modellerimiz
          </h2>
        </div>
        <div>
          <a href="/tasarimlar/" class="px-6 py-2.5 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold uppercase tracking-wider rounded-md transition shadow-md inline-block">
            Tüm 137 Modeli Gör →
          </a>
        </div>
      </div>

      <!-- Kategori Filtre Butonları -->
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/tasarimlar/" class="px-4 py-2 bg-zinc-900 text-white font-bold rounded-md">Tümü (137 Model)</a>
        <a href="/tasarimlar/?kategori=mutfak" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-semibold rounded-md border border-gray-300 transition">Mutfak Tasarımları (40)</a>
        <a href="/tasarimlar/?kategori=kapilar" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-semibold rounded-md border border-gray-300 transition">Özel Kapılar (39)</a>
        <a href="/tasarimlar/?kategori=gomme-dolap" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-semibold rounded-md border border-gray-300 transition">Giyinme Odası (33)</a>
        <a href="/tasarimlar/?kategori=banyo" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-semibold rounded-md border border-gray-300 transition">Lüks Banyo (25)</a>
      </div>

      <!-- Simetrik Model Grid'i (Kırılma yok, aspect-square) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredModels.map((item) => (
          <div class="group bg-white border border-gray-200 hover:border-zinc-900 rounded-xl overflow-hidden flex flex-col justify-between apple-card transition duration-300">
            
            <div class="relative w-full aspect-square overflow-hidden bg-zinc-100 shrink-0">
              <img 
                src={item.img} 
                alt={item.altText || item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-zinc-900/90 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider rounded border border-zinc-700">
                {item.modelNo}
              </span>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1">
                <span class="text-[10.5px] uppercase tracking-wider font-bold text-amber-700 block">
                  {item.category}
                </span>
                <h3 class="text-sm font-bold text-zinc-900 group-hover:text-amber-700 transition line-clamp-2 leading-snug">
                  {item.title}
                </h3>
              </div>
              
              <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-zinc-500 font-medium">Özel Ölçü Üretim</span>
                <a 
                  href={`https://wa.me/905353748329?text=Merhaba%20Cem%20Bey,%20${item.modelNo}%20kodlu%20modeliniz%20hakkında%20bilgi%20ve%20ücretsiz%203D%20keşif%20istiyorum.`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-3 py-1 bg-zinc-900 hover:bg-zinc-800 text-white rounded font-bold text-[11px] transition flex items-center gap-1"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Alt Buton -->
      <div class="text-center pt-4">
        <a href="/tasarimlar/" class="inline-block px-8 py-3.5 bg-slate-100 hover:bg-zinc-200 text-zinc-900 border border-gray-300 text-xs font-bold uppercase tracking-wider rounded-md transition shadow-xs">
          137 Model Arşivinin Tamamını Görüntüle
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. MİMARİ HİZMETLERİMİZ (PLAN MUTFAK & EVDEKOR TADİLAT YAPISI)        -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-slate-100 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="max-w-2xl space-y-2">
        <span class="text-xs uppercase font-bold tracking-widest text-amber-700 block">MİMARİ HİZMETLERİMİZ</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight">
          Evinizin Her Detayına Özel Mühendislik
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Hizmet 1 -->
        <div class="bg-white border border-gray-200 hover:border-zinc-900 rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between group transition duration-300">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-white bg-zinc-900 px-3 py-1 rounded inline-block">
              MUTFAK İMALATI
            </span>
            <h3 class="text-base font-bold text-zinc-900 tracking-tight group-hover:text-amber-700 transition">Özel Ölçü Lüks Mutfak Dolabı</h3>
            <p class="text-xs text-zinc-600 font-normal leading-relaxed">
              İpek mat lake, İtalyan akrilik ve masif ahşap kapaklar. Mekanınıza milimetrik oturan ergonomik dolap sistemleri.
            </p>
          </div>
          <a href="/izmir-mutfak-dolabi-imalati/" class="text-xs font-bold text-zinc-900 hover:text-amber-700 inline-flex items-center gap-1 pt-2">
            <span>Hizmeti İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 2 -->
        <div class="bg-white border border-gray-200 hover:border-zinc-900 rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between group transition duration-300">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-white bg-zinc-900 px-3 py-1 rounded inline-block">
              RENOVASYON
            </span>
            <h3 class="text-base font-bold text-zinc-900 tracking-tight group-hover:text-amber-700 transition">Komple Mutfak Renovasyonu</h3>
            <p class="text-xs text-zinc-600 font-normal leading-relaxed">
              Kırım, su tesisatı, elektrik altyapısı, porselen veya kuvars tezgah dahil A'dan Z'ye anahtar teslim mutfak dönüşümü.
            </p>
          </div>
          <a href="/izmir-komple-mutfak-tadilati/" class="text-xs font-bold text-zinc-900 hover:text-amber-700 inline-flex items-center gap-1 pt-2">
            <span>Hizmeti İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 3 -->
        <div class="bg-white border border-gray-200 hover:border-zinc-900 rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between group transition duration-300">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-white bg-zinc-900 px-3 py-1 rounded inline-block">
              ISLAK HACİM
            </span>
            <h3 class="text-base font-bold text-zinc-900 tracking-tight group-hover:text-amber-700 transition">Lüks Banyo & Seramik</h3>
            <p class="text-xs text-zinc-600 font-normal leading-relaxed">
              Çift kat sürme izolasyon güvencesi, 60x120 İtalyan porselen seramik, gömme armatürler ve marin banyo mobilyaları.
            </p>
          </div>
          <a href="/izmir-banyo-yenileme-seramik/" class="text-xs font-bold text-zinc-900 hover:text-amber-700 inline-flex items-center gap-1 pt-2">
            <span>Hizmeti İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 4 -->
        <div class="bg-white border border-gray-200 hover:border-zinc-900 rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between group transition duration-300">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-white bg-zinc-900 px-3 py-1 rounded inline-block">
              ANAHTAR TESLİM
            </span>
            <h3 class="text-base font-bold text-zinc-900 tracking-tight group-hover:text-amber-700 transition">Komple Daire & Villa Renovasyonu</h3>
            <p class="text-xs text-zinc-600 font-normal leading-relaxed">
              Çeşme, Urla ve İzmir genelinde iç kapılar, zemin parke, aydınlatma ve boya dahil tek muhatap garantili lüks renovasyon.
            </p>
          </div>
