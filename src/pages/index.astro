---
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";
import yapilanIsler from "../data/yapilanIslerData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli ve 8 canlı yapılan iş
const featuredModels = tasarimlar.slice(0, 8);
const featuredWorks = yapilanIsler.slice(0, 8);

const seo = {
  title: "Cem Yeşilay — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir Buca Adatepe atölyemizden kişiye ve mekâna özel projelendirilen akrilik, lake mutfak dolapları, lüks banyo renovasyonu ve anahtar teslim konut taahhüdü. 28 yıllık tecrübe, 137 tescilli model arşivi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "cem yeşilay luxury",
    "cem yeşilay mimarlık",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklarımız parmak izi tutmaz, kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Yerinde lazer rölöve sonrası fotogerçekçi 3D mimari çizim hazırlar, üretime geçmeden önce birebir onayınıza sunarız."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya Blum ve Almanya Häfele entegre frenli sessiz mekanizmalar kullanılır."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken Cem Yeşilay'ı tercih etmenin somut avantajı nedir?",
      answer: "Showroom komisyonsuz doğrudan Adatepe imalat atölyesi birinci el fiyatı, 18mm E1 MDF gövde ve resmi gecikme cezalı sözleşme güvencesi sunuyoruz."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi noter onaylı gecikme cezalı sözleşmeyle yürütür, montaj bitiminde temiz kullanıma hazır teslim ederiz."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. SİNEMATİK PREMİUM VİDEO HERO (%100 DOĞAL IŞIK, SIFIR SARILIK/KIRMIZILIK) -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-[#041910] border-b border-[#0D3826]" style="min-height: 85vh;">
    
    <!-- Referans Video Arka Planı (Tamamen Doğal Ham Işık & Nötr Mimari Denge) -->
    <div class="absolute inset-0 w-full h-full overflow-hidden">
      <video
        id="heroBgVideo"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster="/media/cinematic/home_video_photo.webp"
        class="w-full h-full object-cover scale-102 transition-transform duration-1000"
        style="filter: contrast(1.02) brightness(1.02) saturate(0.92);"
      >
        <source src="/media/cinematic/home_video.mp4" type="video/mp4" />
      </video>
      
      <!-- Aydınlık & Netlik Sağlayan İnce Nötr Gölgeleme (Renklendirme ve Sararma Yok) -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/45 via-black/15 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
    </div>

    <!-- Hero İçerik (Tamamen Şeffaf, Ferah & Videonun Aurasını Ön Plana Çıkaran Lüks Tipografi) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-16 sm:py-24 flex flex-col justify-center items-start min-h-[85vh] z-10">
      
      <div class="max-w-3xl space-y-6 [text-shadow:_0_2px_14px_rgba(0,0,0,0.85)]">
        
        <!-- Üst Prestij Rozeti -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-black/40 backdrop-blur-md text-[#C5A880] border border-[#C5A880]/40 rounded-full shadow-lg">
          <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
          <span class="text-xs font-bold tracking-[0.16em] uppercase font-sans">
            ADATEPE İMALAT ATÖLYESİ • <span class="text-white">28 YIL</span>
          </span>
        </div>

        <!-- Ana Başlık (İzmir İç Mimarlık & Anahtar Teslim Tadilat) -->
        <div class="space-y-3">
          <h1 class="text-3xl sm:text-5xl lg:text-[56px] font-extrabold text-white leading-[1.08] tracking-tight drop-shadow-2xl uppercase">
            İzmir İç Mimarlık ve <br />
            <span class="text-[#C5A880] font-serif font-normal italic lowercase first-letter:uppercase">Anahtar Teslim Tadilat</span>
          </h1>
          <div class="inline-block py-1 px-3 bg-black/40 backdrop-blur-md border-l-4 border-[#C5A880] rounded-r text-sm sm:text-lg md:text-xl font-semibold text-white tracking-wide drop-shadow-md">
            Ev • Villa • Ofis • Mağaza İç Mimarlık ve Tadilat Hizmetleri
          </div>
        </div>

        <!-- Rafine Kısa Açıklama -->
        <p class="text-sm sm:text-base text-[#F0EAE1] font-light leading-relaxed max-w-xl drop-shadow-md">
          Özel imalat lüks mutfak, banyo, giyinme odası ve komple mekan renovasyonu. Avusturya Blum sessiz donanımlar, nanoteknolojik mat lake ve mimari 3D projelendirme.
        </p>

        <!-- CTA Butonları (Cartier Altın & Ferah Şeffaf Cam) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded border border-[#E5C378] shadow-2xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <span>WhatsApp ile 3D Keşif İste</span>
            <span>→</span>
          </a>
          <a 
            href="/tasarimlar/" 
            class="px-8 py-3.5 bg-black/40 hover:bg-black/60 text-white border border-white/30 text-xs sm:text-sm font-semibold uppercase tracking-wider rounded backdrop-blur-md transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <span>137 Tasarım Modeli</span>
          </a>
        </div>

      </div>

      <!-- Sayaç Kartı (Ultra Şeffaf, Zarif & Kristal Glassmorphic Konsol) -->
      <div class="mt-8 sm:mt-12 w-full max-w-4xl bg-black/40 backdrop-blur-2xl border border-white/20 rounded-2xl p-5 sm:p-7 shadow-[0_20px_50px_rgba(0,0,0,0.45)] relative z-10 text-white overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-[1.5px] before:bg-gradient-to-r before:from-transparent before:via-[#C5A880] before:to-transparent">
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
          
          <div class="space-y-1 sm:border-r border-white/15 pr-3 sm:pr-4">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-extrabold tracking-tight text-white font-serif sm:font-sans leading-none drop-shadow-sm" data-target="137">0</span>
              <span class="text-xs sm:text-sm font-bold text-[#C5A880] font-sans">Model</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#C5A880] font-bold">Özgün Koleksiyon</div>
            <div class="text-[10.5px] text-[#D8D2C7] font-light hidden sm:block">1:1 Özel İmalat</div>
          </div>

          <div class="space-y-1 md:border-r border-white/15 pr-3 sm:pr-4">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-extrabold tracking-tight text-white font-serif sm:font-sans leading-none drop-shadow-sm" data-target="28">0</span>
              <span class="text-xs sm:text-sm font-bold text-[#C5A880] font-sans">Yıl</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#C5A880] font-bold">Atölye Mirası</div>
            <div class="text-[10.5px] text-[#D8D2C7] font-light hidden sm:block">Buca Adatepe 1998</div>
          </div>

          <div class="space-y-1 sm:border-r border-white/15 pr-3 sm:pr-4">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-extrabold tracking-tight text-white font-serif sm:font-sans leading-none drop-shadow-sm" data-target="10">0</span>
              <span class="text-xs sm:text-sm font-bold text-[#C5A880] font-sans">Yıl</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#C5A880] font-bold">Gövde Garantisi</div>
            <div class="text-[10.5px] text-[#D8D2C7] font-light hidden sm:block">Avusturya Blum Ray</div>
          </div>

          <div class="space-y-1">
            <div class="flex items-baseline gap-0.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-extrabold tracking-tight text-white font-serif sm:font-sans leading-none drop-shadow-sm" data-target="2850" data-format="comma">0</span>
              <span class="text-2xl sm:text-3xl font-extrabold text-[#C5A880] font-sans">+</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#C5A880] font-bold">Tamamlanan Proje</div>
            <div class="text-[10.5px] text-[#D8D2C7] font-light hidden sm:block">İzmir & Ege Genelinde</div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. ÖNCESİ & SONRASI (EVDEKOR TADİLAT REFERANSI DÖNÜŞÜM MODÜLÜ)        -->
  <!-- ===================================================================== -->
  <BeforeAfter />

  <!-- ===================================================================== -->
  <!-- 3. MİMARİ STANDARTLAR (GLOBAL LUXURY GALLERY STANDARDI - AYDINLIK & NET) -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAFAF8] border-b border-[#EBE6DD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-14 space-y-2.5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-white border border-[#C5A880]/50 rounded-full shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
          <span class="text-[11px] font-bold uppercase tracking-[0.22em] text-[#8C6D3F]">MİMARİ KALİTE STANDARDI</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-[#083322] font-serif tracking-tight">
          Neden Cem Yeşilay Atölyesi?
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 font-light max-w-xl mx-auto">
          28 yıllık zanaat tecrübesi, Avusturya ve İtalya menşeili birinci sınıf hammadde güvencesi.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- KART 01: MAT LAKE -->
        <div class="group bg-white border border-[#E5DFD5] hover:border-[#C5A880] rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)] flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A880] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-[#F0EBE2]">
              <div class="w-11 h-11 rounded-full bg-[#FAF7F2] border border-[#C5A880]/60 text-[#8C6D3F] flex items-center justify-center group-hover:bg-[#083322] group-hover:text-[#C5A880] group-hover:border-[#083322] transition-all duration-300 shadow-xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <span class="font-serif text-xl font-bold tracking-wider text-[#C5A880]/70 group-hover:text-[#C5A880] transition">
                01
              </span>
            </div>

            <div class="pt-4 space-y-1.5">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#C5A880] block font-sans">
                İTALYAN LAKE
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#083322] tracking-tight group-hover:text-[#8C6D3F] transition">
                Leke Tutmayan Mat Yüzeyler
              </h3>
              <p class="text-xs sm:text-[13px] text-zinc-600 font-normal leading-relaxed">
                Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake kapak teknolojisi.
              </p>
            </div>
          </div>

          <div class="pt-4 mt-5 border-t border-[#F0EBE2] flex items-center justify-between text-[11px] font-medium text-zinc-700">
            <span class="inline-flex items-center gap-1.5 text-[#8C6D3F]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
              İtalyan ICA & Milesi
            </span>
            <span class="text-[9.5px] uppercase font-bold tracking-wider text-[#8C6D3F] bg-[#FAF7F2] border border-[#C5A880]/30 px-2 py-0.5 rounded">
              İPEK MAT
            </span>
          </div>
        </div>

        <!-- KART 02: BLUM RAY -->
        <div class="group bg-white border border-[#E5DFD5] hover:border-[#C5A880] rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)] flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A880] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-[#F0EBE2]">
              <div class="w-11 h-11 rounded-full bg-[#FAF7F2] border border-[#C5A880]/60 text-[#8C6D3F] flex items-center justify-center group-hover:bg-[#083322] group-hover:text-[#C5A880] group-hover:border-[#083322] transition-all duration-300 shadow-xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <span class="font-serif text-xl font-bold tracking-wider text-[#C5A880]/70 group-hover:text-[#C5A880] transition">
                02
              </span>
            </div>

            <div class="pt-4 space-y-1.5">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#C5A880] block font-sans">
                AVUSTURYA MEKANİK
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#083322] tracking-tight group-hover:text-[#8C6D3F] transition">
                Kadife Sessizliğinde Blum Ray
              </h3>
              <p class="text-xs sm:text-[13px] text-zinc-600 font-normal leading-relaxed">
                Orijinal Avusturya Blum entegre frenli raylar ve kiler sistemleri ile 10 yıl mekanik garanti.
              </p>
            </div>
          </div>

          <div class="pt-4 mt-5 border-t border-[#F0EBE2] flex items-center justify-between text-[11px] font-medium text-zinc-700">
            <span class="inline-flex items-center gap-1.5 text-[#8C6D3F]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
              Blum Legrabox
            </span>
            <span class="text-[9.5px] uppercase font-bold tracking-wider text-[#8C6D3F] bg-[#FAF7F2] border border-[#C5A880]/30 px-2 py-0.5 rounded">
              10 YIL
            </span>
          </div>
        </div>

        <!-- KART 03: 3D PROJELENDİRME -->
        <div class="group bg-white border border-[#E5DFD5] hover:border-[#C5A880] rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)] flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A880] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-[#F0EBE2]">
              <div class="w-11 h-11 rounded-full bg-[#FAF7F2] border border-[#C5A880]/60 text-[#8C6D3F] flex items-center justify-center group-hover:bg-[#083322] group-hover:text-[#C5A880] group-hover:border-[#083322] transition-all duration-300 shadow-xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="font-serif text-xl font-bold tracking-wider text-[#C5A880]/70 group-hover:text-[#C5A880] transition">
                03
              </span>
            </div>

            <div class="pt-4 space-y-1.5">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#C5A880] block font-sans">
                3D MİMARİ MODELLEME
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#083322] tracking-tight group-hover:text-[#8C6D3F] transition">
                3D Fotogerçekçi Projelendirme
              </h3>
              <p class="text-xs sm:text-[13px] text-zinc-600 font-normal leading-relaxed">
                Evinizin lazer ölçülerine göre renk, kulp ve ışık uyumunu üretime girmeden ekranda birebir görün.
              </p>
            </div>
          </div>

          <div class="pt-4 mt-5 border-t border-[#F0EBE2] flex items-center justify-between text-[11px] font-medium text-zinc-700">
            <span class="inline-flex items-center gap-1.5 text-[#8C6D3F]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#C5A880]"></span>
              Milimetrik Lazer Keşif
            </span>
            <span class="text-[9.5px] uppercase font-bold tracking-wider text-[#8C6D3F] bg-[#FAF7F2] border border-[#C5A880]/30 px-2 py-0.5 rounded">
              ÜCRETSİZ
            </span>
          </div>
        </div>

        <!-- KART 04: SÖZLEŞMELİ TESLİM -->
        <div class="group bg-white border border-[#E5DFD5] hover:border-[#C5A880] rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)] flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#C5A880] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-[#F0EBE2]">
              <div class="w-11 h-11 rounded-full bg-[#FAF7F2] border border-[#C5A880]/60 text-[#8C6D3F] flex items-center justify-center group-hover:bg-[#083322] group-hover:text-[#C5A880] group-hover:border-[#083322] transition-all duration-300 shadow-xs">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <span class="font-serif text-xl font-bold tracking-wider text-[#C5A880]/70 group-hover:text-[#C5A880] transition">
                04
              </span>
            </div>

            <div class="pt-4 space-y-1.5">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#C5A880] block font-sans">
                RESMİ TAAHHÜT
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-[#083322] tracking-tight group-hover:text-[#8C6D3F] transition">
                Sözleşmeli Teslim & Sabit Fiyat
              </h3>
              <p class="text-xs sm:text-[13px] text-zinc-600 font-normal leading-relaxed">
                Sürpriz masraf çıkarmayan resmi sözleşme, gecikme cezası garantisi ve temiz montaj teslimi.
              </p>
            </div>
          </div>

          <div class="pt-4 mt-5 border-t border-[#F0EBE2] flex items-center justify-between text-[11px] font-medium text-zinc-700">
