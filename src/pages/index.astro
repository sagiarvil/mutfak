---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli
const featuredModels = tasarimlar.slice(0, 8);

const seo = {
  title: "Cem Yeşilay — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir Buca Adatepe atölyemizden kişiye ve mekâna özel projelendirilen akrilik, lake mutfak dolapları, lüks banyo renovasyonu ve anahtar teslim konut taahhüdü. 28 yıllık tecrübe, 137 tescilli model arşivi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "cem yeşilay luxury",
    "cem yeşilay mimarlık",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Koleksiyonumuzda özel nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklar kullanıyoruz. Yüzeyler parmak izi tutmaz, nemli mikro fiber bezle tek hamlede kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Mimarımız yerinde lazer rölöve aldıktan sonra evinizin ışık açısına uygun fotogerçekçi 3D mimari çizim hazırlar. Tezgah, kulp, zemin ve kapak renk uyumunu üretime geçmeden önce ekranınızda birebir görürsünüz."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya menşeili Blum ve Almanya menşeili Häfele entegre sessiz frenli raylar ve kiler sistemleri kullanıyoruz. Çekmeceler tek dokunuşla sessizce kapanır ve 10 yıl garantilidir."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken Cem Yeşilay Luxury'yi tercih etmenin somut avantajı nedir?",
      answer: "Aracı veya komisyoncu showroom olmadan doğrudan Buca Adatepe imalat atölyemizden birinci el fiyat alırsınız. Gövdede standart olarak neme mukavemetli 18mm E1 MDF-Lam ve Avusturya Blum mekanizma kullanılır. Resmi sözleşmemizde taahhüt edilen teslim tarihine sadakat garantisi ve gecikilen her takvim günü için cezai şart güvencesi sunulur."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi resmi noter onaylı gecikme cezalı sözleşmeyle yürütüyoruz. İmalat ve montaj ekibimiz montaj bitiminde detaylı temizlik yaparak alanınızı kullanıma hazır teslim eder."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. APPLE MİMARİSİ HERO ALANI & SİNEMATİK VİDEO                       -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-[#FAF9F6] border-b border-[#E5DFD5]" style="min-height: 88vh;">
    
    <!-- Referans Video Arka Planı -->
    <div class="absolute inset-0 w-full h-full">
      <video
        id="heroBgVideo"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster="/media/cinematic/home_video_photo.webp"
        class="w-full h-full object-cover opacity-85 scale-102 transition-transform duration-1000"
      >
        <source src="/media/cinematic/home_video.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-t from-[#FAF9F6] via-[#FAF9F6]/45 to-black/35"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#FAF9F6]/95 via-[#FAF9F6]/75 to-transparent"></div>
    </div>

    <!-- Hero İçerik (Apple Typography Scale) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-20 sm:py-28 flex flex-col justify-center items-start min-h-[88vh] z-10">
      <div class="max-w-2xl space-y-6">
        
        <!-- Apple Capsule Eyebrow -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 bg-white/95 backdrop-blur-xl border border-[#D2D2D7] rounded-full shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-[#8B1E2D]"></span>
          <span class="text-[#1D1D1F] text-[11px] font-semibold tracking-[0.14em] uppercase font-sans">
            ADATEPE İMALAT ATÖLYESİ • 28 YILLIK TECRÜBE
          </span>
        </div>

        <!-- Apple Headline (SF Pro Display Scale: 44px - 60px) -->
        <h1 class="text-[38px] sm:text-[52px] lg:text-[60px] font-bold text-[#1D1D1F] leading-[1.08] tracking-[-0.03em]">
          Hayalinizdeki Mutfağı, <br />
          <span class="font-normal italic text-[#006039]">Kişiye Özel Çizgilerle</span> <br />
          <span class="font-medium text-[#282421]">Gerçeğe Dönüştürüyoruz.</span>
        </h1>

        <!-- Apple Subhead (17px, line-height 1.5) -->
        <p class="text-[16px] sm:text-[17px] text-[#424245] font-normal leading-[1.5] max-w-xl tracking-[-0.01em]">
          Leke tutmayan ipek mat kapaklar, fırçalanmış pirinç detaylar, kadife sessizliğinde Blum raylar ve ferahlatıcı mimari planlama. İzmir genelinde ücretsiz 3D keşif.
        </p>

        <!-- Apple Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white text-[13px] font-semibold tracking-[-0.01em] rounded-full shadow-[0_4px_14px_rgba(0, 96, 57,0.3)] transition duration-200 flex items-center justify-center gap-2"
          >
            <span>WhatsApp ile 3D Keşif İste</span>
            <span>→</span>
          </a>
          <a 
            href="/tasarimlar/" 
            class="px-8 py-3.5 bg-white hover:bg-[#F5F5F7] text-[#1D1D1F] border border-[#D2D2D7] text-[13px] font-semibold tracking-[-0.01em] rounded-full shadow-2xs transition duration-200 flex items-center justify-center gap-2"
          >
            <span>137 Tasarım Modelini İncele</span>
          </a>
        </div>

      </div>

      <!-- Genişletilmiş Premium Hareketli Sayaç Docku (Apple Glassmorphism Standartı) -->
      <div class="mt-10 sm:mt-12 w-full max-w-5xl bg-white/90 backdrop-blur-md border border-[#E5DFD5] rounded-2xl p-6 sm:p-7 shadow-[0_12px_36px_rgba(0, 96, 57,0.06)] relative overflow-hidden">
        <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-[#006039]/5 rounded-full blur-2xl pointer-events-none"></div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 relative z-10">
          
          <!-- Sayaç 1: 137 Model -->
          <div class="space-y-1 pr-3 sm:border-r border-[#E5DFD5]/80">
            <div class="flex items-baseline gap-1.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="137">0</span>
              <span class="text-sm sm:text-base font-bold text-[#C5A880]">Model</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#C5A880] font-bold">Özgün Koleksiyon</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">Mutfak, banyo ve kapı arşivi.</p>
          </div>

          <!-- Sayaç 2: 28 Yıl -->
          <div class="space-y-1 pr-3 lg:border-r border-[#E5DFD5]/80">
            <div class="flex items-baseline gap-1.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="28">0</span>
              <span class="text-sm sm:text-base font-bold text-[#006039]">Yıl</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#006039] font-bold">Atölye Mirası</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">1998'den bu yana kendi imalatımız.</p>
          </div>

          <!-- Sayaç 3: 10 Yıl -->
          <div class="space-y-1 pr-3 sm:border-r border-[#E5DFD5]/80">
            <div class="flex items-baseline gap-1.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="10">0</span>
              <span class="text-sm sm:text-base font-bold text-[#C5A880]">Yıl</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#C5A880] font-bold">Gövde Garantisi</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">E1 sertifikalı nem mukavemetli MDF.</p>
          </div>

          <!-- Sayaç 4: 2.850+ -->
          <div class="space-y-1">
            <div class="flex items-baseline gap-0.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="2850" data-format="comma">0</span>
              <span class="text-2xl sm:text-3xl font-extrabold text-[#006039]">+</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#006039] font-bold">Tamamlanan Proje</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">İzmir genelinde mutlu müşteri referansı.</p>
          </div>

        </div>

        <!-- AEO & Grounding Micro Bar -->
        <div class="mt-5 pt-3.5 border-t border-[#E5DFD5]/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11.5px] text-[#55504A]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#8B1E2D] animate-pulse"></span>
            <span><strong>Adatepe İmalat Atölyesi:</strong> Aracı komisyonsuz, milimetrik lazer rölöve ve fotogerçekçi 3D mimari modelleme.</span>
          </div>
          <a href="/tasarimlar/" class="text-[#006039] font-bold hover:underline inline-flex items-center gap-1 shrink-0">
            Koleksiyonu İncele →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. APPLE 4-SÜTUNLU MİMARİ AVANTAJ KARTLARI                           -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F4F1EA] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="p-6 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded-full bg-[#F4F1EA] border border-[#D2D2D7] flex items-center justify-center text-sm font-bold text-[#006039]">
            01
          </div>
          <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight">Leke Tutmayan Mat Yüzeyler</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
            Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake ve akrilik teknolojisi.
          </p>
        </div>

        <div class="p-6 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded-full bg-[#F4F1EA] border border-[#D2D2D7] flex items-center justify-center text-sm font-bold text-[#006039]">
            02
          </div>
          <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight">Kadife Sessizliğinde Blum Ray</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
            Avusturya menşeili entegre frenli mekanizmalar ile dolap kapakları ve çekmeceler daima sessizce kapanır.
          </p>
        </div>

        <div class="p-6 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded-full bg-[#F4F1EA] border border-[#D2D2D7] flex items-center justify-center text-sm font-bold text-[#006039]">
            03
          </div>
          <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight">3D Çizimle Birebir Önizleme</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
            Evinizin ölçülerine özel fotogerçekçi 3D mimari modelleme ile renkleri ve kulpları önceden görün.
          </p>
        </div>

        <div class="p-6 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded-full bg-[#F4F1EA] border border-[#D2D2D7] flex items-center justify-center text-sm font-bold text-[#006039]">
            04
          </div>
          <h3 class="text-[16px] font-semibold text-[#1D1D1F] tracking-tight">Sözleşmeli Süre & Sabit Fiyat</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
            Sürpriz masraf çıkarmayan resmi sözleşme, gecikme cezası garantisi ve temiz, tertipli montaj teslimi.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. %100 KARE VE SİMETRİK GÖRSEL VİTRİNİ (APPLE PHOTO GRID)          -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- Apple Section Header (36px - 40px) -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#E5DFD5] pb-6">
        <div class="space-y-1.5">
          <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">
            ÖZEL İMALAT KOLEKSİYONU
          </span>
          <h2 class="text-[32px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-[-0.025em]">
            Öne Çıkan Mimari Modellerimiz
          </h2>
        </div>
        <div class="flex items-center gap-3">
          <a href="/tasarimlar/" class="px-6 py-2.5 bg-[#006039] hover:bg-[#00482B] text-white text-[12px] font-semibold tracking-[-0.01em] rounded-full transition shadow-xs">
            Tüm 137 Modeli Gör →
          </a>
        </div>
      </div>

      <!-- Kategori Filtre Butonları -->
      <div class="flex flex-wrap gap-2 text-[12px]">
        <a href="/tasarimlar/" class="px-4 py-2 bg-[#006039] text-white font-medium rounded-full">Tümü (137 Model)</a>
        <a href="/tasarimlar/?kategori=mutfak" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Mutfak Tasarımları (40)</a>
        <a href="/tasarimlar/?kategori=kapilar" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Özel Kapılar (39)</a>
        <a href="/tasarimlar/?kategori=gomme-dolap" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Giyinme Odası (33)</a>
        <a href="/tasarimlar/?kategori=banyo" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Lüks Banyo (25)</a>
      </div>

      <!-- %100 KARE VE SİMETRİK GRID (aspect-square & hizada kartlar) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredModels.map((item) => (
          <div class="group bg-white border border-[#E5DFD5] rounded-xl overflow-hidden flex flex-col justify-between apple-card">
            
            <!-- KARE GÖRSEL KAPSAYICI (aspect-square: 100% simetrik, taşma yok) -->
            <div class="relative w-full aspect-square overflow-hidden bg-[#F5F5F7] shrink-0">
              <img 
                src={item.img} 
                alt={item.altText || item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-white/90 backdrop-blur-md text-[#1D1D1F] text-[10px] font-semibold uppercase tracking-wider rounded-md border border-[#D2D2D7]/80 shadow-2xs">
                {item.modelNo}
              </span>
            </div>

            <!-- Bilgi Alanı (Kusursuz Eşit Yükseklik & Tipografi) -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1">
                <span class="text-[11px] uppercase tracking-wider font-semibold text-[#C5A880] block">
                  {item.category}
                </span>
                <h3 class="text-[14px] font-semibold text-[#1D1D1F] group-hover:text-[#006039] transition line-clamp-2 leading-snug tracking-tight">
                  {item.title}
                </h3>
              </div>
              
              <div class="pt-3 border-t border-[#E5DFD5] flex items-center justify-between text-[12px]">
                <span class="text-[#86868B]">Özel Ölçü Üretim</span>
                <a 
                  href={`https://wa.me/905353748329?text=Merhaba%20Cem%20Bey,%20${item.modelNo}%20kodlu%20modeliniz%20hakkında%20bilgi%20ve%20ücretsiz%203D%20keşif%20istiyorum.`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[#006039] font-semibold hover:underline flex items-center gap-1"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Alt Buton -->
      <div class="text-center pt-4">
        <a href="/tasarimlar/" class="inline-block px-10 py-3.5 bg-white hover:bg-[#F5F5F7] text-[#1D1D1F] border border-[#D2D2D7] text-[13px] font-semibold tracking-tight rounded-full shadow-2xs transition">
          137 Model Arşivinin Tamamını Görüntüle
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. APPLE BENTO HİZMET BLOKLARI                                       -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#F4F1EA] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="max-w-2xl space-y-2">
        <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">MİMARİ HİZMETLERİMİZ</span>
        <h2 class="text-[32px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-tight">
          Evinizin Her Detayına Özel Mühendislik
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Hizmet 1 -->
        <div class="bg-white border border-[#E5DFD5] rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#006039] bg-[#F4F1EA] px-2.5 py-1 rounded-md inline-block">
              MUTFAK
            </span>
            <h3 class="text-[17px] font-semibold text-[#1D1D1F] tracking-tight">Özel Ölçü Lüks Mutfak Dolabı</h3>
            <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
              İpek mat lake, İtalyan akrilik ve masif ahşap kapaklar. Mekanınıza milimetrik oturan ergonomik dolap sistemleri.
            </p>
          </div>
          <a href="/izmir-mutfak-dolabi-imalati/" class="text-[13px] font-semibold text-[#006039] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 2 -->
        <div class="bg-white border border-[#E5DFD5] rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#006039] bg-[#F4F1EA] px-2.5 py-1 rounded-md inline-block">
              RENOVASYON
            </span>
            <h3 class="text-[17px] font-semibold text-[#1D1D1F] tracking-tight">Komple Mutfak Renovasyonu</h3>
            <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
              Kırım, su tesisatı, elektrik altyapısı, porselen veya kuvars tezgah dahil A'dan Z'ye anahtar teslim mutfak dönüşümü.
            </p>
          </div>
          <a href="/izmir-komple-mutfak-tadilati/" class="text-[13px] font-semibold text-[#006039] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 3 -->
        <div class="bg-white border border-[#E5DFD5] rounded-xl p-6 space-y-4 apple-card flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#006039] bg-[#F4F1EA] px-2.5 py-1 rounded-md inline-block">
              ISLAK HACİM
            </span>
            <h3 class="text-[17px] font-semibold text-[#1D1D1F] tracking-tight">Lüks Banyo & Seramik</h3>
            <p class="text-[13px] text-[#6E675F] font-normal leading-[1.45]">
              Çift kat sürme izolasyon güvencesi, 60x120 İtalyan porselen seramik, gömme armatürler ve marin banyo mobilyaları.
            </p>
