  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // Hero video otonom ve kesintisiz oynatma garantisi (iOS / Safari / Chrome Low-Power Safe)
      const heroVid = document.getElementById("heroBgVideo");
      if (heroVid) {
        heroVid.muted = true;
        heroVid.defaultMuted = true;
        const tryPlay = () => {
          heroVid.play().catch(() => {
            // Autoplay kısıtlaması durumunda ilk dokunuşta başlat
            document.body.addEventListener("touchstart", () => heroVid.play(), { once: true });
            document.body.addEventListener("click", () => heroVid.play(), { once: true });
          });
        };
        if (heroVid.readyState >= 2) {
          tryPlay();
        } else {
          heroVid.addEventListener("loadeddata", tryPlay, { once: true });
        }
      }

      const counters = document.querySelectorAll(".stat-counter");
      if (!counters.length) return;

      let animated = false;
      const animateCounters = () => {
        if (animated) return;
        animated = true;

        counters.forEach((counter) => {
          const target = parseInt(counter.getAttribute("data-target") || "0", 10);
          const format = counter.getAttribute("data-format");
          const duration = 1800;
          const startTime = performance.now();

          const updateCount = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Ease out cubic
            const easeProgress = 1 - Math.pow(1 - progress, 3);
            const currentVal = Math.floor(easeProgress * target);

            if (format === "comma") {
              counter.textContent = currentVal.toLocaleString("tr-TR");
            } else {
              counter.textContent = currentVal.toString();
            }

            if (progress < 1) {
              requestAnimationFrame(updateCount);
            } else {
              if (format === "comma") {
                counter.textContent = target.toLocaleString("tr-TR");
              } else {
                counter.textContent = target.toString();
              }
            }
          };

          requestAnimationFrame(updateCount);
        });
      };

      // Anında ve pürüzsüz animasyon tetikleme (hero alanında doğrudan çalışır)
      setTimeout(() => {
        animateCounters();
      }, 350);
    });
  </script>

