---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "Plan Mutfak Tarzı Lüks Mutfak Tasarımı, Banyo & Dekorasyon | İzmir Mutfak Banyo",
  description: "İzmir mutfak tasarım, dekorasyon, tadilat ve modüler mutfak sistemleri. 28 yıllık deneyim ile kişiye özel lake ve akrilik mutfak dolapları, lüks banyo ve anahtar teslim tadilat.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "İzmir Mutfak Banyo & Tasarım",
  keywords: [
    "izmir mutfak tasarım",
    "izmir mutfak dekorasyon",
    "izmir mutfak tadilat",
    "izmir modüler mutfak",
    "izmir mutfak dolap modelleri",
    "izmir hazır mutfak",
    "izmir mutfak firmaları",
    "banyo dolap modelleri",
    "izmir banyo dekorasyon",
    "izmir kapı"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında hangi malzemeleri tercih ediyorsunuz?",
      answer: "İpek mat lake, İtalyan akrilik, doğal masif meşe kaplama ve neme dayanıklı 18mm MDF gövde kullanıyoruz."
    },
    {
      question: "Tasarım aşamasında 3D çizim hizmeti veriyor musunuz?",
      answer: "Evet, evinize gelip milimetrik lazer rölöve alıyor ve fotogerçekçi 3D mimari çizimi ücretsiz olarak hazırlıyoruz."
    },
    {
      question: "Teslimat ve montaj süreniz nedir?",
      answer: "Sözleşmeli süre taahhüdü veriyoruz. İmalat atölyemizde hazırlanan dolaplar belirlenen günde 1 günde monte edilir."
    }
  ]
};

// Plan Mutfak Tarzı 3 Ana Hizmet Kartı
const mainCategories = [
  {
    title: "Mutfak Tasarımı",
    desc: "Kişiye ve mekana özel ada mutfaklar, modern lake ve akrilik dolap sistemleri.",
    img: "/media/showcase/mutfak-calacatta-hero.webp",
    link: "/tasarimlar/?kategori=mutfak",
    btn: "MUTFAK MODELLERİ"
  },
  {
    title: "Banyo Dekorasyonu",
    desc: "Suya tam dayanıklı marin banyo dolapları, doğal taş ve lüks duşakabin çözümleri.",
    img: "/media/showcase/banyo-arduvaz-luks.png",
    link: "/tasarimlar/?kategori=banyo",
    btn: "BANYO MODELLERİ"
  },
  {
    title: "Kapı & Giyinme Odası",
    desc: "Özel tasarım iç oda kapıları, cam bölmeli LED aydınlatmalı giyinme odaları.",
    img: "/media/showcase/gardirob-fume-led.webp",
    link: "/tasarimlar/?kategori=kapilar",
    btn: "KAPI & GİYİNME ODASI"
  }
];

// Plan Mutfak Tarzı Öne Çıkan Modeller Vitrini
const vitrinModeller = [
  {
    title: "Calacatta Şelale Ada Mutfak",
    sub: "İtalyan Doğal Mermer & İpek Mat Lake",
    img: "/media/showcase/mutfak-calacatta-hero.webp",
    badge: "ADA MUTFAK"
  },
  {
    title: "Panoramik Havuz Cepheli Ada",
    sub: "Vizon Akrilik & Gizli Tavan Aydınlatması",
    img: "/media/showcase/mutfak-havuz-ada.webp",
    badge: "VİLLA PROJESİ"
  },
  {
    title: "Country Masif Ahşap Mutfak",
    sub: "Doğal Ahşap Tezgah & Rustik Çizgiler",
    img: "/media/showcase/mutfak-country-ada.png",
    badge: "COUNTRY"
  },
  {
    title: "Modern Minimalist Ada Mutfak",
    sub: "Çizgisel Tasarım & Gizli Kulp Sistemi",
    img: "/media/showcase/mutfak-minimal-ada.webp",
    badge: "MODERN"
  },
  {
    title: "Doğal Taş & Arduvaz Lüks Banyo",
    sub: "Marin Ahşap Tezgah & Füme Cam Kabin",
    img: "/media/showcase/banyo-arduvaz-luks.png",
    badge: "LÜKS BANYO"
  },
  {
    title: "Füme Cam Kapaklı LED Gardırop",
    sub: "Özel Tasarım Giyinme Odası Dolabı",
    img: "/media/showcase/gardirob-fume-led.webp",
    badge: "GİYİNME ODASI"
  },
  {
    title: "Antrasit Akrilik & LED Aydınlatma",
    sub: "Boy Kiler & Fümeli Cam Vitrin",
    img: "/media/showcase/mutfak-antrasit-led.webp",
    badge: "ÖZEL İMALAT"
  },
  {
    title: "Akustik Ahşap Lambrili TV Konsolu",
    sub: "Doğal Ceviz Çıta & Mat Antrasit Lake",
    img: "/media/showcase/salon-lambri-unite.webp",
    badge: "SALON DİZAYN"
  }
];
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. PLAN MUTFAK BİREBİR REVSLIDER HERO BÖLÜMÜ (TAM GENİŞLİK SLIDER)    -->
  <!-- ===================================================================== -->
  <section id="slider" class="relative w-full bg-[#111] overflow-hidden" style="min-height: 680px;">
    
    <!-- Slider Ana Arka Plan Görseli (Kullanıcının Calacatta Mermer Ada Mutfağı) -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/media/showcase/mutfak-calacatta-hero.webp" 
        alt="Mutfağınıza Özel Dizayn - Plan Mutfak Tarzı İzmir Mutfak Banyo" 
        class="w-full h-full object-cover object-center scale-100 transition-transform duration-1000 ease-out" 
        width="1920" 
        height="1080" 
        loading="eager" 
        fetchpriority="high"
      />
      <!-- Plan Mutfak Koyu Katman (text okunurluğu için koyu filtre) -->
      <div class="absolute inset-0 bg-black/50"></div>
    </div>

    <!-- Slider İçerik Katmanı (Plan Mutfak tp-caption Birebir Stilleri) -->
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6 min-h-[680px] flex flex-col justify-center items-center text-center z-10 py-20">
      
      <div class="max-w-4xl space-y-4">
        
        <!-- Büyük Kalın Başlık (Plan Mutfak big_extraheavy_60 Stili) -->
        <h1 
          class="font-['Montserrat',sans-serif] text-3xl sm:text-5xl md:text-6xl lg:text-[70px] font-black text-white uppercase tracking-tight leading-[1.1]" 
          style="text-shadow: 2px 3px 10px rgba(0,0,0,0.9);"
        >
          Mutfağınıza Özel Dizayn
        </h1>

        <!-- Plan Mutfak Kırmızı İnce Ayraç Çizgisi (lines.png karşılığı) -->
        <div class="flex items-center justify-center gap-2 py-1">
          <span class="w-12 sm:w-16 h-[3px] bg-white/60"></span>
          <span class="w-16 sm:w-24 h-[4px] bg-[#CB000F]"></span>
          <span class="w-12 sm:w-16 h-[3px] bg-white/60"></span>
        </div>

        <!-- Alt Başlık (Plan Mutfak extrabold_littlesub_open Stili) -->
        <p 
          class="font-['Montserrat',sans-serif] text-sm sm:text-lg md:text-xl font-bold text-white tracking-wide max-w-2xl mx-auto" 
          style="text-shadow: 1px 2px 6px rgba(0,0,0,0.85);"
        >
          Kalite, şıklık ve güven arıyorsanız yapmanız gereken sadece bize ulaşmak.
        </p>

        <!-- Plan Mutfak Butonları (#CB000F Kırmızı ve Şeffaf Çerçeveli) -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-[#CB000F] hover:bg-[#b0000d] text-white font-['Montserrat',sans-serif] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded transition-all duration-200 shadow-xl hover:scale-105"
          >
            Ücretsiz 3D Keşif Al
          </a>
          <a 
            href="/maliyet-hesapla/" 
            class="px-8 py-3.5 bg-white/20 hover:bg-white hover:text-[#23323A] text-white font-['Montserrat',sans-serif] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded border border-white/50 backdrop-blur-sm transition-all duration-200 hover:scale-105"
          >
            🧮 Canlı Maliyet Hesapla
          </a>
        </div>

      </div>

    </div>

    <!-- Plan Mutfak Slider Gezinme Okları (Sol / Sağ) -->
    <div class="hidden sm:flex absolute inset-y-0 left-4 items-center z-20 pointer-events-none">
      <button 
        type="button" 
        class="w-12 h-12 bg-black/40 hover:bg-[#CB000F] text-white rounded-full flex items-center justify-center backdrop-blur-sm transition pointer-events-auto"
        aria-label="Önceki Slayt"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
    </div>
    <div class="hidden sm:flex absolute inset-y-0 right-4 items-center z-20 pointer-events-none">
      <button 
        type="button" 
        class="w-12 h-12 bg-black/40 hover:bg-[#CB000F] text-white rounded-full flex items-center justify-center backdrop-blur-sm transition pointer-events-auto"
        aria-label="Sonraki Slayt"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

  </section>

  <!-- ===================================================================== -->
  <!-- 2. PLAN MUTFAK TARZI 3'LÜ KATEGORİ BLOKLARI (MUTFAK, BANYO, KAPI)      -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F4F6F8] border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {mainCategories.map((item) => (
          <div class="group bg-white rounded-lg overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            
            <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                width="400" 
                height="250" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <h3 class="absolute bottom-3 left-4 text-white font-['Montserrat',sans-serif] text-lg font-bold">
                {item.title}
              </h3>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
              <p class="text-xs text-[#555] font-['Open_Sans',sans-serif] leading-relaxed">
                {item.desc}
              </p>
              
              <a 
                href={item.link} 
                class="w-full py-2.5 bg-[#23323A] hover:bg-[#CB000F] text-white font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider text-center rounded transition"
              >
                {item.btn} →
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. PLAN MUTFAK HAKKIMIZDA & TECRÜBE BANDI                              -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Sol: Tanıtım Metni (Plan Mutfak Stili) -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-block border-b-2 border-[#CB000F] pb-1">
            <span class="font-['Montserrat',sans-serif] text-xs font-extrabold uppercase tracking-widest text-[#CB000F]">
              28 YILLIK DENEYİM
            </span>
          </div>

          <h2 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#23323A] leading-tight">
            İzmir Mutfak ve Banyo Tasarımında <br />
            <span class="text-[#CB000F]">Yenilikçi &amp; Özel Çözümler</span>
          </h2>

          <p class="text-[#555] font-['Open_Sans',sans-serif] text-sm leading-relaxed">
            İzmir Mutfak Banyo sahip olduğu 28 yıllık deneyimi ile yenilikçi mutfak tasarımları ve dekorasyonları üzerine hizmet vermektedir. Her zaman en iyi hizmeti en kaliteli şekilde sunmanın peşinde olan firmamız sürekli kendini geliştiren bir yapıya sahiptir.
          </p>

          <p class="text-[#555] font-['Open_Sans',sans-serif] text-sm leading-relaxed">
            İzmir mutfak tasarım ihtiyaçları açısından oldukça kreatif bir ekibi ve yenilikçi bir vizyona sahip olan firmamız imzasını attığı her alanı eşsiz kılmayı başarmaktadır. Buca Adatepe imalat atölyemizde bilgisayarlı CNC parkurumuzla doğrudan birinci elden üretim yapıyoruz.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-3 text-center">
            <div class="p-3 bg-[#F4F6F8] rounded border border-gray-200">
              <div class="font-['Montserrat',sans-serif] text-2xl font-black text-[#23323A]">137</div>
              <div class="text-[10.5px] uppercase font-bold text-[#7F8C8D] mt-0.5">Model Arşivi</div>
            </div>
            <div class="p-3 bg-[#F4F6F8] rounded border border-gray-200">
              <div class="font-['Montserrat',sans-serif] text-2xl font-black text-[#23323A]">28</div>
              <div class="text-[10.5px] uppercase font-bold text-[#7F8C8D] mt-0.5">Yıl Tecrübe</div>
            </div>
            <div class="p-3 bg-[#F4F6F8] rounded border border-gray-200">
              <div class="font-['Montserrat',sans-serif] text-2xl font-black text-[#CB000F]">10 Yıl</div>
              <div class="text-[10.5px] uppercase font-bold text-[#7F8C8D] mt-0.5">Blum Garanti</div>
            </div>
            <div class="p-3 bg-[#F4F6F8] rounded border border-gray-200">
              <div class="font-['Montserrat',sans-serif] text-2xl font-black text-[#23323A]">2.850+</div>
              <div class="text-[10.5px] uppercase font-bold text-[#7F8C8D] mt-0.5">Teslim Ev</div>
            </div>
          </div>

          <div class="pt-2">
            <a 
              href="/hakkimizda/" 
              class="px-6 py-3 bg-[#23323A] hover:bg-[#CB000F] text-white font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider rounded transition inline-block"
            >
              Hakkımızda Detaylı Bilgi →
            </a>
          </div>

        </div>

        <!-- Sağ: Kendi CNC Atölye / Fabrika İmalat Görseli -->
        <div class="lg:col-span-5">
          <div class="relative rounded-lg overflow-hidden border-4 border-white shadow-xl">
            <img 
              src="/media/showcase/fabrika-cnc-uretim.png" 
              alt="İzmir Mutfak Banyo CNC İmalat Atölyesi" 
              class="w-full h-auto object-cover" 
              width="600" 
              height="400" 
              loading="lazy" 
            />
            <div class="absolute bottom-0 inset-x-0 p-4 bg-[#23323A]/90 text-white text-xs backdrop-blur-sm">
              <strong class="font-['Montserrat',sans-serif] block text-sm text-[#CB000F]">Buca Adatepe İmalat Atölyemiz</strong>
              <span class="text-gray-300 text-[11.5px]">Aracı komisyonsuz, doğrudan fabrikadan evinize teslimat.</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. PLAN MUTFAK TARZI ÖNE ÇIKAN MODELLER (8'Lİ SEÇKİN VİTRİN)           -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F4F6F8] border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-10">
      
      <!-- Başlık Bandı -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b-2 border-gray-200 pb-4">
        <div>
          <span class="font-['Montserrat',sans-serif] text-xs font-extrabold uppercase tracking-widest text-[#CB000F]">
            ÖZGÜN TASARIMLAR
          </span>
          <h2 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-[#23323A] mt-1">
            Öne Çıkan Modellerimiz
          </h2>
        </div>
        <div>
          <a 
            href="/tasarimlar/" 
            class="px-5 py-2.5 bg-[#CB000F] hover:bg-[#b0000d] text-white font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider rounded transition inline-block"
          >
            Tüm 137 Modeli Gör →
          </a>
        </div>
      </div>

      <!-- 8 Model Grid'i -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {vitrinModeller.map((item) => (
          <div class="group bg-white rounded overflow-hidden border border-gray-200 hover:border-[#CB000F] shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
            
            <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                width="400" 
                height="300" 
              />
              <span class="absolute top-2.5 left-2.5 px-2.5 py-1 bg-[#23323A]/85 text-white font-['Montserrat',sans-serif] text-[9.5px] font-bold uppercase tracking-wider rounded">
                {item.badge}
              </span>
            </div>

            <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <h3 class="font-['Montserrat',sans-serif] text-sm font-bold text-[#23323A] group-hover:text-[#CB000F] transition line-clamp-1">
                  {item.title}
                </h3>
                <p class="text-xs text-[#7F8C8D] font-['Open_Sans',sans-serif] mt-0.5">
                  {item.sub}
                </p>
              </div>

              <div class="pt-3 border-t border-gray-100 flex items-center justify-between">
                <a 
                  href={`https://wa.me/905393333303?text=Merhaba,%20web%20sitenizdeki%20'${encodeURIComponent(item.title)}'%20modeli%20hakkında%20ücretsiz%203D%20keşif%20ve%20fiyat%20almak%20istiyorum.`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[#CB000F] hover:text-[#23323A] font-['Montserrat',sans-serif] text-xs font-bold inline-flex items-center gap-1"
                >
                  <span>3D Keşif İste</span>
                  <span>→</span>
                </a>
                <a 
                  href="/maliyet-hesapla/" 
                  class="text-[11px] text-[#7F8C8D] hover:text-[#CB000F] font-semibold"
                >
                  Fiyat Hesapla
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. ÖNCESİ / SONRASI ŞANTİYE DÖNÜŞÜM KANITI (BEFORE & AFTER)            -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-8">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="font-['Montserrat',sans-serif] text-xs font-extrabold uppercase tracking-widest text-[#CB000F]">
          SOMUT REFERANS KANITI
        </span>
        <h2 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-[#23323A]">
          Kırım ve Molozdan Anahtar Teslim Lükse
        </h2>
        <p class="text-[#555] text-xs sm:text-sm font-['Open_Sans',sans-serif]">
          Eski yıpranmış banyo ve mutfakların Adatepe atölyemiz ustalığıyla kusursuz yaşam alanlarına dönüşümü.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8">
          <div class="relative rounded-lg overflow-hidden border border-gray-300 shadow-xl group">
            <img 
              src="/media/showcase/banyo-oncesi-sonrasi.png" 
              alt="Banyo Tadilatı Öncesi ve Sonrası Dönüşüm Kanıtı" 
              class="w-full h-auto object-cover" 
              width="1000" 
              height="600" 
              loading="lazy" 
            />
            <div class="absolute top-4 left-4 px-3 py-1 bg-[#CB000F] text-white font-['Montserrat',sans-serif] text-xs font-bold uppercase rounded shadow">
              KIRIM &amp; ŞANTİYE
            </div>
            <div class="absolute top-4 right-4 px-3 py-1 bg-[#23323A] text-white font-['Montserrat',sans-serif] text-xs font-bold uppercase rounded shadow">
              ANAHTAR TESLİM SON HALİ
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 space-y-4">
          <div class="p-4 bg-[#F4F6F8] rounded border border-gray-200 space-y-1">
            <strong class="font-['Montserrat',sans-serif] text-sm text-[#23323A] block">1. Lazer Keşif &amp; 3D Proje</strong>
            <p class="text-xs text-[#555]">Milimetrik ölçüm yapılır, renk ve malzeme seçimi onayınıza sunulur.</p>
          </div>

          <div class="p-4 bg-[#F4F6F8] rounded border border-gray-200 space-y-1">
            <strong class="font-['Montserrat',sans-serif] text-sm text-[#23323A] block">2. Kırım &amp; Sıhhi Tesisat</strong>
            <p class="text-xs text-[#555]">Eski fayans ve borular sökülür, çift kat su yalıtımı uygulanır.</p>
          </div>

          <div class="p-4 bg-[#F4F6F8] rounded border border-gray-200 space-y-1">
            <strong class="font-['Montserrat',sans-serif] text-sm text-[#23323A] block">3. Atölye Montajı &amp; Teslim</strong>
            <p class="text-xs text-[#555]">Kendi imalatımız olan dolaplar 1 günde sıfır hata ile monte edilir.</p>
          </div>

          <a 
            href="/maliyet-hesapla/" 
