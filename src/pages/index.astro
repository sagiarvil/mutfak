---
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";
import yapilanIsler from "../data/yapilanIslerData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli ve 8 canlı yapılan iş
const featuredModels = tasarimlar.slice(0, 8);
const featuredWorks = yapilanIsler.slice(0, 8);

const seo = {
  title: "Cem Yeşilay — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir Buca Adatepe atölyemizden kişiye ve mekâna özel projelendirilen akrilik, lake mutfak dolapları, lüks banyo renovasyonu ve anahtar teslim konut taahhüdü. 28 yıllık tecrübe, 137 tescilli model arşivi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "cem yeşilay luxury",
    "cem yeşilay mimarlık",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklarımız parmak izi tutmaz, kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Yerinde lazer rölöve sonrası fotogerçekçi 3D mimari çizim hazırlar, üretime geçmeden önce birebir onayınıza sunarız."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya Blum ve Almanya Häfele entegre frenli sessiz mekanizmalar kullanılır."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken Cem Yeşilay'ı tercih etmenin somut avantajı nedir?",
      answer: "Showroom komisyonsuz doğrudan Adatepe imalat atölyesi birinci el fiyatı, 18mm E1 MDF gövde ve resmi gecikme cezalı sözleşme güvencesi sunuyoruz."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi noter onaylı gecikme cezalı sözleşmeyle yürütür, montaj bitiminde temiz kullanıma hazır teslim ederiz."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. SİNEMATİK PREMİUM VİDEO HERO (KIRMIZILIK GİDERİLDİ, ASİL TON)      -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-[#02130C] border-b border-[#0A2E1D]" style="min-height: 85vh;">
    
    <!-- Referans Video Arka Planı (Sinematik Soğuk-Zümrüt Lüks Tonlama) -->
    <div class="absolute inset-0 w-full h-full overflow-hidden">
      <video
        id="heroBgVideo"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster="/media/cinematic/home_video_photo.webp"
        class="w-full h-full object-cover scale-102 transition-transform duration-1000"
        style="filter: hue-rotate(-12deg) saturate(0.96) contrast(1.14) brightness(0.92);"
      >
        <source src="/media/cinematic/home_video.mp4" type="video/mp4" />
      </video>
      
      <!-- Asil Sinematik Cartier/Rolex Koyu Zümrüt Karartma Filtresi -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#02140D]/90 via-[#041F14]/65 to-black/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#02140D] via-transparent to-black/50"></div>
    </div>

    <!-- Hero İçerik (Cartier Lüks Panel & Rafine Tipografi) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-16 sm:py-24 flex flex-col justify-center items-start min-h-[85vh] z-10">
      
      <div class="max-w-2xl bg-[#031910]/80 backdrop-blur-xl p-6 sm:p-10 rounded-2xl border border-[#C5A880]/30 shadow-2xl space-y-6">
        
        <!-- Üst Prestij Rozeti -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#02140D] text-[#C5A880] border border-[#C5A880]/40 rounded-full shadow-md">
          <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
          <span class="text-xs font-bold tracking-[0.16em] uppercase font-sans">
            ADATEPE İMALAT ATÖLYESİ • <span class="text-white">28 YIL</span>
          </span>
        </div>

        <!-- Ana Başlık (Zarif & Prestijli) -->
        <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold text-white leading-[1.1] tracking-tight">
          Hayalinizdeki Mutfağı, <br />
          <span class="text-[#C5A880] font-serif font-normal italic">Kişiye Özel Çizgilerle</span> <br />
          <span class="text-white">Gerçeğe Dönüştürüyoruz.</span>
        </h1>

        <!-- Rafine Kısa Açıklama -->
        <p class="text-sm sm:text-base text-[#D8D2C7] font-light leading-relaxed max-w-xl">
          Nanoteknolojik mat lake, Avusturya Blum sessiz raylar ve İtalyan mimari projelendirme. İzmir genelinde ücretsiz lazer rölöve ve 3D keşif.
        </p>

        <!-- CTA Butonları (Cartier Altın & Rolex Zümrüt) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded border border-[#E5C378] shadow-xl transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span>WhatsApp ile 3D Keşif İste</span>
            <span>→</span>
          </a>
          <a 
            href="/tasarimlar/" 
            class="px-8 py-3.5 bg-white/10 hover:bg-white/20 text-white border border-white/25 text-xs sm:text-sm font-semibold uppercase tracking-wider rounded backdrop-blur-sm transition duration-300 flex items-center justify-center gap-2"
          >
            <span>137 Tasarım Modeli</span>
          </a>
        </div>

      </div>

      <!-- Sayaç Kartı (Cartier Altın & Koyu Cam) -->
      <div class="mt-8 sm:mt-10 w-full max-w-4xl bg-[#041F14]/90 backdrop-blur-xl border border-[#C5A880]/30 rounded-xl p-5 sm:p-6 shadow-2xl relative z-10 text-white">
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
          
          <div class="space-y-1 sm:border-r border-[#0D3826] pr-2">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-sans" data-target="137">0</span>
              <span class="text-xs sm:text-sm font-bold text-[#C5A880]">Model</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#C5A880] font-bold">Özgün Koleksiyon</div>
          </div>

          <div class="space-y-1 md:border-r border-[#0D3826] pr-2">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-[#C5A880] font-sans" data-target="28">0</span>
              <span class="text-xs sm:text-sm font-bold text-[#C5A880]">Yıl</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-white font-bold">Atölye Mirası</div>
          </div>

          <div class="space-y-1 sm:border-r border-[#0D3826] pr-2">
            <div class="flex items-baseline gap-1">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-sans" data-target="10">0</span>
              <span class="text-xs sm:text-sm font-bold text-[#C5A880]">Yıl</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-[#C5A880] font-bold">Gövde Garantisi</div>
          </div>

          <div class="space-y-1">
            <div class="flex items-baseline gap-0.5">
              <span class="stat-counter text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-sans" data-target="2850" data-format="comma">0</span>
              <span class="text-xl sm:text-2xl font-extrabold text-[#C5A880]">+</span>
            </div>
            <div class="text-[10px] sm:text-[11px] uppercase tracking-wider text-white font-bold">Tamamlanan Proje</div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. ÖNCESİ & SONRASI (EVDEKOR TADİLAT REFERANSI DÖNÜŞÜM MODÜLÜ)        -->
  <!-- ===================================================================== -->
  <BeforeAfter />

  <!-- ===================================================================== -->
  <!-- 3. MİMARİ AVANTAJ KARTLARI (PREMİUM STANDARTLAR)                     -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F8FAFC] border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-[#041F14]">MİMARİ KALİTE STANDARDI</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 font-serif">Neden Cem Yeşilay Atölyesi?</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded bg-[#041F14] text-[#C5A880] flex items-center justify-center text-xs font-bold shadow-md">
            01
          </div>
          <h3 class="text-sm font-bold text-zinc-900 tracking-tight">Leke Tutmayan Mat Yüzeyler</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake kapak teknolojisi.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded bg-[#041F14] text-[#C5A880] flex items-center justify-center text-xs font-bold shadow-md">
            02
          </div>
          <h3 class="text-sm font-bold text-zinc-900 tracking-tight">Kadife Sessizliğinde Blum Ray</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Orijinal Avusturya Blum entegre frenli raylar ve kiler sistemleri ile 10 yıl mekanik garanti.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded bg-[#041F14] text-[#C5A880] flex items-center justify-center text-xs font-bold shadow-md">
            03
          </div>
          <h3 class="text-sm font-bold text-zinc-900 tracking-tight">3D Fotogerçekçi Projelendirme</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Evinizin lazer ölçülerine göre renk, kulp ve ışık uyumunu üretime girmeden ekranda birebir görün.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-xl apple-card space-y-3">
          <div class="w-9 h-9 rounded bg-[#041F14] text-[#C5A880] flex items-center justify-center text-xs font-bold shadow-md">
            04
          </div>
          <h3 class="text-sm font-bold text-zinc-900 tracking-tight">Sözleşmeli Teslim & Sabit Fiyat</h3>
          <p class="text-xs text-zinc-600 font-normal leading-relaxed">
            Sürpriz masraf çıkarmayan resmi sözleşme, gecikme cezası garantisi ve temiz montaj teslimi.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. SEÇKİN MODEL KOLEKSİYONU                                          -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-gray-200 pb-6">
        <div class="space-y-1">
          <span class="text-xs uppercase font-bold tracking-[0.14em] text-[#041F14] block">
            ÖZEL İMALAT KOLEKSİYONU
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight font-serif">
            Öne Çıkan Mimari Modeller
          </h2>
        </div>
        <div>
          <a href="/tasarimlar/" class="px-6 py-2.5 bg-[#041F14] hover:bg-[#073322] text-[#C5A880] text-xs font-bold uppercase tracking-wider rounded transition shadow-md inline-block border border-[#C5A880]/30">
            Tüm 137 Modeli İncele →
          </a>
        </div>
      </div>

      <!-- Filtre Sekmeleri -->
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/tasarimlar/" class="px-4 py-2 bg-[#041F14] text-white font-bold rounded">Tümü (137 Model)</a>
        <a href="/tasarimlar/?kategori=mutfak" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-medium rounded border border-gray-300 transition">Mutfak (40)</a>
        <a href="/tasarimlar/?kategori=kapilar" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-medium rounded border border-gray-300 transition">Özel Kapılar (39)</a>
        <a href="/tasarimlar/?kategori=gomme-dolap" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-medium rounded border border-gray-300 transition">Giyinme Odası (33)</a>
        <a href="/tasarimlar/?kategori=banyo" class="px-4 py-2 bg-slate-100 text-zinc-800 hover:bg-zinc-200 font-medium rounded border border-gray-300 transition">Lüks Banyo (25)</a>
      </div>

      <!-- Model Grid'i -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredModels.map((item) => (
          <div class="group bg-white border border-gray-200 hover:border-[#041F14] rounded-xl overflow-hidden flex flex-col justify-between apple-card transition duration-300">
            
            <div class="relative w-full aspect-square overflow-hidden bg-zinc-100 shrink-0">
              <img 
                src={item.img} 
                alt={item.altText || item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
              />
              <span class="absolute top-3 left-3 px-2 py-0.5 bg-[#041F14]/90 backdrop-blur-md text-[#C5A880] text-[10px] font-bold uppercase tracking-wider rounded border border-[#C5A880]/30">
                {item.modelNo}
              </span>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1">
                <span class="text-[10px] uppercase tracking-wider font-bold text-[#041F14] block">
                  {item.category}
                </span>
                <h3 class="text-sm font-bold text-zinc-900 group-hover:text-[#041F14] transition line-clamp-2 leading-snug">
                  {item.title}
                </h3>
              </div>
              
              <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-zinc-500 text-[11px]">Özel Ölçü Üretim</span>
                <a 
                  href={`https://wa.me/905353748329?text=Merhaba%20Cem%20Bey,%20${item.modelNo}%20kodlu%20modeliniz%20hakkında%20ücretsiz%203D%20keşif%20istiyorum.`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-3 py-1 bg-[#041F14] hover:bg-[#073322] text-[#C5A880] rounded font-bold text-[11px] transition flex items-center gap-1 border border-[#C5A880]/30"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4.5. ATÖLYEMİZDEN GERÇEK YAPILAN İŞLER (CANLI MONTAJ KARELERİ - 96 PROJE) -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-slate-900 text-white border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-zinc-800 pb-6">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#041F14] text-[#C5A880] rounded-full border border-[#C5A880]/30 text-[10.5px] font-bold uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00FF66] animate-pulse"></span>
            CANLI ŞANTİYE & MONTAJ KARELERİ
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-serif mt-2">
            Son Tamamlanan Gerçek Projelerimiz
          </h2>
          <p class="text-xs sm:text-sm text-zinc-400 font-light">
            Kendi atölyemizde üretip teslim ettiğimiz 96+ projeden seçkin montaj kareleri.
          </p>
        </div>
        <div>
          <a href="/yapilan-isler/" class="px-6 py-3 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs font-extrabold uppercase tracking-wider rounded transition shadow-lg inline-flex items-center gap-2">
            <span>Tüm 96 Yapılan İşi Gör</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- 8 Seçkin Kare Simetrik Görsel (1:1 Aspect Square, Sıfır Bozulma) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {featuredWorks.map((work) => (
          <div class="group bg-zinc-950 border border-zinc-800 hover:border-[#C5A880] rounded-xl overflow-hidden flex flex-col justify-between transition-all duration-300">
            
            <div class="relative w-full aspect-square overflow-hidden bg-zinc-900 shrink-0">
              <img 
                src={work.img} 
                alt={work.altText} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                width="800"
                height="800"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-[#041F14]/90 backdrop-blur-md text-[#C5A880] text-[10px] font-bold uppercase tracking-wider rounded border border-[#C5A880]/30">
                #{String(work.id).padStart(2, '0')}
              </span>
              <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 bg-black/75 backdrop-blur-md text-white text-[9.5px] font-medium rounded">
                📍 {work.location}
              </span>
            </div>

            <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
              <div>
                <span class="text-[9.5px] uppercase tracking-wider font-bold text-[#C5A880] block">
                  {work.category}
                </span>
                <h3 class="text-xs font-bold text-white group-hover:text-[#C5A880] transition line-clamp-1 mt-0.5">
                  {work.title}
                </h3>
              </div>
              
              <div class="pt-2 border-t border-zinc-800/80 flex items-center justify-between text-xs">
                <span class="text-[10px] text-zinc-400">Atölye İmalatı</span>
                <a 
                  href={`https://wa.me/905353748329?text=Merhaba%20Cem%20Bey,%20web%20sitenizdeki%20#${work.id}%20numaralı%20${work.location}%20projeniz%20hakkında%20ücretsiz%203D%20keşif%20istiyorum.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-2.5 py-1 bg-[#041F14] hover:bg-[#073322] text-[#C5A880] rounded font-bold text-[10.5px] transition flex items-center gap-1 border border-[#C5A880]/30"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. MİMARİ HİZMETLERİMİZ                                              -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#F8FAFC] border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      
      <div class="max-w-2xl space-y-1.5">
        <span class="text-xs uppercase font-bold tracking-widest text-[#041F14] block">HİZMET KAPSAMIMIZ</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight font-serif">
          Mekana Özel Mimari Mühendislik
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="bg-white border border-gray-200 hover:border-[#041F14] rounded-xl p-6 space-y-3 apple-card flex flex-col justify-between group transition">
          <div class="space-y-2.5">
            <span class="text-[9.5px] font-bold uppercase tracking-wider text-[#C5A880] bg-[#041F14] px-2.5 py-1 rounded inline-block">
              MUTFAK
            </span>
            <h3 class="text-base font-bold text-zinc-900 group-hover:text-[#041F14] transition">Lüks Mutfak Dolabı</h3>
            <p class="text-xs text-zinc-600 font-normal leading-relaxed">
              İpek mat lake ve İtalyan akrilik kapaklar, Blum ray mekanizmaları ile milimetrik üretim.
            </p>
          </div>
          <a href="/izmir-mutfak-dolabi-imalati/" class="text-xs font-bold text-[#041F14] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

        <div class="bg-white border border-gray-200 hover:border-[#041F14] rounded-xl p-6 space-y-3 apple-card flex flex-col justify-between group transition">
          <div class="space-y-2.5">
            <span class="text-[9.5px] font-bold uppercase tracking-wider text-[#C5A880] bg-[#041F14] px-2.5 py-1 rounded inline-block">
              RENOVASYON
            </span>
