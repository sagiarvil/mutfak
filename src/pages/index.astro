---
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "İzmir Mutfak Banyo — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "Buca Adatepe imalat atölyemizden kişiye ve mekâna özel projelendirilen İtalyan ada mutfaklar, akrilik ve lake dolaplar, lüks banyo renovasyonu ve anahtar teslim konut mimarisi. 28 yıllık zanaat.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "izmir lüks ada mutfak",
    "izmir mutfak dolabı imalatı",
    "lake mutfak modelleri 2026",
    "lüks banyo renovasyonu izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon",
    "izmir anahtar teslim tadilat"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklarımız parmak izi tutmaz, nem ve buhardan etkilenmez, kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında mutfağımı veya banyomu önceden görebilir miyim?",
      answer: "Evet. Yerinde milimetrik lazer rölöve sonrası fotogerçekçi 3D mimari çizim hazırlar, üretime geçmeden önce birebir onayınıza sunarız."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya Blum ve Almanya Häfele entegre frenli sessiz mekanizmalar kullanılır. 10 yıl mekanik garanti verilir."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken doğrudan atölyeyi tercih etmenin avantajı nedir?",
      answer: "Showroom komisyonsuz doğrudan Buca Adatepe imalat atölyesi birinci el fiyatı, 18mm E1 sertifikalı neme dayanıklı MDF gövde ve resmi gecikme cezalı sözleşme güvencesi sunuyoruz."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve sabit fiyat garantiniz var mı?",
      answer: "Tüm projelerimizi noter onaylı gecikme cezalı sözleşmeyle yürütür, sözleşme bedeli haricinde 1 TL ek masraf çıkarmayız. Montaj bitiminde temiz kullanıma hazır teslim ederiz."
    }
  ]
};

// Görsel Vitrin Koleksiyonları (Kullanıcının Yüklediği Gerçek İşler)
const mutfakKoleksiyonu = [
  {
    title: "Calacatta Gold Şelale Ada & Doğal Ceviz Mutfak",
    sub: "Özel İmalat • İpek Mat Lake • Blum Donanım",
    img: "/media/showcase/mutfak-calacatta-hero.webp",
    tag: "BAŞYAPIT",
    aspect: "col-span-1 md:col-span-2 row-span-2 aspect-[4/3] md:aspect-auto"
  },
  {
    title: "Panoramik Havuz Cepheli Açık Ada Konsepti",
    sub: "Vizon Akrilik • Asma Tavan Gizli Lineer LED",
    img: "/media/showcase/mutfak-havuz-ada.webp",
    tag: "VİLLA PROJESİ",
    aspect: "col-span-1 aspect-[4/3]"
  },
  {
    title: "İtalyan Heykelsi Salon & Ada Bütünleşmesi",
    sub: "Minimalist Ada • Mermer Tezgah • Açık Yaşam Alanı",
    img: "/media/showcase/salon-ada-mutfak.webp",
    tag: "MİLANO STİLİ",
    aspect: "col-span-1 aspect-[4/3]"
  },
  {
    title: "Antrasit Akrilik & Entegre LED Çerçeveli Dolaplar",
    sub: "Fümeli Cam Bölmeler • Boy Kiler Dolabı",
    img: "/media/showcase/mutfak-antrasit-led.webp",
    tag: "MODERN ÇİZGİ",
    aspect: "col-span-1 aspect-[4/3]"
  },
  {
    title: "İpek Mat Lake Ada & Mermer Bar Masası",
    sub: "Masif Ahşap Sandalyeler • Gizli Kulp Tasarımı",
    img: "/media/showcase/mutfak-lake-ada.webp",
    tag: "MİNİMALİST",
    aspect: "col-span-1 aspect-[4/3]"
  },
  {
    title: "Country Masif Ahşap Tezgahlı Ada Mutfak",
    sub: "Doğal Doku • Sıcak Rustik Detaylar • Özel İmalat",
    img: "/media/showcase/mutfak-country-ada.png",
    tag: "COUNTRY LÜKS",
    aspect: "col-span-1 aspect-[4/3]"
  },
  {
    title: "İtalyan Doğal Ahşap & Taş Doku Uyumu",
    sub: "Arduvaz Doku • Entegre Ankastre Grubu",
    img: "/media/showcase/mutfak-tas-ahsap.webp",
    tag: "ÖZEL ZANAAT",
    aspect: "col-span-1 aspect-[4/3]"
  }
];

const digerKoleksiyon = [
  {
    title: "Doğal Arduvaz Taş Kaplamalı Lüks Banyo & Duşakabin",
    cat: "ISLAK HACİM MİMARİSİ",
    img: "/media/showcase/banyo-arduvaz-luks.png",
    desc: "Suya tam mukavemetli marin masif lavabo tezgahı, antrasit taş kaplama ve özel füme temperli cam kabin."
  },
  {
    title: "Monoblok Calacatta Lavabo & Altın Antrasit Armatür",
    cat: "MİMARİ BANYO DETAYI",
    img: "/media/showcase/banyo-altin-lavabo.webp",
    desc: "Yekpare doğal taş lavabo, gizli sifon sistemi ve duvara gömme termostatik batarya grubu."
  },
  {
    title: "Entegre LED Aydınlatmalı Fümeli Cam Gardırop Odası",
    cat: "ÖZEL GİYİNME ODASI",
    img: "/media/showcase/gardirob-fume-led.webp",
    desc: "Sensörlü dikey LED kanalları, antrasit alüminyum profil çerçeveler ve kadife kaplı çekmece içi aksesuarları."
  },
  {
    title: "Özel Tasarım TV Ünitesi & Akustik Ahşap Lambriler",
    cat: "SALON İÇ MİMARİSİ",
    img: "/media/showcase/salon-lambri-unite.webp",
    desc: "Gizli kablo geçişleri, mat antrasit konsol ve tavana kadar yükselen doğal ceviz çıta lambriler."
  }
];
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. PREMİUM İTALYAN MİMARİ HERO (FOTOĞRAF ODAKLI - SIFIR VİDEO)        -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-[#0A0D14] border-b border-zinc-800 text-white">
    
    <!-- İnce Arka Plan Işık Halesi -->
    <div class="absolute -top-40 right-0 w-[600px] h-[600px] bg-sky-500/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-10 w-[400px] h-[400px] bg-emerald-500/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
      
      <!-- İki Sütunlu Asimetrik Mimari Düzen -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Sol Sütun: Editoryal Tipografi & Çift Eylem (5 Sütun) -->
        <div class="lg:col-span-5 space-y-6 z-10">
          
          <!-- Üst Prestij Rozeti -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 bg-white/5 border border-sky-400/30 rounded-full backdrop-blur-md shadow-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-[11px] font-bold tracking-[0.18em] uppercase text-sky-400 font-sans">
              BUCA ATÖLYESİNDEN • %100 KENDİ İMALATIMIZ
            </span>
          </div>

          <!-- Ana Başlık: Editoryal İtalyan Mimarisi -->
          <div class="space-y-3">
            <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-extrabold text-white leading-[1.08] tracking-tight font-serif">
              Evinizin Kalbine <br />
              <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-sky-300 via-sky-100 to-white">
                İtalyan Zarafeti
              </span>
            </h1>
            <p class="text-sm sm:text-base text-zinc-300 font-light leading-relaxed max-w-lg">
              Aracı veya showroom komisyonu olmadan; Buca Adatepe imalat atölyemizde CNC hassasiyetiyle üretiyor, evinize anahtar teslim kuruyoruz.
            </p>
          </div>

          <!-- 3 Temel Güven Rozeti (Kadınların ve Ailelerin En Çok Aradığı Güvence) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
            <div class="p-3 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm">
              <div class="text-sky-400 font-bold mb-0.5">Ücretsiz 3D Çizim</div>
              <div class="text-[11px] text-zinc-400">Üretime girmeden gör</div>
            </div>
            <div class="p-3 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm">
              <div class="text-sky-400 font-bold mb-0.5">Sabit Fiyat Taahhüdü</div>
              <div class="text-[11px] text-zinc-400">Sözleşme dışı 1₺ çıkmaz</div>
            </div>
            <div class="p-3 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm">
              <div class="text-sky-400 font-bold mb-0.5">10 Yıl Mekanik Garanti</div>
              <div class="text-[11px] text-zinc-400">Avusturya Blum donanım</div>
            </div>
          </div>

          <!-- Çift Mıknatıs Aksiyon Butonları -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-3">
            <a 
              href={siteConfig.whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-7 py-4 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white text-xs sm:text-sm font-bold uppercase tracking-wider rounded-xl shadow-[0_10px_30px_rgba(16,185,129,0.3)] transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              <span>WhatsApp ile 3D Keşif Al</span>
              <span>→</span>
            </a>
            
            <a 
              href="/maliyet-hesapla/" 
              class="px-7 py-4 bg-sky-500 hover:bg-sky-400 text-[#0A0D14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-xl transition duration-300 flex items-center justify-center gap-2 shadow-[0_10px_25px_rgba(14,165,233,0.3)] hover:scale-[1.02]"
            >
              <span>🧮 Maliyeti Canlı Hesapla</span>
            </a>
          </div>

        </div>

        <!-- Sağ Sütun: Calacatta Mermer Şelale Ada Başyapıt Görseli (7 Sütun) -->
        <div class="lg:col-span-7">
          <div class="relative group rounded-3xl overflow-hidden border-2 border-white/10 shadow-[0_30px_70px_rgba(0,0,0,0.7)] bg-zinc-900">
            
            <!-- Ana Görsel (Calacatta Şelale Ada) -->
            <img 
              src="/media/showcase/mutfak-calacatta-hero.webp" 
              alt="İzmir Lüks Calacatta Mermer Şelale Ada Mutfak Tasarımı" 
              class="w-full h-[460px] sm:h-[540px] lg:h-[620px] object-cover object-center group-hover:scale-105 transition-transform duration-1000 ease-out" 
              width="1200" 
              height="800" 
              loading="eager" 
              fetchpriority="high"
            />
            
            <!-- Estetik Gradyan -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A0D14] via-transparent to-black/20 pointer-events-none"></div>

            <!-- Yüzen Mimari Etiketler -->
            <div class="absolute top-5 left-5 px-3.5 py-1.5 bg-black/60 backdrop-blur-md rounded-full border border-white/20 text-xs font-semibold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-400"></span>
              <span>Calacatta Gold Şelale Mermer</span>
            </div>

            <div class="absolute top-5 right-5 px-3 py-1.5 bg-emerald-500/90 backdrop-blur-md rounded-full text-[11px] font-extrabold text-white tracking-wider uppercase">
              1. EL ATÖLYE FİYATI
            </div>

            <div class="absolute bottom-5 left-5 right-5 p-4 sm:p-5 bg-black/60 backdrop-blur-xl rounded-2xl border border-white/15 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-white">
              <div>
                <div class="text-xs uppercase font-bold tracking-wider text-sky-400">Özel Tasarım İtalyan Ada Mutfak</div>
                <div class="text-sm sm:text-base font-serif font-bold text-white mt-0.5">Doğal Ceviz Gövde &amp; İpek Mat Lake Dolaplar</div>
              </div>
              <a 
                href="/maliyet-hesapla/" 
                class="px-4 py-2 bg-white text-zinc-900 rounded-lg text-xs font-bold uppercase tracking-wider hover:bg-sky-400 hover:text-white transition shrink-0"
              >
                Fiyatını Gör →
              </a>
            </div>

          </div>
        </div>

      </div>

      <!-- Sayaç Konsolu (Kristal Şeffaf Mimari Bant) -->
      <div class="mt-12 sm:mt-16 bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center sm:text-left">
          
          <div class="space-y-1 sm:border-r border-white/10 pr-4">
            <div class="text-3xl sm:text-4xl font-extrabold text-white font-serif">137</div>
            <div class="text-xs font-bold uppercase tracking-wider text-sky-400">Özgün Tasarım</div>
            <div class="text-[11px] text-zinc-400 font-light hidden sm:block">Kişiye özel 1:1 projelendirme</div>
          </div>

          <div class="space-y-1 md:border-r border-white/10 pr-4">
            <div class="text-3xl sm:text-4xl font-extrabold text-white font-serif">28 Yıl</div>
            <div class="text-xs font-bold uppercase tracking-wider text-sky-400">Atölye Zanaatı</div>
            <div class="text-[11px] text-zinc-400 font-light hidden sm:block">Buca Adatepe 1998'den beri</div>
          </div>

          <div class="space-y-1 sm:border-r border-white/10 pr-4">
            <div class="text-3xl sm:text-4xl font-extrabold text-white font-serif">10 Yıl</div>
            <div class="text-xs font-bold uppercase tracking-wider text-sky-400">Mekanik Garanti</div>
            <div class="text-[11px] text-zinc-400 font-light hidden sm:block">Orijinal Avusturya Blum ray</div>
          </div>

          <div class="space-y-1">
            <div class="text-3xl sm:text-4xl font-extrabold text-white font-serif">2.850+</div>
            <div class="text-xs font-bold uppercase tracking-wider text-sky-400">Teslim Edilen Ev</div>
            <div class="text-[11px] text-zinc-400 font-light hidden sm:block">İzmir, Çeşme &amp; Urla genelinde</div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. GÖRSEL SANAT VİTRİNİ: "SÖZCÜKLER DEĞİL, ESERLERİMİZ KONUŞSUN"       -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Editoryal Galeri Başlığı -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-zinc-200 pb-8">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-sky-50 text-sky-800 border border-sky-200 rounded-full text-xs font-bold tracking-[0.2em] uppercase">
            <span>ÖZEL İMALAT GALERİSİ</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 font-serif tracking-tight">
            Sözcükler Değil, Eserlerimiz.
          </h2>
          <p class="text-zinc-600 text-sm sm:text-base font-light">
            Buca Adatepe imalat atölyemizde el işçiliği ve CNC teknolojisiyle hayat bulan seçkin mutfak projelerimiz.
          </p>
        </div>
        
        <div class="flex items-center gap-3">
          <a 
            href="/maliyet-hesapla/" 
            class="px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition shadow-md flex items-center gap-2"
          >
            <span>🧮 Bu Tarz Ne Kadar Tutar?</span>
          </a>
        </div>
      </div>

      <!-- Asimetrik Mimari Görsel Grid (Masonry Effect) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {mutfakKoleksiyonu.map((item) => (
          <div class={`group relative rounded-2xl overflow-hidden border border-zinc-200 shadow-sm hover:shadow-2xl transition-all duration-500 bg-zinc-900 ${item.aspect}`}>
            
            <img 
              src={item.img} 
              alt={item.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
              loading="lazy" 
              decoding="async"
              width="800" 
              height="600" 
            />

            <!-- Üst Etiket -->
            <div class="absolute top-4 left-4 px-3 py-1 bg-black/60 backdrop-blur-md rounded-full text-[10px] font-extrabold uppercase tracking-widest text-sky-300 border border-white/20">
              {item.tag}
            </div>

            <!-- Alt Koyu Degrade ve Başlık -->
            <div class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-black/90 via-black/50 to-transparent text-white flex flex-col justify-end">
              <h3 class="text-base sm:text-lg font-serif font-bold leading-snug group-hover:text-sky-300 transition">
                {item.title}
              </h3>
              <p class="text-xs text-zinc-300 font-light mt-1">
                {item.sub}
              </p>
              
              <div class="pt-3 mt-2 border-t border-white/15 flex items-center justify-between text-xs">
                <span class="text-[11px] text-zinc-400">Atölye İmalatı</span>
                <a 
                  href={`https://wa.me/905393333303?text=Merhaba,%20web%20sitenizdeki%20'${encodeURIComponent(item.title)}'%20projeniz%20hakkında%20ücretsiz%203D%20keşif%20ve%20fiyat%20bilgisi%20almak%20istiyorum.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-3 py-1.5 bg-white/20 hover:bg-emerald-500 text-white rounded-lg font-bold text-[11px] transition flex items-center gap-1.5 backdrop-blur-md"
                >
                  <span>3D Keşif İste</span>
                  <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. LÜKS BANYO, GİYİNME ODASI & SALON KOLEKSİYONU                      -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-zinc-50 border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-white border border-zinc-300 text-zinc-700 rounded-full text-xs font-bold tracking-[0.2em] uppercase shadow-xs">
          <span>KOMPLE İÇ MİMARLIK PORTFOLYOSU</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 font-serif tracking-tight">
          Banyo, Giyinme Odası ve Yaşam Alanları
        </h2>
        <p class="text-zinc-600 text-sm font-light">
          Evinizin her metrekaresini kusursuz İtalyan çizgileri ve birinci sınıf zanaatla buluşturuyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {digerKoleksiyon.map((card) => (
          <div class="group bg-white rounded-2xl overflow-hidden border border-zinc-200 hover:border-sky-500 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            
            <div class="relative aspect-[4/3] overflow-hidden bg-zinc-900">
              <img 
                src={card.img} 
                alt={card.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                loading="lazy" 
                decoding="async"
                width="600" 
                height="450" 
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-black/70 backdrop-blur-md text-sky-300 text-[10px] font-bold uppercase tracking-wider rounded-md border border-white/20">
                {card.cat}
              </span>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1.5">
                <h3 class="text-base font-serif font-bold text-zinc-900 group-hover:text-sky-600 transition leading-snug">
                  {card.title}
                </h3>
                <p class="text-xs text-zinc-600 font-light leading-relaxed">
                  {card.desc}
                </p>
              </div>

              <div class="pt-4 border-t border-zinc-100 flex items-center justify-between text-xs">
                <span class="text-emerald-700 font-semibold text-[11px]">1. Sınıf İmalat</span>
                <a 
                  href={`https://wa.me/905393333303?text=Merhaba,%20web%20sitenizdeki%20'${encodeURIComponent(card.title)}'%20hakkında%20bilgi%20ve%20ücretsiz%20keşif%20istiyorum.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
