---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli
const featuredModels = tasarimlar.slice(0, 8);

const seo = {
  title: "Cem Yeşilay — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir'de kadınların hayalindeki ferah, leke tutmayan ve estetik mutfak dolapları, lüks banyolar ve anahtar teslim daire renovasyonu. 28 yıllık atölye tecrübesi, 137 tescilli model ve ücretsiz 3D mimari rölöve.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks İç Mimarlık & Özel Mutfak İmalatı",
  keywords: [
    "cem yeşilay",
    "cem yeşilay mutfak",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "anahtar teslim ev yenileme",
    "çeşme mutfak tadilatı",
    "urla mimarlık banyo"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Koleksiyonumuzda özel nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklar kullanıyoruz. Yüzeyler parmak izi tutmaz, nemli mikro fiber bezle tek hamlede kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Mimarımız yerinde lazer rölöve aldıktan sonra evinizin ışık açısına uygun fotogerçekçi 3D mimari çizim hazırlar. Tezgah, kulp, zemin ve kapak renk uyumunu üretime geçmeden önce ekranınızda birebir görürsünüz."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya menşeili Blum ve Almanya menşeili Häfele entegre sessiz frenli raylar ve kiler sistemleri kullanıyoruz. Çekmeceler tek dokunuşla sessizce kapanır ve 10 yıl garantilidir."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi resmi noter onaylı gecikme cezalı sözleşmeyle yürütüyoruz. İmalat ve montaj ekibimiz montaj bitiminde detaylı temizlik yaparak alanınızı kullanıma hazır teslim eder."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. REFERANS SİTEDEKİ VİDEOYLA HERO VİTRİNİ (AÇIK & IŞILTILI LÜKS)    -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-[#FAF8F5] border-b border-[#E8E1D5]" style="min-height: 88vh;">
    
    <!-- Referans Video Arka Planı -->
    <div class="absolute inset-0 w-full h-full">
      <video
        id="heroBgVideo"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster="/media/cinematic/home_video_photo.webp"
        class="w-full h-full object-cover opacity-85 scale-102 transition-transform duration-1000"
      >
        <source src="/media/cinematic/home_video.mp4" type="video/mp4" />
      </video>
      <!-- Açık Renkli, Ferah & Sıcak Işıltı Gradyanı -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#FBF9F5] via-[#FBF9F5]/40 to-black/30"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#FBF9F5]/90 via-[#FBF9F5]/60 to-transparent"></div>
    </div>

    <!-- Hero İçerik Katmanı (Göz Alıcı Tipografi & Kadın Zarafeti) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-20 sm:py-28 flex flex-col justify-center items-start min-h-[88vh] z-10">
      <div class="max-w-2xl space-y-6">
        
        <!-- Üst Etiket -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white/90 backdrop-blur-md border border-[#D4A373]/60 rounded-full shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#B87353] animate-pulse"></span>
          <span class="text-[#B87353] text-[11px] font-bold tracking-[0.22em] uppercase font-sans">
            ÖZEL ATÖLYE İMALATI • 28 YILLIK DENEYİM
          </span>
        </div>

        <!-- Başlık -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif text-[#262220] leading-[1.14] tracking-tight font-normal">
          Hayalinizdeki Mutfağı, <br />
          <span class="italic font-light text-[#B87353]">Kişiye Özel Dokunuşlarla</span> <br />
          <span class="font-normal text-[#473E3B]">Gerçeğe Dönüştürüyoruz.</span>
        </h1>

        <!-- Alt Açıklama -->
        <p class="text-sm sm:text-base text-[#473E3B] font-light leading-relaxed max-w-xl">
          Leke tutmayan ipek mat yüzeyler, kadife sessizliğinde Blum raylar ve ferahlatıcı mimari detaylar. İzmir genelinde yerinde ücretsiz 3D çizim ve aracısız atölye imalatı.
        </p>

        <!-- CTA Buton Grubu -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-4 bg-gradient-to-r from-[#B87353] via-[#C98A68] to-[#D4A373] text-white text-xs font-bold uppercase tracking-[0.18em] rounded-xs shadow-lg shadow-[#B87353]/25 hover:opacity-95 transition duration-300 flex items-center justify-center gap-2"
          >
            <span>💬</span> <span>WhatsApp ile 3D Keşif İste</span>
          </a>
          <a 
            href="/tasarimlar/" 
            class="px-8 py-4 bg-white/90 hover:bg-white text-[#262220] border border-[#E8E1D5] text-xs font-bold uppercase tracking-[0.18em] rounded-xs shadow-sm transition duration-300 flex items-center justify-center gap-2 hover:border-[#B87353]"
          >
            <span>✦ 137 Tasarım Modelini Gör</span>
          </a>
        </div>

        <!-- Güven Rozetleri -->
        <div class="pt-6 grid grid-cols-3 gap-4 border-t border-[#E8E1D5]/80 text-[#473E3B]">
          <div class="space-y-0.5">
            <div class="text-lg font-serif font-bold text-[#B87353]">137 Model</div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#756A66]">Özgün Tasarım</div>
          </div>
          <div class="space-y-0.5">
            <div class="text-lg font-serif font-bold text-[#B87353]">10 Yıl</div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#756A66]">Gövde Garantisi</div>
          </div>
          <div class="space-y-0.5">
            <div class="text-lg font-serif font-bold text-[#B87353]">2.850+</div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#756A66]">Mutlu Ev Sahibi</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. KADINLARIN İHTİYACINA ÖZEL 4 TEMEL AVANTAJ (AÇIK KARTLAR)          -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#FBF9F5] border-b border-[#E8E1D5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="p-6 bg-white border border-[#E8E1D5] rounded-xs soft-shadow space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#FAF4ED] border border-[#D4A373]/40 flex items-center justify-center text-lg text-[#B87353]">
            ✨
          </div>
          <h3 class="font-serif text-base font-semibold text-[#262220]">Leke Tutmayan Mat Yüzeyler</h3>
          <p class="text-xs text-[#756A66] font-light leading-relaxed">
            Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake ve akrilik teknolojisi.
          </p>
        </div>

        <div class="p-6 bg-white border border-[#E8E1D5] rounded-xs soft-shadow space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#FAF4ED] border border-[#D4A373]/40 flex items-center justify-center text-lg text-[#B87353]">
            🤫
          </div>
          <h3 class="font-serif text-base font-semibold text-[#262220]">Kadife Sessizliğinde Blum Ray</h3>
          <p class="text-xs text-[#756A66] font-light leading-relaxed">
            Avusturya menşeili entegre frenli mekanizmalar ile dolap kapakları ve çekmeceler daima sessizce kapanır.
          </p>
        </div>

        <div class="p-6 bg-white border border-[#E8E1D5] rounded-xs soft-shadow space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#FAF4ED] border border-[#D4A373]/40 flex items-center justify-center text-lg text-[#B87353]">
            📐
          </div>
          <h3 class="font-serif text-base font-semibold text-[#262220]">3D Çizimle Birebir Önizleme</h3>
          <p class="text-xs text-[#756A66] font-light leading-relaxed">
            Evinizin ölçülerine özel fotogerçekçi 3D mimari modelleme ile renkleri ve kulpları önceden görün.
          </p>
        </div>

        <div class="p-6 bg-white border border-[#E8E1D5] rounded-xs soft-shadow space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#FAF4ED] border border-[#D4A373]/40 flex items-center justify-center text-lg text-[#B87353]">
            🤝
          </div>
          <h3 class="font-serif text-base font-semibold text-[#262220]">Sözleşmeli Süre & Sabit Fiyat</h3>
          <p class="text-xs text-[#756A66] font-light leading-relaxed">
            Sürpriz masraf çıkarmayan resmi sözleşme, gecikme cezası garantisi ve temiz, tertipli montaj teslimi.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. %100 KARE VE SİMETRİK GÖRSEL VİTRİNİ (137 MODEL KOLEKSİYONU)     -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF8F5] border-b border-[#E8E1D5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- Başlık ve Filtre -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#E8E1D5] pb-6">
        <div class="space-y-2">
          <span class="text-xs uppercase font-bold tracking-[0.25em] text-[#B87353] block">
            ÖZEL İMALAT KOLEKSİYONU
          </span>
          <h2 class="text-2xl sm:text-4xl font-serif text-[#262220] font-normal">
            En Çok Tercih Edilen <span class="italic text-[#B87353]">Özel Modellerimiz</span>
          </h2>
        </div>
        <div class="flex items-center gap-3">
          <a href="/tasarimlar/" class="px-6 py-3 bg-gradient-to-r from-[#B87353] to-[#C98A68] text-white text-xs font-bold uppercase tracking-wider rounded-xs shadow-sm hover:opacity-95 transition">
            Tüm 137 Modeli Gör →
          </a>
        </div>
      </div>

      <!-- Kategori Filtre Butonları -->
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/tasarimlar/" class="px-4 py-2 bg-[#B87353] text-white font-semibold rounded-xs shadow-xs">Tümü (137 Model)</a>
        <a href="/tasarimlar/?kategori=mutfak" class="px-4 py-2 bg-white text-[#473E3B] hover:text-[#B87353] font-semibold rounded-xs border border-[#E8E1D5] hover:bg-[#FAF8F5] transition">Mutfak Tasarımları (40)</a>
        <a href="/tasarimlar/?kategori=kapilar" class="px-4 py-2 bg-white text-[#473E3B] hover:text-[#B87353] font-semibold rounded-xs border border-[#E8E1D5] hover:bg-[#FAF8F5] transition">Özel Kapılar (39)</a>
        <a href="/tasarimlar/?kategori=gomme-dolap" class="px-4 py-2 bg-white text-[#473E3B] hover:text-[#B87353] font-semibold rounded-xs border border-[#E8E1D5] hover:bg-[#FAF8F5] transition">Giyinme Odası (33)</a>
        <a href="/tasarimlar/?kategori=banyo" class="px-4 py-2 bg-white text-[#473E3B] hover:text-[#B87353] font-semibold rounded-xs border border-[#E8E1D5] hover:bg-[#FAF8F5] transition">Lüks Banyo (25)</a>
      </div>

      <!-- %100 KARE VE SİMETRİK GRID (aspect-square & hizada kartlar) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredModels.map((item) => (
          <div class="group bg-white border border-[#E8E1D5] rounded-xs overflow-hidden flex flex-col justify-between soft-shadow hover:border-[#B87353] transition duration-300">
            
            <!-- KARE GÖRSEL KAPSAYICI (aspect-square: 100% simetrik, taşma yok) -->
            <div class="relative w-full aspect-square overflow-hidden bg-[#F5F0E8] shrink-0">
              <img 
                src={item.img} 
                alt={item.altText || item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-white/95 backdrop-blur-md text-[#B87353] text-[10px] font-bold uppercase tracking-wider rounded-xs border border-[#D4A373]/50 shadow-xs">
                {item.modelNo}
              </span>
            </div>

            <!-- Bilgi Alanı (Kusursuz Eşit Yükseklik & Tipografi) -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1">
                <span class="text-[10px] uppercase tracking-wider font-semibold text-[#B87353] block">
                  {item.category}
                </span>
                <h3 class="text-sm font-semibold text-[#262220] group-hover:text-[#B87353] transition line-clamp-2 leading-snug">
                  {item.title}
                </h3>
              </div>
              
              <div class="pt-3 border-t border-[#E8E1D5] flex items-center justify-between text-xs">
                <span class="text-[11px] text-[#756A66]">Özel Ölçü Üretim</span>
                <a 
                  href={`${siteConfig.whatsappUrl}?text=Merhaba%20Cem%20Bey,%20${item.modelNo}%20kodlu%20modeliniz%20hakkında%20bilgi%20ve%20ücretsiz%203D%20keşif%20istiyorum.`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[#B87353] font-bold hover:underline flex items-center gap-1"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Alt Buton -->
      <div class="text-center pt-4">
        <a href="/tasarimlar/" class="inline-block px-10 py-4 bg-white hover:bg-[#FAF8F5] text-[#262220] border border-[#B87353] text-xs font-bold uppercase tracking-[0.2em] rounded-xs shadow-sm hover:shadow-md transition">
          137 Model Arşivini Görüntüle
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. MİMARİ HİZMETLERİMİZ (AÇIK RENKLİ ZARİF BENTO BLOKLARI)           -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FBF9F5] border-b border-[#E8E1D5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="max-w-2xl space-y-3">
        <span class="text-xs uppercase font-bold tracking-[0.25em] text-[#B87353] block">MİMARİ HİZMETLERİMİZ</span>
        <h2 class="text-2xl sm:text-4xl font-serif text-[#262220]">
          Evinizin Her Köşesine <span class="italic text-[#B87353]">Özel Dokunuş</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Hizmet 1: Mutfak Dolabı -->
        <div class="bg-white border border-[#E8E1D5] rounded-xs p-6 space-y-4 soft-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#B87353] bg-[#FAF4ED] px-2.5 py-1 rounded-xs inline-block">
              MUTFAK
            </span>
            <h3 class="text-lg font-serif font-semibold text-[#262220]">Özel Ölçü Lüks Mutfak Dolabı</h3>
            <p class="text-xs text-[#756A66] font-light leading-relaxed">
              İpek mat lake, İtalyan akrilik ve masif ahşap kapaklar. Mekanınıza milimetrik oturan ergonomik dolap sistemleri.
            </p>
          </div>
          <a href="/izmir-mutfak-dolabi-imalati/" class="text-xs font-bold text-[#B87353] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 2: Mutfak Yenileme -->
        <div class="bg-white border border-[#E8E1D5] rounded-xs p-6 space-y-4 soft-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#B87353] bg-[#FAF4ED] px-2.5 py-1 rounded-xs inline-block">
              RENOVASYON
            </span>
            <h3 class="text-lg font-serif font-semibold text-[#262220]">Komple Mutfak Renovasyonu</h3>
            <p class="text-xs text-[#756A66] font-light leading-relaxed">
              Kırım, su tesisatı, elektrik altyapısı, porselen veya kuvars tezgah dahil A'dan Z'ye anahtar teslim mutfak dönüşümü.
            </p>
          </div>
          <a href="/izmir-komple-mutfak-tadilati/" class="text-xs font-bold text-[#B87353] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 3: Banyo & Islak Hacim -->
        <div class="bg-white border border-[#E8E1D5] rounded-xs p-6 space-y-4 soft-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#B87353] bg-[#FAF4ED] px-2.5 py-1 rounded-xs inline-block">
              ISLAK HACİM
            </span>
            <h3 class="text-lg font-serif font-semibold text-[#262220]">Lüks Banyo & Seramik</h3>
            <p class="text-xs text-[#756A66] font-light leading-relaxed">
              Çift kat sürme izolasyon güvencesi, 60x120 İtalyan porselen seramik, gömme armatürler ve marin banyo mobilyaları.
            </p>
          </div>
          <a href="/izmir-banyo-yenileme-seramik/" class="text-xs font-bold text-[#B87353] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

        <!-- Hizmet 4: Anahtar Teslim Daire & Villa -->
        <div class="bg-white border border-[#E8E1D5] rounded-xs p-6 space-y-4 soft-shadow flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#B87353] bg-[#FAF4ED] px-2.5 py-1 rounded-xs inline-block">
              ANAHTAR TESLİM
            </span>
            <h3 class="text-lg font-serif font-semibold text-[#262220]">Komple Daire & Villa Renovasyonu</h3>
            <p class="text-xs text-[#756A66] font-light leading-relaxed">
              Çeşme, Urla ve İzmir genelinde iç kapılar, zemin parke, aydınlatma ve boya dahil tek muhatap garantili lüks renovasyon.
            </p>
          </div>
          <a href="/izmir-anahtar-teslim-tadilat/" class="text-xs font-bold text-[#B87353] hover:underline inline-flex items-center gap-1 pt-2">
            <span>İncele</span> <span>→</span>
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. KADINLARIN MERAK ETTİĞİ SIKÇA SORULAN SORULAR                     -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF8F5] border-b border-[#E8E1D5]">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-10">
      
      <div class="text-center space-y-2">
        <span class="text-xs uppercase font-bold tracking-[0.25em] text-[#B87353] block">AKLINIZA TAKILANLAR</span>
        <h2 class="text-2xl sm:text-3xl font-serif text-[#262220]">Sıkça Sorulan Sorular</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <details class="group bg-white border border-[#E8E1D5] p-5 rounded-xs transition open:border-[#B87353] soft-shadow">
            <summary class="font-serif text-base text-[#262220] cursor-pointer list-none flex items-center justify-between font-medium">
              <span>{faq.question}</span>
              <span class="text-[#B87353] group-open:rotate-180 transition-transform text-sm">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-[#756A66] font-light leading-relaxed border-t border-[#E8E1D5] pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 6. DÖNÜŞÜM CTA (KADINLARA ÖZEL ZARİF DOKUNUŞ)                         -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-gradient-to-br from-[#FAF6F0] via-[#F5EFE6] to-[#EFE6D8] border-b border-[#E8E1D5] text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <span class="text-xs uppercase font-bold tracking-[0.25em] text-[#B87353] block">ÜCRETSİZ MİMARİ KEŞİF</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#262220]">
        Evinizin Ruhuna Uygun Yeni Bir Mutfak
      </h2>
      <p class="text-sm text-[#473E3B] font-light leading-relaxed max-w-xl mx-auto">
        Mimarımızla tanışın, evinizde lazer ölçümü alalım ve size özel 3D tasarım alternatiflerini hazırlayalım.
      </p>
