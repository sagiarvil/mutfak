---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import tasarimlar from "../data/tasarimlarData.json";

// Kare formatta sergilenecek 8 seçkin tasarım modeli
const featuredModels = tasarimlar.slice(0, 8);

const seo = {
  title: "Yeşilay Mutfak — Lüks Mutfak Tasarımı, Banyo & Anahtar Teslim Renovasyon",
  description: "İzmir Buca Adatepe atölyemizden kişiye ve mekâna özel projelendirilen akrilik, lake mutfak dolapları, lüks banyo renovasyonu ve anahtar teslim konut taahhüdü. 28 yıllık tecrübe, 137 tescilli model arşivi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "Lüks Mimarlık & Mutfak İmalatı",
  keywords: [
    "yeşilay mutfak luxury",
    "yeşilay mutfak mimarlık",
    "izmir özel mutfak dolabı",
    "lake mutfak modelleri 2026",
    "lüks banyo dolabı izmir",
    "adatepe mutfak atölyesi",
    "çeşme mutfak tadilatı",
    "urla lüks renovasyon"
  ],
  faqList: [
    {
      question: "Dolap kapaklarında parmak izi ve leke tutmayan malzeme kullanıyor musunuz?",
      answer: "Evet. Koleksiyonumuzda özel nanoteknolojik ipek mat lake ve İtalyan akrilik kapaklar kullanıyoruz. Yüzeyler parmak izi tutmaz, nemli mikro fiber bezle tek hamlede kolayca temizlenir."
    },
    {
      question: "Tasarım aşamasında renk ve malzeme uyumunu nasıl görebiliriz?",
      answer: "Mimarımız yerinde lazer rölöve aldıktan sonra evinizin ışık açısına uygun fotogerçekçi 3D mimari çizim hazırlar. Tezgah, kulp, zemin ve kapak renk uyumunu üretime geçmeden önce ekranınızda birebir görürsünüz."
    },
    {
      question: "Çekmece ve dolap iç mekanizmalarında hangi donanımları tercih ediyorsunuz?",
      answer: "Tüm sistemlerimizde Avusturya menşeili Blum ve Almanya menşeili Häfele entegre sessiz frenli raylar ve kiler sistemleri kullanıyoruz. Çekmeceler tek dokunuşla sessizce kapanır ve 10 yıl garantilidir."
    },
    {
      question: "İzmir genelinde mutfak yaptırırken Yeşilay Mutfak'ı tercih etmenin somut avantajı nedir?",
      answer: "Aracı veya komisyoncu showroom olmadan doğrudan Buca Adatepe imalat atölyemizden birinci el fiyat alırsınız. Gövdede standart olarak neme mukavemetli 18mm E1 MDF-Lam ve Avusturya Blum mekanizma kullanılır. Resmi sözleşmemizde taahhüt edilen teslim tarihine sadakat garantisi ve gecikilen her takvim günü için cezai şart güvencesi sunulur."
    },
    {
      question: "Sözleşmeli süre taahhüdü ve temiz teslimat garantiniz var mı?",
      answer: "Tüm projelerimizi resmi noter onaylı gecikme cezalı sözleşmeyle yürütüyoruz. İmalat ve montaj ekibimiz montaj bitiminde detaylı temizlik yaparak alanınızı kullanıma hazır teslim eder."
    }
  ]
};
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. APPLE MİMARİSİ HERO ALANI & SİNEMATİK VİDEO                       -->
  <!-- ===================================================================== -->
  <section class="relative w-full overflow-hidden bg-[#FAF9F6] border-b border-[#E5DFD5]" style="min-height: 88vh;">
    
    <!-- Referans Video Arka Planı (Haresiz, Saf %100 Hollywood Sinematik Netliği) -->
    <div class="absolute inset-0 w-full h-full overflow-hidden">
      <video
        id="heroBgVideo"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster="/media/cinematic/home_video_photo.webp"
        class="w-full h-full object-cover opacity-100 scale-100"
      >
        <source src="/media/cinematic/home_video.mp4" type="video/mp4" />
      </video>
      <!-- Yalnızca sol metin alanını pürüzsüzce kucaklayan dikey yumuşak ışık (asla üstte yatay hare oluşturmaz) -->
      <div class="absolute inset-y-0 left-0 w-full md:w-[60%] lg:w-[50%] bg-gradient-to-r from-[#FAF9F6]/95 via-[#FAF9F6]/70 to-transparent pointer-events-none"></div>
    </div>

    <!-- Hero İçerik (Kutusuz, Havada Süzülen Organik Apple Tipografisi) -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-20 sm:py-28 flex flex-col justify-center items-start min-h-[88vh] z-10">
      <div class="max-w-2xl space-y-6">
        
        <!-- Apple Capsule Eyebrow (Rolex Yeşil & Altın Zanaat) -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 bg-[#006039] text-white border border-[#C5A880]/50 rounded-full shadow-[0_4px_16px_rgba(0,96,57,0.35)]">
          <span class="w-2 h-2 rounded-full bg-[#8B1E2D] animate-pulse"></span>
          <span class="text-white text-[11px] font-semibold tracking-[0.14em] uppercase font-sans">
            ADATEPE İMALAT ATÖLYESİ • <span class="text-[#C5A880]">28 YILLIK TECRÜBE</span>
          </span>
        </div>

        <!-- Apple Headline (SF Pro Display Scale: 44px - 60px) -->
        <h1 class="text-[38px] sm:text-[52px] lg:text-[60px] font-bold text-[#1D1D1F] leading-[1.08] tracking-[-0.03em]">
          Hayalinizdeki Mutfağı, <br />
          <span class="font-normal italic text-[#006039]">Kişiye Özel Çizgilerle</span> <br />
          <span class="font-medium text-[#0A2E1F]">Gerçeğe Dönüştürüyoruz.</span>
        </h1>

        <!-- Apple Subhead (17px, line-height 1.5) -->
        <p class="text-[16px] sm:text-[17px] text-[#424245] font-normal leading-[1.5] max-w-xl tracking-[-0.01em]">
          Leke tutmayan ipek mat kapaklar, fırçalanmış pirinç detaylar, kadife sessizliğinde Blum raylar ve ferahlatıcı mimari planlama. İzmir genelinde ücretsiz 3D keşif.
        </p>

        <!-- Apple Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white text-[13px] font-semibold tracking-[-0.01em] rounded-full border border-[#C5A880]/50 shadow-[0_6px_20px_rgba(0,96,57,0.4)] transition duration-200 flex items-center justify-center gap-2"
          >
            <span>WhatsApp ile 3D Keşif İste</span>
            <span>→</span>
          </a>
          <a 
            href="/tasarimlar/" 
            class="px-8 py-3.5 bg-white hover:bg-[#F5F5F7] text-[#006039] border border-[#006039]/30 hover:border-[#006039] text-[13px] font-semibold tracking-[-0.01em] rounded-full shadow-2xs transition duration-200 flex items-center justify-center gap-2"
          >
            <span>137 Tasarım Modelini İncele</span>
          </a>
        </div>

      </div>

      <!-- Genişletilmiş Premium Hareketli Sayaç Docku (Apple Glassmorphism Standartı) -->
      <div id="statsDock" class="mt-12 sm:mt-16 w-full max-w-7xl bg-white/95 backdrop-blur-xl border border-[#006039]/20 rounded-2xl sm:rounded-3xl p-7 sm:p-10 shadow-[0_20px_50px_rgba(0,96,57,0.08)] relative overflow-hidden">
        <div class="absolute -right-8 -bottom-8 w-56 h-56 bg-[#006039]/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-8 -top-8 w-44 h-44 bg-[#C5A880]/15 rounded-full blur-2xl pointer-events-none"></div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 relative z-10">
          
          <!-- Sayaç 1: 137 Model -->
          <div class="space-y-1 pr-3 sm:border-r border-[#E5DFD5]/80">
            <div class="flex items-baseline gap-1.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="137">0</span>
              <span class="text-sm sm:text-base font-bold text-[#C5A880]">Model</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#C5A880] font-bold">Özgün Koleksiyon</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">Mutfak, banyo ve kapı arşivi.</p>
          </div>

          <!-- Sayaç 2: 28 Yıl -->
          <div class="space-y-1 pr-3 lg:border-r border-[#E5DFD5]/80">
            <div class="flex items-baseline gap-1.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#006039] font-sans" data-target="28">0</span>
              <span class="text-sm sm:text-base font-bold text-[#006039]">Yıl</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#006039] font-bold">Atölye Mirası</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">1998'den bu yana kendi imalatımız.</p>
          </div>

          <!-- Sayaç 3: 10 Yıl -->
          <div class="space-y-1 pr-3 sm:border-r border-[#E5DFD5]/80">
            <div class="flex items-baseline gap-1.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="10">0</span>
              <span class="text-sm sm:text-base font-bold text-[#C5A880]">Yıl</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#C5A880] font-bold">Gövde Garantisi</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">E1 sertifikalı nem mukavemetli MDF.</p>
          </div>

          <!-- Sayaç 4: 2.850+ -->
          <div class="space-y-1">
            <div class="flex items-baseline gap-0.5">
              <span class="stat-counter text-3xl sm:text-4xl lg:text-[44px] font-bold tracking-tight text-[#1D1D1F] font-sans" data-target="2850" data-format="comma">0</span>
              <span class="text-2xl sm:text-3xl font-extrabold text-[#006039]">+</span>
            </div>
            <div class="text-[10.5px] uppercase tracking-wider text-[#006039] font-bold">Tamamlanan Proje</div>
            <p class="text-[12px] text-[#6E675F] leading-snug hidden sm:block">İzmir genelinde mutlu müşteri referansı.</p>
          </div>

        </div>

        <!-- AEO & Grounding Micro Bar -->
        <div class="mt-5 pt-3.5 border-t border-[#E5DFD5]/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11.5px] text-[#55504A]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#8B1E2D] animate-pulse"></span>
            <span><strong>Adatepe İmalat Atölyesi:</strong> Aracı komisyonsuz, milimetrik lazer rölöve ve fotogerçekçi 3D mimari modelleme.</span>
          </div>
          <a href="/tasarimlar/" class="text-[#006039] font-bold hover:underline inline-flex items-center gap-1 shrink-0">
            Koleksiyonu İncele →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. APPLE 4-SÜTUNLU MİMARİ AVANTAJ KARTLARI (BÜYÜK & PREMİUM NUMARALAR)-->
  <!-- ===================================================================== -->
  <section class="py-16 sm:py-20 bg-[#F4F1EA] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- GHOST / WATERMARK TYPOGRAPHY HEADER (Dev Enlemesine Soft Watermark Üstte, Altında Başlık Grubu) -->
      <div class="text-center w-full max-w-7xl mx-auto flex flex-col items-center justify-center space-y-2 sm:space-y-3">
        <div class="w-full max-w-3xl sm:max-w-4xl md:max-w-5xl px-4 flex items-center justify-center pointer-events-none select-none">
          <svg viewBox="0 0 580 165" class="w-full h-auto max-h-[85px] sm:max-h-[115px] md:max-h-[140px]" preserveAspectRatio="xMidYMid meet">
            <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-size="160" font-weight="700" font-style="italic" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" fill="#D5D0C5" letter-spacing="-0.02em">Zanaat.</text>
          </svg>
        </div>
        <div class="space-y-2.5 px-4 max-w-3xl mx-auto">
          <h2 class="text-[28px] sm:text-[38px] md:text-[44px] font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
            Kusursuz Detaylar. Tavizsiz Kalite.
          </h2>
          <p class="text-[15px] sm:text-[16.5px] text-[#55504A] font-normal max-w-xl mx-auto leading-relaxed">
            Her milimetresi yaşam alışkanlıklarınıza ve mekanınızın ışığına göre şekillenen birinci sınıf atölye üretimi.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Kart 01 -->
        <div class="p-8 bg-white border border-[#E5DFD5] hover:border-[#006039]/50 rounded-2xl apple-card space-y-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(0,96,57,0.12)] transition duration-300 group">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#006039] to-[#042015] text-[#C5A880] border border-[#C5A880]/50 flex items-center justify-center text-[38px] font-black font-sans shadow-[0_8px_24px_rgba(0,96,57,0.4)] group-hover:scale-105 transition-transform duration-300">
            01
          </div>
          <h3 class="text-[21px] sm:text-[22px] font-extrabold text-[#1D1D1F] tracking-tight leading-snug">Leke Tutmayan Mat Yüzeyler</h3>
          <p class="text-[15px] text-[#55504A] font-normal leading-[1.6]">
            Parmak izi bırakmayan, nem ve buhardan etkilenmeyen antibakteriyel İtalyan lake ve akrilik teknolojisi.
          </p>
        </div>

        <!-- Kart 02 -->
        <div class="p-8 bg-white border border-[#E5DFD5] hover:border-[#006039]/50 rounded-2xl apple-card space-y-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(0,96,57,0.12)] transition duration-300 group">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#006039] to-[#042015] text-[#C5A880] border border-[#C5A880]/50 flex items-center justify-center text-[38px] font-black font-sans shadow-[0_8px_24px_rgba(0,96,57,0.4)] group-hover:scale-105 transition-transform duration-300">
            02
          </div>
          <h3 class="text-[21px] sm:text-[22px] font-extrabold text-[#1D1D1F] tracking-tight leading-snug">Kadife Sessizliğinde Blum Ray</h3>
          <p class="text-[15px] text-[#55504A] font-normal leading-[1.6]">
            Avusturya menşeili entegre frenli mekanizmalar ile dolap kapakları ve çekmeceler daima sessizce kapanır.
          </p>
        </div>

        <!-- Kart 03 -->
        <div class="p-8 bg-white border border-[#E5DFD5] hover:border-[#006039]/50 rounded-2xl apple-card space-y-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(0,96,57,0.12)] transition duration-300 group">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#006039] to-[#042015] text-[#C5A880] border border-[#C5A880]/50 flex items-center justify-center text-[38px] font-black font-sans shadow-[0_8px_24px_rgba(0,96,57,0.4)] group-hover:scale-105 transition-transform duration-300">
            03
          </div>
          <h3 class="text-[21px] sm:text-[22px] font-extrabold text-[#1D1D1F] tracking-tight leading-snug">3D Çizimle Birebir Önizleme</h3>
          <p class="text-[15px] text-[#55504A] font-normal leading-[1.6]">
            Evinizin ölçülerine özel fotogerçekçi 3D mimari modelleme ile renkleri ve kulpları önceden görün.
          </p>
        </div>

        <!-- Kart 04 -->
        <div class="p-8 bg-white border border-[#E5DFD5] hover:border-[#006039]/50 rounded-2xl apple-card space-y-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(0,96,57,0.12)] transition duration-300 group">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-[#006039] to-[#042015] text-[#C5A880] border border-[#C5A880]/50 flex items-center justify-center text-[38px] font-black font-sans shadow-[0_8px_24px_rgba(0,96,57,0.4)] group-hover:scale-105 transition-transform duration-300">
            04
          </div>
          <h3 class="text-[21px] sm:text-[22px] font-extrabold text-[#1D1D1F] tracking-tight leading-snug">Sözleşmeli Süre & Sabit Fiyat</h3>
          <p class="text-[15px] text-[#55504A] font-normal leading-[1.6]">
            Sürpriz masraf çıkarmayan resmi sözleşme, gecikme cezası garantisi ve temiz, tertipli montaj teslimi.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. %100 KARE VE SİMETRİK GÖRSEL VİTRİNİ (APPLE PHOTO GRID)          -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- GHOST / WATERMARK TYPOGRAPHY HEADER (Dev Enlemesine Soft Watermark Üstte, Altında Başlık Grubu) -->
      <div class="text-center w-full max-w-7xl mx-auto flex flex-col items-center justify-center space-y-2 sm:space-y-3">
        <div class="w-full max-w-3xl sm:max-w-4xl md:max-w-5xl px-4 flex items-center justify-center pointer-events-none select-none">
          <svg viewBox="0 0 920 165" class="w-full h-auto max-h-[85px] sm:max-h-[115px] md:max-h-[140px]" preserveAspectRatio="xMidYMid meet">
            <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" font-size="160" font-weight="700" font-style="italic" font-family="'Cormorant Garamond', 'Playfair Display', Georgia, serif" fill="#DBD7CD" letter-spacing="-0.02em">Koleksiyon.</text>
          </svg>
        </div>
        <div class="space-y-2.5 px-4 max-w-3xl mx-auto">
          <h2 class="text-[28px] sm:text-[38px] md:text-[44px] font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
            Öne Çıkan Mimari Modellerimiz.
          </h2>
          <p class="text-[15px] sm:text-[16.5px] text-[#55504A] font-normal max-w-xl mx-auto leading-relaxed">
            İzmir genelinde villa ve seçkin konutlar için üretilen 137 tescilli özgün tasarım arşivi.
          </p>
        </div>
      </div>

      <!-- Kategori Filtre Butonları -->
      <div class="flex flex-wrap gap-2 text-[12px]">
        <a href="/tasarimlar/" class="px-4 py-2 bg-[#006039] hover:bg-[#00482B] text-white font-semibold rounded-full border border-[#C5A880]/40 shadow-[0_4px_12px_rgba(0,96,57,0.25)]">Tümü (137 Model)</a>
        <a href="/tasarimlar/?kategori=mutfak" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] hover:border-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Mutfak Tasarımları (40)</a>
        <a href="/tasarimlar/?kategori=kapilar" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] hover:border-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Özel Kapılar (39)</a>
        <a href="/tasarimlar/?kategori=gomme-dolap" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] hover:border-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Giyinme Odası (33)</a>
        <a href="/tasarimlar/?kategori=banyo" class="px-4 py-2 bg-white text-[#1D1D1F] hover:text-[#006039] hover:border-[#006039] font-medium rounded-full border border-[#D2D2D7] hover:bg-[#F5F5F7] transition">Lüks Banyo (25)</a>
      </div>

      <!-- %100 KARE VE SİMETRİK GRID (aspect-square & hizada kartlar) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredModels.map((item) => (
          <div class="group bg-white border border-[#E5DFD5] hover:border-[#006039] rounded-xl overflow-hidden flex flex-col justify-between apple-card transition duration-300">
            
            <!-- KARE GÖRSEL KAPSAYICI (aspect-square: 100% simetrik, taşma yok) -->
            <div class="relative w-full aspect-square overflow-hidden bg-[#F5F5F7] shrink-0">
              <img 
                src={item.img} 
                alt={item.altText || item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-[#006039]/95 backdrop-blur-md text-white text-[10px] font-semibold uppercase tracking-wider rounded-md border border-[#C5A880]/40 shadow-2xs">
                {item.modelNo}
              </span>
            </div>

            <!-- Bilgi Alanı (Kusursuz Eşit Yükseklik & Tipografi) -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-1">
                <span class="text-[11px] uppercase tracking-wider font-semibold text-[#C5A880] block">
                  {item.category}
                </span>
                <h3 class="text-[14px] font-semibold text-[#1D1D1F] group-hover:text-[#006039] transition line-clamp-2 leading-snug tracking-tight">
                  {item.title}
                </h3>
              </div>
              
              <div class="pt-3 border-t border-[#E5DFD5] flex items-center justify-between text-[12px]">
                <span class="text-[#86868B]">Özel Ölçü Üretim</span>
                <a 
                  href={`https://wa.me/905324261788?text=Merhaba,%20${item.modelNo}%20kodlu%20modeliniz%20hakkında%20bilgi%20ve%20ücretsiz%203D%20keşif%20istiyorum.`} 
                  target="_blank" 
