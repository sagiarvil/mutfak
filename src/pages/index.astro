---
import Layout from "../layouts/Layout.astro";
import PaintBrands from "../components/PaintBrands.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "İzmir Mutfak Banyo — Lüks Ada Mutfak, Banyo & Anahtar Teslim Tadilat",
  description: "İzmir genelinde kişiye ve mekana özel lüks ada mutfak dolapları, lüks banyo renovasyonu, giyinme odaları ve anahtar teslim daire/villa taahhüdü. 28 yıllık üretim tecrübesi.",
  canonical: `${siteConfig.siteUrl}/`,
  serviceName: "İzmir Mutfak Banyo Tasarım & İmalat",
  keywords: [
    "izmir ada mutfak",
    "izmir mutfak dolabı imalatı",
    "lüks banyo tadilatı izmir",
    "lake mutfak modelleri",
    "akrilik mutfak dolabı",
    "anahtar teslim ev tadilatı izmir"
  ]
};

// 4 Ana Kategori - 5 Saniyede Ne Satıldığını Gösteren Büyük Kartlar
const mainSectors = [
  {
    num: "01",
    tag: "ÖZEL İMALAT",
    title: "LÜKS ADA MUTFAK",
    sub: "Calacatta Mermer • İpek Mat Lake • Blum Mekanizma",
    img: "/media/showcase/mutfak-calacatta-hero.webp",
    link: "/tasarimlar/?kategori=mutfak",
    cta: "Mutfak Modelleri"
  },
  {
    num: "02",
    tag: "ISLAK HACİM",
    title: "MİMARİ BANYO",
    sub: "Arduvaz Doğal Taş • Marin Ahşap • Füme Cam Duş",
    img: "/media/showcase/banyo-arduvaz-luks.png",
    link: "/tasarimlar/?kategori=banyo",
    cta: "Banyo Modelleri"
  },
  {
    num: "03",
    tag: "MODERN YAŞAM",
    title: "GİYİNME ODASI & KAPI",
    sub: "Füme Cam Vitrin • Entegre LED • Lake Oda Kapıları",
    img: "/media/showcase/gardirob-fume-led.webp",
    link: "/tasarimlar/?kategori=kapilar",
    cta: "Dolap & Kapı Modelleri"
  },
  {
    num: "04",
    tag: "ANAHTAR TESLİM",
    title: "KOMPLE EV TADİLATI",
    sub: "Kırımdan Montaja • Tesisat • Sabit Fiyat Garantisi",
    img: "/media/showcase/mutfak-havuz-ada.webp",
    link: "/izmir-anahtar-teslim-tadilat/",
    cta: "Tadilat Detayları"
  }
];

// Görsel Hikaye Vitrini (Kullanıcının Gerçek Fotoğrafları)
const galleryStories = [
  {
    title: "Panoramik Havuzlu Ada Mutfak",
    tag: "VİLLA PROJESİ",
    img: "/media/showcase/mutfak-havuz-ada.webp",
    span: "col-span-1 md:col-span-2 row-span-2 aspect-[16/10] md:aspect-auto"
  },
  {
    title: "İtalyan Açık Salon & Ada Mutfak",
    tag: "MİLANO DİZAYN",
    img: "/media/showcase/salon-ada-mutfak.webp",
    span: "col-span-1 aspect-[4/3]"
  },
  {
    title: "Antrasit Akrilik & Fümeli Cam Dolap",
    tag: "BOY KİLER",
    img: "/media/showcase/mutfak-antrasit-led.webp",
    span: "col-span-1 aspect-[4/3]"
  },
  {
    title: "Monoblok Taş Lavabo & Altın Batarya",
    tag: "LÜKS BANYO",
    img: "/media/showcase/banyo-altin-lavabo.webp",
    span: "col-span-1 aspect-[4/3]"
  },
  {
    title: "Country Masif Ahşap Ada",
    tag: "RUSTİK ŞIKLIK",
    img: "/media/showcase/mutfak-country-ada.png",
    span: "col-span-1 aspect-[4/3]"
  }
];
---

<Layout seo={seo} activeService="Ana Sayfa">

  <!-- ===================================================================== -->
  <!-- 1. YENİ NESİL 2077 İNTERAKTİF HERO (5 SANİYEDE ANLAŞILAN GÖRSEL ŞÖLEN)-->
  <!-- ===================================================================== -->
  <section class="relative w-full bg-[#172127] text-white overflow-hidden" style="min-height: 82vh;">
    
    <!-- Arka Plan Büyük Görsel + Dinamik Gradient -->
    <div class="absolute inset-0 w-full h-full">
      <img 
        src="/media/showcase/mutfak-calacatta-hero.webp" 
        alt="İzmir Mutfak Banyo Lüks Ada Mutfak Tasarımı" 
        class="w-full h-full object-cover object-center scale-105 transition-transform duration-1000 ease-out" 
        width="1920" 
        height="1080" 
        loading="eager" 
        fetchpriority="high"
      />
      <!-- Koyu Füme & Kristal Karartma -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#172127]/95 via-[#172127]/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#172127] via-transparent to-black/30"></div>
    </div>

    <!-- Hero Ön Katman -->
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6 min-h-[82vh] flex flex-col justify-center items-start z-10 py-16">
      
      <div class="max-w-2xl space-y-6">
        
        <!-- Üst Vurucu Rozet -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-black/60 border border-white/20 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-[#CB000F] animate-ping"></span>
          <span class="text-[11px] font-extrabold tracking-[0.2em] uppercase text-white font-['Montserrat',sans-serif]">
            DOĞRUDAN ATÖLYEDEN • ARACISIZ İMALAT
          </span>
        </div>

        <!-- 5 Saniyede Ne Olduğunu Vuran Ana Başlık -->
        <div class="space-y-2">
          <h1 class="text-3xl sm:text-5xl lg:text-[62px] font-black text-white uppercase tracking-tight leading-[1.05] font-['Montserrat',sans-serif]">
            LÜKS MUTFAK, BANYO &amp; TADİLAT.
          </h1>
          <div class="w-24 h-1.5 bg-[#CB000F]"></div>
        </div>

        <!-- 1 Satırlık Net Mesaj -->
        <p class="text-base sm:text-lg text-gray-200 font-medium leading-relaxed font-['Montserrat',sans-serif] max-w-xl">
          Evinizin kalbine İtalyan çizgisi: Kendi atölyemizde üretiyor, 1 günde sıfır hata ile monte ediyoruz.
        </p>

        <!-- 3 Adet Canlı İtalyan Özellik Maddesi -->
        <div class="grid grid-cols-3 gap-3 pt-1 text-xs">
          <div class="p-3 bg-black/40 backdrop-blur-md rounded-lg border border-white/10">
            <div class="text-[#CB000F] font-black text-sm">3D Çizim</div>
            <div class="text-gray-300 text-[11px] mt-0.5">Ücretsiz Lazer Keşif</div>
          </div>
          <div class="p-3 bg-black/40 backdrop-blur-md rounded-lg border border-white/10">
            <div class="text-[#CB000F] font-black text-sm">Sabit Fiyat</div>
            <div class="text-gray-300 text-[11px] mt-0.5">Sözleşme Güvencesi</div>
          </div>
          <div class="p-3 bg-black/40 backdrop-blur-md rounded-lg border border-white/10">
            <div class="text-[#CB000F] font-black text-sm">10 Yıl Garanti</div>
            <div class="text-gray-300 text-[11px] mt-0.5">Avusturya Blum Ray</div>
          </div>
        </div>

        <!-- İki Büyük Eylem Butonu -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-3">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-4 bg-[#CB000F] hover:bg-[#b0000d] text-white font-['Montserrat',sans-serif] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded transition-all duration-200 shadow-2xl flex items-center justify-center gap-2 hover:scale-105"
          >
            <span>WhatsApp ile 3D Keşif İste</span>
            <span>→</span>
          </a>
          <a 
            href="/maliyet-hesapla/" 
            class="px-8 py-4 bg-white hover:bg-gray-100 text-[#172127] font-['Montserrat',sans-serif] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded transition-all duration-200 shadow-xl flex items-center justify-center gap-2 hover:scale-105"
          >
            <span>🧮 30 Saniyede Fiyat Hesapla</span>
          </a>
        </div>

      </div>

    </div>

    <!-- Canlı Sayaç Şeridi (Hero Tabanı) -->
    <div class="absolute bottom-0 inset-x-0 bg-[#23323A]/90 backdrop-blur-md border-t border-white/10 py-3 hidden md:block z-10">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 flex items-center justify-between text-xs font-['Montserrat',sans-serif]">
        <div class="flex items-center gap-2">
          <span class="text-[#CB000F] font-black text-base">137</span>
          <span class="text-gray-300 font-bold uppercase">Özgün Model</span>
        </div>
        <div class="text-gray-600">•</div>
        <div class="flex items-center gap-2">
          <span class="text-[#CB000F] font-black text-base">28 Yıl</span>
          <span class="text-gray-300 font-bold uppercase">Atölye Tecrübesi</span>
        </div>
        <div class="text-gray-600">•</div>
        <div class="flex items-center gap-2">
          <span class="text-[#CB000F] font-black text-base">2.850+</span>
          <span class="text-gray-300 font-bold uppercase">Teslim Edilen Ev</span>
        </div>
        <div class="text-gray-600">•</div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-black text-base">%100</span>
          <span class="text-gray-300 font-bold uppercase">Kendi İmalatımız</span>
        </div>
      </div>
    </div>

  </section>

  <!-- ===================================================================== -->
  <!-- 2. 5 SANİYEDE NE SATILDIĞINI ANLATAN 4 BÜYÜK ALAN KARTI                 -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F4F6F8] border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-8">
      
      <div class="flex items-end justify-between border-b-2 border-gray-200 pb-4">
        <div>
          <span class="text-[11px] font-black uppercase tracking-[0.2em] text-[#CB000F] font-['Montserrat',sans-serif] block">
            UZMANLIK ALANLARIMIZ
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-[#172127] uppercase font-['Montserrat',sans-serif] mt-1">
            Neler Üretiyoruz?
          </h2>
        </div>
        <a href="/tasarimlar/" class="text-xs font-bold text-[#CB000F] hover:text-[#172127] transition font-['Montserrat',sans-serif] uppercase hidden sm:block">
          Tüm Kataloğu Gör →
        </a>
      </div>

      <!-- 4 Büyük Kart Grid'i (Hover Zoom & Neon Çerçeve) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {mainSectors.map((sector) => (
          <a 
            href={sector.link} 
            class="group relative bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-[#CB000F] shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col justify-between gsap-reveal td-card-spring"
          >
            <!-- Üst Görsel -->
            <div class="relative aspect-[4/3] overflow-hidden bg-[#172127]">
              <img 
                src={sector.img} 
                alt={sector.title} 
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" 
                loading="lazy" 
                width="400" 
                height="300" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              
              <!-- Sayı & Rozet -->
              <span class="absolute top-3 left-3 px-2 py-0.5 bg-black/70 text-white font-['Montserrat',sans-serif] text-[10px] font-black rounded">
                {sector.num}
              </span>
              <span class="absolute top-3 right-3 px-2 py-0.5 bg-[#CB000F] text-white font-['Montserrat',sans-serif] text-[9px] font-black uppercase tracking-wider rounded">
                {sector.tag}
              </span>

              <!-- Görsel İçi Başlık -->
              <h3 class="absolute bottom-3 left-3 right-3 text-white font-['Montserrat',sans-serif] text-base font-black uppercase leading-tight group-hover:text-[#CB000F] transition">
                {sector.title}
              </h3>
            </div>

            <!-- Kart Altı Açıklama & Buton -->
            <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
              <p class="text-xs text-[#555] font-['Montserrat',sans-serif] font-medium leading-relaxed">
                {sector.sub}
              </p>

              <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs font-['Montserrat',sans-serif]">
                <span class="text-[#CB000F] font-black group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  <span>{sector.cta}</span>
                  <span>→</span>
                </span>
                <span class="text-gray-400 text-[10px] uppercase font-bold">1. El Atölye</span>
              </div>
            </div>

          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. GERÇEK ŞANTİYE DÖNÜŞÜM KANITI (KADINLARIN EN ÇOK GÜVENDİĞİ MODÜL) -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-8">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-[11px] font-black uppercase tracking-[0.2em] text-[#CB000F] font-['Montserrat',sans-serif] block">
          ŞANTİYE DÖNÜŞÜM KANITI
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#23323A] uppercase font-['Montserrat',sans-serif]">
          Kırım &amp; Molozdan Kusursuz Lükse
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 font-['Montserrat',sans-serif]">
          İzmir genelinde teslim ettiğimiz gerçek banyo ve mutfak renovasyonlarının canlı kanıtı.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Sol: Büyük Öncesi / Sonrası Gerçek Görsel -->
        <div class="lg:col-span-8">
          <div class="relative rounded-2xl overflow-hidden border-2 border-gray-300 shadow-2xl group">
            <img 
              src="/media/showcase/banyo-oncesi-sonrasi.png" 
              alt="Banyo Tadilatı Öncesi ve Sonrası Dönüşüm Kanıtı" 
              class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-700" 
              width="1000" 
              height="600" 
              loading="lazy" 
            />
            <div class="absolute top-4 left-4 px-3 py-1 bg-[#CB000F] text-white font-['Montserrat',sans-serif] text-xs font-black uppercase rounded shadow-lg">
              KIRIM &amp; ŞANTİYE
            </div>
            <div class="absolute top-4 right-4 px-3 py-1 bg-[#23323A] text-white font-['Montserrat',sans-serif] text-xs font-black uppercase rounded shadow-lg">
              ANAHTAR TESLİM SON HALİ
            </div>
          </div>
        </div>

        <!-- Sağ: 3 Adımlı Kesintisiz Süreç -->
        <div class="lg:col-span-4 space-y-4">
          
          <div class="p-4 bg-[#F4F6F8] rounded-xl border border-gray-200 space-y-1">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#CB000F] text-white text-xs font-black flex items-center justify-center">1</span>
              <strong class="font-['Montserrat',sans-serif] text-sm text-[#23323A]">Lazer Keşif &amp; 3D Çizim</strong>
            </div>
            <p class="text-xs text-[#555] font-['Montserrat',sans-serif] pl-8">Evinize özel milimetrik ölçü alınır; üretime geçmeden önce 3D onaylarsınız.</p>
          </div>

          <div class="p-4 bg-[#F4F6F8] rounded-xl border border-gray-200 space-y-1">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#CB000F] text-white text-xs font-black flex items-center justify-center">2</span>
              <strong class="font-['Montserrat',sans-serif] text-sm text-[#23323A]">Kırım &amp; Su İzolasyonu</strong>
            </div>
            <p class="text-xs text-[#555] font-['Montserrat',sans-serif] pl-8">Eski tesisat yenilenir, çift kat su izolasyonu ile sızdırmazlık garanti edilir.</p>
          </div>

          <div class="p-4 bg-[#F4F6F8] rounded-xl border border-gray-200 space-y-1">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#23323A] text-white text-xs font-black flex items-center justify-center">3</span>
              <strong class="font-['Montserrat',sans-serif] text-sm text-[#23323A]">1 Günde Temiz Montaj</strong>
            </div>
            <p class="text-xs text-[#555] font-['Montserrat',sans-serif] pl-8">Kendi atölyemizde üretilen dolaplar belirlenen günde temiz teslim edilir.</p>
          </div>

          <div class="space-y-2 pt-2">
            <a 
              href="/oncesi-sonrasi/" 
              class="w-full py-3.5 bg-[#23323A] hover:bg-[#172127] text-white font-['Montserrat',sans-serif] text-xs font-extrabold uppercase tracking-wider rounded-lg text-center block transition shadow-md hover:scale-[1.02]"
            >
              ✨ Tüm Öncesi / Sonrası Projelerini İncele →
            </a>
            <a 
              href="/maliyet-hesapla/" 
              class="w-full py-3.5 bg-[#CB000F] hover:bg-[#b0000d] text-white font-['Montserrat',sans-serif] text-xs font-extrabold uppercase tracking-wider rounded-lg text-center block transition shadow-lg hover:scale-[1.02]"
            >
              Tadilat Maliyetinizi Canlı Hesaplayın →
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. GÖRSEL HİKAYE GALERİSİ: "SÖZLER DEĞİL, İŞLERİMİZ KONUŞSUN"         -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F4F6F8] border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-8">
      
      <div class="flex items-end justify-between border-b-2 border-gray-200 pb-4">
        <div>
          <span class="text-[11px] font-black uppercase tracking-[0.2em] text-[#CB000F] font-['Montserrat',sans-serif] block">
            SANATIMIZ &amp; ZANAATIMIZ
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-[#172127] uppercase font-['Montserrat',sans-serif] mt-1">
            Eserlerimiz
          </h2>
        </div>
        <a href="/yapilan-isler/" class="text-xs font-bold text-[#CB000F] hover:text-[#172127] transition font-['Montserrat',sans-serif] uppercase hidden sm:block">
          96 Canlı Projeyi Gör →
        </a>
      </div>

      <!-- Asimetrik Galeri Grid'i -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {galleryStories.map((story) => (
          <div class={`group relative rounded-xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-2xl transition-all duration-500 bg-[#172127] ${story.span}`}>
            
            <img 
              src={story.img} 
              alt={story.title} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" 
              loading="lazy" 
              width="600" 
              height="450" 
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>

            <span class="absolute top-4 left-4 px-3 py-1 bg-black/60 text-white font-['Montserrat',sans-serif] text-[10px] font-black uppercase tracking-wider rounded border border-white/20">
              {story.tag}
            </span>

            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="font-['Montserrat',sans-serif] text-base sm:text-lg font-black uppercase">
                {story.title}
              </h3>
              <div class="pt-2 mt-2 border-t border-white/20 flex items-center justify-between text-xs">
                <span class="text-gray-300 text-[11px]">Özel Atölye İmalatı</span>
                <a 
                  href={`https://wa.me/905393333303?text=Merhaba,%20web%20sitenizdeki%20'${encodeURIComponent(story.title)}'%20hakkında%20ücretsiz%20keşif%20istiyorum.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-3 py-1 bg-[#CB000F] hover:bg-[#b0000d] text-white rounded font-bold text-[11px] transition"
                >
                  3D Keşif Al
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. KENDİ CNC FABRİKAMIZ (ARACISIZ DOĞRUDAN ÜRETİM GÜVENCESİ)          -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#23323A] text-white border-b border-gray-800">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Sol: CNC Fabrika Görseli -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden border-2 border-white/20 shadow-2xl group">
            <img 
              src="/media/showcase/fabrika-cnc-uretim.png" 
              alt="İzmir Mutfak Banyo CNC Mobilya Fabrikası" 
              class="w-full h-[360px] sm:h-[420px] object-cover group-hover:scale-105 transition-transform duration-700" 
              width="800" 
              height="500" 
              loading="lazy" 
            />
            <div class="absolute bottom-0 inset-x-0 p-4 bg-black/80 backdrop-blur-sm text-white">
              <strong class="font-['Montserrat',sans-serif] text-sm text-[#CB000F] block">Buca İmalat Tesisimiz</strong>
              <span class="text-xs text-gray-300">Bilgisayarlı CNC kesim, otomatik kenar bantlama ve tozsuz lake kurutma kabini.</span>
            </div>
          </div>
        </div>

        <!-- Sağ: Aracısız Avantajlar -->
        <div class="lg:col-span-6 space-y-5">
          <div class="inline-block border-b-2 border-[#CB000F] pb-1">
            <span class="text-xs font-black uppercase tracking-widest text-[#CB000F] font-['Montserrat',sans-serif]">
              ARACISIZ İMALAT GÜVENCESİ
            </span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black text-white uppercase font-['Montserrat',sans-serif] leading-tight">
            Showroom Komisyonu Yok. <br />
            Doğrudan Fabrikadan Evinize.
