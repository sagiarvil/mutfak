---
import Layout from "../../layouts/Layout.astro";

const seo = {
  title: "İzmir Yaşam Alanları & Açık Mutfak Modelleri | Ada Bar & Entegre Yaşam",
  description: "İzmir'de salonla bütünleşik açık plan ada mutfak ve yaşam alanları mimarisi. Ada barlar, entegre TV ve kütüphane üniteleri, gizlenebilir cepli kapılar ve ücretsiz 3D sanal simülasyon.",
  canonical: "https://yesilaymutfak.com/yasam-alanlari-mutfak-modelleri/",
  serviceName: "Yaşam Alanları ve Açık Mutfak Modelleri",
  breadcrumbs: [
    { name: "Koleksiyonlar", url: "/#stretcher-section" },
    { name: "Yaşam Alanları | Life", url: "/yasam-alanlari-mutfak-modelleri/" }
  ],
  faqList: [
    {
      question: "Açık plan mutfaklarda yemek kokusu salona yayılır mı?",
      answer: "Doğru planlanmış bir açık mutfakta; 800-1000 m³/saat çekiş gücüne sahip sessiz fırçasız motorlu ada davlumbazları, aktif karbon plazma filtreler ve mimari hava akış yönlendirmesi sayesinde koku salona yayılmaz."
    },
    {
      question: "Salon ile mutfak arasındaki duvarı kaldırmak güvenli midir?",
      answer: "Kadrolu inşaat mühendisi ve mimarlarımız yerinde inceleme yaparak duvarın taşıyıcı (kolon/kiriş) olup olmadığını rölövede netleştirir. Taşıyıcı olmayan bölme duvarlar kontrollü olarak kırılır, gerekirse statik çelik lentoyla güçlendirilir."
    },
    {
      question: "Mutfak adası aynı zamanda yemek masası olarak kullanılabilir mi?",
      answer: "Kesinlikle. Ada üzerine tasarladığımız 30-40 cm genişliğindeki masif ahşap veya porselen oturma barları, 4-6 kişinin rahatça yemek yiyebileceği ve kahvaltı yapabileceği ergonomik bar sandalyeleriyle entegre edilir."
    },
    {
      question: "Mutfak mobilyası ile salon mobilyalarının uyumu nasıl sağlanır?",
      answer: "Aynı lake renk kodları, doğal meşe kaplamalar ve kuvars dokular kullanılarak mutfak dolaplarından salon TV ünitesine, konsola ve açık kitaplığa kesintisiz bir mimari geçiş tasarlanır."
    }
  ]
};

const models = [
  {
    id: "island-lounge-bar",
    title: "Mavişehir Geniş Ada Bar & Entegre Yaşam",
    badge: "En Popüler",
    tag: "Geniş Ada Bar & Şarap Dolabı",
        img: "/media/projeler/proje-13.webp",
    desc: "Yemek hazırlarken konuklarınızla sohbet edebileceğiniz 4 kişilik masif oturma barı, tezgah altı entegre şaraplık ve bardaklık ünitesiyle modern bir gastronomi sahnesi.",
    features: ["Masif Meşe Konsol Bar Tablası", "Entegre LED Aydınlatmalı Şaraplık", "Blum Legrabox Kiler Çekmeceleri", "Gizli Priz ve Kablosuz Şarj Kulesi"]
  },
  {
    id: "loft-open-space",
    title: "Bayraklı Yüksek Tavan Açık Salon Mutfak",
    badge: "Modern Loft",
    tag: "Metal Konstrüksiyon & Açık Ada",
        img: "/media/projeler/proje-14.webp",
    desc: "Tavandan asılan antrasit metal raf sistemleri, açık plan salon geçişi ve monoblok ada tezgahı. İzmir'in modern penthouse ve loft daireleri için tasarlandı.",
    features: ["Elektrostatik Tavan Asma Raf", "Çift Yönlü Kullanımlı Ada Dolapları", "Kuvars Şelale Kenar Dönüşü", "Dahili Bulaşık Makinesi Gizleme"]
  },
  {
    id: "fusion-media-kitchen",
    title: "Bostanlı TV Üniteli Kesintisiz Salon Mutfak",
    badge: "Bütünleşik Mimari",
    tag: "TV Ünitesi & Kütüphane Entegre",
        img: "/media/projeler/proje-15.webp",
    desc: "Mutfak boy dolaplarının salona doğru kesintisiz devam ederek TV ünitesi, akustik ahşap çıtalar ve açık kitaplığa dönüştüğü sıra dışı bir mimari deneyim.",
    features: ["Kesintisiz Akustik Ahşap Paneller", "Salonla Uyumlu Entegre TV Modülü", "Gizli Bas-Aç Dolap Kapakları", "İçten Aydınlatmalı Kütüphane"]
  },
  {
    id: "hideaway-pocket",
    title: "Sahilevleri Gizli Cepli Pocket Mekanizma",
    badge: "Akıllı Çözüm",
    tag: "Cepli Katlanır Kapaklar",
        img: "/media/projeler/proje-16.webp",
    desc: "Mutfak kullanılmadığında veya misafir ağırlarken tek bir hamleyle kapakların yan ceplere kayarak tezgah ve evyeyi tamamen gizlediği minimalist mucize.",
    features: ["Hawa / Blum Pocket Door Mekanizması", "Gövde İçine Gizlenen Kapak Sistemi", "Tezgah İçi Kahve Köşesi", "Sensörlü Otomatik İç Aydınlatma"]
  },
  {
    id: "panorama-balcony",
    title: "Güzelbahçe Bahçe Açılımlı Sürgülü Mutfak",
    badge: "Ferah & Aydınlık",
    tag: "Geniş Cam Cephe & Bahçe Çıkışı",
        img: "/media/projeler/proje-17.webp",
    desc: "Geniş sürme camlarla balkona veya terasa açılan, doğal gün ışığını sonuna kadar içeri alan ve açık havayla evi bütünleştiren ferah yaşam konsepti.",
    features: ["Neme ve Güneşe Ultra Dirençli Malzeme", "Açık Teras Servis Penceresi Uyumu", "Geniş Aile Ada Masası", "Lamine Porselen İnce Tezgah"]
  },
  {
    id: "studio-smart",
    title: "Konak Akıllı Depolamalı Stüdyo Mutfak",
    badge: "1+1 & Dubleks",
    tag: "Çok Fonksiyonlu Katlanır Ada",
        img: "/media/projeler/proje-18.webp",
    desc: "Metrekaresi kıymetli daireler için katlanabilir ada masası, gizli kiler çekmeceleri ve her santimetrekaresi akıllıca değerlendirilmiş kompakt yaşam alanı.",
    features: ["Açılır Kapanır Teleskopik Bar Masası", "Tavana Kadar Kesintisiz Depolama", "Entegre Mikrodalga ve Fırın Kulesi", "Köşe Dönen Çift Fasulye Sepet"]
  }
];
---

<Layout seo={seo} activeService="Yaşam Alanları | Life">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & SALONLA BÜTÜNLEŞEN YAŞAM ALANI) -->
  <section class="relative bg-[#FAFAF9] border-b border-[#E7E5E4] py-12 sm:py-20 overflow-hidden">
    <!-- Yumuşak Aydınlık Arka Plan Işığı -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F5F5F4]/60 to-transparent pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: 5 SANİYEDE ANLAŞILIR YAŞAM ALANI MİMARİSİ (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#041F14] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#0284C7] font-bold">Yaşam Alanları | Life</span>
          </nav>

          <!-- Prestij Rozeti -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#BAE6FD] rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#0284C7]"></span>
            <span class="text-xs font-bold tracking-[0.16em] uppercase text-[#0369A1] font-sans">
              AÇIK PLAN MİMARİSİ • SALONLA BÜTÜNLEŞİK ADA BAR
            </span>
          </div>

          <!-- Ana Başlık (Heyecan Uyandıran Sosyal Mutfak Konsepti) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-extrabold text-[#0C4A6E] leading-[1.12] tracking-tight">
            Mutfak Artık Servis Odası Değil; <br />
            <span class="text-[#0284C7] font-serif font-normal italic">Salonla Konuşan Ada Bar &amp;</span> <br />
            <span class="text-[#041F14]">Dostların Buluştuğu Yaşam Alanı.</span>
          </h1>

          <!-- Net & İkna Edici Açıklama -->
          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Duvarları yıkarak mutfağınızı salona katan, 4 kişilik ada yemek masaları, gizli kadeh ve kahve köşeleriyle donatılan modern mimari çözümler. Buca Adatepe tesisimizde mekanınıza özel statik analiz ve 3D simülasyonla tasarlıyoruz.
          </p>

          <!-- Kadınların Sevdiği 3 Yaşam Alanı Özelliği -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#E7E5E4] shadow-xs">
              <span class="text-[#0284C7] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Duvar Kırım &amp; Güvenli Statik</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#E7E5E4] shadow-xs">
              <span class="text-[#0284C7] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Ada Bar &amp; Gizli Priz Sistemleri</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#E7E5E4] shadow-xs">
              <span class="text-[#0284C7] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Sıfır Koku Emiş Çözümleri</span>
            </div>
          </div>

          <!-- Aksiyon Butonları -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905324261788?text=Merhaba%20Cem%20Bey,%20açık%20plan%20mutfak%20ve%20ada%20bar%20tasarımı%20için%20ücretsiz%203D%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Açık Mutfak Keşfi</span>
              <span>→</span>
            </a>
            <a 
              href="#modeller" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D6D3D1] text-[#0C4A6E] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>Modelleri İncele ↓</span>
            </a>
          </div>

        </div>

        <!-- SAĞ: BÜYÜLEYİCİ AÇIK PLAN ADA BAR KARESI (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(12,74,110,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-12.webp" 
              alt="İzmir Salonla Bütünleşik Açık Mutfak ve Ada Bar Tasarımı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <!-- Zarif Alt Bilgi Şeridi -->
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] uppercase font-bold tracking-widest text-[#C5A880] block">CANLI MONTAJ REFERANSI</span>
              <p class="text-sm font-semibold text-white mt-0.5">Güzelbahçe Yelki • Açık Plan Ada Bar &amp; Şömine Entegre</p>
            </div>
            <!-- Rozet -->
            <div class="absolute top-4 right-4 px-3 py-1 bg-white/95 backdrop-blur-md rounded-full shadow-md border border-[#E7E5E4] text-[11px] font-bold text-[#0C4A6E]">
              Sosyal Yaşam Alanı
            </div>
          </div>
        </div>

      </div>

      <!-- Alt Güvence Şeridi -->
      <div class="mt-12 pt-8 border-t border-[#E7E5E4] grid grid-cols-2 md:grid-cols-4 gap-6 text-center sm:text-left">
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#0284C7] font-sans">Açık Plan</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Geniş ve Aydınlık Salon Hissiyatı</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#041F14] font-sans">Ada Bar</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Yemek Masası ve Bar Bir Arada</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#C5A880] font-sans">Akustik Panel</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Doğal Ahşap Çıta Geçişleri</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#006039] font-sans">3D Simülasyon</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Önceden Birebir Canlandırma</span>
        </div>
      </div>

    </div>
  </section>
    </div>
  </section>

  <!-- TEKNİK STANDARTLAR TABLOSU -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-blue-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-800">AÇIK PLAN MİMARİ STANDARTLAR</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Açık Plan Mutfak &amp; Yaşam Alanı Mühendislik Kriterleri</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-blue-800">Statik Kırım &amp; Güçlendirme</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">İç mimar ve mühendis eşliğinde kolon/kiriş röntgeni. Taşıyıcı olmayan duvarların güvenli yıkımı, moloz tahliyesi ve tavan alçıpan birleşimleri.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-blue-800">Hava Emiş ve Koku Bariyeri</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Ada üstü pişirme alanlarında minimum 850 m³/h emiş gücüne sahip sessiz fırçasız motorlar ve koku moleküllerini parçalayan aktif karbon filtreler.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-blue-800">Salon Zemin ve Akış Geçişi</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Mutfak seramiği ile salon parkesi arasında kot farkını sıfırlayan gizli pirinç/alüminyum L profiller veya kesintisiz 60x120 derzsiz porselen zemin.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-blue-800">Entegre TV ve Konsol Uyumu</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Mutfakta kullanılan kapak malzemesi (lake, meşe kaplama) ile salonun TV ünitesi, kütüphane ve yemek konsolunun birebir aynı dokuda üretimi.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-blue-800">Cepli (Pocket Door) Gizleme</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Gerektiğinde tezgahı, küçük ev aletlerini ve bulaşık alanını 2 saniyede salon görüntüsünden izole eden sessiz cepli sürme kapak sistemleri.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-blue-800">Elektrik &amp; Ada Su Tesisatı</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Zemin altından adaya taşınan temiz su, gider ve 380V indüksiyon kablolaması. Zemin izolasyonu garantili anahtar teslim uygulama.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MODELLER GALERİSİ -->
  <section class="py-20 sm:py-28 bg-white" id="modeller">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-blue-700 block">MODERN YAŞAM KONSEPTLERİ</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Özgür ve Ferah <span class="font-normal italic">Yaşam Alanları Koleksiyonumuz</span>
        </h2>
        <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">
          Evinizin salonu ve mutfağını tek bir estetik harmoniye kavuşturan, misafirlerinizi keyifle ağırlayacağınız 6 yenilikçi açık plan model serimiz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {models.map((m) => (
          <div class="bg-stone-50 border border-stone-200 overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
            <div class="relative h-64 sm:h-72 overflow-hidden bg-stone-900">
              <img 
                src={m.img} 
                alt={`${m.title} - İzmir Açık Mutfak ve Ada Bar`} 
                class="w-full h-full object-cover transition duration-700 group-hover:scale-105" 
                loading="lazy" 
                decoding="async"
                width="600"
                height="400"
              />
              <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                <span class="px-2.5 py-1 bg-stone-950/85 text-blue-300 text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
                  {m.badge}
                </span>
                <span class="px-2.5 py-0.5 bg-white/90 text-[#041F14] text-[9.5px] font-bold uppercase tracking-wider">
                  {m.tag}
                </span>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <h3 class="text-xl font-bold text-[#041F14] group-hover:text-blue-800 transition">{m.title}</h3>
                <p class="text-xs text-stone-600 font-light leading-relaxed line-clamp-3">{m.desc}</p>
              </div>

              <div class="space-y-2 pt-2 border-t border-stone-200">
                <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400 block">Öne Çıkan Detaylar</span>
                <ul class="space-y-1 text-xs text-stone-700">
                  {m.features.map((f) => (
                    <li class="flex items-center gap-1.5">
                      <span class="text-blue-600 text-xs">✔</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-3 border-t border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] uppercase tracking-wider text-blue-800 block font-extrabold">MİMARİ PROJELENDİRME</span>
                  <span class="text-xs font-semibold text-stone-800">Siz Hayal Edin, Mimarımız Çizsin</span>
                </div>
                <a 
