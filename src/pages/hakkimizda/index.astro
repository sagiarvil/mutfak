---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Hakkımızda — İzmir İç Mimarlık & Özel İmalat Atölyesi | Cem Yeşilay Luxury",
  description: "1998'den bu yana İzmir Buca Adatepe'deki kendi imalat atölyemizde kişiye özel lüks mutfak dolapları, villa renovasyonları ve anahtar teslim mimari taahhüt üretiyoruz. 28 yıllık tecrübe ve aracısız imalatçı güvencesi.",
  canonical: `${siteConfig.siteUrl}/hakkimizda/`,
  serviceName: "Cem Yeşilay Mimarlık & İç Mimari",
  breadcrumbs: [
    { name: "Hakkımızda", url: "/hakkimizda/" }
  ],
  keywords: [
    "cem yeşilay kimdir",
    "cem yeşilay mimarlık hakkımızda",
    "buca adatepe mutfak imalat atölyesi",
    "izmir iç mimarlık firmaları",
    "izmir anahtar teslim ev tadilatı",
    "lüks mutfak dolabı üreticisi izmir"
  ]
};
---

<Layout seo={seo} activeService="Hakkımızda">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (CARTIER & ROLEX LÜKS DARK EMERALD MİMARİ MİRAS)       -->
  <!-- ===================================================================== -->
  <section class="relative py-20 sm:py-28 bg-[#02130C] border-b border-[#0A2E1D] overflow-hidden text-white">
    <!-- Yumuşak Altın Radyal Işık -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(197,168,128,0.14)_0%,transparent_60%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        
        <!-- Üst Prestij Rozeti -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#041F14] text-[#C5A880] border border-[#C5A880]/40 rounded-full shadow-lg">
          <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
          <span class="text-xs font-bold tracking-[0.16em] uppercase font-sans">
            1998'DEN BUGÜNE • 28 YILLIK İMALAT MİRASI
          </span>
        </div>

        <!-- H1 Ana Başlık -->
        <h1 class="text-3xl sm:text-5xl lg:text-[56px] font-extrabold text-white leading-[1.1] tracking-tight uppercase">
          İzmir İç Mimarlık ve <br />
          <span class="text-[#C5A880] font-serif font-normal italic lowercase first-letter:uppercase">28 Yıllık İmalat Zanaatı</span>
        </h1>

        <!-- Açıklama -->
        <p class="text-base sm:text-lg text-[#D8D2C7] font-light leading-relaxed max-w-2xl">
          Cem Yeşilay Luxury; seri üretim fabrikasyonu ve aracı komisyonculuğu reddeden, her milimetresini Buca Adatepe'deki kendi imalat atölyesinde bizzat üreten bağımsız bir mimarlık ve anahtar teslim tasarım stüdyosudur.
        </p>

        <!-- Hızlı CTA -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a 
            href={siteConfig.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-8 py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded border border-[#E5C378] shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <span>WhatsApp ile Keşif Planla</span>
            <span>→</span>
          </a>
          <a 
            href="/yapilan-isler/" 
            class="px-8 py-3.5 bg-[#041F14] hover:bg-[#062B1C] text-white border border-[#C5A880]/30 text-xs sm:text-sm font-semibold uppercase tracking-wider rounded transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <span>96 Canlı Projeyi Gör</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. RAKAMLARLA KURUMSAL OTORİTE (CARTIER GOLD & DEEP EMERALD ŞERİT)    -->
  <!-- ===================================================================== -->
  <section class="py-12 bg-[#041F14] border-b border-[#0D3826] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        
        <div class="space-y-1 sm:border-r border-[#0D3826] pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#C5A880] tracking-tight font-sans">28+ Yıl</div>
          <div class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Kesintisiz Deneyim</div>
          <p class="text-xs text-[#9E9589] font-light">1998'den bu yana Buca Adatepe tesisinde kesintisiz öz üretim.</p>
        </div>

        <div class="space-y-1 md:border-r border-[#0D3826] pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-sans">2.850+</div>
          <div class="text-xs sm:text-sm font-bold text-[#C5A880] uppercase tracking-wider">Teslim Edilen Ev & Villa</div>
          <p class="text-xs text-[#9E9589] font-light">İzmir, Çeşme, Urla ve Güzelbahçe genelinde anahtar teslim başarı.</p>
        </div>

        <div class="space-y-1 sm:border-r border-[#0D3826] pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#C5A880] tracking-tight font-sans">%100</div>
          <div class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Kendi Atölyemiz</div>
          <p class="text-xs text-[#9E9589] font-light">Aracı, komisyoncu veya taşeron yok; doğrudan birinci el imalat.</p>
        </div>

        <div class="space-y-1">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-sans">10 Yıl</div>
          <div class="text-xs sm:text-sm font-bold text-[#C5A880] uppercase tracking-wider">Sözleşmeli Garanti</div>
          <p class="text-xs text-[#9E9589] font-light">E1 marin MDF gövde ve Avusturya Blum mekanizma güvencesi.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. MİMARİ VİZYON & ATÖLYE GERÇEĞİ (BENTO BOX KONSEPTİ)                 -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-14">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs uppercase font-bold tracking-[0.2em] text-[#C5A880] block">İMALAT VE MİMARİ FELSEFEMİZ</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#041F14] tracking-tight">
          Neden Showroom Değil, Doğrudan Atölye?
        </h2>
        <p class="text-base text-zinc-600 font-light leading-relaxed">
          Piyasadaki pek çok hazır mağaza siparişinizi alıp üçüncü şahıslara ürettirirken; biz projenizin milimetrik çiziminden son montaj vidasına kadar her aşamasını kendi atölyemizde yönetiyoruz.
        </p>
      </div>

      <!-- Bento Grid Kartlar -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Kart 1: Aracısız İmalat -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#041F14] text-[#C5A880] flex items-center justify-center font-bold text-lg font-mono">
            01
          </div>
          <h3 class="text-xl font-bold text-[#041F14] tracking-tight group-hover:text-[#C5A880] transition">
            Aracısız Doğrudan Atölye Fiyatı
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-light">
            Showroom kiraları, bayi komisyonları veya pazarlama aracıları maliyete eklenmez. Bütçeniz tabela parasına değil; doğrudan 1. sınıf malzemeye ve usta işçiliğe gider.
          </p>
        </div>

        <!-- Kart 2: Lazer Ölçüm & 3D Proje -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#041F14] text-[#C5A880] flex items-center justify-center font-bold text-lg font-mono">
            02
          </div>
          <h3 class="text-xl font-bold text-[#041F14] tracking-tight group-hover:text-[#C5A880] transition">
            Lazer Rölöve & Fotogerçekçi 3D
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-light">
            Evinize gelerek dijital lazer ile milimetrik ölçü alıyoruz. Mimarlarımız mutfağınızı ve odalarınızı birebir 3D modelleyerek üretime geçmeden önce sanal ortamda onayınıza sunar.
          </p>
        </div>

        <!-- Kart 3: Dünya Sınıfı Donanım -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#041F14] text-[#C5A880] flex items-center justify-center font-bold text-lg font-mono">
            03
          </div>
          <h3 class="text-xl font-bold text-[#041F14] tracking-tight group-hover:text-[#C5A880] transition">
            Avusturya Blum & İtalyan Lake
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-light">
            Sadece E1 yeşil marin suya dayanıklı MDF, sararmaz fırın poliüretan lake ve Avusturya menşeili Blum sessiz frenli ray/menteşeler kullanılır. Sarkma veya gıcırdama yaşanmaz.
          </p>
        </div>

        <!-- Kart 4: Noter Disiplininde Sözleşme -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#041F14] text-[#C5A880] flex items-center justify-center font-bold text-lg font-mono">
            04
          </div>
          <h3 class="text-xl font-bold text-[#041F14] tracking-tight group-hover:text-[#C5A880] transition">
            Gecikme Cezalı Resmi Sözleşme
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-light">
            Tarih belirsizliği veya usta kaçması söz konusu olamaz. Başlangıçta net teslim tarihi sözleşmeye yazılır, her geciken gün için cezai teminat taahhüt edilir.
          </p>
        </div>

        <!-- Kart 5: Anahtar Teslim Konforu -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#041F14] text-[#C5A880] flex items-center justify-center font-bold text-lg font-mono">
            05
          </div>
          <h3 class="text-xl font-bold text-[#041F14] tracking-tight group-hover:text-[#C5A880] transition">
            Komple İç Mimarlık & Kırım-Döküm
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-light">
            Sadece dolap değil; elektrik, sıhhi tesisat, seramik, asma tavan, aydınlatma ve zemin kaplaması tek elden, koordineli bir şantiye ekibiyle yürütülür.
          </p>
        </div>

        <!-- Kart 6: Kusursuz Temiz Teslim -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#041F14] text-[#C5A880] flex items-center justify-center font-bold text-lg font-mono">
            06
          </div>
          <h3 class="text-xl font-bold text-[#041F14] tracking-tight group-hover:text-[#C5A880] transition">
            Tozsuz Montaj & Anahtar Teslim
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-light">
            İş bitiminde inşaat molozu veya kaba pislik bırakılmaz. Mekânınız süpürülmüş, silinmiş ve doğrudan yaşamaya hazır vaziyette teslim edilir.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. MALZEME & DONANIM KALİTE DOKTRİNİ                                 -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#02130C] border-b border-[#0A2E1D] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs uppercase font-bold tracking-[0.2em] text-[#C5A880] block">DÜNYA STANDARTLARI</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Hangi Malzeme ve Markalarla Çalışıyoruz?
        </h2>
        <p class="text-sm sm:text-base text-[#D8D2C7] font-light leading-relaxed">
          Evinizde yıllarca ilk günkü zarafetini ve sessizliğini koruyacak sertifikalı üst segment bileşenler.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-7 bg-[#041F14] border border-[#0D3826] rounded-xl space-y-3 hover:border-[#C5A880]/50 transition">
          <div class="text-[#C5A880] text-sm font-bold tracking-wider uppercase font-mono">YÜZEY TEKNOLOJİSİ</div>
          <h3 class="text-xl font-bold text-white tracking-tight">İtalyan Fırın Mat & İpek Lake</h3>
          <p class="text-xs sm:text-sm text-[#D8D2C7] font-light leading-relaxed">
            Tozsuz kabinlerde katman katman fırınlanan, UV sararma dirençli poliüretan lake. Zamanla renk atmaz, ipeksi dokunuş hissi verir ve parmak izi tutmaz.
          </p>
        </div>

        <div class="p-7 bg-[#041F14] border border-[#0D3826] rounded-xl space-y-3 hover:border-[#C5A880]/50 transition">
          <div class="text-[#C5A880] text-sm font-bold tracking-wider uppercase font-mono">MEKANİZMA SİSTEMİ</div>
          <h3 class="text-xl font-bold text-white tracking-tight">Avusturya Blum & Häfele</h3>
          <p class="text-xs sm:text-sm text-[#D8D2C7] font-light leading-relaxed">
            Blum Tandembox antiasit raylar, Aventos hidrolik kalkar kapaklar ve 200.000 açma-kapama testli sessiz menteşeler ile ömür boyu kusursuz konfor.
          </p>
        </div>

        <div class="p-7 bg-[#041F14] border border-[#0D3826] rounded-xl space-y-3 hover:border-[#C5A880]/50 transition">
          <div class="text-[#C5A880] text-sm font-bold tracking-wider uppercase font-mono">GÖVDE & TEZGAH</div>
          <h3 class="text-xl font-bold text-white tracking-tight">E1 Marin MDF & Porselen / Belenco</h3>
          <p class="text-xs sm:text-sm text-[#D8D2C7] font-light leading-relaxed">
            Rutubete ve suya dirençli yoğun marin yeşil MDF gövde mimarisi; çizilmeye, ısıya ve lekeye tam dirençli Belenco, Çimstone veya İtalyan Laminam porselen tezgahlar.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. PRESTİJLİ ATÖLYE DAVETİ & İLETİŞİM BLOKU                          -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-[#E5DFD5] text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#041F14] text-[#C5A880] border border-[#C5A880]/40 rounded-full text-xs font-bold uppercase tracking-wider">
        <span>BİR KAHVEMİZİ İÇİN</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#041F14] tracking-tight leading-[1.15]">
        Bizi Buca Adatepe İmalat Atölyemizde Ziyaret Edin
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 font-light leading-relaxed max-w-xl mx-auto">
        Malzeme kartelalarını elinizle inceleyin, gövde kesitlerini ve Blum aksamları canlı test edin. Mimarımızla beraber hayalinizdeki projeyi planlayalım.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href={siteConfig.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-10 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-extrabold text-xs sm:text-sm tracking-wider uppercase rounded shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile Randevu Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:02324411060" 
          class="w-full sm:w-auto px-10 py-4 bg-[#041F14] text-white hover:bg-[#062B1C] border border-[#C5A880]/30 font-bold text-xs sm:text-sm tracking-wider uppercase rounded shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>0232 441 1060</span>
        </a>
      </div>

      <div class="pt-6 text-xs text-zinc-500 font-light">
        <span>📍 Adatepe, Özbekistan Cd. No:10/F • Buca / İzmir</span>
        <span class="mx-2">•</span>
        <span>Hafta İçi & Cumartesi: 09:00 - 19:00</span>
      </div>
    </div>
  </section>

</Layout>
