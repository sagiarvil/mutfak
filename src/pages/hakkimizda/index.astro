---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Hakkımızda — Cem Yeşilay Luxury Mimarlık & Özel İmalat Atölyesi",
  description: "1998'den bu yana İzmir Buca Adatepe'deki kendi imalat atölyemizde kişiye özel lüks mutfak dolapları, ıslak hacim renovasyonları ve anahtar teslim mimari taahhüt üretiyoruz. 28 yıllık tecrübe ve 10 yıl bütünleşik garanti.",
  canonical: `${siteConfig.siteUrl}/hakkimizda/`,
  serviceName: "Cem Yeşilay Mimarlık & İç Mimari",
  breadcrumbs: [
    { name: "Hakkımızda", url: "/hakkimizda/" }
  ],
  keywords: [
    "cem yeşilay kimdir",
    "cem yeşilay mimarlık hakkımızda",
    "buca adatepe mutfak atölyesi",
    "izmir özel mobilya imalatçısı",
    "lüks mutfak dolabı üreticisi izmir"
  ]
};
---

<Layout seo={seo} activeService="Hakkımızda">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (ZARİF MİMARİ MİRAS)                                 -->
  <!-- ===================================================================== -->
  <section class="relative py-24 sm:py-32 bg-[#FAF9F6] border-b border-[#E5DFD5] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#D2D2D7] rounded-full shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
        <span class="text-[#1D1D1F] text-[11px] font-semibold tracking-[0.14em] uppercase font-sans">
          1998'DEN BUGÜNE 28 YILLIK ZANAAT & MİMARLIK MİRASI
        </span>
      </div>

      <h1 class="text-[36px] sm:text-[54px] lg:text-[62px] font-bold text-[#1D1D1F] leading-[1.08] tracking-[-0.03em] max-w-4xl">
        Mekânın Ruhuna Dokunan, <br />
        <span class="italic font-normal text-[#006039]">Aracısız Atölye İmalatı &</span> <br />
        <span class="font-medium text-[#282421]">Kişiye Özel Mimari Zarafet.</span>
      </h1>

      <p class="text-[16px] sm:text-[18px] text-[#6E675F] font-normal leading-relaxed max-w-2xl">
        Cem Yeşilay Luxury; seri üretim kalıplarından uzak, her milimetresi evinizin ışık açısına ve yaşam alışkanlıklarınıza göre tasarlanan bağımsız bir mimarlık ve imalat atölyesidir.
      </p>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. RAKAMLARLA KURUMSAL OTORİTE (E-E-A-T METRİKLERİ)                  -->
  <!-- ===================================================================== -->
  <section class="py-14 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center sm:text-left">
        <div class="space-y-1">
          <div class="text-[36px] sm:text-[44px] font-bold text-[#1D1D1F] tracking-tight">28+ Yıl</div>
          <div class="text-[13px] font-medium text-[#C5A880]">Kesintisiz İmalat Deneyimi</div>
          <p class="text-[12px] text-[#86868B] font-light">1998'den bu yana Buca Adatepe'de kendi öz sermayemizle üretim.</p>
        </div>
        <div class="space-y-1">
          <div class="text-[36px] sm:text-[44px] font-bold text-[#1D1D1F] tracking-tight">2.850+</div>
          <div class="text-[13px] font-medium text-[#C5A880]">Teslim Edilmiş Konut & Villa</div>
          <p class="text-[12px] text-[#86868B] font-light">İzmir, Çeşme ve Urla genelinde anahtar teslim mimari referans.</p>
        </div>
        <div class="space-y-1">
          <div class="text-[36px] sm:text-[44px] font-bold text-[#1D1D1F] tracking-tight">137 Model</div>
          <div class="text-[13px] font-medium text-[#C5A880]">Tescilli Tasarım Arşivi</div>
          <p class="text-[12px] text-[#86868B] font-light">Mutfak, banyo, giyinme odası ve özel kapılardan oluşan zengin koleksiyon.</p>
        </div>
        <div class="space-y-1">
          <div class="text-[36px] sm:text-[44px] font-bold text-[#1D1D1F] tracking-tight">10 Yıl</div>
          <div class="text-[13px] font-medium text-[#C5A880]">Bütünleşik Gövde Garantisi</div>
          <p class="text-[12px] text-[#86868B] font-light">E1 marin MDF ve Blum mekanizmalarla resmi sözleşmeli güvence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. BİZİ FARKLI VE RAKİPSİZ KILAN 4 İLKEMİZ                           -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-14">
      
      <div class="max-w-2xl space-y-2">
        <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">İMALAT FELSEFEMİZ</span>
        <h2 class="text-[32px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-tight">
          Neden Cem Yeşilay Luxury?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- İlke 1 -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-4">
          <span class="text-xs font-mono font-bold text-[#006039] bg-[#F4F1EA] px-3 py-1 rounded-full inline-block">01 • ARACISIZ DİREKT ATÖLYE</span>
          <h3 class="text-[20px] font-semibold text-[#1D1D1F] tracking-tight">Komisyonsuz, Şeffaf ve Birinci Elden Üretim</h3>
          <p class="text-[14px] text-[#6E675F] font-normal leading-relaxed">
            Biz bir pazarlama ofisi ya da taşeron kullanan bir aracı firma değiliz. Buca Adatepe'deki kendi modern üretim tesisimizde, kendi kadrolu ustalarımız ve mimarlarımızla çalışıyoruz. Bu sayede aracı komisyonu ödemez, en yüksek kalite malzemeyi en şeffaf maliyetle alırsınız.
          </p>
        </div>

        <!-- İlke 2 -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-4">
          <span class="text-xs font-mono font-bold text-[#006039] bg-[#F4F1EA] px-3 py-1 rounded-full inline-block">02 • MİMARİ MÜHENDİSLİK</span>
          <h3 class="text-[20px] font-semibold text-[#1D1D1F] tracking-tight">Lazer Rölöve & Fotogerçekçi 3D Simülasyon</h3>
          <p class="text-[14px] text-[#6E675F] font-normal leading-relaxed">
            Evinize gelerek lazer metre ile milimetrik rölöve ölçüsü alıyoruz. Mekânınızın doğal ışık alışını, su ve elektrik hatlarını analiz ederek sanal gerçeklik hassasiyetinde 3D modelleme hazırlıyoruz. Sürprizlere yer bırakmadan, ne göreceğinizi önceden onaylıyorsunuz.
          </p>
        </div>

        <!-- İlke 3 -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-4">
          <span class="text-xs font-mono font-bold text-[#006039] bg-[#F4F1EA] px-3 py-1 rounded-full inline-block">03 • DÜNYA DONANIM STANDARDI</span>
          <h3 class="text-[20px] font-semibold text-[#1D1D1F] tracking-tight">Blum & Häfele Entegre Frenli Mekanizmalar</h3>
          <p class="text-[14px] text-[#6E675F] font-normal leading-relaxed">
            Dolap gövdelerimizde yalnızca E1 sınıfı nem ve su buharına dirençli yeşil marin MDF kullanıyoruz. Ray ve menteşe aksamında ise dünyanın 1 numarası Avusturya menşeili Blum sistemlerini tercih ederek kapakların ömür boyu kadife sessizliğinde çalışmasını sağlıyoruz.
          </p>
        </div>

        <!-- İlke 4 -->
        <div class="p-8 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-4">
          <span class="text-xs font-mono font-bold text-[#006039] bg-[#F4F1EA] px-3 py-1 rounded-full inline-block">04 • HUKUKİ TAAHHÜT</span>
          <h3 class="text-[20px] font-semibold text-[#1D1D1F] tracking-tight">Gecikme Cezalı Resmi Sözleşme & Temiz Teslim</h3>
          <p class="text-[14px] text-[#6E675F] font-normal leading-relaxed">
            "Bugün biter, yarın başlar" belirsizliği yok. İş başlangıcında teslim tarihini resmi sözleşmeyle güvence altına alıyor, her geciken gün için cezai şart taahhüt ediyoruz. Montaj bittiğinde ustalarımız alanı tertemiz süpürüp kullanıma hazır halde teslim eder.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. ATÖLYE & MALZEME STANDARTLARI VİTRİNİ                             -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">ZANAAT DETAYLARI</span>
        <h2 class="text-[32px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-tight">
          Hangi Malzemelerle Çalışıyoruz?
        </h2>
        <p class="text-[15px] text-[#6E675F] font-normal leading-relaxed">
          Evinizde yıllarca ilk günkü parlaklığını koruyacak, aşınmaya ve neme meydan okuyan sertifikalı bileşenler.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-xl space-y-3">
          <h3 class="text-[18px] font-semibold text-[#1D1D1F] tracking-tight">İtalyan Fırın Lake Kapaklar</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.5]">
            Özel tozsuz boya kabinlerimizde fırınlanan, UV sararma korumalı poliüretan ipek mat ve parlak lake yüzeyler. Zamanla sararma yapmaz, parmak izi tutmaz.
          </p>
        </div>

        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-xl space-y-3">
          <h3 class="text-[18px] font-semibold text-[#1D1D1F] tracking-tight">Çizilmez Çizgi Akrilik</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.5]">
            Ultra yüksek parlaklıkta ayna efekti sunan, derinlik hissi veren ve çizilmelere karşı güçlendirilmiş 1. sınıf antibakteriyel akrilik paneller.
          </p>
        </div>

        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-xl space-y-3">
          <h3 class="text-[18px] font-semibold text-[#1D1D1F] tracking-tight">Laminam & Belenco Tezgahlar</h3>
          <p class="text-[13px] text-[#6E675F] font-normal leading-[1.5]">
            Isıya, kesilmeye, asit ve lekeye %100 dayanıklı porselen plaka tezgahlar ve kuvars yüzeyler ile kusursuz mimari bütünlük.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. ÇAĞRI VE ATÖLYE DAVETİ                                             -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5] text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">ATÖLYEMİZE DAVETLİSİNİZ</span>
      <h2 class="text-[32px] sm:text-[44px] font-bold text-[#1D1D1F] tracking-tight leading-[1.15]">
        Bizi Adatepe'deki İmalat Atölyemizde Ziyaret Edin
      </h2>
      <p class="text-[15px] text-[#6E675F] font-normal leading-relaxed max-w-xl mx-auto">
        Malzeme kartelalarını elinizle hissedin, gövde kesitlerini ve Blum aksamları canlı inceleyin. Mimarımızla bir kahve eşliğinde projenizi planlayalım.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a 
          href="https://wa.me/905324261788" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white font-semibold text-[13px] tracking-tight rounded-full shadow-[0_4px_14px_rgba(0, 96, 57,0.3)] transition"
        >
          WhatsApp ile Randevu Al →
        </a>
        <a 
          href="tel:02324411060" 
          class="w-full sm:w-auto px-9 py-3.5 bg-white text-[#1D1D1F] border border-[#D2D2D7] hover:bg-[#F5F5F7] font-semibold text-[13px] tracking-tight rounded-full shadow-2xs transition"
        >
          0232 441 1060
        </a>
      </div>
    </div>
  </section>

</Layout>
