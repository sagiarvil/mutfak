---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Hakkımızda — İzmir İç Mimarlık & Özel İmalat Atölyesi | İzmir Mutfak Banyo Luxury",
  description: "1998'den bu yana İzmir Buca Adatepe'deki kendi imalat atölyemizde kişiye özel lüks mutfak dolapları, villa renovasyonları ve anahtar teslim mimari taahhüt üretiyoruz. 28 yıllık tecrübe ve aracısız imalatçı güvencesi.",
  canonical: `${siteConfig.siteUrl}/hakkimizda/`,
  serviceName: "İzmir Mutfak Banyo Mimarlık & İç Mimari",
  breadcrumbs: [
    { name: "Hakkımızda", url: "/hakkimizda/" }
  ],
  keywords: [
    "izmir mutfak banyo kimdir",
    "izmir mutfak banyo mimarlık hakkımızda",
    "buca adatepe mutfak imalat atölyesi",
    "izmir iç mimarlık firmaları",
    "izmir anahtar teslim ev tadilatı",
    "lüks mutfak dolabı üreticisi izmir"
  ]
};
---

<Layout seo={seo} activeService="Hakkımızda">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (AYDINLIK, PREMİUM SPLIT VİTRİN - DARK HERO YOK)         -->
  <!-- ===================================================================== -->
  <section class="relative bg-[#F4F6F8] border-b border-[#E2E8F0] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F4F6F8]/60 to-transparent pointer-events-none"></div>

    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AYDINLIK & GÜVEN VEREN MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#23323A] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#CB000F] font-bold">Hakkımızda</span>
          </nav>

          <!-- Prestij Rozeti -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#CB000F]/50 rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span class="text-xs font-bold tracking-[0.16em] uppercase text-[#23323A] font-sans">
              1998'DEN BUGÜNE • 28 YILLIK İMALAT MİRASI
            </span>
          </div>

          <!-- Ana Başlık (Net, Okunabilir & Lüks Tipografi) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#23323A] leading-[1.14] tracking-tight">
            İzmir İç Mimarlık ve <br />
            <span class="text-[#CB000F] font-['Montserrat',sans-serif] font-normal ">28 Yıllık İmalat Zanaatı:</span> <br />
            <span class="text-[#23323A]">İzmir Mutfak Banyo Luxury.</span>
          </h1>

          <!-- Açıklama -->
          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            İzmir Mutfak Banyo Luxury; seri üretim fabrikasyonu ve aracı komisyonculuğu reddeden, her milimetresini Buca Adatepe'deki kendi imalat atölyesinde bizzat üreten bağımsız bir mimarlık ve anahtar teslim tasarım stüdyosudur.
          </p>

          <!-- İstatistik Şeridi (Aydınlık Kart Formatı) -->
          <div class="grid grid-cols-3 gap-3 pt-1 text-xs">
            <div class="bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs text-center sm:text-left">
              <span class="text-2xl sm:text-3xl font-extrabold text-[#23323A] block font-['Montserrat',sans-serif]">28</span>
              <span class="text-zinc-600 uppercase tracking-wider text-[10px] font-bold">Yıllık Tecrübe</span>
            </div>
            <div class="bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs text-center sm:text-left">
              <span class="text-2xl sm:text-3xl font-extrabold text-[#CB000F] block font-['Montserrat',sans-serif]">2.850+</span>
              <span class="text-zinc-600 uppercase tracking-wider text-[10px] font-bold">Teslim Proje</span>
            </div>
            <div class="bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs text-center sm:text-left">
              <span class="text-2xl sm:text-3xl font-extrabold text-[#23323A] block font-['Montserrat',sans-serif]">%100</span>
              <span class="text-zinc-600 uppercase tracking-wider text-[10px] font-bold">Kendi Atölyemiz</span>
            </div>
          </div>

          <!-- Aksiyon Butonları -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href={siteConfig.whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#CB000F] hover:bg-[#b0000d] text-white text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#CB000F] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Keşif Planla</span>
              <span>→</span>
            </a>
            <a 
              href="/yapilan-isler/" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#23323A] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>96 Canlı Projeyi Gör</span>
            </a>
          </div>

        </div>

        <!-- SAĞ: ATÖLYE MİMARİ GÖRSELİ (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-03.webp" 
              alt="İzmir Mutfak Banyo Buca Adatepe İmalat Atölyesi ve Mutfak Üretimi" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#CB000F] block">MİMARİ İMALAT MERKEZİ</span>
              <p class="text-sm font-['Montserrat',sans-serif] font-bold text-white mt-0.5">Buca Adatepe Atölyesi • 1998'den Beri Kesintisiz Üretim</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. RAKAMLARLA KURUMSAL OTORİTE (LUMINOUS ARCHITECTURAL STATS CONSOLE) -->
  <!-- ===================================================================== -->
  <section class="py-14 bg-[#FAFAF8] border-b border-[#EBE6DD] text-zinc-900">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        
        <div class="space-y-1.5 sm:border-r border-[#E2E8F0] pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">28+ Yıl</div>
          <div class="text-xs sm:text-sm font-bold text-[#CB000F] uppercase tracking-wider font-sans">Kesintisiz Deneyim</div>
          <p class="text-xs text-zinc-600 font-normal">1998'den bu yana Buca Adatepe tesisinde kesintisiz öz üretim.</p>
        </div>

        <div class="space-y-1.5 md:border-r border-[#E2E8F0] pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">2.850+</div>
          <div class="text-xs sm:text-sm font-bold text-[#CB000F] uppercase tracking-wider font-sans">Teslim Edilen Ev & Villa</div>
          <p class="text-xs text-zinc-600 font-normal">İzmir, Çeşme, Urla ve Güzelbahçe genelinde anahtar teslim başarı.</p>
        </div>

        <div class="space-y-1.5 sm:border-r border-[#E2E8F0] pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">%100</div>
          <div class="text-xs sm:text-sm font-bold text-[#CB000F] uppercase tracking-wider font-sans">Kendi Atölyemiz</div>
          <p class="text-xs text-zinc-600 font-normal">Aracı, komisyoncu veya taşeron yok; doğrudan birinci el imalat.</p>
        </div>

        <div class="space-y-1.5">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">10 Yıl</div>
          <div class="text-xs sm:text-sm font-bold text-[#CB000F] uppercase tracking-wider font-sans">Sözleşmeli Garanti</div>
          <p class="text-xs text-zinc-600 font-normal">E1 marin MDF gövde ve Avusturya Blum mekanizma güvencesi.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. MİMARİ VİZYON & ATÖLYE GERÇEĞİ (BENTO BOX KONSEPTİ)                 -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E2E8F0]">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8 space-y-14">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs uppercase font-bold tracking-[0.2em] text-[#CB000F] block">İMALAT VE MİMARİ FELSEFEMİZ</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#23323A] tracking-tight">
          Neden Showroom Değil, Doğrudan Atölye?
        </h2>
        <p class="text-base text-zinc-600 font-normal leading-relaxed">
          Piyasadaki pek çok hazır mağaza siparişinizi alıp üçüncü şahıslara ürettirirken; biz projenizin milimetrik çiziminden son montaj vidasına kadar her aşamasını kendi atölyemizde yönetiyoruz.
        </p>
      </div>

      <!-- Bento Grid Kartlar -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Kart 1: Aracısız İmalat -->
        <div class="p-8 bg-white border border-[#E2E8F0] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#23323A] text-[#CB000F] flex items-center justify-center font-bold text-lg font-mono">
            01
          </div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight group-hover:text-[#CB000F] transition">
            Aracısız Doğrudan Atölye Fiyatı
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-normal">
            Showroom kiraları, bayi komisyonları veya pazarlama aracıları maliyete eklenmez. Bütçeniz tabela parasına değil; doğrudan 1. sınıf malzemeye ve usta işçiliğe gider.
          </p>
        </div>

        <!-- Kart 2: Lazer Ölçüm & 3D Proje -->
        <div class="p-8 bg-white border border-[#E2E8F0] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#23323A] text-[#CB000F] flex items-center justify-center font-bold text-lg font-mono">
            02
          </div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight group-hover:text-[#CB000F] transition">
            Lazer Rölöve & Fotogerçekçi 3D
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-normal">
            Evinize gelerek dijital lazer ile milimetrik ölçü alıyoruz. Mimarlarımız mutfağınızı ve odalarınızı birebir 3D modelleyerek üretime geçmeden önce sanal ortamda onayınıza sunar.
          </p>
        </div>

        <!-- Kart 3: Dünya Sınıfı Donanım -->
        <div class="p-8 bg-white border border-[#E2E8F0] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#23323A] text-[#CB000F] flex items-center justify-center font-bold text-lg font-mono">
            03
          </div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight group-hover:text-[#CB000F] transition">
            Avusturya Blum & İtalyan Lake
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-normal">
            Sadece E1 yeşil marin suya dayanıklı MDF, sararmaz fırın poliüretan lake ve Avusturya menşeili Blum sessiz frenli ray/menteşeler kullanılır. Sarkma veya gıcırdama yaşanmaz.
          </p>
        </div>

        <!-- Kart 4: Noter Disiplininde Sözleşme -->
        <div class="p-8 bg-white border border-[#E2E8F0] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#23323A] text-[#CB000F] flex items-center justify-center font-bold text-lg font-mono">
            04
          </div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight group-hover:text-[#CB000F] transition">
            Gecikme Cezalı Resmi Sözleşme
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-normal">
            Tarih belirsizliği veya usta kaçması söz konusu olamaz. Başlangıçta net teslim tarihi sözleşmeye yazılır, her geciken gün için cezai teminat taahhüt edilir.
          </p>
        </div>

        <!-- Kart 5: Anahtar Teslim Konforu -->
        <div class="p-8 bg-white border border-[#E2E8F0] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#23323A] text-[#CB000F] flex items-center justify-center font-bold text-lg font-mono">
            05
          </div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight group-hover:text-[#CB000F] transition">
            Komple İç Mimarlık & Kırım-Döküm
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-normal">
            Sadece dolap değil; elektrik, sıhhi tesisat, seramik, asma tavan, aydınlatma ve zemin kaplaması tek elden, koordineli bir şantiye ekibiyle yürütülür.
          </p>
        </div>

        <!-- Kart 6: Kusursuz Temiz Teslim -->
        <div class="p-8 bg-white border border-[#E2E8F0] rounded-2xl shadow-sm space-y-4 hover:shadow-md transition group">
          <div class="w-12 h-12 rounded-xl bg-[#23323A] text-[#CB000F] flex items-center justify-center font-bold text-lg font-mono">
            06
          </div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight group-hover:text-[#CB000F] transition">
            Tozsuz Montaj & Anahtar Teslim
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed font-normal">
            İş bitiminde inşaat molozu veya kaba pislik bırakılmaz. Mekânınız süpürülmüş, silinmiş ve doğrudan yaşamaya hazır vaziyette teslim edilir.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. MALZEME & DONANIM KALİTE DOKTRİNİ (HAUTE COUTURE SPECIFICATIONS)  -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#F9F8F5] border-b border-[#E2E8F0] text-zinc-900">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-2.5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-white border border-[#CB000F]/50 rounded-full shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#CB000F]"></span>
          <span class="text-[11px] font-bold uppercase tracking-[0.22em] text-[#CB000F]">DÜNYA STANDARTLARI</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">
          Hangi Malzeme ve Markalarla Çalışıyoruz?
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 font-normal leading-relaxed">
          Evinizde yıllarca ilk günkü zarafetini ve sessizliğini koruyacak sertifikalı üst segment bileşenler.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-7 bg-white border border-[#E2E8F0] hover:border-[#CB000F] rounded-2xl space-y-3 transition-all duration-300 hover:-translate-y-1 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)]">
          <div class="text-[#CB000F] text-xs font-bold tracking-wider uppercase font-sans">YÜZEY TEKNOLOJİSİ</div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">İtalyan Fırın Mat & İpek Lake</h3>
          <p class="text-xs sm:text-sm text-zinc-600 font-normal leading-relaxed">
            Tozsuz kabinlerde katman katman fırınlanan, UV sararma dirençli poliüretan lake. Zamanla renk atmaz, ipeksi dokunuş hissi verir ve parmak izi tutmaz.
          </p>
        </div>

        <div class="p-7 bg-white border border-[#E2E8F0] hover:border-[#CB000F] rounded-2xl space-y-3 transition-all duration-300 hover:-translate-y-1 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)]">
          <div class="text-[#CB000F] text-xs font-bold tracking-wider uppercase font-sans">MEKANİZMA SİSTEMİ</div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">Avusturya Blum & Häfele</h3>
          <p class="text-xs sm:text-sm text-zinc-600 font-normal leading-relaxed">
            Blum Tandembox antiasit raylar, Aventos hidrolik kalkar kapaklar ve 200.000 açma-kapama testli sessiz menteşeler ile ömür boyu kusursuz konfor.
          </p>
        </div>

        <div class="p-7 bg-white border border-[#E2E8F0] hover:border-[#CB000F] rounded-2xl space-y-3 transition-all duration-300 hover:-translate-y-1 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_36px_rgba(197,168,128,0.18)]">
          <div class="text-[#CB000F] text-xs font-bold tracking-wider uppercase font-sans">GÖVDE & TEZGAH</div>
          <h3 class="text-xl font-bold text-[#23323A] tracking-tight font-['Montserrat',sans-serif]">E1 Marin MDF & Porselen / Belenco</h3>
          <p class="text-xs sm:text-sm text-zinc-600 font-normal leading-relaxed">
            Rutubete ve suya dirençli yoğun marin yeşil MDF gövde mimarisi; çizilmeye, ısıya ve lekeye tam dirençli Belenco, Çimstone veya İtalyan Laminam porselen tezgahlar.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. PRESTİJLİ ATÖLYE DAVETİ & İLETİŞİM BLOKU                          -->
  <!-- ===================================================================== -->
  <section class="py-24 relative overflow-hidden bg-gradient-to-b from-[#F4F6F8] via-[#F4F6F8] to-[#F4F6F8] text-center border-t border-[#E2E8F0] text-zinc-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white rounded-full border border-[#CB000F]/60 text-[#CB000F] text-xs uppercase font-bold tracking-widest shadow-xs">
        <span>BİR KAHVEMİZİ İÇİN</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#23323A] tracking-tight leading-[1.15] font-['Montserrat',sans-serif]">
        Bizi İzmir İmalat Atölyemizde Ziyaret Edin
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 font-normal leading-relaxed max-w-xl mx-auto">
        Malzeme kartelalarını elinizle inceleyin, gövde kesitlerini ve Blum aksamları canlı test edin. Mimarımızla beraber hayalinizdeki projeyi planlayalım.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href={siteConfig.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-10 py-4 bg-[#23323A] hover:bg-[#172127] text-[#CB000F] font-extrabold text-xs sm:text-sm tracking-wider uppercase rounded-xl border border-[#CB000F]/40 shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile Randevu Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:05393333303" 
          class="w-full sm:w-auto px-10 py-4 bg-white hover:bg-[#F4F6F8] text-[#23323A] border border-[#E2E8F0] font-bold text-xs sm:text-sm tracking-wider uppercase rounded-xl shadow-xs transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>📞 0539 333 33 03</span>
        </a>
      </div>

      <div class="pt-6 text-xs text-zinc-500 font-normal">
        <span>📍 İzmir Geneli Yerinde Keşif & Montaj</span>
        <span class="mx-2">•</span>
        <span>Hafta İçi & Cumartesi: 09:00 - 19:00</span>
      </div>
    </div>
  </section>

</Layout>
