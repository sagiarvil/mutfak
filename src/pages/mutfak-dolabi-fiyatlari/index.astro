---
import Layout from "../../layouts/Layout.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import { siteConfig } from "../../data/siteConfig";
import { buildWhatsAppUrl, buildTelUrl } from "../../utils/whatsapp";

const seo = {
  title: "2026 İzmir Mutfak Dolabı Metretül Fiyatları & Maliyet Tablosu",
  description: "2026 güncel İzmir mutfak dolabı metretül fiyatları, malzeme karşılaştırmaları (Akrilik, Membran, Lake, Masif) ve şeffaf tadilat maliyet tablosu.",
  canonical: "https://izmirmutfakbanyo.com.tr/mutfak-dolabi-fiyatlari/",
  serviceName: "Mutfak Dolabı Fiyat Rehberi",
  breadcrumbs: [
    { name: "Fiyat Rehberi", url: "/mutfak-dolabi-fiyatlari/" }
  ]
};
---

<Layout seo={seo} activeService="Fiyat Rehberi">
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Ana Sayfa</a>
        <span class="sep">/</span>
        <span class="current">Fiyat Rehberi</span>
      </nav>
      <h1 class="page-title">2026 İzmir Mutfak Dolabı Fiyatları & Metretül Maliyet Hesaplama</h1>
      <p class="page-lead">2026 güncel İzmir mutfak dolabı metretül fiyatları, malzeme karşılaştırmaları (Akrilik, Membran, Lake, Masif) ve şeffaf tadilat maliyet tablosu.</p>
      <div class="page-actions">
        <a href={buildWhatsAppUrl({ service: "Fiyat Rehberi" })} target="_blank" rel="noopener noreferrer" class="btn-wa">
          💬 WhatsApp ile Keşif İste
        </a>
        <a href={buildTelUrl()} class="btn-call">
          📞 ${siteConfig.phoneFormatted}
        </a>
      </div>
    </div>
  </div>

  <section class="page-content-section">
    <div class="container content-container">
      <div class="main-article prose">
        
      <h2>Mutfak Dolabı Fiyatları Nasıl Hesaplanır?</h2>
      <p>Mutfak dolabı fiyatlandırması genellikle alt ve üst dolabın toplam uzunluğu üzerinden 'Metretül' (mtül) hesabı ile yapılır. Fiyatı etkileyen ana faktörler kapak malzemesi, mekanizma markası (Blum/Hafele) ve tezgâh seçimidir.</p>
      
      <h3>2026 Ortalama Metretül Fiyat Aralıkları (İzmir)</h3>
      <table class="pricing-table">
        <thead>
          <tr>
            <th>Kapak Türü</th>
            <th>Gövde Özelliği</th>
            <th>Aksam Kalitesi</th>
            <th>Maliyet Skalası</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>MDF Lam Standart</strong></td>
            <td>1. Sınıf Beyaz MDF</td>
            <td>Standart Frenli</td>
            <td>Ekonomik Bütçe</td>
          </tr>
          <tr>
            <td><strong>Akrilik Parlak / Mat</strong></td>
            <td>%100 Neme Dayanıklı MDF</td>
            <td>Blum / Hafele Frenli</td>
            <td>Orta - Üst Segment</td>
          </tr>
          <tr>
            <td><strong>Membran (Vakumlu)</strong></td>
            <td>CNC İşlemeli MDF</td>
            <td>Frenli Ray/Menteşe</td>
            <td>Dengeli Fiyat/Performans</td>
          </tr>
          <tr>
            <td><strong>İpek Mat Lake Boya</strong></td>
            <td>Poliüretan Çift Kat Boya</td>
            <td>Blum Tandembox / Aventos</td>
            <td>Premium Kalite</td>
          </tr>
        </tbody>
      </table>
      <p><em>* Kesin fiyat teklifi mutfağınızın ölçüsü, köşe mekanizmaları, kiler sistemleri ve tezgâh seçimine göre yerinde ücretsiz keşif sonrası netleşir.</em></p>
    
      </div>

      <aside class="sidebar">
        <div class="sidebar-box">
          <h3>Hızlı Fiyat & Keşif</h3>
          <p>İzmir içi adresinize gelerek ölçü alıyor ve 3D çizim hazırlıyoruz.</p>
          <a href={buildWhatsAppUrl({ service: "Fiyat Rehberi" })} target="_blank" rel="noopener noreferrer" class="btn-sidebar-wa">
            WhatsApp Keşif Hattı
          </a>
        </div>

        <div class="sidebar-box">
          <h3>Diğer Hizmetlerimiz</h3>
          <ul class="sidebar-links">
            <li><a href="/mutfak-dolabi/">Mutfak Dolabı</a></li>
            <li><a href="/mutfak-tadilati/">Mutfak Tadilatı</a></li>
            <li><a href="/banyo-tadilati/">Banyo Tadilatı</a></li>
            <li><a href="/ev-tadilati/">Komple Ev Tadilatı</a></li>
            <li><a href="/mutfak-dolabi-fiyatlari/">Fiyat Rehberi</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <WhatsAppCTA 
    title="Fiyat Rehberi İçin Fiyat ve Keşif Talebi Oluşturun"
    subtitle="İzmir'in tüm ilçelerine 1 iş günü içinde ücretsiz keşif randevusu veriyoruz."
    service="Fiyat Rehberi"
  />
</Layout>

<style>
  .page-header {
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0 3rem;
  }
  .breadcrumb-nav {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .breadcrumb-nav a {
    color: #38bdf8;
    text-decoration: none;
  }
  .sep {
    opacity: 0.5;
  }
  .current {
    color: #e2e8f0;
  }
  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
  }
  .page-lead {
    font-size: 1.1rem;
    color: #cbd5e1;
    max-width: 800px;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }
  .page-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-wa {
    background: #25d366;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  }
  .btn-call {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .page-content-section {
    padding: 3.5rem 0;
  }
  .content-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
  }
  .main-article {
    line-height: 1.75;
    color: #334155;
    font-size: 1.05rem;
  }
  .main-article :global(h2) {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    margin: 2rem 0 1rem;
  }
  .main-article :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin: 1.5rem 0 0.75rem;
  }
  .main-article :global(p) {
    margin-bottom: 1.25rem;
  }
  .main-article :global(ul), .main-article :global(ol) {
    margin: 0 0 1.5rem 1.5rem;
  }
  .main-article :global(li) {
    margin-bottom: 0.5rem;
  }
  .main-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .main-article :global(th), .main-article :global(td) {
    border: 1px solid #cbd5e1;
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .main-article :global(th) {
    background: #f1f5f9;
    font-weight: 700;
  }
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
  }
  .sidebar-box h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: #0f172a;
  }
  .sidebar-box p {
    font-size: 0.9rem;
    color: #64748b;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .btn-sidebar-wa {
    display: block;
    background: #25d366;
    color: #ffffff;
    text-align: center;
    padding: 0.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.5rem;
  }
  .sidebar-links a {
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .sidebar-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 850px) {
    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .page-title {
      font-size: 1.75rem;
    }
  }
</style>