---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Komple Mutfak Tadilatı İzmir | Kırım, Tesisat & Montaj",
  description: "İzmir komple mutfak tadilatı. Kırım, moloz atımı, su-elektrik tesisatı, 60x120 porselen seramik, tezgah ve özel imalat mutfak dolabı montajı. Kadrolu mimarımızla 3D sanal simülasyon ve mimar onaylı sözleşme güvencesi.",
  canonical: "https://yesilaymutfak.com/izmir-komple-mutfak-tadilati/",
  serviceName: "Komple Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Komple Mutfak Tadilatı", url: "/izmir-komple-mutfak-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de mutfak kırımından tesisatına komple mutfak yenileme süreci ve maliyeti nedir?",
      answer: "Komple mutfak yenileme süreci; kırım, hafriyat, elektrik-su tesisatı yenileme, seramik kaplama, dolap ve tezgah montajı dahil 12-16 iş günüdür. Maliyet seçilen kapak ve tezgah sınıfına göre şeffaf metretül ve işçilik cetveliyle belirlenir."
    },
    {
      question: "Tadilat süresince elektrik ve su tesisatında hangi markalar kullanılır?",
      answer: "Tüm boru tesisatında Fıratpen / Hakan Plastik kompozit borular, elektrik altyapısında Siemens / Schneider sigortalar ve Viko yanmaz kablolar kullanılır."
    },
    {
      question: "Tadilat sürecinde ek bütçe veya maliyet çıkar mı?",
      answer: "Kesinlikle olmaz. 1998 yılından gelen kurumsal disiplinimizle tüm kalemler noter onaylı resmi sözleşmeyle kilitlenir; tek kuruş sürpriz maliyet çıkarılmaz."
    }
  ]
};
---

<Layout seo={seo} activeService="Komple Mutfak Tadilatı">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1800&q=75&fm=webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Komple Mutfak Tadilatı</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1998'DEN BUGÜNE 28 YILLIK TECRÜBE • 2.850+ TESLİM EDİLMİŞ PROJE
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İzmir Komple Mutfak Tadilatı: <br /><span class="font-normal italic">Tesisat, Kırım, Tezgah ve Dolap Yenileme Projeleri</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Kırım, moloz, tesisat, elektrik, seramik, tezgah ve dolap işlerini tek çatı altında çözüyoruz. Kadrolu mimar ve iç mimarlarımızın 3D sanal canlandırma simülasyonu ile üretime girmeden önce sonucu görün, resmi sözleşmeyle sıfır riskle teslim alın.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905353748329?text=Merhaba,%20komple%20mutfak%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile 3D Keşif İste</span>
        </a>
        <a href="tel:05353748329" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0535 374 83 29
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-stone-100 border-b border-stone-200 py-10" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900">Komple Mutfak Tadilatı Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Gövde Malzemesi</strong>
          <p class="text-stone-600">E1 Normunda 18 mm Neme Dayanıklı Beyaz / Antrasit MDF-Lam.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Kapak Seçenekleri</strong>
          <p class="text-stone-600">İtalyan Akrilik, Çift Yüz Lake Boya, Doğal Ahşap Kaplama, Membran.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Menteşe ve Ray Sistemleri</strong>
          <p class="text-stone-600">Blum Clip-Top / Hettich Frenli Ray Sistemleri (Ömür Boyu Garanti).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">İmalat 15-21 İş Günü | Komple Tadilat 20-30 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.850+ teslim edilmiş konut mutfak tadilatı referansı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tek Muhatap Mimar</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta karmaşasına son; tüm şantiye kadrolu mimarımız yönetiminde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Mekan Deneyimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Sürprizsiz sonuç için üretime girmeden fotogerçekçi canlandırma.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden tüm İzmir geneline yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Komple Mutfak Tadilatı Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Mutfağınızı Yenilemek İçin Ücretsiz Keşif Randevusu Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp üzerinden iletişime geçin; mimarımız adresinizde keşif yapsın.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905353748329?text=Merhaba,%20komple%20mutfak%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0535 374 83 29)
        </a>
      </div>
    </div>
  </section>

</Layout>