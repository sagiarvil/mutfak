---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Komple Mutfak Tadilatı İzmir | Kırım, Tesisat & Montaj",
  description: "İzmir komple mutfak tadilatı. Kırım, moloz atımı, su-elektrik tesisatı, 60x120 porselen seramik, tezgah ve özel imalat mutfak dolabı montajı. Kadrolu mimarımızla 3D sanal simülasyon ve mimar onaylı sözleşme güvencesi.",
  canonical: "https://izmirmutfakbanyo.com.tr/izmir-komple-mutfak-tadilati/",
  serviceName: "Komple Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Komple Mutfak Tadilatı", url: "/izmir-komple-mutfak-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de mutfak kırımından tesisatına komple mutfak yenileme süreci ve maliyeti nedir?",
      answer: "Komple mutfak yenileme süreci; kırım, hafriyat, elektrik-su tesisatı yenileme, seramik kaplama, dolap ve tezgah montajı dahil 12-16 iş günüdür. Maliyet seçilen kapak ve tezgah sınıfına göre şeffaf metretül ve işçilik cetveliyle belirlenir."
    },
    {
      question: "Tadilat süresince elektrik ve su tesisatında hangi markalar kullanılır?",
      answer: "Tüm boru tesisatında Fıratpen / Hakan Plastik kompozit borular, elektrik altyapısında Siemens / Schneider sigortalar ve Viko yanmaz kablolar kullanılır."
    },
    {
      question: "Tadilat sürecinde ek bütçe veya maliyet çıkar mı?",
      answer: "Kesinlikle olmaz. 1998 yılından gelen kurumsal disiplinimizle tüm kalemler noter onaylı resmi sözleşmeyle kilitlenir; tek kuruş sürpriz maliyet çıkarılmaz."
    }
  ]
};
---

<Layout seo={seo} activeService="Komple Mutfak Tadilatı">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & CANLI SPLIT VİTRİN - DARK HERO YOK) -->
  <section class="relative bg-[#FBF9F5] border-b border-[#EAE5DC] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F5EFE6]/60 to-transparent pointer-events-none"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AYDINLIK & GÜVEN VEREN MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#083322] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#8C6D3F] font-bold">Komple Mutfak Tadilatı</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#C5A880]/50 text-[#083322] text-[11px] font-bold tracking-[0.16em] uppercase rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span>28 YILLIK TECRÜBE • 2.850+ TESLİM PROJE</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#083322] leading-[1.14] tracking-tight">
            İzmir Komple Mutfak Tadilatı: <br />
            <span class="text-[#8C6D3F] font-serif font-normal italic">Tesisat, Kırım, Tezgah &amp; Dolap</span> <br />
            <span class="text-[#2B231D]">Anahtar Teslim Yenileme.</span>
          </h1>

          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Kırım, moloz, sıhhi tesisat, elektrik altyapısı, seramik, porselen tezgah ve lake dolap işlerini tek çatı altında çözüyoruz. Kadrolu mimarımızın 3D simülasyonu ile üretime girmeden sonucu görün, resmi sözleşmeyle sıfır riskle teslim alın.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Tüm Kırım &amp; Tesisat Dahil</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">İtalyan Lake &amp; Porselen Tezgah</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Gecikme Cezası Garantisi</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905393333303?text=Merhaba,%20komple%20mutfak%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile 3D Keşif İste</span>
              <span>→</span>
            </a>
            <a 
              href="tel:05393333303" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#083322] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              0539 333 33 03
            </a>
          </div>
        </div>

        <!-- SAĞ: AYDINLIK MUTFAK TADİLATI GÖRSELİ (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-07.webp" 
              alt="İzmir Komple Mutfak Tadilatı ve Tezgah Dolap Yenileme" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#C5A880] block">KOMPLE RENOVASYON</span>
              <p class="text-sm font-serif font-bold text-white mt-0.5">Karşıyaka Yalı Daire • Komple Kırım & Lake Mutfak Teslimi</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#006039] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880]">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Komple Mutfak Tadilatı Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Gövde Malzemesi</strong>
          <p class="text-stone-600">E1 Normunda 18 mm Neme Dayanıklı Beyaz / Antrasit MDF-Lam.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Kapak Seçenekleri</strong>
          <p class="text-stone-600">İtalyan Akrilik, Çift Yüz Lake Boya, Doğal Ahşap Kaplama, Membran.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Menteşe ve Ray Sistemleri</strong>
          <p class="text-stone-600">Blum Clip-Top / Hettich Frenli Ray Sistemleri (Ömür Boyu Garanti).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">İmalat 15-21 İş Günü | Komple Tadilat 20-30 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.850+ teslim edilmiş konut mutfak tadilatı referansı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tek Muhatap Mimar</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta karmaşasına son; tüm şantiye kadrolu mimarımız yönetiminde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Mekan Deneyimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Sürprizsiz sonuç için üretime girmeden fotogerçekçi canlandırma.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden tüm İzmir geneline yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Komple Mutfak Tadilatı Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#041F14]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- ÇAĞRI BÖLÜMÜ (LUMINOUS ARCHITECTURAL VIP CALLOUT)                    -->
  <!-- ===================================================================== -->
  <section class="py-20 relative overflow-hidden bg-gradient-to-b from-[#FAF8F5] via-[#F4F0E8] to-[#FAF8F5] text-center border-t border-[#E8E2D8] text-zinc-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white rounded-full border border-[#C5A880]/60 text-[#8C6D3F] text-xs uppercase font-bold tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#107C41] animate-ping"></span>
        MİMARİ KEŞİF & ÖZEL RANDEVU
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#083322] font-serif tracking-tight leading-tight">
        Mutfağınızı Yenilemek İçin Ücretsiz Keşif Randevusu Alın
      </h2>
      <p class="text-xs sm:text-sm text-zinc-600 font-light max-w-xl mx-auto leading-relaxed">
        İletişime geçin veya WhatsApp üzerinden iletişime geçin; mimarımız adresinizde keşif yapsın.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a 
          href="https://wa.me/905393333303?text=Merhaba,%20komple%20mutfak%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-4 bg-[#083322] hover:bg-[#0C4A31] text-[#C5A880] text-xs font-bold uppercase tracking-wider rounded-xl border border-[#C5A880]/40 shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile VIP Keşif Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:05393333303" 
          class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-[#FAF7F2] border border-[#E5DFD5] text-[#083322] font-bold text-xs uppercase tracking-wider rounded-xl shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>📞 0539 333 33 03</span>
        </a>
      </div>
    </div>
  </section>

</Layout>