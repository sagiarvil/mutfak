---
import Layout from "../../layouts/Layout.astro";
import yapilanIsler from "../../data/yapilanIslerData.json";

const seo = {
  title: "Yapılan İşler & Canlı Atölye Montajları — Cem Yeşilay Luxury",
  description: "İzmir Buca Adatepe imalat atölyemizden Urla, Çeşme, Karşıyaka ve tüm İzmir genelinde tamamlayıp teslim ettiğimiz 96+ gerçek lake mutfak, lüks banyo, özel kapı ve anahtar teslim renovasyon projeleri.",
  canonical: "https://yesilaymutfak.com/yapilan-isler/",
  serviceName: "Tamamlanan Projeler & İmalat Galerisi",
  breadcrumbs: [
    { name: "Yapılan İşler", url: "/yapilan-isler/" }
  ],
  keywords: [
    "cem yeşilay yapılan işler",
    "izmir mutfak montaj fotoğrafları",
    "buca atölye imalat teslimleri",
    "çeşme villa mutfak projeleri",
    "urla lüks mutfak referansları",
    "anahtar teslim tadilat fotoğrafları izmir"
  ]
};

const categories = ["Tümü", "Mutfak İmalatı", "Mutfak Tadilatı", "Lüks Banyo", "Tadilat & Dekorasyon", "Özel İmalat"];
---

<Layout seo={seo} activeService="Yapılan İşler">

  <!-- ===================================================================== -->
  <!-- 1. HERO BAŞLIK BÖLÜMÜ (CARTIER & ROLEX LÜKS DARK EMERALD)             -->
  <!-- ===================================================================== -->
  <section class="relative py-20 sm:py-24 bg-[#02130C] border-b border-[#0A2E1D] overflow-hidden text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(197,168,128,0.12)_0%,transparent_60%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#041F14] text-[#C5A880] border border-[#C5A880]/40 rounded-full shadow-lg">
        <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
        <span class="text-[11px] font-bold tracking-[0.16em] uppercase font-sans">
          ATÖLYEMİZDEN CANLI TESLİMAT KARELERİ • 96 GERÇEK PROJE
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-[56px] font-extrabold text-white leading-[1.1] tracking-tight font-serif max-w-4xl">
        Adatepe İmalat Zanaatı, <br />
        <span class="text-[#C5A880] font-normal italic">Teslim Ettiğimiz Yaşam Alanları.</span>
      </h1>

      <p class="text-sm sm:text-base text-[#D8D2C7] font-light leading-relaxed max-w-2xl">
        Showroom kataloğu değil; Buca Adatepe tesisimizde imal edip İzmir, Urla ve Çeşme genelindeki evlere montajını gerçekleştirdiğimiz gerçek mutfak, banyo ve anahtar teslim projelerimiz.
      </p>

      <!-- İstatistik Şeridi -->
      <div class="flex flex-wrap items-center gap-6 sm:gap-10 pt-4 border-t border-[#0D3826] text-xs">
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#C5A880] block font-sans">96</span>
          <span class="text-[#D8D2C7] uppercase tracking-wider text-[10px]">Fotoğraflanmış Proje</span>
        </div>
        <div class="w-px h-8 bg-[#0D3826]"></div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-white block font-sans">28</span>
          <span class="text-[#D8D2C7] uppercase tracking-wider text-[10px]">Yıllık Atölye Tecrübesi</span>
        </div>
        <div class="w-px h-8 bg-[#0D3826]"></div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#00FF66] block font-sans">%100</span>
          <span class="text-[#D8D2C7] uppercase tracking-wider text-[10px]">Kendi İmalatımız</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. YAPILAN İŞLER FİLTRELİ GALERİ VİTRİNİ (KARE & SİMETRİK)            -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F8FAFC] border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      
      <!-- Kategori Filtre Butonları -->
      <div class="flex flex-wrap gap-2 text-xs" id="filterButtons">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            data-filter={cat}
            class={`px-4 py-2.5 rounded font-bold uppercase tracking-wider text-[11px] transition-all duration-200 cursor-pointer ${idx === 0 ? 'bg-[#041F14] text-[#C5A880] border border-[#C5A880]/30 shadow-md active-filter' : 'bg-white text-zinc-700 hover:bg-zinc-100 border border-gray-300'}`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- 96 KARE VE SİMETRİK GÖRSEL GRID'İ (ASPECT-SQUARE, SIFIR BOZULMA) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="projectsGrid">
        {yapilanIsler.map((item) => (
          <div 
            class="project-card group bg-white border border-gray-200 hover:border-[#041F14] rounded-xl overflow-hidden flex flex-col justify-between apple-card transition-all duration-300"
            data-category={item.category}
          >
            <!-- 1:1 KARE GÖRSEL -->
            <div class="relative w-full aspect-square overflow-hidden bg-zinc-900 shrink-0">
              <img 
                src={item.img} 
                alt={item.altText} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                width="800"
                height="800"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-[#041F14]/90 backdrop-blur-md text-[#C5A880] text-[10px] font-bold uppercase tracking-wider rounded border border-[#C5A880]/30">
                #{String(item.id).padStart(2, '0')}
              </span>
              <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 bg-black/75 backdrop-blur-md text-white text-[9.5px] font-medium rounded">
                📍 {item.location}
              </span>
            </div>

            <!-- Bilgi ve WhatsApp Keşif Butonu -->
            <div class="p-4 flex-1 flex flex-col justify-between space-y-2.5">
              <div>
                <span class="text-[10px] uppercase tracking-wider font-bold text-[#041F14] block">
                  {item.category}
                </span>
                <h3 class="text-xs sm:text-[13px] font-bold text-zinc-900 group-hover:text-[#041F14] transition line-clamp-1 mt-0.5">
                  {item.title}
                </h3>
              </div>

              <div class="pt-2 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-[10.5px] text-zinc-500">Montaj Teslimi</span>
                <a 
                  href={`https://wa.me/905324261788?text=Merhaba%20Cem%20Bey,%20web%20sitenizdeki%20#${item.id}%20numaralı%20${item.location}%20projeniz%20hakkında%20bilgi%20ve%20ücretsiz%20keşif%20istiyorum.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-2.5 py-1 bg-[#041F14] hover:bg-[#073322] text-[#C5A880] rounded font-bold text-[10.5px] transition flex items-center gap-1 border border-[#C5A880]/30"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. ALT VIP KEŞİF ÇAĞRISI                                             -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#02130C] text-center border-t border-[#092B1B] text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight font-serif">
        Sizin Evinize de Bu Kaliteyi Taşıyalım
      </h2>
      <p class="text-xs sm:text-sm text-[#D8D2C7] font-light max-w-xl mx-auto">
        Tüm projelerimiz resmi noter onaylı gecikme cezalı sözleşmeyle güvence altına alınır. Yerinde ücretsiz lazer ölçüsü için hemen iletişime geçin.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a 
          href="https://wa.me/905324261788?text=Merhaba%20Cem%20Bey,%20yaptığınız%20işleri%20inceledim,%20benim%20evim%20için%20de%20ücretsiz%203D%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-8 py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-extrabold text-xs uppercase tracking-wider rounded border border-[#E5C378] shadow-xl transition-all duration-300"
        >
          WhatsApp ile VIP Keşif Al →
        </a>
        <a 
          href="tel:02324411060" 
          class="px-8 py-3.5 bg-[#051F14] hover:bg-[#083523] text-white border border-[#C5A880]/40 font-semibold text-xs uppercase tracking-wider rounded transition"
        >
          📞 0232 441 1060
        </a>
      </div>
    </div>
  </section>

  <!-- Filtreleme Scripti -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const filterBtns = document.querySelectorAll("#filterButtons button");
      const cards = document.querySelectorAll(".project-card");

      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Buton stil değişimi
          filterBtns.forEach(b => {
            b.className = "px-4 py-2.5 rounded font-bold uppercase tracking-wider text-[11px] transition-all duration-200 cursor-pointer bg-white text-zinc-700 hover:bg-zinc-100 border border-gray-300";
          });
          btn.className = "px-4 py-2.5 rounded font-bold uppercase tracking-wider text-[11px] transition-all duration-200 cursor-pointer bg-[#041F14] text-[#C5A880] border border-[#C5A880]/30 shadow-md active-filter";

          // Kartları filtrele
          cards.forEach(card => {
            const cat = card.getAttribute("data-category");
            if (filter === "Tümü" || cat === filter) {
              card.style.display = "flex";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    });
  </script>

</Layout>
