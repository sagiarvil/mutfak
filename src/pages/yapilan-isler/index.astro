---
import Layout from "../../layouts/Layout.astro";
import yapilanIsler from "../../data/yapilanIslerData.json";

const seo = {
  title: "İzmir Mutfak Dolabı & Tadilat Projelerimiz — Yapılan Gerçek İşler | İzmir Mutfak Banyo",
  description: "İzmir genelinde montajını tamamladığımız 96+ gerçek mutfak dolabı, anahtar teslim daire tadilatı, lüks banyo yenileme ve villa iç mimarlık projelerimizin canlı fotoğrafları.",
  canonical: "https://izmirmutfakbanyo.com.tr/yapilan-isler/",
  serviceName: "İzmir Mutfak Dolabı & Anahtar Teslim Tadilat Projelerimiz",
  breadcrumbs: [
    { name: "Yapılan İşler", url: "/yapilan-isler/" }
  ],
  keywords: [
    "izmir mutfak dolabı modelleri ve yapılan işler",
    "izmir anahtar teslim tadilat projeleri",
    "buca mutfak tadilatı fotoğrafları",
    "çeşme villa tadilat referansları",
    "urla lüks mutfak dolabı montajı",
    "izmir komple ev tadilatı öncesi sonrası"
  ]
};

const categories = ["Tümü", "Mutfak İmalatı", "Mutfak Tadilatı", "Lüks Banyo", "Tadilat & Dekorasyon", "Özel İmalat"];
---

<Layout seo={seo} activeService="Yapılan İşler">

  <!-- ===================================================================== -->
  <!-- 1. HERO BAŞLIK BÖLÜMÜ (AYDINLIK, PREMİUM SPLIT VİTRİN - DARK HERO YOK)   -->
  <!-- ===================================================================== -->
  <section class="relative bg-[#F4F6F8] border-b border-[#E2E8F0] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F4F6F8]/60 to-transparent pointer-events-none"></div>

    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, DOĞAL & PREMİUM ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#23323A] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#CB000F] font-bold">Yapılan İşler</span>
          </nav>

          <!-- Prestij Rozeti -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#CB000F]/50 rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span class="text-xs font-bold tracking-[0.16em] uppercase text-[#23323A] font-sans">
              CANLI ŞANTİYE MONTAJLARI • 96 GERÇEK PROJE
            </span>
          </div>

          <!-- Ana Başlık (Net, Okunabilir & Lüks Tipografi) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#23323A] leading-[1.14] tracking-tight">
            İzmir Mutfak Dolabı & <br />
            <span class="text-[#CB000F] font-['Montserrat',sans-serif] font-normal ">Anahtar Teslim Tadilat</span> <br />
            <span class="text-[#23323A]">Canlı Projelerimiz.</span>
          </h1>

          <!-- Net Açıklama -->
          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Katalog veya sanal render değil; İzmir imalat atölyemizde bizzat üretip İzmir genelinde montajını tamamladığımız gerçek mutfak dolapları, lüks banyo yenileme ve komple daire/villa taahhütlerimiz.
          </p>

          <!-- İstatistik Şeridi (Aydınlık Kart Formatı) -->
          <div class="grid grid-cols-3 gap-3 pt-1 text-xs">
            <div class="bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs text-center sm:text-left">
              <span class="text-2xl sm:text-3xl font-extrabold text-[#23323A] block font-['Montserrat',sans-serif]">96</span>
              <span class="text-zinc-600 uppercase tracking-wider text-[10px] font-bold">Teslim Edilen Proje</span>
            </div>
            <div class="bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs text-center sm:text-left">
              <span class="text-2xl sm:text-3xl font-extrabold text-[#CB000F] block font-['Montserrat',sans-serif]">28</span>
              <span class="text-zinc-600 uppercase tracking-wider text-[10px] font-bold">Yıllık Atölye Mirası</span>
            </div>
            <div class="bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs text-center sm:text-left">
              <span class="text-2xl sm:text-3xl font-extrabold text-[#23323A] block font-['Montserrat',sans-serif]">%100</span>
              <span class="text-zinc-600 uppercase tracking-wider text-[10px] font-bold">Birinci El İmalat</span>
            </div>
          </div>

          <!-- Aksiyon Butonları (Cartier Altın & Beyaz) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905393333303?text=Merhaba,%20yaptığınız%20projeleri%20inceledim,%20evim%20için%20ücretsiz%203D%20keşif%20almak%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#CB000F] hover:bg-[#b0000d] text-white text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#CB000F] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile 3D Keşif İste</span>
              <span>→</span>
            </a>
            <a 
              href="#galeri" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#23323A] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>96 Projeyi Filtrele ↓</span>
            </a>
          </div>

        </div>

        <!-- SAĞ: BÜYÜLEYİCİ, AYDINLIK GERÇEK MONTAJ SAHNESİ (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-01.webp" 
              alt="İzmir Gerçek Mutfak Dolabı İmalatı ve Canlı Montajı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#CB000F] block">CANLI TESLİMAT REFERANSI</span>
              <p class="text-sm font-['Montserrat',sans-serif] font-bold text-white mt-0.5">Mavişehir Rezidans • Lake & Ada Mutfak Dönüşümü</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. YAPILAN İŞLER FİLTRELİ GALERİ VİTRİNİ (KARE & SİMETRİK)            -->
  <!-- ===================================================================== -->
  <section class="py-16 bg-[#F8FAFC] border-b border-gray-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8 space-y-10">
      
      <!-- Kategori Filtre Butonları -->
      <div class="flex flex-wrap gap-2 text-xs" id="filterButtons">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            data-filter={cat}
            class={`px-4 py-2.5 rounded font-bold uppercase tracking-wider text-[11px] transition-all duration-200 cursor-pointer ${idx === 0 ? 'bg-[#23323A] text-[#CB000F] border border-[#CB000F]/30 shadow-md active-filter' : 'bg-white text-zinc-700 hover:bg-zinc-100 border border-gray-300'}`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- 96 KARE VE SİMETRİK GÖRSEL GRID'İ (ASPECT-SQUARE, SIFIR BOZULMA) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="projectsGrid">
        {yapilanIsler.map((item) => (
          <div 
            class="project-card group bg-white border border-gray-200 hover:border-[#23323A] rounded-xl overflow-hidden flex flex-col justify-between apple-card transition-all duration-300"
            data-category={item.category}
          >
            <!-- 1:1 KARE GÖRSEL -->
            <div class="relative w-full aspect-square overflow-hidden bg-zinc-900 shrink-0">
              <img 
                src={item.img} 
                alt={item.altText} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                width="800"
                height="800"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-[#23323A]/90 backdrop-blur-md text-[#CB000F] text-[10px] font-bold uppercase tracking-wider rounded border border-[#CB000F]/30">
                #{String(item.id).padStart(2, '0')}
              </span>
              <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 bg-black/75 backdrop-blur-md text-white text-[9.5px] font-medium rounded">
                📍 {item.location}
              </span>
            </div>

            <!-- Bilgi ve WhatsApp Keşif Butonu -->
            <div class="p-4 flex-1 flex flex-col justify-between space-y-2.5">
              <div>
                <span class="text-[10px] uppercase tracking-wider font-bold text-[#23323A] block">
                  {item.category}
                </span>
                <h3 class="text-xs sm:text-[13px] font-bold text-zinc-900 group-hover:text-[#23323A] transition line-clamp-1 mt-0.5">
                  {item.title}
                </h3>
              </div>

              <div class="pt-2 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-[10.5px] text-zinc-500">Montaj Teslimi</span>
                <a 
                  href={`https://wa.me/905393333303?text=Merhaba,%20web%20sitenizdeki%20#${item.id}%20numaralı%20${item.location}%20projeniz%20hakkında%20bilgi%20ve%20ücretsiz%20keşif%20istiyorum.`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-2.5 py-1 bg-[#23323A] hover:bg-[#073322] text-[#CB000F] rounded font-bold text-[10.5px] transition flex items-center gap-1 border border-[#CB000F]/30"
                >
                  <span>3D Keşif</span> <span>→</span>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. ALT VIP KEŞİF ÇAĞRISI (LUMINOUS ARCHITECTURAL CALLOUT)             -->
  <!-- ===================================================================== -->
  <section class="py-24 relative overflow-hidden bg-gradient-to-b from-[#F4F6F8] via-[#F4F6F8] to-[#F4F6F8] text-center border-t border-[#E2E8F0] text-zinc-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white rounded-full border border-[#CB000F]/60 text-[#CB000F] text-xs uppercase font-bold tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#107C41] animate-ping"></span>
        ÖZEL MİMARİ DÖNÜŞÜM
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-['Montserrat',sans-serif] leading-tight">
        Sizin Evinize de Bu Kaliteyi Taşıyalım
      </h2>
      <p class="text-xs sm:text-sm text-zinc-300 font-normal max-w-xl mx-auto leading-relaxed">
        Tüm projelerimiz resmi noter onaylı gecikme cezalı sözleşmeyle güvence altına alınır. Yerinde ücretsiz lazer ölçüsü için hemen iletişime geçin.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-3">
        <a 
          href="https://wa.me/905393333303?text=Merhaba,%20yaptığınız%20işleri%20inceledim,%20benim%20evim%20için%20de%20ücretsiz%203D%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-4 bg-[#23323A] hover:bg-[#172127] text-[#CB000F] font-extrabold text-xs uppercase tracking-wider rounded-xl border border-[#CB000F]/40 shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile VIP Keşif Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:05393333303" 
          class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-[#F4F6F8] text-[#23323A] border border-[#E2E8F0] font-bold text-xs uppercase tracking-wider rounded-xl shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>📞 0539 333 33 03</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Filtreleme Scripti -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const filterBtns = document.querySelectorAll("#filterButtons button");
      const cards = document.querySelectorAll(".project-card");

      filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Buton stil değişimi
          filterBtns.forEach(b => {
            b.className = "px-4 py-2.5 rounded font-bold uppercase tracking-wider text-[11px] transition-all duration-200 cursor-pointer bg-white text-zinc-700 hover:bg-zinc-100 border border-gray-300";
          });
          btn.className = "px-4 py-2.5 rounded font-bold uppercase tracking-wider text-[11px] transition-all duration-200 cursor-pointer bg-[#23323A] text-[#CB000F] border border-[#CB000F]/30 shadow-md active-filter";

          // Kartları filtrele
          cards.forEach(card => {
            const cat = card.getAttribute("data-category");
            if (filter === "Tümü" || cat === filter) {
              card.style.display = "flex";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    });
  </script>

</Layout>
