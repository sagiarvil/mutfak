---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Mutfak Dolabı Mimari Projelendirme | Siz Hayal Edin Biz Çizelim",
  description: "2026 güncel İzmir mutfak dolabı modelleri ve mimari tasarımları, malzeme bazlı (Lake, Akrilik, MDF-Lam, Masif) metretül cetveli, kırım-montaj işçilik rayiçleri ve Buca imalat atölyesinden şeffaf maliyet hesaplama tablosu.",
  canonical: "https://yesilaymutfak.com/2026-mutfak-dolabi-fiyatlari/",
  serviceName: "Mutfak Dolabı 3D Mimari Tasarım & Keşif Rehberi",
  breadcrumbs: [
    { name: "2026 Mimari Projelendirme", url: "/2026-mutfak-dolabi-fiyatlari/" }
  ],
  faqList: [
    {
      question: "2026 yılında İzmir'de ortalama bir mutfak dolabı nasıl projelendirilir ve malzeme seçimi nasıl yapılır?",
      answer: "2026 yılında İzmir'de mutfak dolabı imalatı mekanınızın ölçülerine göre özel olarak metretül ve mekan rölövesine göre özel olarak projelendirilir. Standart MDF-Lam ekonomik segmentten başlarken, İtalyan akrilik kapak orta-üst segmentte, çift yüz ipek mat lake boya ise premium grupta yer alır. Buca atölyemizden aracısız fabrika tasarımı sunuyoruz."
    },
    {
      question: "Mimari keşif ve 3D çizim hizmeti ücrete tabi midir?",
      answer: "Tekliflerimizde nakliye, montaj ve kulp aksamları dahildir. Tezgah tercihi (Porselen, Belenco, Çimstone veya Masif Ahşap) müşteri seçimine göre net maliyetiyle ayrı kalem olarak belirtilir."
    },
    {
      question: "Siz hayal edin, biz ortaya çıkaralım mottosu nasıl uygulanıyor?",
      answer: "Hayır. Kadrolu mimarımızın evinize gelerek lazerli rölöve alması ve 3D sanal canlandırma simülasyonunu hazırlaması tamamen ücretsizdir."
    }
  ]
};
---

<Layout seo={seo} activeService="Mimari Rehber">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-[#0E2017] text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('/media/real/yesilay-mimari-danismanlik-toplanti-wide.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A1A12]/85 via-[#0A1A12]/40 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">2026 Mimari Projelendirme Rehberi</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1998'DEN BUGÜNE 28 YILLIK TECRÜBE • SİZ HAYAL EDİN BİZ ORTAYA ÇIKARALIM
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Siz Hayal Edin, Mimarımız Çizsin: <br /><span class="font-normal italic">Evinize Özel 3D Mutfak Tasarımı &amp; Birebir Projelendirme</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Ekonomik kaliteli MDF-Lam'dan ultra lüks lake ve masif modellere kadar her bütçeye uygun şeffaf üretim. İzmir Buca imalat atölyemizden aracısız, kadrolu mimarımızın hazırladığı ücretsiz 3D sanal simülasyon güvencesiyle.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20mutfak%20dolabı%20mimari çizim%20hesaplaması%20için%20teklif%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>Mimarımızla 3D Çizim Başlat</span>
        </a>
        <a href="tel:02324411060" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0232 441 10 60
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING: İLK 14KB İÇİ DETAYLI ŞEFFAF TABLO -->
  <section class="bg-stone-100 border-b border-stone-200 py-10" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">MİMARİ DANIŞMANLIK &amp; PLANLAMA</span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900">Mutfak Projenizi Belirleyen Malzeme &amp; Mimari Standartlar</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">MDF-Lam Standart</strong>
          <p class="text-stone-600">E1 Normunda 18 mm Beyaz MDF Gövde, Samet Frenli Ray/Menteşe • Ekonomik Bütçe.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">İtalyan Akrilik</strong>
          <p class="text-stone-600">Çizilmez Akrilik Yüzey, Blum Frenli Ray Sistemleri • Dayanıklılık & Tasarım Lideri.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">İpek Mat Lake</strong>
          <p class="text-stone-600">Poliüretan Çift Kat Astar &amp; Boya, Blum Aventos Kalkar Kapak • Lüks Mimari Segment.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">İmalat 15-21 İş Günü | Yerinde Montaj 1-2 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Doğrudan İmalat</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Aracı komisyonu yok, Buca atölyemizden doğrudan fabrika maliyeti.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📐</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Ücretsiz 3D Çizim</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">İç mimarlarımız evinize özel çizimi hazırlar, bütçeyi netleştirir.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🔒</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar Onaylı Sözleşme Güvencesi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Sözleşmede belirlenen tutar değişmez, tek kuruş sürpriz çıkmaz.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tüm İzmir'e Keşif</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca merkezli olarak 30 ilçenin tamamına ücretsiz yerinde ölçü.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GERÇEK ATÖLYE & SHOWROOM VİTRİNİ -->
  <section class="py-20 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">GERÇEK İMALAT VE TEŞHİR KANITI</span>
        <h2 class="text-2xl sm:text-4xl font-light text-stone-950 font-editorial">
          Komple Mutfak Renovasyonunda Gerçek Atölye Güvencesi
        </h2>
        <p class="text-sm text-stone-600 font-light leading-relaxed">
          Kırım ve tesisattan lake dolap imalatına, porselen tezgahtan montaja kadar tek muhatap garantisi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-showroom-gece-cephe.webp" alt="Yeşilay Mutfak Showroom Dış Cephesi" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider rounded">AMİRAL SHOWROOM</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Buca Gaziler Showroom</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Yeni nesil ada mutfak modellerini ve kapak seçeneklerini canlı görün.</p>
          </div>
        </div>

        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-aluminyum-fluted-cam-kapak.webp" alt="Alüminyum Profil ve Fluted Cam Kapak" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-stone-900 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold uppercase tracking-wider rounded">İTALYAN DONANIM</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">Fluted Cam & Çerçeve Profiller</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Buhara ve çizilmeye dayanıklı modern cam kiler dolap sistemleri.</p>
          </div>
        </div>

        <div class="group bg-[#FAF9F6] border border-stone-200 overflow-hidden rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="aspect-[4/3] overflow-hidden bg-stone-900 relative">
            <img src="/media/real/yesilay-mimari-danismanlik-toplanti-wide.webp" alt="Mimari Danışmanlık ve Bütçe Planlama" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 bg-emerald-700 text-white text-[10px] font-bold uppercase tracking-wider rounded">BİREBİR REHBERLİK</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-700 transition">3D Projelendirme & Sabit Fiyat</h3>
            <p class="text-xs text-stone-600 leading-relaxed">Lazer rölöve sonrası noter onaylı sözleşmeyle sürpriz masrafsız teslim.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Mimari Tasarım ve Projelendirme Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Siz Hayal Edin, Birlikte Ortaya Çıkaralım: 3D Çizim Randevusu Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        Ölçülerinizi WhatsApp'tan gönderin veya ücretsiz keşif isteyin; 3D çizim ve kalem kalem dökümlü 3D sanal çizim ve mimari projenizi hazırlayalım.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20mutfak%20dolabı%20mimari çizim%20hesaplaması%20için%20teklif%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 Mimarımızla Görüşün & 3D Çizim Alın (0232 441 10 60)
        </a>
      </div>
    </div>
  </section>

</Layout>