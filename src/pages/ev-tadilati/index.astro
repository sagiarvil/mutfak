---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Komple Ev Tadilatı & Daire Yenileme | 1984'ten Bugüne",
  description: "İzmir komple ev tadilatı. Mutfak, banyo, elektrik, su tesisatı, zemin parke, alçı tavan ve boya. Kadrolu mimarımızla 3D sanal canlandırma ve resmi sözleşmeli sabit fiyat garantisi.",
  canonical: "https://izmirmutfakbanyo.com.tr/ev-tadilati/",
  serviceName: "Komple Ev Tadilatı",
  breadcrumbs: [
    { name: "Ev Tadilatı", url: "/ev-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de 3+1 daire komple tadilatı kaç günde biter?",
      answer: "Komple daire tadilatı (kırım, tesisat, elektrik, mutfak, banyo, seramik, parke ve boya) ortalama 25 ila 35 iş günü içerisinde anahtar teslim tamamlanır."
    },
    {
      question: "Tadilat süresince şantiyeyi nasıl takip edebilirim?",
      answer: "Projenin başında kadrolu mimarımız atanır. Günlük fotoğraflı ve videolu şantiye ilerleme raporu WhatsApp üzerinden iletilir."
    }
  ]
};
---

<Layout seo={seo} activeService="Komple Ev Tadilatı">
  
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Komple Ev Tadilatı</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1984'TEN BUGÜNE 42 YILLIK TECRÜBE • 2.463+ TESLİM EDİLMİŞ PROJE
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İzmir Komple Ev Tadilatı, <br /><span class="font-normal italic">Mimari Projelendirme &amp; Anahtar Teslim</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Mutfak, banyo, elektrik, su tesisatı, parke, lake kapı ve asma tavan işlerini tek elden yönetiyoruz. Kadrolu mimar ve iç mimarlarımızla 3D sanal mekan simülasyonu sunuyor, resmi sözleşmeli sabit fiyat garantisiyle teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20komple%20ev%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Keşif İste</span>
        </a>
        <a href="tel:05393333303" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0539 333 33 03
        </a>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1984</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">42 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463+ tamamlanmış daire ve villa tadilatı referansı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tek Muhatap, Sıfır Stres</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Tüm ustaları, şantiyeyi ve teslimatı mimarımız koordine eder.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Tüm odaları 3 boyutlu modelleyerek sürprizleri sıfırlıyoruz.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; Tüm İzmir</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca showroomumuzdan İzmir geneline yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Evinizi Yenilemek İçin Ücretsiz Keşif Randevusu Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        Buca Showroomumuza gelin veya WhatsApp'tan yazın; kadrolu mimarımız evinize gelerek rölöve ve 3D çizim analizini hazırlasın.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20komple%20ev%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0539 333 33 03)
        </a>
      </div>
    </div>
  </section>

</Layout>
