---
import Layout from "../../layouts/Layout.astro";

const seo = {
  title: "İzmir Klasik & Country Mutfak Modelleri | Çıtalı Lake & Masif İmalat",
  description: "İzmir'de el işçiliği CNC çıtalı lake ve country mutfak dolabı imalatı. Sararmayan 4 kat ipek mat lake, porselen ve pirinç kulplar, masif detaylar ve Buca atölyesinden ücretsiz 3D çizim.",
  canonical: "https://izmirmutfakbanyo.com.tr/klasik-country-mutfak-modelleri/",
  serviceName: "Klasik ve Country Mutfak Modelleri İmalatı",
  breadcrumbs: [
    { name: "Koleksiyonlar", url: "/#stretcher-section" },
    { name: "Klasik & Country Mutfak Modelleri", url: "/klasik-country-mutfak-modelleri/" }
  ],
  faqList: [
    {
      question: "Lake country mutfak dolapları zamanla sararma yapar mı?",
      answer: "Hayır. Atölyemizde kullanılan 4 kat poliüretan ve akrilik bazlı İtalyan lake boyalar UV filtreli fırın kurutmalıdır. Güneş ışığı ve yemek buharına karşı renk değişimi ve sararmaya karşı 10 yıl boya garantilidir."
    },
    {
      question: "Country mutfaklarda çıta temizliği zor mudur?",
      answer: "Kullandığımız CNC çıta profilleri toz tutmayan yumuşak eğimli (pahlı) açılarla frezelenir ve ipek mat pürüzsüz boyayla kaplanır. Nemli bir mikrofiber bezle saniyeler içinde kolayca silinir."
    },
    {
      question: "Klasik mutfaklarda ahşap tezgah mı yoksa porselen mi tercih edilmeli?",
      answer: "Doğal sıcaklık arayanlar için fırınlanmış masif meşe tezgahlar, yoğun su ve sıcak tencere teması olan evlerde ise klasik mermer dokulu Calacatta porselen veya kuvars tezgahlar tavsiye edilir."
    },
    {
      question: "Klasik mutfak teslim süresi ne kadardır?",
      answer: "Detaylı çıta işçiliği, astar ve katlar arası zımparalı fırın boya süreçleri sebebiyle klasik ve country mutfak imalat süremiz ortalama 20-25 iş günüdür."
    }
  ]
};

const models = [
  {
    id: "provenza-country",
    title: "Foça Masif Çerçeveli Beyaz Country",
    badge: "Zamansız Klasik",
    tag: "İpek Mat Lake & Masif Meşe",
        img: "/media/projeler/proje-01.webp",
    desc: "Fransız Provence kır evlerinin dinginliğini İzmir'e taşıyan model. Kırık beyaz çıtalı lake kapaklar, doğal masif meşe ada tezgahı ve porselen seramik çift gözlü evye.",
    features: ["45 Derece CNC Çıta Göbek", "Fırınlanmış Masif Meşe Ada", "Blum Frenli Gizli Raylar", "Porselen Esintili Antik Kulplar"]
  },
  {
    id: "toscana-vintage",
    title: "Urla Bağ Evi Adaçayı Yeşili Lake",
    badge: "2026 Trend Rengi",
    tag: "Adaçayı Lake & Antik Pirinç",
        img: "/media/projeler/proje-02.webp",
    desc: "Huzur veren pastel adaçayı yeşili lake gövde, eskitme antik sarı pirinç fincan kulplar ve çıtalı cam vitrin dolapları. Akdeniz mimarisine en çok yakışan sıcak atmosfer.",
    features: ["İtalyan Fırınlı Mat Lake", "Kare Çıtalı Cam Vitrin Dolapları", "Belenco Damarlı Kuvars Tezgah", "Gizli Şişelik ve Baharatlık Ünitesi"]
  },
  {
    id: "victoria-somine",
    title: "Alaçatı Rustik Kemerli Taş Villa Mutfak",
    badge: "Görkemli Tasarım",
    tag: "Geniş Davlumbaz Tacı & Ada",
        img: "/media/projeler/proje-03.webp",
    desc: "Ocak bölümünü şömine formunda çerçeveleyen gösterişli ahşap davlumbaz tacı, oyma yan kolonlar ve geniş tencereler için tasarlanmış derin country çekmeceler.",
    features: ["Özel Oyma Davlumbaz Tacı", "Masif Sütun ve Taç Detayları", "Porselen Tekne Evye", "İçten Led Aydınlatmalı Vitrin"]
  },
  {
    id: "riviera-navy",
    title: "Çeşme Gece Mavisi Pirinç Detaylı Klasik",
    badge: "Asil & Karakterli",
    tag: "Gece Mavisi Lake & Altın Detay",
        img: "/media/projeler/proje-04.webp",
    desc: "Cesur ve asil bir duruş: Derin lacivert ipek lake yüzeyler, fırçalanmış mat altın kulp detayları ve Calacatta altın damarlı parlak kuvars tezgah uyumu.",
    features: ["Sararmayan UV Koruma Lake", "Fırçalanmış Mat Altın Donanım", "Calacatta Gold Kuvars Tezgah", "Blum Tandembox Çift Çeper Ray"]
  },
  {
    id: "hampton-ceviz",
    title: "Bademler Doğal Kestane Masif Çerçeve",
    badge: "Doğal & Sıcak",
    tag: "Doğal Ceviz & Taş Doku",
        img: "/media/projeler/proje-05.webp",
    desc: "Doğal ceviz ağacı çıtalarla çerçevelenmiş kapaklar, taş dokulu ada panelleri ve organik zarafet. Hem şehir evleri hem de Urla / Çeşme taş evleri için ideal.",
    features: ["Masif Ceviz Çerçeve Çıta", "Doğal Yağlı Koruma Cilası", "Kuvars Taş Görünümlü Tezgah", "Geniş Boy Kiler Dolabı"]
  },
  {
    id: "cottage-krem",
    title: "Göztepe Neoklasik Sıcak Krem Lake",
    badge: "Sıcak & Samimi",
    tag: "Sıcak Krem & Dikey Ahşap Oluk",
        img: "/media/projeler/proje-06.webp",
    desc: "Gözü yormayan sıcak vanilya-krem tonları, dikey fuga çıtaları ve geniş ada masası. Ailenin bir arada vakit geçirdiği en samimi mutfak konsepti.",
    features: ["Dikey Fuga CNC Detayları", "Akrilik Çizilmez Krem Yüzey", "Ahşap Masif Açık Raflar", "Gömme Tabaklık ve Kadehlik"]
  }
];
---

<Layout seo={seo} activeService="Klasik & Country Mutfak Modelleri">
  
  <!-- HERO BÖLÜMÜ (SICAK COUNTRY, AYDINLIK FİLDİŞİ & NEFES KESEN ZARAFET) -->
  <section class="relative bg-[#FDFCFA] border-b border-[#EAE3D6] py-12 sm:py-20 overflow-hidden">
    <!-- Yumuşak Sıcak Güneş Işığı Hissiyatı -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#FAF4E8]/70 to-transparent pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: 5 SANİYEDE ANLAŞILIR SICAK COUNTRY DOKUSU (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#041F14] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#8B5E3C] font-bold">Klasik &amp; Country Koleksiyonu</span>
          </nav>

          <!-- Prestij Rozeti -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#D4B996] rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
            <span class="text-xs font-bold tracking-[0.16em] uppercase text-[#5C3D28] font-sans">
              ZAMANSIZ COUNTRY MİMARİSİ • İTALYAN ÇITA &amp; İPEK LAKE
            </span>
          </div>

          <!-- Ana Başlık (Sıcak, Duygusal & Kadınların Göz Bebeği Country Zarafeti) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-extrabold text-[#2C1810] leading-[1.12] tracking-tight">
            Evinizin Kalbi, <br />
            <span class="text-[#8B5E3C] font-serif font-normal italic">Zarif Çıta &amp; Masif Sıcaklığıyla</span> <br />
            <span class="text-[#041F14]">Huzur Veren Bir Masala Dönüşsün.</span>
          </h1>

          <!-- Net & İkna Edici Açıklama -->
          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Modası yıllar geçse de eskimeyen çıtalı kapak işçiliği, sararma yapmayan UV korumalı 4 kat fırın boyası, antik pirinç kulplar ve masif ada masası entegrasyonu. Buca atölyemizde kişiye özel ölçüyle hayalinizdeki country sıcaklığını üretiyoruz.
          </p>

          <!-- Kadınların Sevdiği 3 Country Detayı -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#EAE3D6] shadow-xs">
              <span class="text-[#8B5E3C] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Sararmayan İpek Mat Boya</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#EAE3D6] shadow-xs">
              <span class="text-[#8B5E3C] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Geniş Ada &amp; Kahvaltı Masası</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-2.5 rounded-lg border border-[#EAE3D6] shadow-xs">
              <span class="text-[#8B5E3C] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Antik Pirinç Porselen Donanım</span>
            </div>
          </div>

          <!-- Aksiyon Butonları -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905393333303?text=Merhaba,%20country%20ve%20klasik%20mutfak%20modelleriniz%20hakkında%20bilgi%20ve%20ücretsiz%203D%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Country Keşif İste</span>
              <span>→</span>
            </a>
            <a 
              href="#modeller" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#2C1810] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>Modelleri İncele ↓</span>
            </a>
          </div>

        </div>

        <!-- SAĞ: IŞIK SAÇAN SICAK COUNTRY MUTFAK KARESI (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(92,61,40,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-04.webp" 
              alt="İzmir Klasik & Country Çıtalı Mutfak Dolabı İmalatı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <!-- Zarif Alt Bilgi Şeridi -->
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] uppercase font-bold tracking-widest text-[#C5A880] block">CANLI MONTAJ REFERANSI</span>
              <p class="text-sm font-semibold text-white mt-0.5">Çeşme Alaçatı • Fildişi Çıtalı Ada Mutfak</p>
            </div>
            <!-- Rozet -->
            <div class="absolute top-4 right-4 px-3 py-1 bg-white/95 backdrop-blur-md rounded-full shadow-md border border-[#EAE3D6] text-[11px] font-bold text-[#5C3D28]">
              45° Kusursuz CNC Gönye
            </div>
          </div>
        </div>

      </div>

      <!-- Alt Güvence Şeridi -->
      <div class="mt-12 pt-8 border-t border-[#EAE3D6] grid grid-cols-2 md:grid-cols-4 gap-6 text-center sm:text-left">
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#8B5E3C] font-sans">10 Yıl</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Sararmaz Lake Garantisi</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#2C1810] font-sans">E1 MDF</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Rutubete Dirençli Yeşil Marin Gövde</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#C5A880] font-sans">Masif Ahşap</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Doğal Ağaç Hare ve Dokusu</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-[#006039] font-sans">Sözleşmeli</span>
          <span class="text-xs text-zinc-600 block mt-0.5 font-medium">Zamanında Teslim Taahhüdü</span>
        </div>
      </div>

    </div>
  </section>
    </div>
  </section>

  <!-- TEKNİK STANDARTLAR TABLOSU -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-amber-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-800">COUNTRY &amp; KLASİK TEKNİK DETAYLAR</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Klasik &amp; Country Mutfak Malzeme ve Ustalık Standartları</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-amber-800">Çıta &amp; Göbek Profili</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Özel açılı CNC freze makinelerinde açılan ve el zımparasıyla pürüzsüzleştirilen 45° çıtalar. Toz tutmayan, kolay silinebilir özel pah kırımları.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-amber-800">4 Kat Fırın Lake Boya</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">2 kat poliüretan astar + 2 kat sararmayan son kat ipek mat boya. Atölyemizdeki pozitif basınçlı tozsuz fırınlarda kurutulur.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-amber-800">Aksesuar &amp; Kulp Seçenekleri</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Antik eskitme sarı pirinç fincan kulplar, porselen çiçek desenli düğmeler, camlı vitrin çıtaları ve gizlenebilir çekmece içi baharatlıklar.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-amber-800">Taç, Baza ve Şömine Tasarımı</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Tavan birleşiminde oymalı ahşap taçlar, alt kısımda ayakları gizleyen country bazalar ve ocak üstü için görkemli şömine davlumbaz mimarisi.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-amber-800">Gövde ve Neme Dayanım</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">18 mm neme dayanıklı E1 MDF-Lam gövde, 1 mm kalınlığında darbelere dayanıklı ABS kenar bantları ile su sızıntılarına karşı tam koruma.</p>
        </div>
        <div class="relative bg-gradient-to-br from-white via-[#FCFDFB] to-[#F7FAF8] p-6 rounded-xl border border-[#C5A880]/30 shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_rgba(4,31,20,0.1)] hover:-translate-y-1 transition-all duration-300 space-y-2.5 group">
          <strong class="text-stone-950 block text-xs uppercase tracking-wider text-amber-800">Evye ve Batarya Uyumu</strong>
          <p class="text-xs sm:text-[13px] text-zinc-600 font-light leading-relaxed">Tezgah altı veya önü açık döküm porselen (apron sink) tekne evyeler ve döner borulu kuğu rustik bataryalar ile kusursuz uyum.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MODELLER GALERİSİ -->
  <section class="py-20 sm:py-28 bg-white" id="modeller">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-700 block">ZAMANSIZ VE SICAK YAŞAM ALANLARI</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Seçkin <span class="font-normal italic">Klasik &amp; Country Mutfak Koleksiyonumuz</span>
        </h2>
        <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">
          Ahşabın doğallığı, çıtaların zarafeti ve ipek mat boyanın dinginliği... Buca atölyemizde kişiye özel üretilen 6 imza modelimizi inceleyin.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {models.map((m) => (
          <div class="bg-stone-50 border border-stone-200 overflow-hidden flex flex-col group hover:shadow-xl transition-all duration-300">
            <div class="relative h-64 sm:h-72 overflow-hidden bg-stone-900">
              <img 
                src={m.img} 
                alt={`${m.title} - İzmir Klasik ve Country Mutfak`} 
                class="w-full h-full object-cover transition duration-700 group-hover:scale-105" 
                loading="lazy" 
                decoding="async"
                width="600"
                height="400"
              />
              <div class="absolute top-3 left-3 flex flex-col gap-1.5">
                <span class="px-2.5 py-1 bg-stone-950/85 text-amber-300 text-[10px] font-bold uppercase tracking-wider backdrop-blur-sm">
                  {m.badge}
                </span>
                <span class="px-2.5 py-0.5 bg-white/90 text-[#041F14] text-[9.5px] font-bold uppercase tracking-wider">
                  {m.tag}
                </span>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <h3 class="text-xl font-bold text-[#041F14] group-hover:text-amber-800 transition">{m.title}</h3>
                <p class="text-xs text-stone-600 font-light leading-relaxed line-clamp-3">{m.desc}</p>
              </div>

              <div class="space-y-2 pt-2 border-t border-stone-200">
                <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400 block">Öne Çıkan Detaylar</span>
                <ul class="space-y-1 text-xs text-stone-700">
                  {m.features.map((f) => (
                    <li class="flex items-center gap-1.5">
                      <span class="text-amber-600 text-xs">✔</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-3 border-t border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] uppercase tracking-wider text-amber-800 block font-extrabold">MİMARİ PROJELENDİRME</span>
                  <span class="text-xs font-semibold text-stone-800">Siz Hayal Edin, Mimarımız Çizsin</span>
                </div>
                <a 
                  href={`https://wa.me/905393333303?text=Merhaba,%20${encodeURIComponent(m.title)}%20modeli%20i%C3%A7in%20mimar%C4%B1n%C4%B1zla%203D%20%C3%A7izim%20ve%20teklif%20g%C3%B6r%C3%BC%C5%9Fmesi%20yapmak%20istiyorum.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2.5 bg-amber-400 text-stone-950 text-[11px] font-black uppercase tracking-wider hover:opacity-90 transition inline-flex items-center justify-center gap-1.5 shadow-sm"
                >
                  <span>Mimarımızla Çizin</span>
                  <span>→</span>
                </a>
              </div>
