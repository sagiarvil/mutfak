---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";
import { buildWhatsAppUrl, buildTelUrl } from "../../utils/whatsapp";

const seo = {
  title: "İzmir Mutfak Tadilatı & Yenileme | 1984'ten Bugüne 42 Yıllık Güven",
  description: "İzmir komple mutfak tadilatı. Kadrolu mimar ve iç mimarlarımızla 3D sanal mekan deneyimi, kırım, tesisat, elektrik, porselen tezgah ve özel imalat lake dolaplar. Resmi sözleşmeli sabit fiyat garantisi.",
  canonical: "https://izmirmutfakbanyo.com.tr/mutfak-tadilati/",
  serviceName: "Mutfak Tadilatı",
  breadcrumbs: [
    { name: "Mutfak Tadilatı", url: "/mutfak-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de komple mutfak tadilatı kaç gün sürer?",
      answer: "Komple mutfak tadilatı; kırım, moloz atımı, su/elektrik tesisat yenileme, seramik kaplama, özel imalat dolap ve tezgah montajı dahil olmak üzere ortalama 12 ila 16 iş günü içerisinde tamamlanarak teslim edilir."
    },
    {
      question: "Tadilat öncesinde mutfağımı 3D olarak görebilir miyim?",
      answer: "Evet. Bünyemizdeki kadrolu mimar ve iç mimarlarımız, evinizin lazerli rölövesini alarak fotogerçekçi 3D canlandırma ve sanal mekan deneyimi sunar. Üretime başlamadan önce tüm renkleri, dolap yerleşimini ve ışık açılarını görerek en doğru kararı sıfır riskle verirsiniz."
    },
    {
      question: "Fiyat tadilat sürecinde artar mı, sabit fiyat garantisi var mı?",
      answer: "Kesinlikle artmaz. 1984 yılından gelen kurumsal disiplinimizle kullanılacak tüm malzemeler, markalar ve toplam bütçe resmi sözleşmeyle sabitlenir; süreç boyunca tek kuruş sürpriz maliyet çıkarılmaz."
    },
    {
      question: "Buca dışındaki ilçelere de mutfak tadilatı hizmeti veriyor musunuz?",
      answer: "Evet. Buca merkez showroom ve imalat atölyemizden Karabağlar, Konak, Bornova, Karşıyaka, Bayraklı, Çiğli, Urla, Çeşme ve İzmir'in tüm 30 ilçesine yerinde ücretsiz mimari keşif ve anahtar teslim uygulama hizmeti sağlıyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Mutfak Tadilatı">
  
  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (MİMARİ KOLEKSİYON & PREMİUM ATMOSFER)                 -->
  <!-- ===================================================================== -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1800&q=80');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Mutfak Tadilatı</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1984'TEN BUGÜNE 42 YILLIK TECRÜBE • 2.463+ TESLİM EDİLMİŞ PROJE
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İzmir Komple Mutfak Tadilatı, <br /><span class="font-normal italic">Mimari Tasarım &amp; Kusursuz İmalat</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        1984'ten bu yana İzmir Buca mağazamız ve kendi imalat atölyemizde kadrolu mimar ve iç mimarlarımızla mutfakları A'dan Z'ye yeniliyoruz. Evinize özel 3D fotogerçekçi canlandırma ve sanal mekan deneyimi ile üretime girmeden önce en doğru kararı vermenizi sağlıyor, resmi sözleşmeli sabit fiyat garantisiyle teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20mutfak%20tadilatı%20için%20ücretsiz%203D%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile 3D Keşif İste</span>
        </a>
        <a href="tel:05393333303" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0539 333 33 03
        </a>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. KURUMSAL GÜVEN VE DEĞER ÖNERİSİ ŞERİDİ (4 SÜTUN)                  -->
  <!-- ===================================================================== -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1984</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">42 Yıllık Ustalık</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş mutfak projesi ve resmi sözleşmeli güvence.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📐</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar &amp; İç Mimar Kadrosu</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Taşeronsuz, doğrudan kadrolu iç mimarlarımızla milimetrik rölöve ve ergonomik plan.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Mekan Deneyimi</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Üretime girmeden önce fotogerçekçi simülasyonla mutfağınızı yaşayın, sıfır riskle karar verin.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; Tüm İzmir</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca Showroomumuzdan Karabağlar, Konak, Bornova ve 30 ilçeye yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. GERÇEK İMALAT VE UYGULAMA FOTOĞRAFLARI GALERİSİ                   -->
  <!-- ===================================================================== -->
  <section class="py-20 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">GERÇEK İMALAT VE UYGULAMA GALERİSİ</span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          İzmir Evlerinde Teslim Ettiğimiz <br /><span class="font-normal italic">Özel Mutfak Dönüşümleri</span>
        </h2>
        <div class="w-12 h-0.5 bg-stone-900"></div>
        <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
          Kendi atölyemizde ürettiğimiz lake, akrilik ve masif mutfakların kırım, tesisat, tezgah ve dolap montaj aşamalarından gerçek fotoğraflar.
        </p>
      </div>

      <!-- 6 Yüksek Kaliteli Mimari Fotoğraf Izgarası -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Foto 1 -->
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1000&q=80" alt="Mavişehir Akrilik Ada Mutfak Tadilatı" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Ada Mutfak &amp; Akrilik</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Mavişehir Komple Ada Mutfak Yenileme</h3>
            <p class="text-xs text-stone-500 font-light">1. sınıf çizilmez akrilik kapak, Çimstone tezgah ve Blum elektrikli çekmece mekanizmaları.</p>
          </div>
        </div>

        <!-- Foto 2 -->
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1556912172-45b7abe8b7e1?auto=format&fit=crop&w=1000&q=80" alt="Bornova Gola Kulpsuz Minimalist Mutfak" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Gola Kulpsuz Lake</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Bornova Minimalist Gola Mutfak Tadilatı</h3>
            <p class="text-xs text-stone-500 font-light">Gizli alüminyum profil gola kulp, süpermat antrasit yüzey ve monoblok porselen tezgah.</p>
          </div>
        </div>

        <!-- Foto 3 -->
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1556912998-c57cc6b63cd7?auto=format&fit=crop&w=1000&q=80" alt="Urla Masif Meşe Country Mutfak" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Country &amp; Masif Meşe</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Urla Taş Ev Masif Ahşap Mutfak Dönüşümü</h3>
            <p class="text-xs text-stone-500 font-light">Doğal fırınlanmış meşe ada tezgahı, antik pirinç kulplar ve seramik çiftlik evyesi montajı.</p>
          </div>
        </div>

        <!-- Foto 4 -->
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80" alt="Bostanlı Füme Cam Aydınlatmalı Mutfak" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Cam Vitrin &amp; LED</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Bostanlı Vitrinli LED Aydınlatmalı Mutfak</h3>
            <p class="text-xs text-stone-500 font-light">Alüminyum antrasit çerçeveli füme cam kapaklar, entegre sıcak LED aydınlatma ve kuvars tezgah.</p>
          </div>
        </div>

        <!-- Foto 5 -->
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1000&q=80" alt="Alsancak Akıllı Depolama Şehir Mutfağı" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Akıllı Kiler &amp; Depolama</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Alsancak Fonksiyonel Şehir Mutfağı</h3>
            <p class="text-xs text-stone-500 font-light">Fasulye köşe sepeti mekanizması, asansörlü üst dolap ve gizli kiler çözümü.</p>
          </div>
        </div>

        <!-- Foto 6 -->
        <div class="group bg-stone-50 border border-stone-200 overflow-hidden shadow-2xs hover:shadow-lg transition duration-300">
          <div class="h-64 overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1556909172-8c07e4499172?auto=format&fit=crop&w=1000&q=80" alt="Bayraklı Loft Ada Mutfak Tadilatı" class="w-full h-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <span class="absolute top-3 left-3 bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-stone-900">Endüstriyel Loft Ada</span>
          </div>
          <div class="p-5 space-y-1.5">
            <h3 class="font-bold text-stone-900 text-sm">Bayraklı Antrasit Loft Ada Mutfak</h3>
            <p class="text-xs text-stone-500 font-light">Mat antrasit metal görünümlü kapaklar, paslanmaz çelik eviye ve ada çevresi bar oturumu.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. 3D SANAL MEKAN DENEYİMİ (MÜŞTERİ KARAR KOLAYLIĞI VURGUSU)         -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">SIFIR RİSKLİ MİMARİ KARAR</span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-950 tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
            Kararsızlığa Son Veren <br /><span class="font-normal italic">3D Fotogerçekçi Sanal Mekan Deneyimi</span>
          </h2>
          <div class="w-12 h-0.5 bg-stone-900"></div>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Mutfak tadilatında en çok yaşanan korku; "Acaba bittiğinde nasıl duracak, renkler birbirine uyacak mı?" endişesidir. Bünyemizdeki kadrolu mimar ve iç mimarlarımızla bu riski sıfıra indiriyoruz.
          </p>
          <div class="space-y-3 text-xs font-semibold text-stone-800">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Lazerle alınan milimetrik ölçü üzerinden evinizin 3D ikizi modellenir.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Lake, akrilik, tezgah ve aydınlatma renkleri birebir ışık simülasyonuyla denenir.</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Buca mağazamızda numuneleri elinize alarak sanal çizimle eşleştirip güvenle karar verirsiniz.</span>
            </div>
          </div>
          <div class="pt-2">
            <a href="https://wa.me/905393333303?text=Merhaba,%20mutfağım%20için%203D%20canlandırma%20ve%20keşif%20randevusu%20almak%20istiyorum." target="_blank" class="px-8 py-3.5 bg-stone-900 text-white text-xs font-bold uppercase tracking-widest hover:bg-stone-800 transition shadow-sm inline-flex items-center gap-2">
              <span>Mutfağını Sanal Ortamda Tasarla</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="relative overflow-hidden border border-stone-200 shadow-xl bg-white">
            <img src="/media/cinematic/elia_spotlight.jpg" alt="3D Mimari Mutfak Modellemesi" class="w-full h-[400px] sm:h-[450px] object-cover" loading="lazy" />
            <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md p-5 border border-stone-200">
              <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-700 block">Buca Showroom &amp; Tasarım Ofisi</span>
              <span class="text-sm font-bold text-stone-950 block">İç Mimarlarımızla Birebir Sanal Canlandırma</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. 5 ADIMDA MUTFAK TADİLATI SÜRECİ                                   -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#161616] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-extrabold uppercase tracking-[0.25em] text-emerald-400 block">1984'TEN GELEN ŞEFFAF SÜREÇ</span>
        <h2 class="text-3xl sm:text-4xl font-light text-white tracking-tight" style="font-family: 'Playfair Display', Georgia, serif;">
          Kırımdan Teslimata <span class="font-normal italic">5 Planlı Aşama</span>
        </h2>
        <div class="w-12 h-0.5 bg-emerald-500"></div>
        <p class="text-xs sm:text-sm text-stone-400 font-light leading-relaxed">
          Sürpriz maliyetler, uzayan teslimat tarihleri ve kalitesiz malzeme riskini tamamen ortadan kaldırıyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        <div class="bg-stone-900 border border-stone-800 p-6 space-y-3 hover:border-emerald-500/50 transition">
          <span class="text-3xl font-black text-stone-700">01</span>
          <h3 class="text-sm font-bold text-white">Lazerli Keşif &amp; Rölöve</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">Mimarımız evinize gelir. Lazer metreyle milimetrik ölçü alır, mekan ergonomisini inceler.</p>
          <div class="text-[11px] text-emerald-400 font-semibold pt-1">● Ücretsiz Keşif</div>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-6 space-y-3 hover:border-emerald-500/50 transition">
          <span class="text-3xl font-black text-stone-700">02</span>
          <h3 class="text-sm font-bold text-white">3D Canlandırma &amp; Seçim</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizin 3D modeli üzerinde renkleri, tezgahı ve kulpları deneyip sıfır riskle karar verirsiniz.</p>
          <div class="text-[11px] text-emerald-400 font-semibold pt-1">● Karar Kolaylığı</div>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-6 space-y-3 hover:border-emerald-500/50 transition">
          <span class="text-3xl font-black text-stone-700">03</span>
          <h3 class="text-sm font-bold text-white">Resmi Sözleşme &amp; Fiyat</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">Tüm marka detayları, teslim tarihi ve bütçe resmi sözleşmeye yazılır. Ekstra ücret çıkmaz.</p>
          <div class="text-[11px] text-emerald-400 font-semibold pt-1">● Sabit Bütçe</div>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-6 space-y-3 hover:border-emerald-500/50 transition">
          <span class="text-3xl font-black text-stone-700">04</span>
          <h3 class="text-sm font-bold text-white">Atölye İmalatı &amp; Tesisat</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">Kendi CNC atölyemizde dolaplar üretilirken, evinizde kırım, su ve elektrik altyapısı yenilenir.</p>
          <div class="text-[11px] text-emerald-400 font-semibold pt-1">● Kendi Fabrikamız</div>
        </div>

        <div class="bg-stone-900 border border-stone-800 p-6 space-y-3 hover:border-emerald-500/50 transition">
          <span class="text-3xl font-black text-stone-700">05</span>
          <h3 class="text-sm font-bold text-white">Temiz Montaj &amp; Teslim</h3>
          <p class="text-xs text-stone-400 font-light leading-relaxed">Usta heyetimiz tozsuz montajı tamamlar, tezgahı bağlar ve mekanınızı 10 yıl garantiyle teslim eder.</p>
          <div class="text-[11px] text-emerald-400 font-semibold pt-1">● 10 Yıl Garanti</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 6. MALZEME & TEKNİK STANDARTLAR TABLOSU                              -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      <div class="max-w-3xl space-y-3">
