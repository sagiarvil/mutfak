---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Anahtar Teslim Tadilat İzmir | Resmi Sözleşme & Gün Garantili",
  description: "İzmir sözleşmeli, resmi sözleşmeli ve gecikme cezalı anahtar teslim konut ve villa tadilatı. Kadrolu mimar ve iç mimarlarımızla 3D sanal simülasyon ve tek elden garantili teslimat.",
  canonical: "https://izmirmutfakbanyo.com.tr/izmir-anahtar-teslim-tadilat/",
  serviceName: "Anahtar Teslim Tadilat",
  breadcrumbs: [
    { name: "Anahtar Teslim Tadilat", url: "/izmir-anahtar-teslim-tadilat/" }
  ],
  faqList: [
    {
      question: "İzmir'de sözleşmeli, sözleşmede sürpriz çıkarmayan anahtar teslim tadilat şirketi hangisidir?",
      answer: "1998'den bu yana İzmir Buca merkez mağaza ve atölyemizde resmi sözleşmeyle hizmet veriyoruz. Malzeme markaları, metretül detayları ve gecikme cezası sözleşmede sabitlenir; tek kuruş sürpriz maliyet çıkarılmaz."
    },
    {
      question: "Sözleşmede gecikme cezası taahhüdü nasıl işler?",
      answer: "Belirlenen teslim tarihinden sonraki her gecikme günü için sözleşmede açıkça yazılı cezai şart bedeli işverene ödenir."
    },
    {
      question: "Hangi ilçelere keşif hizmeti veriyorsunuz?",
      answer: "Buca merkezimizden Karşıyaka, Bornova, Konak, Bayraklı, Çiğli, Urla, Çeşme, Güzelbahçe dahil tüm 30 İzmir ilçesine ücretsiz keşif sağlıyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Anahtar Teslim">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & PRESTİJLİ SPLIT VİTRİN - DARK HERO YOK) -->
  <section class="relative bg-[#FBF9F5] border-b border-[#EAE5DC] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F5EFE6]/60 to-transparent pointer-events-none"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AYDINLIK & GÜVEN VEREN MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#083322] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#8C6D3F] font-bold">Anahtar Teslim Tadilat</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#C5A880]/50 text-[#083322] text-[11px] font-bold tracking-[0.16em] uppercase rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span>28 YILLIK TECRÜBE • SÖZLEŞMELİ SABİT FİYAT</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#083322] leading-[1.14] tracking-tight">
            Sözleşmeli, Sabit Bütçeli ve <br />
            <span class="text-[#8C6D3F] font-serif font-normal italic">Gecikme Cezası Garantili:</span> <br />
            <span class="text-[#2B231D]">İzmir Anahtar Teslim Tadilat.</span>
          </h1>

          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            1998'den bu yana İzmir Buca Adatepe imalat atölyemizle konutları anahtar teslim yeniliyoruz. Mimarlarımızın hazırladığı 3D sanal simülasyonla sürpriz riskini sıfırlıyor; şeffaf sözleşme ve tek muhatap güvencesiyle teslim ediyoruz.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Resmi Sabit Fiyat Sözleşmesi</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Gecikme Cezası Maddesi</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#EAE5DC] shadow-xs">
              <span class="text-[#083322] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Tek Muhatap &amp; Temiz Teslim</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905324261788?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#E5C378] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Keşif İste</span>
              <span>→</span>
            </a>
            <a 
              href="tel:02324411060" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#083322] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              0232 441 1060
            </a>
          </div>
        </div>

        <!-- SAĞ: TADİLAT PROJESİ AYDINLIK GÖRSEL (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-05.webp" 
              alt="İzmir Anahtar Teslim Ev ve Villa Tadilatı İmalatı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#C5A880] block">ANAHTAR TESLİM DÖNÜŞÜM</span>
              <p class="text-sm font-serif font-bold text-white mt-0.5">Çeşme Villa Komple Renovasyon & Mutfak Montajı</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#006039] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880]">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Anahtar Teslim Tadilat Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Sözleşme &amp; Taahhüt</strong>
          <p class="text-stone-600">Noter Onaylı Resmi Sözleşme ve Taahhüt (Tek Kuruş Sürpriz Ek Maliyet Çıkmaz).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Gecikme Cezası</strong>
          <p class="text-stone-600">Gününde Teslim Garantisi; Her Gecikme Günü İçin Sözleşmeli Cezai Şart Taahhüdü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Malzeme Kalitesi</strong>
          <p class="text-stone-600">1. Sınıf E1 MDF-Lam, Blum Frenli Ray, Vitra/Bien Seramik, Jotun Boya, Fırat Boru.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Daire Tadilatı 20-30 İş Günü | Villa Renovasyonu 35-45 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş anahtar teslim tadilat projesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar Yönetiminde Şantiye</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta arama stresine son; tüm süreç kadrolu mimarımız yönetiminde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizi üretime girmeden fotogerçekçi canlandırmayla görüp karar verin.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca İmalat &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca merkez mağazamızdan tüm İzmir'e ücretsiz yerinde keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Anahtar Teslim Tadilat Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#041F14]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- ÇAĞRI BÖLÜMÜ (LUMINOUS ARCHITECTURAL VIP CALLOUT)                    -->
  <!-- ===================================================================== -->
  <section class="py-20 relative overflow-hidden bg-gradient-to-b from-[#FAF8F5] via-[#F4F0E8] to-[#FAF8F5] text-center border-t border-[#E8E2D8] text-zinc-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white rounded-full border border-[#C5A880]/60 text-[#8C6D3F] text-xs uppercase font-bold tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#107C41] animate-ping"></span>
        MİMARİ KEŞİF & ÖZEL RANDEVU
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#083322] font-serif tracking-tight leading-tight">
        Evinizi Güvenle Yenilemek İçin Ücretsiz Keşif Alın
      </h2>
      <p class="text-xs sm:text-sm text-zinc-600 font-light max-w-xl mx-auto leading-relaxed">
        İletişime geçin veya WhatsApp üzerinden iletişime geçin; kadrolu mimarımız adresinizde keşif randevunuzu oluştursun.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a 
          href="https://wa.me/905324261788?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-4 bg-[#083322] hover:bg-[#0C4A31] text-[#C5A880] text-xs font-bold uppercase tracking-wider rounded-xl border border-[#C5A880]/40 shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile VIP Keşif Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:02324411060" 
          class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-[#FAF7F2] border border-[#E5DFD5] text-[#083322] font-bold text-xs uppercase tracking-wider rounded-xl shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>📞 0232 441 1060</span>
        </a>
      </div>
    </div>
  </section>

</Layout>