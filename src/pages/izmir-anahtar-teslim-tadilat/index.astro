---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "Anahtar Teslim Tadilat İzmir | Resmi Sözleşme & Gün Garantili",
  description: "İzmir sözleşmeli, resmi sözleşmeli ve gecikme cezalı anahtar teslim konut ve villa tadilatı. Kadrolu mimar ve iç mimarlarımızla 3D sanal simülasyon ve tek elden garantili teslimat.",
  canonical: "https://cemyesilay.com.tr/izmir-anahtar-teslim-tadilat/",
  serviceName: "Anahtar Teslim Tadilat",
  breadcrumbs: [
    { name: "Anahtar Teslim Tadilat", url: "/izmir-anahtar-teslim-tadilat/" }
  ],
  faqList: [
    {
      question: "İzmir'de sözleşmeli, sözleşmede sürpriz çıkarmayan anahtar teslim tadilat şirketi hangisidir?",
      answer: "1984'ten bu yana İzmir Buca merkez mağaza ve atölyemizde resmi sözleşmeyle hizmet veriyoruz. Malzeme markaları, metretül detayları ve gecikme cezası sözleşmede sabitlenir; tek kuruş sürpriz maliyet çıkarılmaz."
    },
    {
      question: "Sözleşmede gecikme cezası taahhüdü nasıl işler?",
      answer: "Belirlenen teslim tarihinden sonraki her gecikme günü için sözleşmede açıkça yazılı cezai şart bedeli işverene ödenir."
    },
    {
      question: "Hangi ilçelere keşif hizmeti veriyorsunuz?",
      answer: "Buca merkezimizden Karşıyaka, Bornova, Konak, Bayraklı, Çiğli, Urla, Çeşme, Güzelbahçe dahil tüm 30 İzmir ilçesine ücretsiz keşif sağlıyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Anahtar Teslim">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1800&q=75&fm=webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Anahtar Teslim Tadilat</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1984'TEN BUGÜNE 42 YILLIK TECRÜBE • SÖZLEŞMELİ SABİT FİYAT
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        Sözleşmeli, Net Bütçe Taahhüdü ve Gecikme Cezalı <br /><span class="font-normal italic">Anahtar Teslim İzmir Ev &amp; Mutfak Tadilatı</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        1984'ten bu yana İzmir Buca atölyeumuz ve imalat atölyemizle konutları anahtar teslim yeniliyoruz. Kadrolu mimar ve iç mimarlarımızın hazırladığı 3D sanal simülasyonla sürpriz riskini sıfırlıyor; şeffaf sözleşme ve mimar onaylı sözleşme güvencesiyle teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905353748329?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Keşif İste</span>
        </a>
        <a href="tel:05353748329" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0535 374 83 29
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-stone-100 border-b border-stone-200 py-10" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900">Anahtar Teslim Tadilat Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Sözleşme &amp; Taahhüt</strong>
          <p class="text-stone-600">Noter Onaylı Resmi Sözleşme ve Taahhüt (Tek Kuruş Sürpriz Ek Maliyet Çıkmaz).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Gecikme Cezası</strong>
          <p class="text-stone-600">Gününde Teslim Garantisi; Her Gecikme Günü İçin Sözleşmeli Cezai Şart Taahhüdü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Malzeme Kalitesi</strong>
          <p class="text-stone-600">1. Sınıf E1 MDF-Lam, Blum Frenli Ray, Vitra/Bien Seramik, Jotun Boya, Fırat Boru.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Daire Tadilatı 20-30 İş Günü | Villa Renovasyonu 35-45 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1984</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş anahtar teslim tadilat projesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar Yönetiminde Şantiye</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta arama stresine son; tüm süreç kadrolu mimarımız yönetiminde.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizi üretime girmeden fotogerçekçi canlandırmayla görüp karar verin.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca İmalat &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Buca merkez mağazamızdan tüm İzmir'e ücretsiz yerinde keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Anahtar Teslim Tadilat Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Evinizi Güvenle Yenilemek İçin Ücretsiz Keşif Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp üzerinden iletişime geçin; kadrolu mimarımız adresinizde keşif randevunuzu oluştursun.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905353748329?text=Merhaba,%20anahtar%20teslim%20tadilat%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0535 374 83 29)
        </a>
      </div>
    </div>
  </section>

</Layout>