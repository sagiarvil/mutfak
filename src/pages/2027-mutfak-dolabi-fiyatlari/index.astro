---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Mutfak Dolabı Mimari Projelendirme | Siz Hayal Edin Biz Çizelim",
  description: "2027 güncel İzmir mutfak dolabı modelleri ve mimari tasarımları, malzeme bazlı (Lake, Akrilik, MDF-Lam, Masif) metretül cetveli, kırım-montaj işçilik rayiçleri ve Buca imalat atölyesinden şeffaf maliyet hesaplama tablosu.",
  canonical: "https://izmirmutfakbanyo.com.tr/2027-mutfak-dolabi-fiyatlari/",
  serviceName: "Mutfak Dolabı 3D Mimari Tasarım & Keşif Rehberi",
  breadcrumbs: [
    { name: "2026 Mimari Projelendirme", url: "/2027-mutfak-dolabi-fiyatlari/" }
  ],
  faqList: [
    {
      question: "2027 yılında İzmir'de ortalama bir mutfak dolabı nasıl projelendirilir ve malzeme seçimi nasıl yapılır?",
      answer: "2027 yılında İzmir'de mutfak dolabı imalatı mekanınızın ölçülerine göre özel olarak metretül ve mekan rölövesine göre özel olarak projelendirilir. Standart MDF-Lam ekonomik segmentten başlarken, İtalyan akrilik kapak orta-üst segmentte, çift yüz ipek mat lake boya ise premium grupta yer alır. Buca atölyemizden aracısız fabrika tasarımı sunuyoruz."
    },
    {
      question: "Mimari keşif ve 3D çizim hizmeti ücrete tabi midir?",
      answer: "Tekliflerimizde nakliye, montaj ve kulp aksamları dahildir. Tezgah tercihi (Porselen, Belenco, Çimstone veya Masif Ahşap) müşteri seçimine göre net maliyetiyle ayrı kalem olarak belirtilir."
    },
    {
      question: "Siz hayal edin, biz ortaya çıkaralım mottosu nasıl uygulanıyor?",
      answer: "Hayır. Kadrolu mimarımızın evinize gelerek lazerli rölöve alması ve 3D sanal canlandırma simülasyonunu hazırlaması tamamen ücretsizdir."
    }
  ]
};
---

<Layout seo={seo} activeService="Mimari Rehber">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & CANLI PROJELENDİRME SPLIT VİTRİN - DARK HERO YOK) -->
  <section class="relative bg-[#F4F6F8] border-b border-[#E2E8F0] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F4F6F8]/60 to-transparent pointer-events-none"></div>
    
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AYDINLIK & GÜVEN VEREN MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#23323A] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#CB000F] font-bold">2026 Mimari Projelendirme Rehberi</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#CB000F]/50 text-[#23323A] text-[11px] font-bold tracking-[0.16em] uppercase rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span>28 YILLIK TECRÜBE • 3D BİREBİR PROJELENDİRME</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#23323A] leading-[1.14] tracking-tight">
            Siz Hayal Edin, Mimarımız Çizsin: <br />
            <span class="text-[#CB000F] font-['Montserrat',sans-serif] font-normal ">Evinize Özel 3D Mutfak Tasarımı &amp;</span> <br />
            <span class="text-[#23323A]">Birebir Projelendirme Rehberi.</span>
          </h1>

          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Ekonomik kaliteli MDF-Lam'dan ultra lüks lake ve masif modellere kadar her bütçeye uygun şeffaf üretim. İzmir Buca imalat atölyemizden aracısız, mimarımızın hazırladığı ücretsiz 3D sanal simülasyon güvencesiyle.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs">
              <span class="text-[#23323A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">1:1 Ücretsiz 3D Mimari Çizim</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs">
              <span class="text-[#23323A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Resmi Sözleşmeli Sabit Bütçe</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs">
              <span class="text-[#23323A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">10 Yıl Gövde &amp; Ray Garantisi</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905393333303?text=Merhaba,%20mutfak%20dolabı%20mimari%20çizim%20hesaplaması%20için%20teklif%20almak%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#CB000F] hover:bg-[#b0000d] text-white text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#CB000F] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>Mimarımızla 3D Çizim Başlat</span>
              <span>→</span>
            </a>
            <a 
              href="tel:05393333303" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#23323A] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              0539 333 33 03
            </a>
          </div>
        </div>

        <!-- SAĞ: AYDINLIK PROJE GÖRSELİ (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/proje-05.webp" 
              alt="İzmir 2027 Mutfak Dolabı Modelleri ve 3D Projelendirme" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#CB000F] block">3D MİMARİ PROJELENDİRME</span>
              <p class="text-sm font-['Montserrat',sans-serif] font-bold text-white mt-0.5">Lüks Lake Mutfak Dolabı & Ada Tezgah Tasarımı</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING: İLK 14KB İÇİ DETAYLI ŞEFFAF TABLO -->
  <section class="bg-[#F8F9FA] border-b border-[#E2E8F0] py-16" id="teknik-standartlar">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#23323A] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#CB000F]">MİMARİ DANIŞMANLIK &amp; PLANLAMA</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#23323A]">Mutfak Projenizi Belirleyen Malzeme &amp; Mimari Standartlar</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">MDF-Lam Standart</strong>
          <p class="text-stone-600">E1 Normunda 18 mm Beyaz MDF Gövde, Samet Frenli Ray/Menteşe • Ekonomik Bütçe.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">İtalyan Akrilik</strong>
          <p class="text-stone-600">Çizilmez Akrilik Yüzey, Blum Frenli Ray Sistemleri • Dayanıklılık & Tasarım Lideri.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">İpek Mat Lake</strong>
          <p class="text-stone-600">Poliüretan Çift Kat Astar &amp; Boya, Blum Aventos Kalkar Kapak • Lüks Mimari Segment.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">İmalat 15-21 İş Günü | Yerinde Montaj 1-2 İş Günü.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Doğrudan İmalat</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">Aracı komisyonu yok, Buca atölyemizden doğrudan fabrika maliyeti.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📐</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Ücretsiz 3D Çizim</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">İç mimarlarımız evinize özel çizimi hazırlar, bütçeyi netleştirir.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🔒</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Mimar Onaylı Sözleşme Güvencesi</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">Sözleşmede belirlenen tutar değişmez, tek kuruş sürpriz çıkmaz.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tüm İzmir'e Keşif</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">Buca merkezli olarak 30 ilçenin tamamına ücretsiz yerinde ölçü.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-normal text-stone-950 font-editorial">Mimari Tasarım ve Projelendirme Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#23323A]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-normal leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- ÇAĞRI BÖLÜMÜ (LUMINOUS ARCHITECTURAL VIP CALLOUT)                    -->
  <!-- ===================================================================== -->
  <section class="py-20 relative overflow-hidden bg-gradient-to-b from-[#F4F6F8] via-[#F4F6F8] to-[#F4F6F8] text-center border-t border-[#E2E8F0] text-zinc-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white rounded-full border border-[#CB000F]/60 text-[#CB000F] text-xs uppercase font-bold tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#107C41] animate-ping"></span>
        MİMARİ KEŞİF & ÖZEL RANDEVU
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#172127] font-['Montserrat',sans-serif] tracking-tight leading-tight">
        Siz Hayal Edin, Birlikte Ortaya Çıkaralım: 3D Çizim Randevusu Alın
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 font-normal max-w-xl mx-auto leading-relaxed">
        Ölçülerinizi WhatsApp'tan gönderin veya ücretsiz keşif isteyin; 3D çizim ve kalem kalem dökümlü 3D sanal çizim ve mimari projenizi hazırlayalım.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a 
          href="https://wa.me/905393333303?text=Merhaba,%20mutfak%20dolabı%20mimari çizim%20hesaplaması%20için%20teklif%20almak%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-4 bg-[#23323A] hover:bg-[#172127] text-white text-xs font-bold uppercase tracking-wider rounded-xl border border-[#CB000F]/40 shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile VIP Keşif Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:05393333303" 
          class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-[#F4F6F8] border border-[#E2E8F0] text-[#23323A] font-bold text-xs uppercase tracking-wider rounded-xl shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>📞 0539 333 33 03</span>
        </a>
      </div>
    </div>
  </section>

</Layout>