---
import Layout from "../../layouts/Layout.astro";
import tasarimlar from "../../data/tasarimlarData.json";

const seo = {
  title: "Tasarımlar & Yapılan İşler | 137 Özel İmalat Model Kataloğu | İzmir Mutfak",
  description: "Cem Yeşilay Mimarlık atölyemizde üretilen 137 tescilli mutfak dolabı, lake iç oda kapısı, banyo dolabı ve gömme dolap modeli. Model numarası veya tarz arayarak 3D keşif isteyin.",
  canonical: "https://yesilaymutfak.com/tasarimlar/",
  serviceName: "Tasarımlar ve Yapılan İşler Model Kataloğu",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Tasarımlar & Yapılan İşler", url: "/tasarimlar/" }
  ]
};

const totalCount = tasarimlar.length;
const kitchenCount = tasarimlar.filter(t => t.category === "Mutfak Tasarımları").length;
const doorCount = tasarimlar.filter(t => t.category === "Kapılar").length;
const wardrobeCount = tasarimlar.filter(t => t.category === "Gömme Dolap").length;
const bathCount = tasarimlar.filter(t => t.category === "Banyo Dolapları").length;

// Google, Google Görseller & LLM Botları İçin Schema.org ImageGallery & ItemList
const schemaImageGallery = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Cem Yeşilay Mimarlık Özel Tasarım ve İmalat Model Kataloğu",
  "description": "Buca imalat atölyemizde üretilen 137 tescilli mutfak dolabı, lake iç oda kapısı, banyo dolabı ve gömme dolap modeli.",
  "url": "https://yesilaymutfak.com/tasarimlar/",
  "publisher": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Cem Yeşilay Mimarlık",
    "url": "https://yesilaymutfak.com",
    "telephone": "+905353748329",
    "areaServed": "İzmir",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Buca",
      "addressRegion": "İzmir",
      "addressCountry": "TR"
    }
  },
  "itemListElement": tasarimlar.map((item, idx) => ({
    "@type": "ImageObject",
    "position": idx + 1,
    "name": item.seoTitle,
    "caption": item.altText,
    "description": item.aiDescription,
    "keywords": item.keywords.join(", "),
    "contentUrl": `https://yesilaymutfak.com${item.img}`,
    "thumbnailUrl": `https://yesilaymutfak.com${item.img}`,
    "representativeOfPage": false,
    "creator": {
      "@type": "Organization",
      "name": "Cem Yeşilay Mimarlık"
    }
  }))
};
---

<Layout seo={seo}>
  <!-- Google & LLM Botları İçin Zengin Yapısal Veri (UI Tasarımını Etkilemez) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaImageGallery)} />

  <!-- Sayfa Üst Başlığı (Cem Yeşilay Standartı - Sade, Lüks, Sıcak Kırık Beyaz) -->
  <section class="bg-[#F8F7F3] border-b border-stone-200/80 pt-32 pb-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#1E1810] tracking-tight">
        Tasarımlar
      </h1>
      <p class="text-xs sm:text-sm text-stone-500 max-w-xl mx-auto font-normal">
        Özel üretim mutfak, kapı, banyo ve gömme dolap portfolyomuz. Model numarası veya aradığınız tarzı yazarak anında bulabilirsiniz.
      </p>

      <!-- Model Numarası & Arama Çubuğu (Genişletilmiş Ticari Arama) -->
      <div class="pt-2 max-w-md mx-auto">
        <div class="relative flex items-center bg-white border border-stone-300 shadow-xs focus-within:border-[#B87353] transition">
          <div class="pl-3.5 text-stone-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Model No veya tarz ile ara (Örn: Model 46, Ada Mutfak, Lake...)" 
            class="w-full py-2.5 px-2.5 bg-transparent text-stone-900 placeholder-stone-400 text-xs sm:text-sm font-medium focus:outline-none"
            autocomplete="off"
          />
          <button 
            type="button" 
            id="clearSearch" 
            class="hidden pr-3 text-stone-400 hover:text-stone-700 text-[11px] font-bold tracking-wider uppercase"
          >
            Temizle
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Kategori Filtreleri (Cem Yeşilay Birebir Filtre Dizilimi) -->
  <section class="bg-white border-b border-stone-200 sticky top-16 z-30 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center justify-center gap-1 sm:gap-4 flex-wrap text-xs sm:text-sm font-medium">
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-[#B87353] text-[#1E1810] font-bold" 
          data-filter="all"
        >
          Tümü ({totalCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="mutfak-tasarimlari"
        >
          Mutfak Tasarımları ({kitchenCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="kapilar"
        >
          Kapılar ({doorCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="gomme-dolap"
        >
          Gömme Dolap ({wardrobeCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="banyo-dolaplari"
        >
          Banyo Dolapları ({bathCount})
        </button>
      </div>
    </div>
  </section>

  <!-- Cem Yeşilay Birebir KARE KUTULAR Portfolyo Galerisi (1:1 Aspect Ratio & 15px Boşluk) -->
  <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto min-h-[70vh]">
    <div id="modelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[15px]">
      {tasarimlar.map((item, idx) => (
        <figure 
          class="model-card group relative aspect-square w-full bg-stone-100 overflow-hidden cursor-pointer shadow-xs"
          data-category={item.categorySlug}
          data-model={item.modelNo.toLowerCase()}
          data-title={item.title.toLowerCase()}
          data-keywords={item.keywords.join(" ").toLowerCase()}
          data-desc={item.aiDescription.toLowerCase()}
          data-category-name={item.category}
          data-img={item.img}
          data-model-id={item.modelNo}
          data-title-raw={item.title}
          itemscope 
          itemtype="https://schema.org/ImageObject"
        >
          <!-- 1:1 Tam Kare Görsel (İlk 6 Model Eager LCP, Sonraki 131 Model Gerçek IntersectionObserver + Data-Src) -->
          {idx < 6 ? (
            <img 
              src={item.img} 
              alt={item.altText} 
              title={item.seoTitle}
              loading="eager" 
              decoding="async"
              fetchpriority="high"
              width="600"
              height="600"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              itemprop="contentUrl"
            />
          ) : (
            <>
              <img 
                src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 600'%3E%3Crect width='100%25' height='100%25' fill='%23f5f5f4'/%3E%3C/svg%3E"
                data-src={item.img} 
                alt={item.altText} 
                title={item.seoTitle}
                loading="lazy" 
                decoding="async"
                fetchpriority="low"
                width="600"
                height="600"
                class="lazy-progressive-img w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-106 opacity-0"
                itemprop="contentUrl"
              />
              <noscript>
                <img src={item.img} alt={item.altText} width="600" height="600" class="w-full h-full object-cover" />
              </noscript>
            </>
          )}

          <!-- Google & AI Botları İçin Semantik W3C sr-only Katmanı (Görsel Tasarımı Asla Bozmaz) -->
          <div class="sr-only">
            <h2 itemprop="name">{item.seoTitle}</h2>
            <p itemprop="description">{item.aiDescription}</p>
            <span itemprop="keywords">{item.keywords.join(", ")}</span>
          </div>

          <!-- Sol Üst Köşe Model No Rozeti (Kullanıcı Her Zaman Görsün) -->
          <div class="absolute top-3 left-3 z-10 pointer-events-none">
            <span class="px-2 py-1 bg-stone-950/85 text-[#B87353] font-mono text-xs font-bold tracking-wider uppercase border border-[#B87353]/40 backdrop-blur-xs">
              {item.modelNo}
            </span>
          </div>

          <!-- Cem Yeşilay Birebir Fly Overlay (Hover Durumunda Açılan Amber Katman) -->
          <figcaption class="absolute inset-0 bg-[#10B981]/92 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center text-center p-6 text-white z-20 pointer-events-none backdrop-blur-xs">
            <span class="text-xs font-semibold tracking-widest uppercase text-white/90 mb-1 text-[11px] font-bold">
              {item.category}
            </span>
            <div class="text-lg sm:text-xl font-serif font-bold text-white leading-tight max-w-xs font-bold">
              {item.title}
            </div>
            <div class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-stone-950 text-white text-xs font-bold uppercase tracking-wider shadow-md">
              <span>İncele &bull; 3D Çizdir</span>
              <span>&rarr;</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Arama Sonucu Bulunamadı -->
    <div id="noResults" class="hidden text-center py-20 space-y-3">
      <div class="w-12 h-12 bg-stone-100 text-stone-400 rounded-full flex items-center justify-center mx-auto text-xl font-serif">
        &empty;
      </div>
      <h3 class="text-lg font-serif font-bold text-[#1E1810]">Aradığınız Model Bulunamadı</h3>
      <p class="text-xs sm:text-sm text-stone-500 max-w-sm mx-auto">
        Lütfen model numarası veya arama kelimesini kontrol edin.
      </p>
      <button 
        type="button" 
        id="resetBtn" 
        class="px-4 py-2 bg-stone-900 text-white text-xs font-bold uppercase tracking-wider hover:bg-stone-800 transition"
      >
        Tüm Modelleri Göster
      </button>
    </div>
  </section>

  <!-- Cem Yeşilay Birebir Lightbox Modalı (Tıklanan Modeli Açar) -->
  <div 
    id="lightboxModal" 
    class="fixed inset-0 z-50 bg-stone-950/90 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Tasarım Görseli"
  >
    <div class="relative max-w-3xl w-full bg-white overflow-hidden shadow-2xl flex flex-col">
      <!-- Modal Üst Başlık -->
      <div class="p-3.5 bg-stone-900 text-white flex items-center justify-between">
        <div>
          <span id="modalCategory" class="text-[11px] font-semibold text-[#B87353] uppercase tracking-wider block"></span>
          <h3 id="modalTitle" class="text-base sm:text-lg font-serif font-bold text-white"></h3>
        </div>
        <button 
          type="button" 
          id="closeModal" 
          class="text-stone-400 hover:text-white text-2xl font-light w-8 h-8 flex items-center justify-center"
          aria-label="Kapat"
        >
          &times;
        </button>
      </div>

      <!-- Modal Görsel Alanı -->
      <div class="relative bg-stone-950 flex items-center justify-center max-h-[65vh] overflow-hidden">
        <img id="modalImg" src="" alt="" class="max-h-[65vh] w-auto object-contain mx-auto" />
      </div>

      <!-- Modal Alt Barı (Tescilli Açıklama & WhatsApp İletişimi) -->
      <div class="p-4 bg-[#F8F7F3] border-t border-stone-200 space-y-3">
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <span id="modalModelNo" class="text-xs font-mono font-bold text-stone-900 bg-stone-200 px-2 py-0.5 rounded-xs"></span>
            <span class="text-[10px] text-stone-500 font-semibold uppercase tracking-wider">İzmir Buca Özel İmalat</span>
          </div>
          <p id="modalDesc" class="text-xs text-stone-700 font-normal leading-relaxed"></p>
        </div>
        <div class="pt-2 border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-center sm:text-left">
            <span class="text-[10px] text-emerald-800 font-bold uppercase tracking-wider block">✓ Ücretsiz 3D Keşif &amp; Tasarım</span>
          </div>
          <a 
            id="modalWhatsappBtn" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-[#10B981] hover:bg-[#059669] text-white text-xs font-bold uppercase tracking-wider shadow-xs transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Bu Modeli 3D Çizdir &amp; Bilgi Al</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Arama, Filtre ve Modal Scripti -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("searchInput");
      const clearBtn = document.getElementById("clearSearch");
      const filterBtns = document.querySelectorAll(".filter-btn");
      const cards = document.querySelectorAll(".model-card");
      const noResults = document.getElementById("noResults");
      const resetBtn = document.getElementById("resetBtn");

      const modal = document.getElementById("lightboxModal");
      const closeModal = document.getElementById("closeModal");
      const modalImg = document.getElementById("modalImg");
      const modalTitle = document.getElementById("modalTitle");
      const modalCategory = document.getElementById("modalCategory");
      const modalModelNo = document.getElementById("modalModelNo");
      const modalDesc = document.getElementById("modalDesc");
      const modalWhatsappBtn = document.getElementById("modalWhatsappBtn");

      // =========================================================================
      // DİNAMİK INTERSECTION OBSERVER LAZY LOAD MOTORU (Preload Scanner Koruması)
      // =========================================================================
      const progressiveImages = document.querySelectorAll(".lazy-progressive-img");

      function loadProgressiveImg(img) {
        if (!img) return;
        const realSrc = img.getAttribute("data-src");
        if (!realSrc || img.src === realSrc) return;

        const preloader = new Image();
        preloader.onload = () => {
          img.src = realSrc;
          img.classList.remove("opacity-0");
        };
        preloader.src = realSrc;
      }

      let imageObserver = null;
      if ("IntersectionObserver" in window) {
        imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const targetImg = entry.target;
              loadProgressiveImg(targetImg);
              observer.unobserve(targetImg);
            }
          });
        }, {
          rootMargin: "250px 0px", // Kullanıcı yaklaşınca 250px önden yükleme
          threshold: 0.01
        });

        progressiveImages.forEach((img) => imageObserver.observe(img));
      } else {
        // Fallback: Eski tarayıcılarda doğrudan yükle
        progressiveImages.forEach(loadProgressiveImg);
      }

      // Filtreleme / arama yapıldığında ekrana yeni giren kartları anında tarayan tetikleyici
      function checkVisibleLazyImages() {
        if (!imageObserver) return;
        progressiveImages.forEach((img) => {
          const card = img.closest(".model-card");
          if (card && card.style.display !== "none") {
            const rect = card.getBoundingClientRect();
            if (rect.top < window.innerHeight + 400 && rect.bottom > -200) {
              loadProgressiveImg(img);
              imageObserver.unobserve(img);
            }
          }
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const initialCat = urlParams.get("kategori");
      let currentFilter = "all";
      if (initialCat) {
        if (initialCat === "mutfak") currentFilter = "mutfak-tasarimlari";
        else if (initialCat === "kapilar" || initialCat === "kapi") currentFilter = "kapilar";
        else if (initialCat === "gomme-dolap" || initialCat === "gardrop") currentFilter = "gomme-dolap";
        else if (initialCat === "banyo") currentFilter = "banyo-dolaplari";
      }

      let currentQuery = "";
      if (currentFilter !== "all") {
        filterBtns.forEach(b => {
          if (b.getAttribute("data-filter") === currentFilter) {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#B87353] text-[#1E1810] font-bold";
          } else {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          }
        });
        filterCards();
      }

      function filterCards() {
        let count = 0;
        cards.forEach((card) => {
          const cat = card.getAttribute("data-category");
          const model = card.getAttribute("data-model");
          const title = card.getAttribute("data-title");
          const kw = card.getAttribute("data-keywords") || "";
          const desc = card.getAttribute("data-desc") || "";

          const matchesCat = currentFilter === "all" || cat === currentFilter;
          const matchesQuery = !currentQuery || 
            model.includes(currentQuery) || 
            title.includes(currentQuery) || 
            kw.includes(currentQuery) || 
            desc.includes(currentQuery);

          if (matchesCat && matchesQuery) {
            card.style.display = "";
            count++;
          } else {
            card.style.display = "none";
          }
        });

        if (noResults) {
          if (count === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }

        // Filtreleme sonrası ekranda kalan görselleri kontrol et
        setTimeout(checkVisibleLazyImages, 50);
      }

      // Canlı arama
      searchInput?.addEventListener("input", (e) => {
        currentQuery = e.target.value.toLowerCase().trim();
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove("hidden");
          } else {
            clearBtn.classList.add("hidden");
          }
        }
        filterCards();
      });

      // Temizle
      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        clearBtn.classList.add("hidden");
        filterCards();
        searchInput?.focus();
      });

      // Sıfırla
      resetBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        clearBtn?.classList.add("hidden");
        currentFilter = "all";
        filterBtns.forEach(btn => {
          if (btn.getAttribute("data-filter") === "all") {
            btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#B87353] text-[#1E1810] font-bold";
          } else {
            btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          }
        });
        filterCards();
      });

      // Kategori filtreleri
      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          });
          btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#B87353] text-[#1E1810] font-bold";
          currentFilter = btn.getAttribute("data-filter");
          filterCards();
        });
      });

      // Modal açma
      cards.forEach((card) => {
        card.addEventListener("click", () => {
          const img = card.getAttribute("data-img");
          const title = card.getAttribute("data-title-raw");
          const category = card.getAttribute("data-category-name");
          const modelNo = card.getAttribute("data-model-id");

          const desc = card.getAttribute("data-desc") || "";
          if (modalImg) modalImg.src = img;
          if (modalTitle) modalTitle.textContent = title;
          if (modalCategory) modalCategory.textContent = category;
          if (modalModelNo) modalModelNo.textContent = modelNo;
          if (modalDesc) modalDesc.textContent = desc;

          const whatsappText = encodeURIComponent(`Merhaba, web sitenizdeki ${modelNo} (${title} - ${category}) modelini beğendim. Kendi evim için özel ölçü rölöve ve 3D çizim projelendirmesi hakkında bilgi almak istiyorum.`);
          if (modalWhatsappBtn) modalWhatsappBtn.href = `https://wa.me/905353748329?text=${whatsappText}`;

          if (modal) {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
          }
        });
      });

      // Modal kapatma
      function closeLightbox() {
        if (modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          document.body.style.overflow = "";
        }
      }

      closeModal?.addEventListener("click", closeLightbox);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    });
  </script>

<style>
  .model-card {
    content-visibility: auto;
    contain-intrinsic-size: 380px;
  }
</style>

</Layout>
