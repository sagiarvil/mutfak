---
import Layout from "../../layouts/Layout.astro";
import tasarimlar from "../../data/tasarimlarData.json";

const seo = {
  title: "Tasarımlar & Yapılan İşler | Tunç Mutfak Tarzı Özel İmalat Kataloğu | İzmir Mutfak",
  description: "İzmir Mutfak & Banyo atölyemizde üretilen 137 tescilli mutfak, kapı, banyo ve gömme dolap tasarımı. Model numarasıyla arayın, mimarımızla 3D projelendirin.",
  canonical: "https://izmirmutfakbanyo.com.tr/tasarimlar/",
  serviceName: "Tasarımlar ve Yapılan İşler",
  breadcrumbs: [
    { name: "Ana Sayfa", url: "/" },
    { name: "Tasarımlar & Yapılan İşler", url: "/tasarimlar/" }
  ]
};

const totalCount = tasarimlar.length;
const kitchenCount = tasarimlar.filter(t => t.category === "Mutfak Tasarımları").length;
const doorCount = tasarimlar.filter(t => t.category === "Kapılar").length;
const wardrobeCount = tasarimlar.filter(t => t.category === "Gömme Dolap").length;
const bathCount = tasarimlar.filter(t => t.category === "Banyo Dolapları").length;
---

<Layout seo={seo}>
  <!-- Sayfa Üst Başlığı (Tunç Mutfak Standartı - Sade, Lüks, Sıcak Kırık Beyaz) -->
  <section class="bg-[#F8F7F3] border-b border-stone-200/80 pt-32 pb-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-[#1E1810] tracking-tight">
        Tasarımlar
      </h1>
      <p class="text-xs sm:text-sm text-stone-500 max-w-xl mx-auto font-normal">
        Özel üretim mutfak, kapı, banyo ve gömme dolap portfolyomuz. Model numarası girerek dilediğiniz tasarımı anında bulabilirsiniz.
      </p>

      <!-- Model Numarası Hızlı Arama Kutusu -->
      <div class="pt-2 max-w-md mx-auto">
        <div class="relative flex items-center bg-white border border-stone-300 shadow-xs focus-within:border-[#F9C349] transition">
          <div class="pl-3.5 text-stone-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Model No ile ara (Örn: Model 46, Model 10...)" 
            class="w-full py-2.5 px-2.5 bg-transparent text-stone-900 placeholder-stone-400 text-xs sm:text-sm font-medium focus:outline-none"
            autocomplete="off"
          />
          <button 
            type="button" 
            id="clearSearch" 
            class="hidden pr-3 text-stone-400 hover:text-stone-700 text-[11px] font-bold tracking-wider uppercase"
          >
            Temizle
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Kategori Filtreleri (Tunç Mutfak Birebir Filtre Dizilimi) -->
  <section class="bg-white border-b border-stone-200 sticky top-16 z-30 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex items-center justify-center gap-1 sm:gap-4 flex-wrap text-xs sm:text-sm font-medium">
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-[#F9C349] text-[#1E1810] font-bold" 
          data-filter="all"
        >
          Tümü ({totalCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="mutfak-tasarimlari"
        >
          Mutfak Tasarımları ({kitchenCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="kapilar"
        >
          Kapılar ({doorCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="gomme-dolap"
        >
          Gömme Dolap ({wardrobeCount})
        </button>
        <button 
          type="button" 
          class="filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]" 
          data-filter="banyo-dolaplari"
        >
          Banyo Dolapları ({bathCount})
        </button>
      </div>
    </div>
  </section>

  <!-- Tunç Mutfak Birebir KARE KUTULAR Portfolyo Galerisi (1:1 Aspect Ratio & 15px Boşluk) -->
  <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto min-h-[70vh]">
    <div id="modelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[15px]">
      {tasarimlar.map((item) => (
        <figure 
          class="model-card group relative aspect-square w-full bg-stone-100 overflow-hidden cursor-pointer shadow-xs"
          data-category={item.categorySlug}
          data-model={item.modelNo.toLowerCase()}
          data-title={item.title.toLowerCase()}
          data-category-name={item.category}
          data-img={item.img}
          data-model-id={item.modelNo}
          data-title-raw={item.title}
        >
          <!-- 1:1 Tam Kare Görsel (Object-Cover ile Asla Taşmaz, Her Kutu Milimetrik Eşit) -->
          <img 
            src={item.img} 
            alt={`${item.title} - ${item.category} - ${item.modelNo}`} 
            loading="lazy" 
            decoding="async"
            width="600"
            height="600"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
          />

          <!-- Sol Üst Köşe Model No Rozeti (Kullanıcı Her Zaman Görsün) -->
          <div class="absolute top-3 left-3 z-10 pointer-events-none">
            <span class="px-2 py-1 bg-stone-950/85 text-[#F9C349] font-mono text-xs font-bold tracking-wider uppercase border border-[#F9C349]/40 backdrop-blur-xs">
              {item.modelNo}
            </span>
          </div>

          <!-- Tunç Mutfak Birebir Fly Overlay (Hover Durumunda Açılan Amber Katman) -->
          <figcaption class="absolute inset-0 bg-[#E8B017]/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center text-center p-6 text-stone-950 z-20 pointer-events-none">
            <span class="text-xs font-semibold tracking-widest uppercase text-stone-800 mb-1">
              {item.category}
            </span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-950 leading-tight">
              {item.title}
            </h2>
            <div class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-stone-950 text-white text-xs font-bold uppercase tracking-wider shadow-md">
              <span>İncele &bull; 3D Çizdir</span>
              <span>&rarr;</span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Arama Sonucu Bulunamadı -->
    <div id="noResults" class="hidden text-center py-20 space-y-3">
      <div class="w-12 h-12 bg-stone-100 text-stone-400 rounded-full flex items-center justify-center mx-auto text-xl font-serif">
        &empty;
      </div>
      <h3 class="text-lg font-serif font-bold text-[#1E1810]">Aradığınız Model Bulunamadı</h3>
      <p class="text-xs sm:text-sm text-stone-500 max-w-sm mx-auto">
        Lütfen model numarasını kontrol edin veya filtreleri sıfırlayın.
      </p>
      <button 
        type="button" 
        id="resetBtn" 
        class="px-4 py-2 bg-stone-900 text-white text-xs font-bold uppercase tracking-wider hover:bg-stone-800 transition"
      >
        Tüm Modelleri Göster
      </button>
    </div>
  </section>

  <!-- Tunç Mutfak Birebir Lightbox Modalı (Tıklanan Modeli Açar) -->
  <div 
    id="lightboxModal" 
    class="fixed inset-0 z-50 bg-stone-950/90 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Tasarım Görseli"
  >
    <div class="relative max-w-3xl w-full bg-white overflow-hidden shadow-2xl flex flex-col">
      <!-- Modal Üst Başlık -->
      <div class="p-3.5 bg-stone-900 text-white flex items-center justify-between">
        <div>
          <span id="modalCategory" class="text-[11px] font-semibold text-[#F9C349] uppercase tracking-wider block"></span>
          <h3 id="modalTitle" class="text-base sm:text-lg font-serif font-bold text-white"></h3>
        </div>
        <button 
          type="button" 
          id="closeModal" 
          class="text-stone-400 hover:text-white text-2xl font-light w-8 h-8 flex items-center justify-center"
          aria-label="Kapat"
        >
          &times;
        </button>
      </div>

      <!-- Modal Görsel Alanı -->
      <div class="relative bg-stone-950 flex items-center justify-center max-h-[65vh] overflow-hidden">
        <img id="modalImg" src="" alt="" class="max-h-[65vh] w-auto object-contain mx-auto" />
      </div>

      <!-- Modal Alt Barı (WhatsApp İletişimi) -->
      <div class="p-3.5 bg-[#F8F7F3] border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="text-center sm:text-left">
          <span class="text-[10px] text-stone-500 uppercase tracking-wider block">Seçilen Model Numarası</span>
          <span id="modalModelNo" class="text-sm font-mono font-bold text-stone-900"></span>
        </div>
        <a 
          id="modalWhatsappBtn" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider shadow-xs transition"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Bu Modeli 3D Çizdir &amp; Bilgi Al</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Arama, Filtre ve Modal Scripti -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("searchInput");
      const clearBtn = document.getElementById("clearSearch");
      const filterBtns = document.querySelectorAll(".filter-btn");
      const cards = document.querySelectorAll(".model-card");
      const noResults = document.getElementById("noResults");
      const resetBtn = document.getElementById("resetBtn");

      const modal = document.getElementById("lightboxModal");
      const closeModal = document.getElementById("closeModal");
      const modalImg = document.getElementById("modalImg");
      const modalTitle = document.getElementById("modalTitle");
      const modalCategory = document.getElementById("modalCategory");
      const modalModelNo = document.getElementById("modalModelNo");
      const modalWhatsappBtn = document.getElementById("modalWhatsappBtn");

      const urlParams = new URLSearchParams(window.location.search);
      const initialCat = urlParams.get("kategori");
      let currentFilter = "all";
      if (initialCat) {
        if (initialCat === "mutfak") currentFilter = "mutfak-tasarimlari";
        else if (initialCat === "kapilar" || initialCat === "kapi") currentFilter = "kapilar";
        else if (initialCat === "gomme-dolap" || initialCat === "gardrop") currentFilter = "gomme-dolap";
        else if (initialCat === "banyo") currentFilter = "banyo-dolaplari";
      }
      let currentQuery = "";
      if (currentFilter !== "all") {
        filterBtns.forEach(b => {
          if (b.getAttribute("data-filter") === currentFilter) {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#F9C349] text-[#1E1810] font-bold";
          } else {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          }
        });
        filterCards();
      }

      function filterCards() {
        let count = 0;
        cards.forEach((card) => {
          const cat = card.getAttribute("data-category");
          const model = card.getAttribute("data-model");
          const title = card.getAttribute("data-title");

          const matchesCat = currentFilter === "all" || cat === currentFilter;
          const matchesQuery = !currentQuery || model.includes(currentQuery) || title.includes(currentQuery);

          if (matchesCat && matchesQuery) {
            card.style.display = "";
            count++;
          } else {
            card.style.display = "none";
          }
        });

        if (noResults) {
          if (count === 0) {
            noResults.classList.remove("hidden");
          } else {
            noResults.classList.add("hidden");
          }
        }
      }

      // Canlı arama
      searchInput?.addEventListener("input", (e) => {
        currentQuery = e.target.value.toLowerCase().trim();
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove("hidden");
          } else {
            clearBtn.classList.add("hidden");
          }
        }
        filterCards();
      });

      // Temizle
      clearBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        clearBtn.classList.add("hidden");
        filterCards();
        searchInput?.focus();
      });

      // Sıfırla
      resetBtn?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        currentQuery = "";
        clearBtn?.classList.add("hidden");
        currentFilter = "all";
        filterBtns.forEach(btn => {
          if (btn.getAttribute("data-filter") === "all") {
            btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#F9C349] text-[#1E1810] font-bold";
          } else {
            btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          }
        });
        filterCards();
      });

      // Kategori filtreleri
      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => {
            b.className = "filter-btn px-3 py-1.5 transition border-b-2 border-transparent text-stone-500 hover:text-[#1E1810]";
          });
          btn.className = "filter-btn px-3 py-1.5 transition border-b-2 border-[#F9C349] text-[#1E1810] font-bold";
          currentFilter = btn.getAttribute("data-filter");
          filterCards();
        });
      });

      // Modal açma
      cards.forEach((card) => {
        card.addEventListener("click", () => {
          const img = card.getAttribute("data-img");
          const title = card.getAttribute("data-title-raw");
          const category = card.getAttribute("data-category-name");
          const modelNo = card.getAttribute("data-model-id");

          if (modalImg) modalImg.src = img;
          if (modalTitle) modalTitle.textContent = title;
          if (modalCategory) modalCategory.textContent = category;
          if (modalModelNo) modalModelNo.textContent = modelNo;

          const whatsappText = encodeURIComponent(`Merhaba, web sitenizdeki ${modelNo} (${title} - ${category}) modelini beğendim. Kendi evim için özel ölçü rölöve ve 3D çizim projelendirmesi hakkında bilgi almak istiyorum.`);
          if (modalWhatsappBtn) modalWhatsappBtn.href = `https://wa.me/905393333303?text=${whatsappText}`;

          if (modal) {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
          }
        });
      });

      // Modal kapatma
      function closeLightbox() {
        if (modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
          document.body.style.overflow = "";
        }
      }

      closeModal?.addEventListener("click", closeLightbox);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeLightbox();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
          closeLightbox();
        }
      });
    });
  </script>
</Layout>
