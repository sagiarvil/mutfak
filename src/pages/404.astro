---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";
import { buildWhatsAppUrl } from "../utils/whatsapp";

const seo = {
  title: "Sayfa Bulunamadı (404) | İzmir Mutfak Banyo",
  description: "Aradığınız sayfa taşınmış veya silinmiş olabilir. İzmir mutfak ve banyo tadilatı ana sayfasına dönün.",
  canonical: "https://izmirmutfakbanyo.com.tr/404/"
};
---

<Layout seo={seo}>
  <section class="not-found">
    <div class="container text-center">
      <span class="code">404</span>
      <h1 class="title">Sayfa Bulunamadı</h1>
      <p class="desc">
        Aradığınız sayfa silinmiş veya adresi değişmiş olabilir. Aşağıdaki bağlantılardan hizmetlerimize ulaşabilir veya doğrudan WhatsApp'tan bize yazabilirsiniz.
      </p>
      <div class="actions">
        <a href="/" class="btn-home">← Ana Sayfaya Dön</a>
        <a href={buildWhatsAppUrl()} target="_blank" rel="noopener noreferrer" class="btn-wa">💬 WhatsApp İle Ulaşın</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 6rem 1rem;
    text-align: center;
  }
  .code {
    font-size: 5rem;
    font-weight: 900;
    color: #cbd5e1;
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
  }
  .title {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1rem;
  }
  .desc {
    max-width: 500px;
    margin: 0 auto 2rem;
    color: #64748b;
    font-size: 1.05rem;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-home {
    background: #0f172a;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
  }
  .btn-wa {
    background: #25d366;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
  }
</style>
