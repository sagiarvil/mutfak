---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "Sayfa Bulunamadı (404) | İzmir Mutfak Banyo",
  description: "Aradığınız sayfa taşınmış veya silinmiş olabilir. İzmir mutfak ve banyo tadilatı ana sayfasına dönün.",
  canonical: "https://izmirmutfakbanyo.com.tr/404/"
};
---

<Layout seo={seo}>
  <section class="py-28 sm:py-36 bg-stone-950 text-white text-center">
    <div class="max-w-2xl mx-auto px-4 space-y-6">
      <span class="text-7xl sm:text-8xl font-black text-stone-800 block">404</span>
      <h1 class="text-2xl sm:text-3xl font-light font-editorial">Aradığınız Sayfa Bulunamadı</h1>
      <p class="text-xs sm:text-sm text-stone-400 font-light leading-relaxed">
        Ulaşmak istediğiniz sayfa adresi değişmiş veya taşınmış olabilir. 1984'ten gelen güvencemizle mutfak, banyo ve ev tadilatı hizmetlerimizi incelemek için ana sayfaya dönebilirsiniz.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href="/" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          ← Ana Sayfaya Dön
        </a>
        <a href="https://wa.me/905393333303" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-transparent border border-stone-600 text-stone-300 text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          💬 WhatsApp Danışma
        </a>
      </div>
    </div>
  </section>
</Layout>