---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/siteConfig";

const seo = {
  title: "Sayfa Bulunamadı (404) | İzmir Mutfak Banyo Mimarlık",
  description: "Aradığınız sayfa taşınmış veya silinmiş olabilir. İzmir mutfak ve banyo tadilatı ana sayfasına dönün.",
  canonical: "https://izmirmutfakbanyo.com.tr/404/"
};
---

<Layout seo={seo}>
  <section class="py-28 sm:py-36 bg-[#F4F6F8] text-zinc-900 text-center border-b border-[#E2E8F0]">
    <div class="max-w-2xl mx-auto px-4 space-y-6">
      <span class="text-7xl sm:text-8xl font-black text-[#CB000F]/40 block font-['Montserrat',sans-serif]">404</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white font-['Montserrat',sans-serif] tracking-tight">Aradığınız Sayfa Bulunamadı</h1>
      <p class="text-xs sm:text-sm text-zinc-300 font-normal leading-relaxed max-w-lg mx-auto">
        Ulaşmak istediğiniz sayfa adresi değişmiş veya taşınmış olabilir. 1998'den gelen güvencemizle mutfak, banyo ve ev tadilatı hizmetlerimizi incelemek için ana sayfaya dönebilirsiniz.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a href="/" class="w-full sm:w-auto px-8 py-3.5 bg-[#23323A] hover:bg-[#172127] text-white text-xs font-bold uppercase tracking-wider rounded-xl transition shadow-md border border-[#CB000F]/30">
          ← Ana Sayfaya Dön
        </a>
        <a href="https://wa.me/905393333303" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-3.5 bg-white border border-[#E2E8F0] text-[#23323A] hover:bg-[#F4F6F8] text-xs font-bold uppercase tracking-wider rounded-xl transition shadow-xs">
          💬 WhatsApp Danışma
        </a>
      </div>
    </div>
  </section>
</Layout>
