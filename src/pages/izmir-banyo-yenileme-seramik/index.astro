---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Banyo Yenileme & Seramik | Su İzolasyon Garantili",
  description: "İzmir banyo yenileme ve 60x120 granit seramik kaplama işleri. Çift kat elastik sürme su yalıtımı, Geberit gömme rezervuar, özel imalat banyo dolabı ve duşakabin çözümleri.",
  canonical: "https://izmirmutfakbanyo.com.tr/izmir-banyo-yenileme-seramik/",
  serviceName: "Banyo Yenileme & Seramik",
  breadcrumbs: [
    { name: "Banyo Yenileme & Seramik", url: "/izmir-banyo-yenileme-seramik/" }
  ],
  faqList: [
    {
      question: "Banyo seramik döşeme, su yalıtımı ve duşakabin yenileme İzmir'de kime yaptırılır?",
      answer: "Banyo tadilatında alt kata su sızma riskini önlemek için çift kat elastik sürme izolasyon ve köşe pah bantları şarttır. Buca merkez atölyemizde kadrolu ustalarımızla 10 yıl resmi su sızdırmazlık garantisi veriyoruz."
    },
    {
      question: "İzmir'de komple banyo tadilatı kaç günde biter?",
      answer: "Kırım, sıhhi tesisat yenileme, şap, çift kat sürme yalıtım, 60x120 seramik döşeme, asma klozet ve dolap montajı dahil 7 ila 10 iş günü içerisinde tamamlanır."
    },
    {
      question: "Küçük banyolar için özel dolap imalatı yapıyor musunuz?",
      answer: "Evet. Çamaşır makinesi gizleme modülleri, gömme aynalı dolaplar ve neme dayanıklı lake banyo mobilyalarını Buca atölyemizde milimetrik üretiyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Banyo Yenileme & Seramik">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & CANLI LÜKS BANYO SPLIT VİTRİN - DARK HERO YOK) -->
  <section class="relative bg-[#F4F6F8] border-b border-[#E2E8F0] py-12 sm:py-20 overflow-hidden text-zinc-900">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#F4F6F8]/60 to-transparent pointer-events-none"></div>
    
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- SOL: NET, AYDINLIK & GÜVEN VEREN MİMARİ ANLATI (7 SÜTUN) -->
        <div class="lg:col-span-7 space-y-6">
          <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 uppercase tracking-wider" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#23323A] transition">Ana Sayfa</a>
            <span>/</span>
            <span class="text-[#CB000F] font-bold">Banyo Yenileme &amp; Seramik</span>
          </nav>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#CB000F]/50 text-[#23323A] text-[11px] font-bold tracking-[0.16em] uppercase rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
            <span>28 YILLIK TECRÜBE • 10 YIL SU YALITIMI GARANTİSİ</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#23323A] leading-[1.14] tracking-tight">
            Lüks Banyo Yenileme ve <br />
            <span class="text-[#CB000F] font-['Montserrat',sans-serif] font-normal ">60x120 Seramik Uygulama:</span> <br />
            <span class="text-[#23323A]">İzmir İçi Garantili Çözümler.</span>
          </h1>

          <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-xl">
            Çift kat elastik sürme izolasyon, Geberit gömme rezervuar, 60x120 porselen seramik döşeme ve neme dayanıklı özel imalat lake banyo dolapları. Buca atölyemizden tüm İzmir'e garantili anahtar teslim uygulama.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-xs">
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs">
              <span class="text-[#23323A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">10 Yıl Su İzolasyon Garantisi</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs">
              <span class="text-[#23323A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Geberit &amp; Hansgrohe Donanım</span>
            </div>
            <div class="flex items-center gap-2 bg-white p-3 rounded-xl border border-[#E2E8F0] shadow-xs">
              <span class="text-[#23323A] font-bold text-sm">✓</span>
              <span class="text-zinc-800 font-semibold">Marin Neme Dayanıklı Lake</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a 
              href="https://wa.me/905393333303?text=Merhaba,%20banyo%20yenileme%20için%20ücretsiz%20keşif%20istiyorum." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-8 py-4 bg-[#CB000F] hover:bg-[#b0000d] text-white text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-lg border border-[#CB000F] shadow-lg transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              <span>WhatsApp ile Banyo Keşfi İste</span>
              <span>→</span>
            </a>
            <a 
              href="tel:05393333303" 
              class="px-8 py-4 bg-white hover:bg-zinc-50 border border-[#D5CFC5] text-[#23323A] text-xs sm:text-sm font-bold uppercase tracking-wider rounded-lg shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
            >
              0539 333 33 03
            </a>
          </div>
        </div>

        <!-- SAĞ: BANYO PROJESİ AYDINLIK GÖRSEL (5 SÜTUN) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(4,31,20,0.12)] border-4 border-white group">
            <img 
              src="/media/projeler/banyo-15.webp" 
              alt="İzmir Lüks Banyo Yenileme ve 60x120 Seramik Döşeme İmalatı" 
              class="w-full h-[380px] sm:h-[460px] object-cover transition-transform duration-1000 group-hover:scale-105"
              width="600"
              height="460"
              loading="eager"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#CB000F] block">GERÇEK UYGULAMA REFERANSI</span>
              <p class="text-sm font-['Montserrat',sans-serif] font-bold text-white mt-0.5">Urla Villa • 60x120 Porselen Seramik & Marin Dolap</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-[#F8F9FA] border-b border-[#E2E8F0] py-16" id="teknik-standartlar">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#23323A] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#CB000F]">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#23323A]">Banyo Yenileme &amp; Seramik Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Yalıtım &amp; İzolasyon</strong>
          <p class="text-stone-600">Çift Kat Çimento Esaslı Elastik Sürme Yalıtım + Köşe Pah Bandı (10 Yıl Sızdırmazlık Garantisi).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Seramik ve Kaplama</strong>
          <p class="text-stone-600">60x120 Rektifiyeli Porselen Granit Seramik (Vitra, Bien, Kütahya Seramik 1. Kalite).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Gömme Rezervuar &amp; Vitrifiye</strong>
          <p class="text-stone-600">Geberit / Vitra Asma Klozet Sistemleri ve ECA / Artema Termostatik Bataryalar.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Banyo Yenileme 7-10 İş Günü (Eksiksiz Su Testi Yapılarak Teslim Edilir).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#23323A] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">2.463'ten fazla teslim edilmiş garantili banyo tadilatı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🛡️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">10 Yıl Sızdırmazlık</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">Çift kat elastik sürme izolasyonla alt kata su sızma riski sıfır.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">Banyonuzu 3 boyutlu modelleyerek seramik desenlerini önceden görün.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; Tüm İzmir</h4>
            <p class="text-xs text-stone-400 font-normal leading-relaxed">Atölyemizden 30 ilçenin tamamına ücretsiz mimari keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-normal text-stone-950 font-editorial">Banyo Yenileme Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#23323A]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-normal leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- ÇAĞRI BÖLÜMÜ (LUMINOUS ARCHITECTURAL VIP CALLOUT)                    -->
  <!-- ===================================================================== -->
  <section class="py-20 relative overflow-hidden bg-gradient-to-b from-[#F4F6F8] via-[#F4F6F8] to-[#F4F6F8] text-center border-t border-[#E2E8F0] text-zinc-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white rounded-full border border-[#CB000F]/60 text-[#CB000F] text-xs uppercase font-bold tracking-widest shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#107C41] animate-ping"></span>
        MİMARİ KEŞİF & ÖZEL RANDEVU
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#23323A] font-['Montserrat',sans-serif] tracking-tight leading-tight">
        Banyonuzu Yenilemek İçin Ücretsiz Keşif Alın
      </h2>
      <p class="text-xs sm:text-sm text-zinc-600 font-normal max-w-xl mx-auto leading-relaxed">
        İletişime geçin veya WhatsApp'tan yazın; kadrolu mimarımız evinize gelerek rölöve ve 3D çizim analizini hazırlasın.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a 
          href="https://wa.me/905393333303?text=Merhaba,%20banyo%20yenileme%20için%20ücretsiz%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-4 bg-[#23323A] hover:bg-[#172127] text-[#CB000F] text-xs font-bold uppercase tracking-wider rounded-xl border border-[#CB000F]/40 shadow-xl transition-all duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile VIP Keşif Al</span>
          <span>→</span>
        </a>
        <a 
          href="tel:05393333303" 
          class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-[#F4F6F8] border border-[#E2E8F0] text-[#23323A] font-bold text-xs uppercase tracking-wider rounded-xl shadow-xs transition duration-300 flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>📞 0539 333 33 03</span>
        </a>
      </div>
    </div>
  </section>

</Layout>