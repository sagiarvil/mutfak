---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Banyo Yenileme & Seramik | Su İzolasyon Garantili",
  description: "İzmir banyo yenileme ve 60x120 granit seramik kaplama işleri. Çift kat elastik sürme su yalıtımı, Geberit gömme rezervuar, özel imalat banyo dolabı ve duşakabin çözümleri.",
  canonical: "https://yesilaymutfak.com/izmir-banyo-yenileme-seramik/",
  serviceName: "Banyo Yenileme & Seramik",
  breadcrumbs: [
    { name: "Banyo Yenileme & Seramik", url: "/izmir-banyo-yenileme-seramik/" }
  ],
  faqList: [
    {
      question: "Banyo seramik döşeme, su yalıtımı ve duşakabin yenileme İzmir'de kime yaptırılır?",
      answer: "Banyo tadilatında alt kata su sızma riskini önlemek için çift kat elastik sürme izolasyon ve köşe pah bantları şarttır. Buca merkez atölyemizde kadrolu ustalarımızla 10 yıl resmi su sızdırmazlık garantisi veriyoruz."
    },
    {
      question: "İzmir'de komple banyo tadilatı kaç günde biter?",
      answer: "Kırım, sıhhi tesisat yenileme, şap, çift kat sürme yalıtım, 60x120 seramik döşeme, asma klozet ve dolap montajı dahil 7 ila 10 iş günü içerisinde tamamlanır."
    },
    {
      question: "Küçük banyolar için özel dolap imalatı yapıyor musunuz?",
      answer: "Evet. Çamaşır makinesi gizleme modülleri, gömme aynalı dolaplar ve neme dayanıklı lake banyo mobilyalarını Buca atölyemizde milimetrik üretiyoruz."
    }
  ]
};
---

<Layout seo={seo} activeService="Banyo Yenileme & Seramik">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & CANLI LÜKS BANYO VİTRİNİ) -->
  <section class="relative py-20 sm:py-28 overflow-hidden bg-[#041F14]">
    <div class="absolute inset-0 bg-cover bg-center opacity-75 scale-105 transition-transform duration-1000" style="background-image: url('/media/projeler/banyo-15.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#02130C]/90 via-[#041F14]/60 to-black/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#02130C] via-transparent to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6 z-10 [text-shadow:_0_2px_12px_rgba(0,0,0,0.8)]">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[#D8D2C7] uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-[#C5A880]">Banyo Yenileme &amp; Seramik</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-black/40 backdrop-blur-md border border-[#C5A880]/50 text-[#C5A880] text-[11px] font-bold tracking-[0.2em] uppercase rounded-full shadow-lg">
        <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
        <span>1998'DEN BUGÜNE 28 YILLIK TECRÜBE • 10 YIL SU YALITIMI GARANTİSİ</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12] drop-shadow-xl">
        Banyo Yenileme ve 60x120 Seramik Uygulama: <br /><span class="text-[#C5A880] font-serif font-normal italic">İzmir İçi Yalıtımlı Anahtar Teslim Çözümler</span>
      </h1>

      <p class="text-base sm:text-lg text-[#F0EAE1] font-light leading-relaxed max-w-2xl drop-shadow-md">
        Çift kat elastik sürme izolasyon, Geberit gömme rezervuar, 60x120 porselen seramik döşeme ve neme dayanıklı özel imalat lake banyo dolapları. Buca atölyemizden tüm İzmir'e garantili uygulama.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-3">
        <a 
          href="https://wa.me/905324261788?text=Merhaba,%20banyo%20yenileme%20için%20ücretsiz%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-8 py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded border border-[#E5C378] shadow-2xl transition-all duration-300 flex items-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile Banyo Keşfi İste</span>
          <span>→</span>
        </a>
        <a 
          href="tel:02324411060" 
          class="px-8 py-3.5 bg-black/40 hover:bg-black/60 border border-white/30 text-white text-xs sm:text-sm font-semibold uppercase tracking-wider rounded backdrop-blur-md transition duration-300 hover:scale-[1.02]"
        >
          0232 441 1060
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-stone-100 border-b border-stone-200 py-10" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900">Banyo Yenileme &amp; Seramik Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Yalıtım &amp; İzolasyon</strong>
          <p class="text-stone-600">Çift Kat Çimento Esaslı Elastik Sürme Yalıtım + Köşe Pah Bandı (10 Yıl Sızdırmazlık Garantisi).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Seramik ve Kaplama</strong>
          <p class="text-stone-600">60x120 Rektifiyeli Porselen Granit Seramik (Vitra, Bien, Kütahya Seramik 1. Kalite).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Gömme Rezervuar &amp; Vitrifiye</strong>
          <p class="text-stone-600">Geberit / Vitra Asma Klozet Sistemleri ve ECA / Artema Termostatik Bataryalar.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Banyo Yenileme 7-10 İş Günü (Eksiksiz Su Testi Yapılarak Teslim Edilir).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Güven</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463'ten fazla teslim edilmiş garantili banyo tadilatı.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🛡️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">10 Yıl Sızdırmazlık</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Çift kat elastik sürme izolasyonla alt kata su sızma riski sıfır.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Banyonuzu 3 boyutlu modelleyerek seramik desenlerini önceden görün.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; Tüm İzmir</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden 30 ilçenin tamamına ücretsiz mimari keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Banyo Yenileme Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Banyonuzu Yenilemek İçin Ücretsiz Keşif Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp'tan yazın; kadrolu mimarımız evinize gelerek rölöve ve 3D çizim analizini hazırlasın.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20banyo%20yenileme%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0532 426 17 88)
        </a>
      </div>
    </div>
  </section>

</Layout>