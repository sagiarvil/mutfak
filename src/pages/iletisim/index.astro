---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const googleMapsEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3127.322080345155!2d27.1724!3d38.3842!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14bbd8e0e6c58bb7%3A0x6b63394747eb4ca1!2sAdatepe%2C%20%C3%96zbekistan%20Cd.%20No%3A10%2FF%2C%2035390%20Buca%2F%C4%B0zmir!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str";
const googleMapsDirectionsUrl = "https://maps.google.com/?q=Adatepe+Özbekistan+Cd.+No:10/F+Buca+İzmir";

const seo = {
  title: "VIP İletişim & Atölye Randevusu — Cem Yeşilay Luxury Mimarlık | İzmir",
  description: "Cem Yeşilay Luxury imalat atölyesi ve mimarlık ofisi iletişim bilgileri. Adatepe, Özbekistan Cd. no:10/f, Buca/İzmir. Yerinde lazer rölöve ve fotogerçekçi 3D mimari keşif için doğrudan mimarımızla görüşün: 0535 374 83 29.",
  canonical: `${siteConfig.siteUrl}/iletisim/`,
  serviceName: "Mimari Keşif ve Atölye Ziyareti",
  breadcrumbs: [
    { name: "İletişim", url: "/iletisim/" }
  ],
  keywords: [
    "cem yeşilay iletişim",
    "cem yeşilay mimarlık adres",
    "buca adatepe mutfak imalatçısı",
    "lüks mutfak randevu izmir",
    "özbekistan caddesi mobilya atölyesi",
    "izmir 3d mimari keşif randevusu"
  ]
};
---

<Layout seo={seo} activeService="İletişim">

  <!-- ===================================================================== -->
  <!-- 1. HERO ALANI (ROLEX & CARTIER LUXURY ATELIER STANDARDI)              -->
  <!-- ===================================================================== -->
  <section class="relative py-20 sm:py-28 bg-[#02130C] border-b border-[#0A2E1D] overflow-hidden text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(197,168,128,0.15)_0%,transparent_60%)] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-[#041F14] text-[#C5A880] border border-[#C5A880]/40 rounded-full shadow-lg">
        <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
        <span class="text-[11px] font-bold tracking-[0.16em] uppercase font-sans">
          BİZE ULAŞIN • ADATEPE İMALAT ATÖLYESİ & OFİS
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-[58px] font-extrabold text-white leading-[1.1] tracking-tight font-serif max-w-4xl">
        Projenizi Bir Kahve Eşliğinde <br />
        <span class="text-[#C5A880] font-normal italic">Atölyemizde Birlikte Tasarlayalım.</span>
      </h1>

      <p class="text-sm sm:text-base text-[#D8D2C7] font-light leading-relaxed max-w-2xl">
        Kendi imalat tesisimizde gövde kesitlerini, İtalyan lake numunelerini ve Blum sessiz ray mekanizmalarını birebir inceleyin. Mimarımızla tanışarak evinize özel fotogerçekçi 3D mimari keşif randevusu oluşturun.
      </p>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. DOĞRUDAN VIP İLETİŞİM KARTLARI (3'LÜ PREMİUM DOCK)                -->
  <!-- ===================================================================== -->
  <section class="py-14 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Kart 1: Doğrudan Telefon -->
        <div class="p-6 bg-[#F8FAFC] border border-gray-200 rounded-xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded bg-[#041F14] text-[#C5A880] flex items-center justify-center text-sm font-bold shadow-md">
              📞
            </div>
            <span class="text-[10.5px] font-bold uppercase tracking-wider text-[#041F14] block">DOĞRUDAN HAT</span>
            <h3 class="text-xl font-bold text-zinc-900 tracking-tight font-sans">0535 374 83 29</h3>
            <p class="text-xs text-zinc-600 font-light leading-relaxed">
              Pazartesi – Cumartesi 08:30 - 19:30 saatleri arasında doğrudan mimarımıza ulaşabilirsiniz.
            </p>
          </div>
          <a href="tel:05353748329" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#041F14] hover:text-[#C5A880] transition pt-2">
            <span>Doğrudan Arayın</span> <span>→</span>
          </a>
        </div>

        <!-- Kart 2: WhatsApp VIP Keşif -->
        <div class="p-6 bg-[#041F14] border border-[#0D3826] rounded-xl apple-card space-y-4 flex flex-col justify-between text-white">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded bg-[#083523] text-[#00FF66] flex items-center justify-center text-sm font-bold shadow-md border border-[#00FF66]/30">
              💬
            </div>
            <span class="text-[10.5px] font-bold uppercase tracking-wider text-[#C5A880] block">WHATSAPP VIP KEŞİF</span>
            <h3 class="text-xl font-bold text-white tracking-tight font-sans">Hızlı Rölöve & 3D Çizim</h3>
            <p class="text-xs text-[#D8D2C7] font-light leading-relaxed">
              Mevcut mutfağınızın fotoğraf veya ölçülerini ileterek 15 dakikada ön maliyet analizi alın.
            </p>
          </div>
          <a href="https://wa.me/905353748329" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#C5A880] hover:text-white transition pt-2">
            <span>WhatsApp Keşif Başlatın</span> <span>→</span>
          </a>
        </div>

        <!-- Kart 3: Instagram Atölye Vitrini -->
        <div class="p-6 bg-[#F8FAFC] border border-gray-200 rounded-xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded bg-[#041F14] text-[#C5A880] flex items-center justify-center text-sm font-bold shadow-md">
              📷
            </div>
            <span class="text-[10.5px] font-bold uppercase tracking-wider text-[#041F14] block">CANLI ŞANTİYELER</span>
            <h3 class="text-xl font-bold text-zinc-900 tracking-tight font-sans">@cemyesilay.luxury</h3>
            <p class="text-xs text-zinc-600 font-light leading-relaxed">
              Atölye üretim süreçlerini ve teslim edilen İzmir villalarını Instagram'da canlı izleyin.
            </p>
          </div>
          <a href="https://www.instagram.com/cemyesilay.luxury" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#041F14] hover:text-[#C5A880] transition pt-2">
            <span>Instagram'da İnceleyin</span> <span>→</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. VIP 3D MİMARİ KEŞİF & RÖLÖVE RANDEVU FORMU (DÜNYA STANDARDI)         -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#F8FAFC] border-b border-gray-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase font-bold tracking-widest text-[#041F14]">MİMARİ KEŞİF TALEBİ</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 font-serif">
          Mekanınız İçin 3D Rölöve Randevusu Alın
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600">
          Aşağıdaki formu doldurun, projeniz doğrudan mimarımızın ekranına düşsün.
        </p>
      </div>

      <!-- Lüks Form Konsolu -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-10 shadow-xl space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          
          <!-- Ad Soyad -->
          <div class="space-y-1.5">
            <label for="formName" class="text-xs font-bold uppercase tracking-wider text-zinc-800 block">Adınız Soyadınız *</label>
            <input 
              type="text" 
              id="formName" 
              placeholder="Örn: Barış Bey" 
              class="w-full px-4 py-3 bg-[#F8FAFC] border border-gray-300 rounded text-xs text-zinc-900 focus:outline-none focus:border-[#041F14] transition"
            />
          </div>

          <!-- Telefon Numarası -->
          <div class="space-y-1.5">
            <label for="formPhone" class="text-xs font-bold uppercase tracking-wider text-zinc-800 block">Telefon Numaranız *</label>
            <input 
              type="tel" 
              id="formPhone" 
              placeholder="Örn: 0532 000 00 00" 
              class="w-full px-4 py-3 bg-[#F8FAFC] border border-gray-300 rounded text-xs text-zinc-900 focus:outline-none focus:border-[#041F14] transition"
            />
          </div>

          <!-- Proje Bölgesi -->
          <div class="space-y-1.5">
            <label for="formDistrict" class="text-xs font-bold uppercase tracking-wider text-zinc-800 block">Proje Bölgesi (İzmir) *</label>
            <select 
              id="formDistrict" 
              class="w-full px-4 py-3 bg-[#F8FAFC] border border-gray-300 rounded text-xs text-zinc-900 focus:outline-none focus:border-[#041F14] transition"
            >
              <option value="Buca">Buca</option>
              <option value="Urla">Urla</option>
              <option value="Çeşme">Çeşme</option>
              <option value="Karşıyaka">Karşıyaka / Mavişehir</option>
              <option value="Bornova">Bornova</option>
              <option value="Güzelbahçe">Güzelbahçe</option>
              <option value="Konak / Alsancak">Konak / Alsancak</option>
              <option value="Gaziemir">Gaziemir</option>
              <option value="Balçova / Narlıdere">Balçova / Narlıdere</option>
              <option value="Diğer İzmir İlçesi">Diğer İzmir İlçesi</option>
            </select>
          </div>

          <!-- İlgilenilen Mimari Hizmet -->
          <div class="space-y-1.5">
            <label for="formService" class="text-xs font-bold uppercase tracking-wider text-zinc-800 block">Hizmet Türü *</label>
            <select 
              id="formService" 
              class="w-full px-4 py-3 bg-[#F8FAFC] border border-gray-300 rounded text-xs text-zinc-900 focus:outline-none focus:border-[#041F14] transition"
            >
              <option value="Özel Ölçü Lüks Mutfak Dolabı">Özel Ölçü Lüks Mutfak Dolabı</option>
              <option value="Komple Mutfak Renovasyonu (Kırım + Tesisat + Tezgah)">Komple Mutfak Renovasyonu</option>
              <option value="Lüks Banyo & Seramik Yenileme">Lüks Banyo & Seramik Yenileme</option>
              <option value="Özel İç Kapılar & Giyinme Odası">Özel İç Kapılar & Giyinme Odası</option>
              <option value="Anahtar Teslim Daire / Villa Renovasyonu">Anahtar Teslim Daire / Villa Renovasyonu</option>
            </select>
          </div>

        </div>

        <!-- Proje Notu -->
        <div class="space-y-1.5">
          <label for="formNote" class="text-xs font-bold uppercase tracking-wider text-zinc-800 block">Projeniz Hakkında Kısa Not</label>
          <textarea 
            id="formNote" 
            rows="3" 
            placeholder="Örn: 12 metrekare L tipi mutfak, ada tezgahlı ve ipek mat lake kapak düşünüyoruz..." 
            class="w-full px-4 py-3 bg-[#F8FAFC] border border-gray-300 rounded text-xs text-zinc-900 focus:outline-none focus:border-[#041F14] transition"
          ></textarea>
        </div>

        <!-- Gönder Butonu -->
        <div>
          <button 
            type="button" 
            id="btnSubmitQuote" 
            class="w-full py-4 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] font-extrabold uppercase tracking-wider rounded border border-[#E5C378] transition shadow-lg text-xs sm:text-sm flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>WhatsApp ile Doğrudan Mimara İlet</span>
            <span>→</span>
          </button>
          <p class="text-[11px] text-zinc-500 text-center mt-2">
            🔒 Bilgileriniz 3. şahıslarla paylaşılmaz; doğrudan resmi atölye hattımıza iletilir.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. ATÖLYE & MALZEME KÜTÜPHANESİ TANITIMI                              -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs uppercase font-bold tracking-widest text-[#041F14] block">ADATEPE İMALAT MERKEZİ</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 font-serif leading-tight">
            28 Yıllık Zanaat Mirası & <br />
            <span class="text-[#041F14]">Kendi İmalat Tesisimiz</span>
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-normal">
            Buca Adatepe'deki atölyemizde fason veya taşeron kullanılmaz. Gövdeden kapak lake boyasına, Blum ray montajından lazer kesime kadar her aşama kendi bünyemizdeki ustalarımızca yürütülür.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3">
              <span class="text-[#041F14] font-bold text-base">✓</span>
              <div>
                <h4 class="text-xs font-bold text-zinc-900 uppercase">18mm Çift Yüz E1 MDF-Lam Gövde</h4>
                <p class="text-[11px] text-zinc-500">Neme ve buhara tam dayanıklı, şişme yapmayan yapısal garanti.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[#041F14] font-bold text-base">✓</span>
              <div>
                <h4 class="text-xs font-bold text-zinc-900 uppercase">Avusturya Blum & Häfele Donanım</h4>
                <p class="text-[11px] text-zinc-500">Kadife sessizliğinde entegre frenli ray ve kalkar kapaklar.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[#041F14] font-bold text-base">✓</span>
              <div>
                <h4 class="text-xs font-bold text-zinc-900 uppercase">Milimetrik Lazer Rölöve & 3D Çizim</h4>
                <p class="text-[11px] text-zinc-500">Montajda sıfır hata ve kusursuz mekana oturma taahhüdü.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Sağ: Google Haritalar Gömülü Konsolu -->
        <div class="lg:col-span-6">
          <div class="w-full h-80 sm:h-96 rounded-2xl overflow-hidden border border-gray-300 shadow-xl relative bg-zinc-100">
            <iframe 
              src={googleMapsEmbedUrl} 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Cem Yeşilay Luxury Atölye Konumu"
            ></iframe>
          </div>
          <div class="mt-3 flex items-center justify-between text-xs text-zinc-600">
            <span>📍 Adatepe, Özbekistan Cd. no:10/f, 35000 Buca/İzmir</span>
            <a href={googleMapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#041F14] hover:underline">
              Yol Tarifi Al →
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Form Etkileşim Scripti -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("btnSubmitQuote");
      if (!btn) return;

      btn.addEventListener("click", () => {
        const name = (document.getElementById("formName")?.value || "").trim();
        const phone = (document.getElementById("formPhone")?.value || "").trim();
        const district = document.getElementById("formDistrict")?.value || "İzmir";
        const service = document.getElementById("formService")?.value || "Özel Mutfak Dolabı";
        const note = (document.getElementById("formNote")?.value || "").trim();

        if (!name || !phone) {
          alert("Lütfen adınızı ve telefon numaranızı giriniz.");
          return;
        }

        const msg = `Merhaba Cem Bey,\nBen *${name}* (${phone}).\nİzmir *${district}* bölgesindeki mekanım için *${service}* projelendirmesi ve ücretsiz 3D mimari rölöve randevusu almak istiyorum.\nNot: ${note || "Bilgi ve keşif rica ediyorum."}`;
        
        const waLink = `https://wa.me/905353748329?text=${encodeURIComponent(msg)}`;
        window.open(waLink, "_blank");
      });
    });
  </script>

</Layout>
