  <!-- CLIENT-SIDE SCRIPT: ADRESİ KOPYALAMA BUTONU ETKİLEŞİMİ               -->
  <!-- ===================================================================== -->
  <script is:inline define:vars={{ fullAddress }}>
    const copyBtn = document.getElementById('copyAddressBtn');
    const copyText = document.getElementById('copyBtnText');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(fullAddress);
          const original = copyText.innerText;
          copyText.innerText = "✓ Adres Kopyalandı!";
          copyBtn.classList.add('bg-[#10B981]', 'text-white', 'border-[#10B981]');
          setTimeout(() => {
            copyText.innerText = original;
            copyBtn.classList.remove('bg-[#10B981]', 'text-white', 'border-[#10B981]');
          }, 2500);
        } catch (e) {
          prompt("Adresi kopyalayabilirsiniz:", fullAddress);
        }
      });
    }
  </script>

