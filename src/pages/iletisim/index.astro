---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const googleMapsUrl = "https://share.google/C0WRDJ4gisVAQIAzr";
const googleMapsEmbedUrl = "https://maps.google.com/maps?q=38.392083,27.180623&hl=tr&z=16&output=embed";
const appleMapsUrl = "https://maps.apple.com/?q=38.392083,27.180623";
const yandexMapsUrl = "https://yandex.com.tr/harita/?pt=27.180623,38.392083&z=17&l=map";
const fullAddress = "Gaziler Mahallesi 1084/2 Sokak No: 1/A (Gazi Osman Paşa Cd. Köşesi) Buca / İzmir";

const seo = {
  title: "İletişim, Konum & Atölye Yol Tarifi — Yeşilay Mutfak Mimarlık | Buca İzmir",
  description: "Yeşilay Mutfak mağaza ve imalat atölyesi canlı Google Haritalar konumu ve yol tarifi. Gaziler Mah. 1084/2 Sokak No: 1/A Buca/İzmir. Keşif randevusu için: 0232 441 10 60.",
  canonical: `${siteConfig.siteUrl}/iletisim/`,
  serviceName: "Mimari Keşif ve Atölye Ziyareti",
  breadcrumbs: [
    { name: "İletişim & Konum", url: "/iletisim/" }
  ],
  keywords: [
    "yeşilay mutfak iletişim",
    "yeşilay mutfak adres",
    "yeşilay mutfak google harita",
    "yeşilay mutfak yol tarifi",
    "buca adatepe mutfak atölyesi nerede",
    "gazi osman paşa caddesi mobilya imalatçısı",
    "izmir mimari keşif randevusu"
  ]
};
---

<Layout seo={seo} activeService="İletişim">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (APPLE MINIMALIST LUXURY)                             -->
  <!-- ===================================================================== -->
  <section class="relative py-16 sm:py-24 bg-[#FAF9F6] border-b border-[#E5DFD5] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#D2D2D7] rounded-full shadow-2xs">
        <span class="w-2.5 h-2.5 rounded-full bg-[#10B981] animate-pulse"></span>
        <span class="text-[#1D1D1F] text-[11px] font-semibold tracking-[0.14em] uppercase font-sans">
          CANLI KONUM & ADRES TARİFİ • ADATEPE / GAZİLER İMALAT ATÖLYESİ
        </span>
      </div>

      <h1 class="text-[34px] sm:text-[48px] lg:text-[56px] font-bold text-[#1D1D1F] leading-[1.1] tracking-[-0.03em] max-w-4xl">
        Atölyemizde Bir Kahve Eşliğinde <br />
        <span class="italic font-normal text-[#006039]">Hayalinizdeki Mutfağı Planlayalım.</span>
      </h1>

      <p class="text-[16px] sm:text-[18px] text-[#6E675F] font-normal leading-relaxed max-w-2xl">
        İzmir Buca'daki kendi imalat tesisimizde gövde kesitlerini, İtalyan lake kapak numunelerini ve Blum menteşe mekanizmalarını canlı deneyimleyin. Google Haritalar navigasyonuyla kolayca ulaşın.
      </p>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. HIZLI İLETİŞİM VE ERİŞİM KARTLARI (3'LÜ APPLE GRID)               -->
  <!-- ===================================================================== -->
  <section class="py-12 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Kart 1: Doğrudan Telefon -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-full bg-white border border-[#D2D2D7] flex items-center justify-center text-[#006039] shadow-2xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">DOĞRUDAN TELEFON HATTI</span>
            <h3 class="text-[22px] font-bold text-[#1D1D1F] tracking-tight">0232 441 10 60</h3>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              Haftanın 6 günü 09:00 – 19:30 saatleri arasında doğrudan mimarlarımıza ve atölye şefimize ulaşabilirsiniz.
            </p>
          </div>
          <a href="tel:02324411060" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#006039] hover:underline pt-2">
            <span>Hemen Telefonla Arayın</span> <span>→</span>
          </a>
        </div>

        <!-- Kart 2: WhatsApp Keşif & Rölöve -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-full bg-[#006039] text-white flex items-center justify-center shadow-2xs">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-1.115-.06-.275-.088-.63-.223-1.096-.425-1.986-.86-3.274-2.871-3.373-3.003-.099-.133-.804-1.072-.804-2.044 0-.972.508-1.45.69-1.65.182-.2.398-.25.53-.25.133 0 .265.001.382.007.123.006.288-.047.45.344.167.404.57 1.391.62 1.492.05.101.083.22.016.353-.066.133-.1.216-.199.332-.099.117-.208.261-.297.351-.099.099-.202.207-.087.404.116.198.514.849 1.103 1.374.757.675 1.396.884 1.595.983.199.099.315.083.431-.05.116-.134.498-.58.63-.779.133-.199.265-.166.448-.099.182.066 1.157.546 1.356.645.199.1.332.15.381.233.05.083.05.479-.094.884z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">WHATSAPP MİMARİ KEŞİF HATTI</span>
            <h3 class="text-[22px] font-bold text-[#1D1D1F] tracking-tight">Hızlı Fotoğraf & Keşif</h3>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              Mevcut mutfağınızın fotoğraf veya kaba ölçülerini ileterek aynı gün ön bütçe ve 3D simülasyon değerlendirmesi alabilirsiniz.
            </p>
          </div>
          <a href="https://wa.me/905324261788" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#006039] hover:underline pt-2">
            <span>WhatsApp Sohbeti Başlatın</span> <span>→</span>
          </a>
        </div>

        <!-- Kart 3: Canlı Navigasyon & Konum -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-full bg-white border border-[#D2D2D7] flex items-center justify-center text-[#C5A880] shadow-2xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">GOOGLE HARİTALAR KONUMU</span>
            <h3 class="text-[22px] font-bold text-[#1D1D1F] tracking-tight">Buca Gaziler / Adatepe</h3>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              İzmir Çevre Yolu Buca çıkışına 5 dakika mesafede, geniş otoparklı mağaza ve atölye binamız.
            </p>
          </div>
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#006039] hover:underline pt-2">
            <span>Google Maps'te Canlı Aç</span> <span>↗</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. PROFESYONEL GOOGLE MAPS VE CANLI HARİTA MERKEZİ                   -->
  <!-- ===================================================================== -->
  <section class="py-16 sm:py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      
      <!-- Bölüm Başlığı -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#E5DFD5] pb-6">
        <div class="space-y-2">
          <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">
            CANLI İNTERAKTİF HARİTA & NAVİGASYON
          </span>
          <h2 class="text-[30px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-tight">
            Google Haritalar ile Atölyemizi Bulun
          </h2>
          <p class="text-[14px] text-[#6E675F] max-w-2xl">
            Haritayı yakınlaştırıp uzaklaştırabilir, doğrudan yol tarifi alabilir veya telefonunuzdaki tercih ettiğiniz navigasyon uygulamasıyla kapımıza kadar gelebilirsiniz.
          </p>
        </div>

        <!-- Hızlı Navigasyon Butonları -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <a 
            href={googleMapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-5 py-2.5 bg-[#006039] hover:bg-[#00482B] text-white text-xs font-semibold tracking-tight rounded-full shadow-sm transition inline-flex items-center gap-2"
          >
            <span>📍 Google Maps'te Aç</span>
            <span>↗</span>
          </a>
          <button 
            type="button"
            id="copyAddressBtn"
            class="px-4 py-2.5 bg-white hover:bg-[#F5F5F7] text-[#1D1D1F] border border-[#D2D2D7] text-xs font-semibold tracking-tight rounded-full shadow-2xs transition inline-flex items-center gap-1.5 cursor-pointer"
            title="Adresi panoya kopyala"
          >
            <span>📋</span>
            <span id="copyBtnText">Adresi Kopyala</span>
          </button>
        </div>
      </div>

      <!-- Harita Vitrini (Profesyonel Çerçeve + iFrame) -->
      <div class="bg-white border border-[#E5DFD5] rounded-2xl overflow-hidden shadow-sm apple-card">
        
        <!-- Harita Üst Bilgi Barı -->
        <div class="px-5 py-4 bg-[#FAF9F6] border-b border-[#E5DFD5] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-[#10B981]"></span>
            </span>
            <span class="font-bold text-[#1D1D1F]">Yeşilay Mutfak Mağaza & İmalat Atölyesi</span>
            <span class="hidden sm:inline text-[#86868B]">•</span>
            <span class="hidden sm:inline text-[#6E675F]">{fullAddress}</span>
          </div>

          <div class="flex items-center gap-3 text-[11.5px] font-medium text-[#6E675F]">
            <span>Koordinat: <strong class="text-[#1D1D1F]">38.3921° K, 27.1806° D</strong></span>
          </div>
        </div>

        <!-- İnteraktif Google Maps iframe -->
        <div class="relative w-full h-[440px] sm:h-[500px] lg:h-[540px] bg-[#E5DFD5]">
          <iframe 
            src={googleMapsEmbedUrl} 
            class="w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Yeşilay Mutfak Google Harita Konumu">
          </iframe>
        </div>

        <!-- Harita Altı Çoklu Navigasyon Aksiyonları -->
        <div class="p-4 sm:p-5 bg-white border-t border-[#E5DFD5] flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="text-[#6E675F] text-[12.5px]">
            <strong class="text-[#1D1D1F]">Navigasyon Seçin:</strong> Tercih ettiğiniz harita uygulamasıyla tek dokunuşla rota başlatın.
          </div>
          
          <div class="flex flex-wrap items-center gap-2">
            <a 
              href={googleMapsUrl}
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 bg-[#FAF9F6] hover:bg-[#F0EDE8] border border-[#D2D2D7] text-[#1D1D1F] font-semibold text-[11.5px] rounded-lg transition inline-flex items-center gap-1.5"
            >
              <span>🗺️ Google Maps</span>
              <span>↗</span>
            </a>
            <a 
              href={appleMapsUrl}
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 bg-[#FAF9F6] hover:bg-[#F0EDE8] border border-[#D2D2D7] text-[#1D1D1F] font-semibold text-[11.5px] rounded-lg transition inline-flex items-center gap-1.5"
            >
              <span>🍏 Apple Haritalar</span>
              <span>↗</span>
            </a>
            <a 
              href={yandexMapsUrl}
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 bg-[#FAF9F6] hover:bg-[#F0EDE8] border border-[#D2D2D7] text-[#1D1D1F] font-semibold text-[11.5px] rounded-lg transition inline-flex items-center gap-1.5"
            >
              <span>🟡 Yandex Haritalar</span>
              <span>↗</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. DETAYLI ADRES VE ULAŞIM REHBERİ (ADRES TARİFLERİ)                  -->
  <!-- ===================================================================== -->
  <section class="py-16 sm:py-20 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">
          ADIM ADIM YOL TARİFLERİ
        </span>
        <h2 class="text-[30px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-tight">
          Nasıl Gelinir? Tüm Ulaşım Seçenekleri
        </h2>
        <p class="text-[15px] text-[#6E675F] leading-relaxed">
          Atölyemiz Buca'nın en erişilebilir ana arterlerinden birinde, Gaziler Mahallesi Gazi Osman Paşa Caddesi üzerinde bulunmaktadır. İster özel aracınızla ister toplu taşımayla kolayca ulaşabilirsiniz.
        </p>
      </div>

      <!-- 4'lü Kapsamlı Rehber Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Kart 1: Özel Araç & Otoyol -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl space-y-3 flex flex-col justify-between apple-card">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white border border-[#D2D2D7] flex items-center justify-center text-xl shadow-2xs">
              🚗
            </div>
            <h3 class="text-[17px] font-bold text-[#1D1D1F]">Özel Araç & Otoyol</h3>
            <p class="text-[12.5px] text-[#6E675F] font-normal leading-relaxed">
              İzmir Çevre Yolu (O-30) <strong>Buca - Kozağaç / Heykel</strong> sapağından çıkış yapın. Heykel Meydanı'ndan sonra Gaziler / Gazi Osman Paşa Caddesi aksına dönerek yaklaşık <strong>4-6 dakika</strong> içinde atölyemize varabilirsiniz.
            </p>
          </div>
          <div class="pt-3 border-t border-[#E5DFD5] text-[11.5px] font-semibold text-[#006039]">
            ✓ Rahat ve akıcı güzergah
          </div>
        </div>

        <!-- Kart 2: İZBAN & Toplu Taşıma -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl space-y-3 flex flex-col justify-between apple-card">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white border border-[#D2D2D7] flex items-center justify-center text-xl shadow-2xs">
              🚌
            </div>
            <h3 class="text-[17px] font-bold text-[#1D1D1F]">İZBAN & ESHOT Otobüsleri</h3>
            <p class="text-[12.5px] text-[#6E675F] font-normal leading-relaxed">
              <strong>Şirinyer İZBAN İstasyonu</strong> aktarma merkezinden kalkan Gaziler / Heykel dolmuşları ya da ESHOT hatlarıyla (104, 465, 470, 878) <strong>Gazi Osman Paşa Caddesi durağında</strong> inin. Atölye sadece 70 metre (1 dk) mesafededir.
            </p>
          </div>
          <div class="pt-3 border-t border-[#E5DFD5] text-[11.5px] font-semibold text-[#006039]">
            ✓ Duraktan 1 dakika yürüme
          </div>
        </div>

        <!-- Kart 3: Ücretsiz Müşteri Otoparkı -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl space-y-3 flex flex-col justify-between apple-card">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white border border-[#D2D2D7] flex items-center justify-center text-xl shadow-2xs">
              🅿️
            </div>
            <h3 class="text-[17px] font-bold text-[#1D1D1F]">Geniş ve Rahat Otopark</h3>
            <p class="text-[12.5px] text-[#6E675F] font-normal leading-relaxed">
              Buca merkezindeki otopark sorununu dert etmeyin. Mağaza ve atölye binamızın hemen ön cephesinde müşterilerimize ayrılmış <strong>geniş, düzayak ve ücretsiz araç park alanı</strong> mevcuttur.
            </p>
          </div>
          <div class="pt-3 border-t border-[#E5DFD5] text-[11.5px] font-semibold text-[#006039]">
            ✓ Kapı önü ücretsiz park
          </div>
        </div>

        <!-- Kart 4: Çevre Nirengi Noktaları -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl space-y-3 flex flex-col justify-between apple-card">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-white border border-[#D2D2D7] flex items-center justify-center text-xl shadow-2xs">
              📍
            </div>
            <h3 class="text-[17px] font-bold text-[#1D1D1F]">Bölge Referans Noktası</h3>
            <p class="text-[12.5px] text-[#6E675F] font-normal leading-relaxed">
              Buca mobilya ve mutfak imalat bölgesinin ana aksında, <strong>Gaziler Mahallesi 1084/2 Sokak ile Gazi Osman Paşa Caddesi köşesinde</strong> yer alıyoruz. Yeşil kurumsal tabelamız caddeden doğrudan görünür.
            </p>
          </div>
          <div class="pt-3 border-t border-[#E5DFD5] text-[11.5px] font-semibold text-[#006039]">
            ✓ Köşe başı kolay görünür konum
          </div>
        </div>

      </div>

      <!-- İzmir İlçelerinden Tahmini Varış Süreleri Tablosu -->
      <div class="p-6 sm:p-8 bg-[#FAF9F6] border border-[#E5DFD5] rounded-2xl space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="text-[18px] font-bold text-[#1D1D1F]">İzmir İlçelerinden Atölyemize Tahmini Sürüş Süreleri</h3>
            <p class="text-[13px] text-[#6E675F]">Çevre yolu ve ana bağlantı yollarıyla atölyemize ne kadar sürede ulaşabileceğinizi inceleyin.</p>
          </div>
          <span class="text-xs font-semibold px-3 py-1 bg-white border border-[#D2D2D7] rounded-full text-[#006039] self-start sm:self-auto">
            İzmir Geneli Hızlı Erişim
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-2">
          
          <div class="p-3.5 bg-white border border-[#E5DFD5] rounded-xl text-center space-y-1">
            <div class="text-[11px] font-bold text-[#86868B] uppercase">KONAK / ALSANCAK</div>
            <div class="text-[18px] font-bold text-[#1D1D1F]">~15-18 Dk</div>
            <div class="text-[10.5px] text-[#6E675F]">Menderes Cd.</div>
          </div>

          <div class="p-3.5 bg-white border border-[#E5DFD5] rounded-xl text-center space-y-1">
            <div class="text-[11px] font-bold text-[#86868B] uppercase">BORNOVA / BAYRAKLI</div>
            <div class="text-[18px] font-bold text-[#1D1D1F]">~18-22 Dk</div>
            <div class="text-[10.5px] text-[#6E675F]">Otoyol Buca Doğu</div>
          </div>

          <div class="p-3.5 bg-white border border-[#E5DFD5] rounded-xl text-center space-y-1">
            <div class="text-[11px] font-bold text-[#86868B] uppercase">KARŞIYAKA / MAVİŞEHİR</div>
            <div class="text-[18px] font-bold text-[#1D1D1F]">~25-30 Dk</div>
            <div class="text-[10.5px] text-[#6E675F]">İzmir Çevre Yolu</div>
          </div>

