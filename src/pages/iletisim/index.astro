---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const googleMapsUrl = "https://share.google/HC5sweG3HXcjogRNZ";

const seo = {
  title: "İletişim & Atölye Ziyareti — Yeşilay Mutfak Mimarlık | Buca İzmir",
  description: "Yeşilay Mutfak imalat atölyesi ve mimarlık ofisi iletişim bilgileri. Adatepe, Özbekistan Cd. no:10/f, Buca/İzmir. Lazer rölöve, 3D çizim ve ücretsiz keşif randevusu için hemen arayın: 0232 441 10 60.",
  canonical: `${siteConfig.siteUrl}/iletisim/`,
  serviceName: "Mimari Keşif ve Atölye Ziyareti",
  breadcrumbs: [
    { name: "İletişim", url: "/iletisim/" }
  ],
  keywords: [
    "yeşilay mutfak iletişim",
    "yeşilay mutfak adres",
    "buca adatepe mutfak atölyesi telefon",
    "özbekistan caddesi mobilya imalatçısı",
    "izmir mimari keşif randevusu"
  ]
};
---

<Layout seo={seo} activeService="İletişim">

  <!-- ===================================================================== -->
  <!-- 1. HERO BÖLÜMÜ (APPLE MINIMALIST LUXURY)                             -->
  <!-- ===================================================================== -->
  <section class="relative py-20 sm:py-28 bg-[#FAF9F6] border-b border-[#E5DFD5] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white border border-[#D2D2D7] rounded-full shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
        <span class="text-[#1D1D1F] text-[11px] font-semibold tracking-[0.14em] uppercase font-sans">
          BİZE ULAŞIN • ADATEPE İMALAT ATÖLYESİ & OFİS
        </span>
      </div>

      <h1 class="text-[36px] sm:text-[52px] lg:text-[60px] font-bold text-[#1D1D1F] leading-[1.08] tracking-[-0.03em] max-w-4xl">
        Projenizi Bir Kahve Eşliğinde <br />
        <span class="italic font-normal text-[#006039]">Atölyemizde Planlayalım.</span>
      </h1>

      <p class="text-[16px] sm:text-[18px] text-[#6E675F] font-normal leading-relaxed max-w-2xl">
        Adatepe'deki kendi imalat tesisimizde gövde kesitlerini, İtalyan lake numunelerini ve Blum donanımları canlı inceleyin. Mimarımızla tanışarak evinize özel 3D çizim randevusu alın.
      </p>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. İLERİ SEVİYE İLETİŞİM KARTLARI (3'LÜ APPLE GRID)                  -->
  <!-- ===================================================================== -->
  <section class="py-14 bg-white border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Kart 1: Doğrudan Telefon -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-full bg-white border border-[#D2D2D7] flex items-center justify-center text-[#006039]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">DOĞRUDAN HAT</span>
            <h3 class="text-[20px] font-bold text-[#1D1D1F] tracking-tight">0232 441 10 60</h3>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              Haftanın 6 günü 09:00 - 19:30 saatleri arasında doğrudan mimarımıza ulaşabilirsiniz.
            </p>
          </div>
          <a href="tel:02324411060" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#006039] hover:underline pt-2">
            <span>Hemen Telefonla Arayın</span> <span>→</span>
          </a>
        </div>

        <!-- Kart 2: WhatsApp Mimari Keşif -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-full bg-[#006039] text-white flex items-center justify-center">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-1.115-.06-.275-.088-.63-.223-1.096-.425-1.986-.86-3.274-2.871-3.373-3.003-.099-.133-.804-1.072-.804-2.044 0-.972.508-1.45.69-1.65.182-.2.398-.25.53-.25.133 0 .265.001.382.007.123.006.288-.047.45.344.167.404.57 1.391.62 1.492.05.101.083.22.016.353-.066.133-.1.216-.199.332-.099.117-.208.261-.297.351-.099.099-.202.207-.087.404.116.198.514.849 1.103 1.374.757.675 1.396.884 1.595.983.199.099.315.083.431-.05.116-.134.498-.58.63-.779.133-.199.265-.166.448-.099.182.066 1.157.546 1.356.645.199.1.332.15.381.233.05.083.05.479-.094.884z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">WHATSAPP KEŞİF HATTI</span>
            <h3 class="text-[20px] font-bold text-[#1D1D1F] tracking-tight">Hızlı Rölöve & Çizim</h3>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              Mevcut mutfağınızın fotoğraf veya ölçülerini ileterek anında 3D maliyet değerlendirmesi alabilirsiniz.
            </p>
          </div>
          <a href="https://wa.me/905324261788" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#006039] hover:underline pt-2">
            <span>WhatsApp Sohbeti Başlatın</span> <span>→</span>
          </a>
        </div>

        <!-- Kart 3: Instagram Lüks Vitrin -->
        <div class="p-6 bg-[#FAF9F6] border border-[#E5DFD5] rounded-xl apple-card space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-full bg-white border border-[#D2D2D7] flex items-center justify-center text-[#C5A880]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5" stroke-width="2"/><path stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">CANLI PROJELER</span>
            <h3 class="text-[20px] font-bold text-[#1D1D1F] tracking-tight">@yesilaymutfak</h3>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              Atölye üretim aşamalarını, şantiye montaj videolarını ve yeni modelleri Instagram'da takip edin.
            </p>
          </div>
          <a href="https://www.instagram.com/yesilaymutfak" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#C5A880] hover:underline pt-2">
            <span>Instagram Profilini İncele</span> <span>→</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. PROFESYONEL "NASIL ULAŞILIR?" VE HARİTA YÖNLENDİRME MERKEZİ        -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-[#FAF9F6] border-b border-[#E5DFD5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-12">
      
      <!-- Başlık -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-[#E5DFD5] pb-6">
        <div class="space-y-2">
          <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">
            KONUM & ULAŞIM REHBERİ
          </span>
          <h2 class="text-[32px] sm:text-[40px] font-bold text-[#1D1D1F] tracking-tight">
            Atölyemize Nasıl Ulaşılır?
          </h2>
        </div>
        <div class="flex items-center gap-3">
          <a 
            href={googleMapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-6 py-3 bg-[#006039] hover:bg-[#00482B] text-white text-xs font-semibold tracking-tight rounded-full shadow-sm transition flex items-center gap-2"
          >
            <span>📍 Google Haritalar'da Aç</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Sol: Ulaşım Yönlendirme Kartları (7 Kolon) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Açık Adres Kartı -->
          <div class="p-6 bg-white border border-[#E5DFD5] rounded-xl apple-card space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#006039]">RESMİ ATÖLYE & MAĞAZA ADRESİ</span>
              <span class="text-[11px] text-[#86868B]">Buca / İZMİR</span>
            </div>
            <div class="text-[18px] sm:text-[20px] font-semibold text-[#1D1D1F] leading-snug">
              Adatepe, Özbekistan Cd. no:10/f, 35000 Buca/İzmir
            </div>
            <p class="text-[13px] text-[#6E675F] font-light leading-relaxed">
              Özbekistan Caddesi üzerinde, merkezi ve araçla kolayca yanaşabileceğiniz geniş otopark alanına sahip bağımsız atölye binamızda hizmet veriyoruz.
            </p>
          </div>

          <!-- Ulaşım Seçenekleri (2 Sütunlu Rehber) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Özel Araç İle -->
            <div class="p-5 bg-white border border-[#E5DFD5] rounded-xl space-y-2.5">
              <div class="flex items-center gap-2 text-[#006039] font-bold text-xs uppercase tracking-wider">
                <span>🚗</span> <span>Özel Araç İle Geliş</span>
              </div>
              <p class="text-[12.5px] text-[#6E675F] font-normal leading-relaxed">
                İzmir Çevre Yolu Buca çıkışından sonra Heykel / Adatepe yönüne doğru yaklaşık 6-8 dakikalık sürüş mesafesindedir. Atölyemizin önünde müşterilerimize özel rahat araç park alanı mevcuttur.
              </p>
            </div>

            <!-- Toplu Taşıma İle -->
            <div class="p-5 bg-white border border-[#E5DFD5] rounded-xl space-y-2.5">
              <div class="flex items-center gap-2 text-[#006039] font-bold text-xs uppercase tracking-wider">
                <span>🚌</span> <span>Toplu Taşıma İle Geliş</span>
              </div>
              <p class="text-[12.5px] text-[#6E675F] font-normal leading-relaxed">
                Şirinyer İZBAN istasyonundan kalkan Buca Adatepe dolmuşları ve ESHOT otobüs hatları ile Özbekistan Caddesi durağında inerek 1 dakika yürüme mesafesinde kolayca ulaşabilirsiniz.
              </p>
            </div>

          </div>

          <!-- Canlı Yol Tarifi Butonları Grubu -->
          <div class="p-5 bg-[#F4F1EA] border border-[#E5DFD5] rounded-xl flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-0.5 text-center sm:text-left">
              <div class="text-[14px] font-bold text-[#1D1D1F]">Canlı Navigasyon Başlatın</div>
              <div class="text-[12px] text-[#6E675F]">Telefonunuzdaki harita uygulamasıyla tek tıkla kapımıza kadar gelin.</div>
            </div>
            <div class="flex items-center gap-2.5 shrink-0">
              <a 
                href={googleMapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-5 py-2.5 bg-[#006039] hover:bg-[#00482B] text-white text-xs font-semibold rounded-full shadow-2xs transition"
              >
                Google Maps Yol Tarifi
              </a>
            </div>
          </div>

        </div>

        <!-- Sağ: Harita & Görsel Bilgi Modülü (5 Kolon) -->
        <div class="lg:col-span-5 bg-white border border-[#E5DFD5] rounded-xl overflow-hidden apple-card flex flex-col justify-between">
          
          <div class="p-6 border-b border-[#E5DFD5] space-y-2 bg-[#FAF9F6]">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#C5A880] block">ATÖLYE ÇALIŞMA SAATLERİ</span>
            <div class="space-y-1.5 text-xs text-[#1D1D1F] font-medium">
              <div class="flex items-center justify-between py-1 border-b border-[#E5DFD5]">
                <span>Pazartesi – Cuma</span>
                <span class="font-bold">09:00 – 19:30</span>
              </div>
              <div class="flex items-center justify-between py-1 border-b border-[#E5DFD5]">
                <span>Cumartesi</span>
                <span class="font-bold">09:30 – 18:30</span>
              </div>
              <div class="flex items-center justify-between py-1">
                <span>Pazar</span>
                <span class="text-[#C5A880] font-semibold">Randevulu Özel Keşif</span>
              </div>
            </div>
          </div>

          <!-- Konum Görsel / Tıklanabilir Harita Çerçevesi -->
          <div class="relative p-6 text-center space-y-4">
            <div class="w-16 h-16 rounded-full bg-[#F4F1EA] border border-[#D2D2D7] flex items-center justify-center text-2xl text-[#006039] mx-auto shadow-2xs">
              📍
            </div>
            <div class="space-y-1">
              <h4 class="text-[16px] font-bold text-[#1D1D1F]">Yeşilay Mutfak</h4>
              <p class="text-[12.5px] text-[#6E675F]">Adatepe, Özbekistan Cd. no:10/f Buca/İzmir</p>
            </div>
            <div class="pt-2">
              <a 
                href={googleMapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-block w-full py-3 px-4 bg-white hover:bg-[#F5F5F7] text-[#1D1D1F] border border-[#006039] font-semibold text-xs tracking-tight rounded-full transition shadow-2xs"
              >
                Haritada Canlı Konumu Görüntüle →
              </a>
            </div>
          </div>

          <div class="p-4 bg-[#F4F1EA] border-t border-[#E5DFD5] text-center text-[11.5px] text-[#6E675F]">
            Randevulu keşif için öncesinde WhatsApp ile iletişime geçmeniz önerilir.
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. HIZLI İLETİŞİM ÇAĞRISI                                            -->
  <!-- ===================================================================== -->
  <section class="py-20 bg-white border-b border-[#E5DFD5] text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-8 space-y-6">
      <span class="text-[12px] uppercase font-semibold tracking-[0.14em] text-[#C5A880] block">HEMEN BAŞLAYALIM</span>
      <h2 class="text-[32px] sm:text-[42px] font-bold text-[#1D1D1F] tracking-tight leading-[1.15]">
        Mimarımız Adresinize Gelsin, Ücretsiz Rölöve Alsın
      </h2>
      <p class="text-[15px] text-[#6E675F] font-normal leading-relaxed max-w-xl mx-auto">
        İzmir içi tüm ilçelerde evinizi yerinde inceliyor, hayalinizdeki mutfak ve banyo için fotogerçekçi 3D mimari simülasyon hazırlıyoruz.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a 
          href="https://wa.me/905324261788" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-9 py-3.5 bg-[#006039] hover:bg-[#00482B] text-white font-semibold text-[13px] tracking-tight rounded-full shadow-[0_4px_14px_rgba(0, 96, 57,0.3)] transition"
        >
          WhatsApp ile Keşif İste →
        </a>
        <a 
          href="tel:02324411060" 
          class="w-full sm:w-auto px-9 py-3.5 bg-white text-[#1D1D1F] border border-[#D2D2D7] hover:bg-[#F5F5F7] font-semibold text-[13px] tracking-tight rounded-full shadow-2xs transition"
        >
          0232 441 10 60
        </a>
      </div>
    </div>
  </section>

</Layout>
