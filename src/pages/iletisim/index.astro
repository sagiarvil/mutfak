---
import Layout from "../../layouts/Layout.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import { siteConfig } from "../../data/siteConfig";
import { buildWhatsAppUrl, buildTelUrl } from "../../utils/whatsapp";

const seo = {
  title: "İletişim & Ücretsiz Keşif Talebi | İzmir Mutfak Banyo",
  description: "İzmir mutfak dolabı ve tadilat işleriniz için hemen arayın veya WhatsApp'tan mesaj atın. Telefon: 0539 333 33 03. Google Haritalar konumu ve iletişim bilgileri.",
  canonical: "https://izmirmutfakbanyo.com.tr/iletisim/",
  serviceName: "Keşif ve İletişim",
  breadcrumbs: [
    { name: "İletişim", url: "/iletisim/" }
  ]
};
---

<Layout seo={seo} activeService="İletişim">
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Ana Sayfa</a>
        <span class="sep">/</span>
        <span class="current">İletişim</span>
      </nav>
      <h1 class="page-title">İletişim & Ücretsiz Keşif Randevusu</h1>
      <p class="page-lead">İzmir mutfak dolabı ve tadilat işleriniz için hemen arayın veya WhatsApp'tan mesaj atın. Telefon: 0539 333 33 03. Google Haritalar konumu ve iletişim bilgileri.</p>
      <div class="page-actions">
        <a href={buildWhatsAppUrl({ service: "İletişim" })} target="_blank" rel="noopener noreferrer" class="btn-wa">
          💬 WhatsApp ile Keşif İste
        </a>
        <a href={buildTelUrl()} class="btn-call">
          📞 ${siteConfig.phoneFormatted}
        </a>
      </div>
    </div>
  </div>

  <section class="page-content-section">
    <div class="container content-container">
      <div class="main-article prose">
        
      <h2>Bizimle İletişime Geçin</h2>
      <p>Tadilat projeniz hakkında aklınıza takılan her soruyu yanıtlamaktan mutluluk duyarız. Mimarımız ve ustamızla doğrudan görüşmek için aşağıdaki kanalları kullanabilirsiniz.</p>
      
      <div class="contact-info-box">
        <p>📞 <strong>Telefon:</strong> <a href="tel:+905393333303">0539 333 33 03</a></p>
        <p>💬 <strong>WhatsApp:</strong> <a href="https://wa.me/905393333303" target="_blank">0539 333 33 03</a></p>
        <p>📍 <strong>Hizmet Alanı:</strong> Tüm İzmir İlçeleri (Karşıyaka, Bornova, Çiğli, Konak, Urla, Çeşme vb.)</p>
        <p>🗺️ <strong>Google Harita:</strong> <a href="https://share.google/p94hYPiU7cDUM7Va1" target="_blank">Haritada Yol Tarifi Al</a></p>
        <p>⏰ <strong>Çalışma Saatleri:</strong> Pazartesi - Cumartesi: 08:30 - 19:30</p>
      </div>
    
      </div>

      <aside class="sidebar">
        <div class="sidebar-box">
          <h3>Hızlı Fiyat & Keşif</h3>
          <p>İzmir içi adresinize gelerek ölçü alıyor ve 3D çizim hazırlıyoruz.</p>
          <a href={buildWhatsAppUrl({ service: "İletişim" })} target="_blank" rel="noopener noreferrer" class="btn-sidebar-wa">
            WhatsApp Keşif Hattı
          </a>
        </div>

        <div class="sidebar-box">
          <h3>Diğer Hizmetlerimiz</h3>
          <ul class="sidebar-links">
            <li><a href="/mutfak-dolabi/">Mutfak Dolabı</a></li>
            <li><a href="/mutfak-tadilati/">Mutfak Tadilatı</a></li>
            <li><a href="/banyo-tadilati/">Banyo Tadilatı</a></li>
            <li><a href="/ev-tadilati/">Komple Ev Tadilatı</a></li>
            <li><a href="/mutfak-dolabi-fiyatlari/">Fiyat Rehberi</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <WhatsAppCTA 
    title="İletişim İçin Fiyat ve Keşif Talebi Oluşturun"
    subtitle="İzmir'in tüm ilçelerine 1 iş günü içinde ücretsiz keşif randevusu veriyoruz."
    service="İletişim"
  />
</Layout>

<style>
  .page-header {
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0 3rem;
  }
  .breadcrumb-nav {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .breadcrumb-nav a {
    color: #38bdf8;
    text-decoration: none;
  }
  .sep {
    opacity: 0.5;
  }
  .current {
    color: #e2e8f0;
  }
  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
  }
  .page-lead {
    font-size: 1.1rem;
    color: #cbd5e1;
    max-width: 800px;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }
  .page-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn-wa {
    background: #25d366;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  }
  .btn-call {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .page-content-section {
    padding: 3.5rem 0;
  }
  .content-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
  }
  .main-article {
    line-height: 1.75;
    color: #334155;
    font-size: 1.05rem;
  }
  .main-article :global(h2) {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    margin: 2rem 0 1rem;
  }
  .main-article :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin: 1.5rem 0 0.75rem;
  }
  .main-article :global(p) {
    margin-bottom: 1.25rem;
  }
  .main-article :global(ul), .main-article :global(ol) {
    margin: 0 0 1.5rem 1.5rem;
  }
  .main-article :global(li) {
    margin-bottom: 0.5rem;
  }
  .main-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .main-article :global(th), .main-article :global(td) {
    border: 1px solid #cbd5e1;
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .main-article :global(th) {
    background: #f1f5f9;
    font-weight: 700;
  }
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
  }
  .sidebar-box h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: #0f172a;
  }
  .sidebar-box p {
    font-size: 0.9rem;
    color: #64748b;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .btn-sidebar-wa {
    display: block;
    background: #25d366;
    color: #ffffff;
    text-align: center;
    padding: 0.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    margin-bottom: 0.5rem;
  }
  .sidebar-links a {
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .sidebar-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 850px) {
    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .page-title {
      font-size: 1.75rem;
    }
  }
</style>