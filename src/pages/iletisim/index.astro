---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İletişim & Ücretsiz Keşif Randevusu | İzmir Mutfak Banyo | 1984'ten Bugüne",
  description: "İzmir mutfak dolabı ve komple ev tadilatı keşif randevusu için bize ulaşın. Buca Showroom & İmalat Mağazası, telefon: 0539 333 33 03. Tüm İzmir ilçelerine ücretsiz mimari keşif.",
  canonical: "https://izmirmutfakbanyo.com.tr/iletisim/",
  serviceName: "Keşif ve İletişim",
  breadcrumbs: [
    { name: "İletişim", url: "/iletisim/" }
  ]
};
---

<Layout seo={seo} activeService="İletişim">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1800&q=75&fm=webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">İletişim</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1984'TEN BUGÜNE 42 YILLIK TECRÜBE • BUCA MERKEZ SHOWROOM
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İletişim &amp; Ücretsiz Keşif Randevusu, <br /><span class="font-normal italic">Mimarımızla Doğrudan Görüşün</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        Tadilat projeniz hakkında danışmak, malzeme numunelerini yerinde incelemek ve eviniz için 3D sanal canlandırma simülasyonu talep etmek için Buca showroomumuza bekliyoruz veya doğrudan arayabilirsiniz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20ücretsiz%20keşif%20randevusu%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Keşif İste</span>
        </a>
        <a href="tel:05393333303" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0539 333 33 03
        </a>
      </div>
    </div>
  </section>

  <!-- İLETİŞİM VE ADRES BİLGİLERİ -->
  <section class="py-20 sm:py-24 bg-white border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <!-- Sol: İletişim Detayları -->
        <div class="space-y-8">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">DOĞRUDAN ULAŞIM</span>
            <h2 class="text-3xl font-light text-stone-950 tracking-tight font-editorial">Buca Mağazamız &amp; Keşif Hattı</h2>
            <div class="w-12 h-0.5 bg-stone-900"></div>
            <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
              İzmir Buca merkez mağaza ve showroomumuzda malzeme kartelalarını, gövde kesitlerini ve Blum aksamları canlı inceleyebilirsiniz.
            </p>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-4 p-5 bg-stone-50 border border-stone-200">
              <span class="text-2xl text-emerald-600">📞</span>
              <div>
                <h3 class="font-bold text-stone-900 text-xs uppercase tracking-wider">Telefon Hattı</h3>
                <p class="text-sm font-semibold text-stone-800"><a href="tel:05393333303" class="hover:text-emerald-700">0539 333 33 03</a></p>
                <p class="text-xs text-stone-500 font-light">Pazartesi - Cumartesi: 08:30 - 19:30</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-stone-50 border border-stone-200">
              <span class="text-2xl text-emerald-600">💬</span>
              <div>
                <h3 class="font-bold text-stone-900 text-xs uppercase tracking-wider">WhatsApp Mimari Destek</h3>
                <p class="text-sm font-semibold text-stone-800"><a href="https://wa.me/905393333303" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-700">0539 333 33 03</a></p>
                <p class="text-xs text-stone-500 font-light">Fotoğraf veya rölöve göndererek anlık ön fiyat teklifi alabilirsiniz.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-5 bg-stone-50 border border-stone-200">
              <span class="text-2xl text-emerald-600">📍</span>
              <div>
                <h3 class="font-bold text-stone-900 text-xs uppercase tracking-wider">Showroom &amp; İmalat Atölyesi</h3>
                <p class="text-sm font-semibold text-stone-800">Buca Showroom &amp; İmalat Mağazası, Buca / İZMİR</p>
                <p class="text-xs text-stone-500 font-light">Hizmet Alanı: Tüm 30 İzmir İlçesi (Konak, Karşıyaka, Bornova, Urla, Çeşme vb.)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Sağ: Hızlı Keşif Formu / İletişim Kutusu -->
        <div class="bg-stone-900 text-white p-8 sm:p-10 space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 block">HIZLI KEŞİF TALEBİ</span>
            <h3 class="text-2xl font-light font-editorial">Mimarımız Adresinize Gelsin</h3>
            <p class="text-xs text-stone-300 font-light leading-relaxed">
              WhatsApp üzerinden adres ve oda fotoğraflarınızı ilettiğinizde, kadrolu mimarımız aynı gün içerisinde randevunuzu planlar ve evinize gelerek rölöve alır.
            </p>
            <div class="space-y-3 pt-4 border-t border-stone-800 text-xs text-stone-300">
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Ücretsiz lazerli milimetrik rölöve</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Fotogerçekçi 3D sanal canlandırma simülasyonu</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Kalem kalem malzeme şartnameli sabit fiyat teklifi</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>1984'ten gelen resmi sözleşme güvencesi</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <a href="https://wa.me/905393333303?text=Merhaba,%20ücretsiz%20keşif%20randevusu%20almak%20istiyorum." target="_blank" rel="noopener noreferrer" class="w-full py-4 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg text-center block">
              💬 WhatsApp ile Hemen Keşif İste
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
