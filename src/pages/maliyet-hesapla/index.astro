          if (currentTotal > targetTRY && state.subOptions.kitchenIsland) {
            state.subOptions.kitchenIsland = false;
            document.getElementById('opt_kitchenIsland').checked = false;
            changes.push('Mutfak ada modülü standart L/U düzene çevrildi');
            currentTotal = calculateEstimate().grandTotalTRY;
          }
          if (currentTotal > targetTRY && state.items.architecture) {
            state.subOptions.archService = '3d_only';
            document.getElementById('archServiceOption').value = '3d_only';
            changes.push('Mimari paket "Sadece 3D Tasarım & Proje" olarak optimize edildi');
            currentTotal = calculateEstimate().grandTotalTRY;
          }
          if (currentTotal > targetTRY && state.items.hvac) {
            state.items.hvac = false;
            changes.push('Klima/kombi cihaz yenilemesi mevcut sistem korunarak hariç tutuldu');
            currentTotal = calculateEstimate().grandTotalTRY;
          }
          if (currentTotal > targetTRY && state.tier === 'standard') {
            state.tier = 'economic';
            document.querySelectorAll('input[name="qualityTier"]').forEach(r => { r.checked = (r.value === 'economic'); });
            changes.push('Malzeme grubu "İskandinav Pratik (0.72x)" yerli koleksiyona çekildi');
            currentTotal = calculateEstimate().grandTotalTRY;
          }
        } else {
          // User has extra budget headroom! Upgrade smartly
          if (state.tier === 'economic') {
            state.tier = 'standard';
            document.querySelectorAll('input[name="qualityTier"]').forEach(r => { r.checked = (r.value === 'standard'); });
            changes.push('Bütçe uygunluğu sayesinde malzeme sınıfı "Modern Konfor" segmentine yükseltildi');
          }
          if (!state.items.architecture) {
            state.items.architecture = true;
            changes.push('3D İç Mimari Tasarım ve Şantiye Kontrolü bütçeye dahil edildi');
          }
        }

        syncItemCheckboxes();
        render();
        updateContractDraft();

        const afterCalc = calculateEstimate();
        const diff = initialTotal - afterCalc.grandTotalTRY;
        const box = document.getElementById('aiOptimizerResultBox');
        const savedBadge = document.getElementById('aiOptSavedBadge');
        const details = document.getElementById('aiOptDetails');

        if (box) {
          box.classList.remove('hidden');
          savedBadge.textContent = diff >= 0 ? `Tasarruf: ${formatMoney(diff)}` : `Kalite Artışı: +${formatMoney(Math.abs(diff))}`;
          details.textContent = (changes.length > 0 ? changes.join(' • ') : 'Mevcut konfigürasyonunuz hedef bütçenizle zaten ideal uyumda.') +
            ` (Su ve elektrik altyapı güvenliği %100 korundu. Yeni Bütçe: ${formatMoney(afterCalc.grandTotalTRY)})`;
        }
        showToast('AI Bütçe Optimizasyonu uygulandı!');
      });

