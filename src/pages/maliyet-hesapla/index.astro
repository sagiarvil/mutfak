---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloating from "../../components/WhatsAppFloating.astro";

const pageSeo = {
  title: "2026 Mutfak, Banyo ve Komple Ev Tadilatı Maliyet Hesaplama | İzmir Mutfak Banyo",
  description: "İzmir mutfak dolabı, lüks banyo yenileme ve komple daire tadilatı maliyetlerini canlı hesaplayın. 2026 güncel malzeme, işçilik ve anahtar teslim atölye fiyatları.",
  canonical: "https://izmirmutfakbanyo.com.tr/maliyet-hesapla/",
  ogType: "website"
};
---

<Layout seo={pageSeo}>
  <Header />

  <main class="bg-[#F8FAFC] text-slate-800 min-h-screen py-10 sm:py-14">
    <!-- ÜST BAŞLIK ALANI -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs font-semibold tracking-wide uppercase mb-3">
        <span>⚡ 2026 İZMİR GÜNCEL ATÖLYE FİYATLARI</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-serif">
        Tadilat & Mobilya Maliyet Hesaplama
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        İzmir'de mutfak dolabı, lüks banyo renovasyonu veya komple daire tadilatınız için malzeme, işçilik ve tesisat kalemlerini seçin; yaklaşık bütçenizi anında kuruşu kuruşuna görün.
      </p>

      <!-- 3 ANA SEKME (TABS) -->
      <div class="mt-8 flex flex-wrap justify-center gap-2 sm:gap-4 p-1.5 bg-slate-200/80 rounded-2xl max-w-2xl mx-auto border border-slate-300">
        <button 
          type="button" 
          id="tabBtnMutfak" 
          class="calc-tab-btn flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 shadow-sm bg-white text-slate-900 flex items-center justify-center gap-2"
          data-target="panelMutfak"
        >
          <span class="text-base">🍳</span> Mutfak Tadilatı
        </button>
        <button 
          type="button" 
          id="tabBtnBanyo" 
          class="calc-tab-btn flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900 flex items-center justify-center gap-2"
          data-target="panelBanyo"
        >
          <span class="text-base">🛁</span> Banyo Yenileme
        </button>
        <button 
          type="button" 
          id="tabBtnKomple" 
          class="calc-tab-btn flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900 flex items-center justify-center gap-2"
          data-target="panelKomple"
        >
          <span class="text-base">🏠</span> Komple Ev Tadilatı
        </button>
      </div>
    </div>

    <!-- HESAPLAMA ALANLARI KONTEYNERİ -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- ============================================================== -->
      <!-- SEKME 1: MUTFAK TADİLATI HESAPLAMA                              -->
      <!-- ============================================================== -->
      <div id="panelMutfak" class="calc-panel block">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- SOL: GİRDİLER (8 KOLON) -->
          <div class="lg:col-span-8 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
            
            <!-- 1. Mutfak Alanı Slider -->
            <div class="space-y-3 pb-5 border-b border-slate-100">
              <div class="flex justify-between items-center">
                <label class="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>📐</span> Mutfak Taban Alanı:
                </label>
                <div class="flex items-center gap-2">
                  <input type="number" id="m_alan_input" min="5" max="40" value="12" class="w-16 px-2 py-1 border border-slate-300 rounded-lg text-center font-bold text-sky-600 text-sm focus:outline-sky-500" />
                  <span class="text-xs font-semibold text-slate-500">m²</span>
                </div>
              </div>
              <input type="range" id="m_alan_slider" min="5" max="40" value="12" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-sky-600" />
              <div class="flex justify-between text-[11px] text-slate-600 font-medium">
                <span>5 m² (Küçük)</span>
                <span>12 m² (Standart)</span>
                <span>20 m² (Geniş Ada)</span>
                <span>40 m² (Lüks Villa)</span>
              </div>
            </div>

            <!-- 2. Bina Yaşı / Altyapı Çarpanı -->
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Bina Yaşı (Tesisat Riski)</label>
              <div class="grid grid-cols-3 gap-2.5">
                <button type="button" class="opt-btn active p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_bina" data-val="yeni">
                  0 - 10 Yıl <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Yeni / Standart</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_bina" data-val="orta">
                  11 - 20 Yıl <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Orta Yaş (+%20)</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_bina" data-val="eski">
                  20+ Yıl <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Eski Yapı (+%30)</span>
                </button>
              </div>
            </div>

            <!-- 3. Mutfak Dolabı Malzemesi -->
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Mutfak Dolabı Malzemesi & Kapak</label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <button type="button" class="opt-btn p-3 rounded-xl border text-left text-xs font-bold transition" data-group="m_dolap" data-val="mdf">
                  MDF-Lam Kapak
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Ekonomik & Dayanıklı</span>
                </button>
                <button type="button" class="opt-btn active p-3 rounded-xl border text-left text-xs font-bold transition" data-group="m_dolap" data-val="akrilik">
                  Çizilmez Akrilik / Membran
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Yüksek Parlak / Mat Popüler</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-left text-xs font-bold transition" data-group="m_dolap" data-val="lake">
                  İpek Mat Lake / Masif Ahşap
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Kişiye Özel Lüks İmalat</span>
                </button>
              </div>
            </div>

            <!-- 4. Tezgah Seçimi -->
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Tezgah Tipi</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <button type="button" class="opt-btn p-2.5 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="laminat">
                  Laminat
                  <span class="block text-[10px] text-slate-600 font-normal">Ekonomik</span>
                </button>
                <button type="button" class="opt-btn p-2.5 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="granit">
                  Doğal Granit
                  <span class="block text-[10px] text-slate-600 font-normal">Klasik Taş</span>
                </button>
                <button type="button" class="opt-btn active p-2.5 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="kuvars">
                  Kuvars (Çimstone/Belenco)
                  <span class="block text-[10px] text-slate-600 font-normal">Çizilmez & Leke Tutmaz</span>
                </button>
                <button type="button" class="opt-btn p-2.5 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="porselen">
                  İtalyan Porselen
                  <span class="block text-[10px] text-slate-600 font-normal">Isıya %100 Dayanıklı</span>
                </button>
              </div>
            </div>

            <!-- 5. Diğer İnşaat & Tesisat Kalemleri -->
            <div class="space-y-3 pt-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Altyapı & İlave Uygulamalar</label>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <!-- Kırım Döküm -->
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Kırım & Moloz Tahliyesi</span>
                    <span class="text-[11px] text-slate-600">Eski dolap ve fayansların sökülmesi</span>
                  </div>
                  <input type="checkbox" id="m_chk_yikim" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <!-- Zemin Seramiği -->
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Zemin Granit / Seramik</span>
                    <span class="text-[11px] text-slate-600">60x120 rektifiyeli döşeme</span>
                  </div>
                  <input type="checkbox" id="m_chk_zemin" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <!-- Su Tesisatı -->
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Sıhhi Su Tesisatı Yenileme</span>
                    <span class="text-[11px] text-slate-600">Temiz su ve gider boruları</span>
                  </div>
                  <input type="checkbox" id="m_chk_su" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <!-- Elektrik Tesisatı -->
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Elektrik & Priz Hatları</span>
                    <span class="text-[11px] text-slate-600">Tezgah arası prizler ve sigorta</span>
                  </div>
                  <input type="checkbox" id="m_chk_elektrik" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <!-- Boya Badana -->
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Tavan & Duvar Boya Badana</span>
                    <span class="text-[11px] text-slate-600">Silinebilir su bazlı boya</span>
                  </div>
                  <input type="checkbox" id="m_chk_boya" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <!-- Spot & LED Aydınlatma -->
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Gizli LED & Spot Aydınlatma</span>
                    <span class="text-[11px] text-slate-600">Tezgah altı ve süpürgelik LED</span>
                  </div>
                  <input type="checkbox" id="m_chk_aydinlatma" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>
              </div>
            </div>

          </div>

          <!-- SAĞ: CANLI MALİYET KARTI (4 KOLON) -->
          <div class="lg:col-span-4 sticky top-24 space-y-4">
            <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-sky-950 text-white p-6 sm:p-7 rounded-2xl shadow-xl border border-slate-700">
              <div class="flex items-center justify-between pb-3 border-b border-slate-700/80">
                <span class="text-xs uppercase tracking-widest text-sky-400 font-bold">MUTFAK TAHMİNİ BÜTÇE</span>
                <span class="text-[11px] px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-mono">2026</span>
              </div>

              <!-- Ana Tutar -->
              <div class="my-5 text-center">
                <span class="text-[11px] text-slate-400 block mb-1">Tahmini Yaklaşık Maliyet Aralığı</span>
                <div class="text-2xl sm:text-3xl font-black text-white tracking-tight" id="m_total_display">
                  ₺ 125.000 – ₺ 185.000
                </div>
                <span class="text-[11px] text-emerald-400 block mt-1.5 font-medium">✓ Malzeme + İmalat + Montaj Dahil</span>
              </div>

              <!-- Kalem Kalem Kırılım -->
              <div class="space-y-2 py-3 border-t border-b border-slate-700/80 text-xs" id="m_breakdown_list">
                <!-- JS dinamik dolduracak -->
              </div>

              <!-- Butonlar -->
              <div class="mt-5 space-y-2.5">
                <a 
                  id="m_btn_whatsapp" 
                  href="#" 
                  target="_blank" 
                  class="w-full py-3 px-4 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold rounded-xl text-center block text-xs tracking-wider uppercase transition shadow-lg shadow-emerald-500/20"
                >
                  💬 Bu Hesaplamayla Teklif İste
                </a>
                <a 
                  href="tel:02324411060" 
                  class="w-full py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-xl text-center block text-xs transition border border-slate-700"
                >
                  📞 0232 441 1060 - Bizi Arayın
                </a>
              </div>
              <p class="text-[10px] text-slate-400 text-center mt-3">
                * Kesin maliyet yerinde 3D lazer rölöve ve seçilecek mekanizma detaylarına göre belirlenir.
              </p>
            </div>
          </div>

        </div>
      </div>


      <!-- ============================================================== -->
      <!-- SEKME 2: BANYO YENİLEME HESAPLAMA                               -->
      <!-- ============================================================== -->
      <div id="panelBanyo" class="calc-panel hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <div class="lg:col-span-8 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
            
            <!-- 1. Banyo Alanı -->
            <div class="space-y-3 pb-5 border-b border-slate-100">
              <div class="flex justify-between items-center">
                <label class="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>📐</span> Banyo Alanı:
                </label>
                <div class="flex items-center gap-2">
                  <input type="number" id="b_alan_input" min="3" max="25" value="6" class="w-16 px-2 py-1 border border-slate-300 rounded-lg text-center font-bold text-sky-600 text-sm focus:outline-sky-500" />
                  <span class="text-xs font-semibold text-slate-500">m²</span>
                </div>
              </div>
              <input type="range" id="b_alan_slider" min="3" max="25" value="6" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-sky-600" />
              <div class="flex justify-between text-[11px] text-slate-600 font-medium">
                <span>3 m² (Misafir Banyo)</span>
                <span>6 m² (Standart Ebeveyn)</span>
                <span>12 m² (Geniş Lüks)</span>
                <span>25 m² (Villa SPA)</span>
              </div>
            </div>

            <!-- 2. Bina Yaşı -->
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Bina Yaşı (Kırım & Su Tesisatı Riski)</label>
              <div class="grid grid-cols-3 gap-2.5">
                <button type="button" class="opt-btn active p-3 rounded-xl border text-center text-xs font-bold transition" data-group="b_bina" data-val="yeni">
                  0 - 10 Yıl <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Yeni Yapı</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="b_bina" data-val="orta">
                  11 - 20 Yıl <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Orta Yaş (+%20)</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="b_bina" data-val="eski">
                  20+ Yıl <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Eski Yapı (+%30)</span>
                </button>
              </div>
            </div>

            <!-- 3. Seramik & Fayans -->
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Seramik & Fayans Kalitesi</label>
              <div class="grid grid-cols-2 gap-2.5">
                <button type="button" class="opt-btn active p-3 rounded-xl border text-left text-xs font-bold transition" data-group="b_seramik" data-val="standart">
                  Standart 60x60 / 30x60 Seramik
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Kaliteli yerli üretim (Çanakkale/VitrA)</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-left text-xs font-bold transition" data-group="b_seramik" data-val="premium">
                  60x120 / 120x240 Porselen Granit
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Lüks derzsiz lazer kesim porselen</span>
                </button>
              </div>
            </div>

            <!-- 4. Vitrifiye & Duşakabin -->
            <div class="space-y-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Gömme Rezervuar & Klozet</label>
              <div class="grid grid-cols-2 gap-2.5">
                <button type="button" class="opt-btn active p-3 rounded-xl border text-left text-xs font-bold transition" data-group="b_klozet" data-val="standart">
                  Standart Takım Klozet
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Yerden bağlantılı kaliteli vitrifiye</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-left text-xs font-bold transition" data-group="b_klozet" data-val="asma">
                  Geberit / VitrA Gömme Rezervuar + Asma Klozet
                  <span class="block text-[10px] text-slate-600 font-normal mt-0.5">Duvar içi sessiz sistem & hijyenik</span>
                </button>
              </div>
            </div>

            <!-- 5. Banyo İlave Kalemleri -->
            <div class="space-y-3 pt-2">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Kapsam Seçenekleri</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Kırım & Hafriyat</span>
                    <span class="text-[11px] text-slate-600">Eski fayans ve küvetin sökümü</span>
                  </div>
                  <input type="checkbox" id="b_chk_yikim" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Çift Kat İzolasyon (Membran)</span>
                    <span class="text-[11px] text-slate-600">Alt kata su sızdırmazlık garantisi</span>
                  </div>
                  <input type="checkbox" id="b_chk_izolasyon" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Özel Banyo Dolabı & Ayna</span>
                    <span class="text-[11px] text-slate-600">Suya dayanıklı marin gövde lake</span>
                  </div>
                  <input type="checkbox" id="b_chk_dolap" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Duşakabin & Lineer Gider</span>
                    <span class="text-[11px] text-slate-600">Temperli cam + İtalyan duş kanalı</span>
                  </div>
                  <input type="checkbox" id="b_chk_dus" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Su & Gider Tesisatı</span>
                    <span class="text-[11px] text-slate-600">PPRC borulama ve test</span>
                  </div>
                  <input type="checkbox" id="b_chk_su" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>

                <div class="p-3 rounded-xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-slate-800 block">Havlupan & Havalandırma</span>
                    <span class="text-[11px] text-slate-600">Krom / Antrasit havlupan radyatör</span>
                  </div>
                  <input type="checkbox" id="b_chk_havlupan" class="w-5 h-5 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" checked />
                </div>
              </div>
            </div>

          </div>

          <!-- SAĞ KART -->
          <div class="lg:col-span-4 sticky top-24 space-y-4">
            <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-sky-950 text-white p-6 sm:p-7 rounded-2xl shadow-xl border border-slate-700">
              <div class="flex items-center justify-between pb-3 border-b border-slate-700/80">
                <span class="text-xs uppercase tracking-widest text-sky-400 font-bold">BANYO TAHMİNİ BÜTÇE</span>
                <span class="text-[11px] px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-mono">2026</span>
              </div>

              <div class="my-5 text-center">
                <span class="text-[11px] text-slate-400 block mb-1">Tahmini Yaklaşık Maliyet Aralığı</span>
                <div class="text-2xl sm:text-3xl font-black text-white tracking-tight" id="b_total_display">
                  ₺ 65.000 – ₺ 110.000
                </div>
                <span class="text-[11px] text-emerald-400 block mt-1.5 font-medium">✓ İzolasyon & İşçilik Garantili</span>
              </div>

