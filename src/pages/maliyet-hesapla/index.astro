<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // TAB KONTROLÜ
    const tabs = document.querySelectorAll(".calc-tab-btn");
    const panels = document.querySelectorAll(".calc-panel");

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const targetId = tab.dataset.target;
        tabs.forEach(t => {
          t.classList.remove("bg-white", "text-slate-900", "shadow-xs", "font-bold");
          t.classList.add("text-slate-600", "font-semibold");
        });
        tab.classList.add("bg-white", "text-slate-900", "shadow-xs", "font-bold");
        tab.classList.remove("text-slate-600", "font-semibold");

        panels.forEach(p => p.classList.add("hidden"));
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.remove("hidden");
      });
    });

    const fmt = (num) => "₺ " + Math.round(num).toLocaleString("tr-TR");

    // 1. MUTFAK
    const mState = {
      alan: 12,
      bina: "yeni",
      dolap: "akrilik",
      tezgah: "kuvars",
      yikim: true,
      zemin: true,
      su: true,
      elektrik: true,
      boya: true,
      aydinlatma: true
    };

    const mPrices = {
      binaMultiplier: { yeni: 1.0, orta: 1.15, eski: 1.25 },
      iscilikM2: { min: 1100, max: 1650 },
      dolap: {
        mdf: { min: 8500, max: 11000 },
        akrilik: { min: 12500, max: 16500 },
        lake: { min: 19500, max: 28500 }
      },
      tezgah: {
        laminat: { min: 1400, max: 2800 },
        granit: { min: 3800, max: 6500 },
        kuvars: { min: 8500, max: 13500 },
        porselen: { min: 14500, max: 22000 }
      },
      yikim: { min: 3000, max: 6000 },
      zeminM2: { min: 1400, max: 2400 },
      su: { min: 5500, max: 9500 },
      elektrik: { min: 4000, max: 7500 },
      boya: { min: 3500, max: 6000 },
      aydinlatma: { min: 2500, max: 4500 }
    };

    function calcMutfak() {
      const mult = mPrices.binaMultiplier[mState.bina];
      const m2 = mState.alan;
      const dolapMetre = Math.max(3, m2 * 0.38);

      let totalMin = 0;
      let totalMax = 0;
      const breakdown = [];

      const iscMin = mPrices.iscilikM2.min * m2 * mult;
      const iscMax = mPrices.iscilikM2.max * m2 * mult;
      totalMin += iscMin; totalMax += iscMax;
      breakdown.push({ name: "Usta & Şantiye İşçiliği", min: iscMin, max: iscMax });

      const dMin = mPrices.dolap[mState.dolap].min * dolapMetre;
      const dMax = mPrices.dolap[mState.dolap].max * dolapMetre;
      totalMin += dMin; totalMax += dMax;
      breakdown.push({ name: `Dolap (${dolapMetre.toFixed(1)} mtül)`, min: dMin, max: dMax });

      const tMin = mPrices.tezgah[mState.tezgah].min * (dolapMetre * 0.9);
      const tMax = mPrices.tezgah[mState.tezgah].max * (dolapMetre * 0.9);
      totalMin += tMin; totalMax += tMax;
      breakdown.push({ name: "Tezgah Seçimi", min: tMin, max: tMax });

      if (mState.yikim) {
        totalMin += mPrices.yikim.min * mult; totalMax += mPrices.yikim.max * mult;
        breakdown.push({ name: "Kırım & Moloz Tahliyesi", min: mPrices.yikim.min * mult, max: mPrices.yikim.max * mult });
      }
      if (mState.zemin) {
        totalMin += mPrices.zeminM2.min * m2; totalMax += mPrices.zeminM2.max * m2;
        breakdown.push({ name: "Zemin Seramik / Granit", min: mPrices.zeminM2.min * m2, max: mPrices.zeminM2.max * m2 });
      }
      if (mState.su) {
        totalMin += mPrices.su.min * mult; totalMax += mPrices.su.max * mult;
        breakdown.push({ name: "Sıhhi Tesisat", min: mPrices.su.min * mult, max: mPrices.su.max * mult });
      }
      if (mState.elektrik) {
        totalMin += mPrices.elektrik.min * mult; totalMax += mPrices.elektrik.max * mult;
        breakdown.push({ name: "Elektrik Altyapısı & Prizler", min: mPrices.elektrik.min * mult, max: mPrices.elektrik.max * mult });
      }
      if (mState.boya) {
        totalMin += mPrices.boya.min; totalMax += mPrices.boya.max;
        breakdown.push({ name: "Boya Badana", min: mPrices.boya.min, max: mPrices.boya.max });
      }
      if (mState.aydinlatma) {
        totalMin += mPrices.aydinlatma.min; totalMax += mPrices.aydinlatma.max;
        breakdown.push({ name: "Lineer LED Profil", min: mPrices.aydinlatma.min, max: mPrices.aydinlatma.max });
      }

      document.getElementById("m_total_display").textContent = `${fmt(totalMin)} – ${fmt(totalMax)}`;
      
      const listEl = document.getElementById("m_breakdown_list");
      listEl.innerHTML = breakdown.map(item => `
        <div class="flex justify-between items-center text-slate-300">
          <span class="text-slate-400 font-light truncate max-w-[200px]">${item.name}</span>
          <span class="font-mono text-white">${fmt(item.min)} – ${fmt(item.max)}</span>
        </div>
      `).join("");

      const msg = `Merhaba İzmir Mutfak Banyo,
Mutfak Tadilatı Maliyet Hesaplama sonucum:

` +
        `📐 Alan: ${mState.alan} m²
` +
        `🏢 Bina Yaşı: ${mState.bina}
` +
        `🚪 Dolap: ${mState.dolap.toUpperCase()}
` +
        `💎 Tezgah: ${mState.tezgah.toUpperCase()}
` +
        `🔨 Kırım/Yıkım: ${mState.yikim ? "Var" : "Yok"}
` +
        `🧱 Zemin: ${mState.zemin ? "Var" : "Yok"}
` +
        `💧 Su Tesisatı: ${mState.su ? "Var" : "Yok"}

` +
        `💰 Bütçe Aralığı: ${fmt(totalMin)} – ${fmt(totalMax)}

` +
        `Detaylı teklif ve yerinde rölöve keşfi rica ediyorum.`;
      
      document.getElementById("m_btn_whatsapp").href = `https://wa.me/905324261788?text=${encodeURIComponent(msg)}`;
    }

    const mSlider = document.getElementById("m_alan_slider");
    const mInput = document.getElementById("m_alan_input");
    mSlider.addEventListener("input", (e) => {
      mInput.value = e.target.value;
      mState.alan = Number(e.target.value);
      calcMutfak();
    });
    mInput.addEventListener("input", (e) => {
      const val = Math.max(5, Math.min(40, Number(e.target.value) || 5));
      mSlider.value = val;
      mState.alan = val;
      calcMutfak();
    });

    document.querySelectorAll('[data-group="m_bina"], [data-group="m_dolap"], [data-group="m_tezgah"]').forEach(btn => {
      btn.addEventListener("click", () => {
        const group = btn.dataset.group;
        const val = btn.dataset.val;
        document.querySelectorAll(`[data-group="${group}"]`).forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        if (group === "m_bina") mState.bina = val;
        if (group === "m_dolap") mState.dolap = val;
        if (group === "m_tezgah") mState.tezgah = val;
        calcMutfak();
      });
    });

    ["m_chk_yikim", "m_chk_zemin", "m_chk_su", "m_chk_elektrik", "m_chk_boya", "m_chk_aydinlatma"].forEach(id => {
      const chk = document.getElementById(id);
      chk.addEventListener("change", (e) => {
        const key = id.replace("m_chk_", "");
        mState[key] = e.target.checked;
        calcMutfak();
      });
    });


    // 2. BANYO
    const bState = {
      alan: 6,
      bina: "yeni",
      seramik: "standart",
      klozet: "standart",
      yikim: true,
      izolasyon: true,
      dolap: true,
      dus: true,
      su: true,
      havlupan: true
    };

    const bPrices = {
      binaMultiplier: { yeni: 1.0, orta: 1.15, eski: 1.25 },
      iscilikM2: { min: 2200, max: 3600 },
      seramik: {
        standart: { min: 2200, max: 3600 },
        premium: { min: 4200, max: 6800 }
      },
      klozet: {
        standart: { min: 4800, max: 8500 },
        asma: { min: 9500, max: 17500 }
      },
      yikim: { min: 3500, max: 6500 },
      izolasyon: { min: 3800, max: 6500 },
      dolap: { min: 7500, max: 16500 },
      dus: { min: 6800, max: 14500 },
      su: { min: 4800, max: 8500 },
      havlupan: { min: 2800, max: 5500 }
    };

    function calcBanyo() {
      const mult = bPrices.binaMultiplier[bState.bina];
      const m2 = bState.alan;
      let totalMin = 0; let totalMax = 0;
      const breakdown = [];

      const iscMin = bPrices.iscilikM2.min * m2 * mult;
      const iscMax = bPrices.iscilikM2.max * m2 * mult;
      totalMin += iscMin; totalMax += iscMax;
      breakdown.push({ name: "Banyo Seramik & İmalat İşçiliği", min: iscMin, max: iscMax });

      const serMin = bPrices.seramik[bState.seramik].min * (m2 * 2.8);
      const serMax = bPrices.seramik[bState.seramik].max * (m2 * 2.8);
      totalMin += serMin; totalMax += serMax;
      breakdown.push({ name: "Fayans / Porselen Malzeme", min: serMin, max: serMax });

      const klzMin = bPrices.klozet[bState.klozet].min;
      const klzMax = bPrices.klozet[bState.klozet].max;
      totalMin += klzMin; totalMax += klzMax;
      breakdown.push({ name: "Klozet & Rezervuar", min: klzMin, max: klzMax });

      if (bState.yikim) {
        totalMin += bPrices.yikim.min * mult; totalMax += bPrices.yikim.max * mult;
        breakdown.push({ name: "Kırım & Moloz", min: bPrices.yikim.min * mult, max: bPrices.yikim.max * mult });
      }
      if (bState.izolasyon) {
        totalMin += bPrices.izolasyon.min; totalMax += bPrices.izolasyon.max;
        breakdown.push({ name: "Çift Kat İzolasyon (Membran)", min: bPrices.izolasyon.min, max: bPrices.izolasyon.max });
      }
      if (bState.dolap) {
        totalMin += bPrices.dolap.min; totalMax += bPrices.dolap.max;
        breakdown.push({ name: "Marin Banyo Dolabı & Ayna", min: bPrices.dolap.min, max: bPrices.dolap.max });
      }
      if (bState.dus) {
        totalMin += bPrices.dus.min; totalMax += bPrices.dus.max;
        breakdown.push({ name: "Duşakabin & Duş Kanalı", min: bPrices.dus.min, max: bPrices.dus.max });
      }
      if (bState.su) {
        totalMin += bPrices.su.min * mult; totalMax += bPrices.su.max * mult;
        breakdown.push({ name: "Su & Gider Tesisatı", min: bPrices.su.min * mult, max: bPrices.su.max * mult });
      }
      if (bState.havlupan) {
        totalMin += bPrices.havlupan.min; totalMax += bPrices.havlupan.max;
        breakdown.push({ name: "Havlupan Radyatör", min: bPrices.havlupan.min, max: bPrices.havlupan.max });
