      };

      function getTextureForMaterial(type, c1, c2) {
        const key = `${type}_${c1}_${c2}`;
        if (threeCtx.texCache && threeCtx.texCache[key]) return threeCtx.texCache[key];
        if (!threeCtx.texCache) threeCtx.texCache = {};

        const c = document.createElement('canvas');
        c.width = 256;
        c.height = 256;
        const g = c.getContext('2d');
        g.fillStyle = c1;
        g.fillRect(0, 0, 256, 256);

        if (type === 'floor') {
          g.strokeStyle = c2;
          g.lineWidth = 2;
          for (let y = 0; y < 256; y += 32) {
            g.beginPath(); g.moveTo(0, y); g.lineTo(256, y); g.stroke();
            for (let x = (y % 64 === 0 ? 0 : 64); x < 256; x += 128) {
              g.beginPath(); g.moveTo(x, y); g.lineTo(x, y + 32); g.stroke();
            }
          }
        } else if (type === 'tile') {
          g.strokeStyle = c2;
          g.lineWidth = 2;
          for (let i = 0; i <= 256; i += 64) {
            g.beginPath(); g.moveTo(i, 0); g.lineTo(i, 256); g.stroke();
            g.beginPath(); g.moveTo(0, i); g.lineTo(256, i); g.stroke();
          }
        }

        const tex = new THREE.CanvasTexture(c);
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.RepeatWrapping;
        tex.repeat.set(3, 3);
        threeCtx.texCache[key] = tex;
        return tex;
      }

      function initThreeEngine(canvas) {
        if (typeof THREE === 'undefined') return false;
        if (threeCtx.renderer) return true;
        try {
          const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          renderer.shadowMap.enabled = true;
          renderer.shadowMap.type = THREE.PCFSoftShadowMap;
          renderer.outputEncoding = THREE.sRGBEncoding;

          const scene = new THREE.Scene();
          scene.background = new THREE.Color('#181A1E');

          const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / Math.max(1, canvas.clientHeight), 0.1, 100);
          const raycaster = new THREE.Raycaster();

          threeCtx.renderer = renderer;
          threeCtx.scene = scene;
          threeCtx.camera = camera;
          threeCtx.raycaster = raycaster;
          return true;
        } catch (err) {
          return false;
        }
      }

      function getSceneSignature(boxes) {
        return JSON.stringify({
          s: bimState.scene,
          r: bimState.renderMode,
          e: Math.round(bimState.explode * 100),
          kl: bimState.kitchenLayout,
          cd: bimState.cabinetDoor,
          ct: bimState.countertop,
          bs: bimState.bathroomSpec,
          wc: bimState.wallColorKey,
          ft: bimState.floorTypeKey,
          cc: bimState.cabinetColorKey,
          hw: state.hardwareFinish,
          ki: !!state.subOptions.kitchenIsland,
          ok: !!state.subOptions.openKitchen,
          fc: !!state.subOptions.falseCeiling,
          uf: !!state.subOptions.underfloorHeating,
          gb: !!state.subOptions.glassBalcony,
          cp: !!state.items.carpentry,
          dr: !!state.items.doors,
          len: boxes.length
        });
      }

      function rebuildThreeSceneGraph(boxes) {
        const scene = threeCtx.scene;
        while (scene.children.length > 0) {
          scene.remove(scene.children[0]);
        }
        threeCtx.meshMap.clear();

        // Clean Studio Architectural Lighting (Balanced Warm Daylight)
        const ambient = new THREE.AmbientLight(0xFFFDF9, 0.72);
        scene.add(ambient);

        const hemi = new THREE.HemisphereLight(0xFFFFFF, 0x3F3A32, 0.48);
        hemi.position.set(0, 8, 0);
        scene.add(hemi);

        const dirLight = new THREE.DirectionalLight(0xFFFBEB, 0.82);
        dirLight.position.set(6, 10, 7);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 1024;
        dirLight.shadow.mapSize.height = 1024;
        scene.add(dirLight);

        // Subtle Architectural Ground Grid
        const grid = new THREE.GridHelper(12, 24, 0xC5A059, 0x2A2D34);
        grid.position.y = -0.18;
        scene.add(grid);

        const floorPal = FLOOR_PALETTES[bimState.floorTypeKey] || FLOOR_PALETTES.oak;

        boxes.forEach(b => {
          const geom = new THREE.BoxGeometry(b.w, b.h, b.d);
          const group = new THREE.Group();
          group.position.set(b.x, b.y, b.z);

          let matOpts = {
            color: new THREE.Color(b.color || '#E5E7EB'),
            roughness: b.roughness !== undefined ? b.roughness : 0.4,
            metalness: b.metalness !== undefined ? b.metalness : 0.05
          };

          if (b.id === 'floor_slab' || b.id === 'apt_slab') {
            matOpts.map = getTextureForMaterial('floor', floorPal.hex, floorPal.grain);
          } else if (b.id === 'bath_floor' || b.id === 'bath_wall_back' || b.id === 'bath_wall_left') {
            matOpts.map = getTextureForMaterial('tile', b.color, '#9CA3AF');
          }

          if (b.emissive) {
            matOpts.emissive = new THREE.Color(b.emissive);
            matOpts.emissiveIntensity = b.emissiveIntensity || 0.4;
          }

          if (bimState.renderMode === 'wireframe') {
            matOpts.wireframe = true;
          } else if (bimState.renderMode === 'xray') {
            if (b.layer !== 'mep' && !b.isMembrane && !b.isPipe) {
              matOpts.transparent = true;
              matOpts.opacity = 0.22;
            }
          } else if (b.isGlass) {
            matOpts.transparent = true;
            matOpts.opacity = 0.35;
          } else if (b.isOuterWall) {
            matOpts.transparent = true;
            matOpts.opacity = 0.95;
          }

          const mat = new THREE.MeshStandardMaterial(matOpts);
          const mesh = new THREE.Mesh(geom, mat);
          mesh.castShadow = !b.isOuterWall && !b.isGlass;
          mesh.receiveShadow = true;
          mesh.userData = { partId: b.id, boxData: b };
          group.add(mesh);

          // Crisp architectural edge lines
          const edges = new THREE.EdgesGeometry(geom);
          const isSelected = (bimState.selectedPartId === b.id);
          const lineMat = new THREE.LineBasicMaterial({
            color: isSelected ? 0xC5A059 : 0x1F242D,
            transparent: true,
            opacity: isSelected ? 1.0 : 0.38
          });
          const lineSeg = new THREE.LineSegments(edges, lineMat);
          group.add(lineSeg);

          scene.add(group);
          threeCtx.meshMap.set(b.id, { group, mesh, lineSeg, boxData: b });
        });
      }

      // Smart 360° Wall Cutaway: any exterior wall between the camera and room center
      // smoothly fades out so the interior is 100% visible from every 360° angle!
      function updateSmartWallCutawayAndSelection() {
        const camPos = threeCtx.camera.position;
        const isInside = (bimState.cameraMode === 'inside360');

        threeCtx.meshMap.forEach((entry, id) => {
          const { mesh, lineSeg, boxData } = entry;
          const isSelected = (bimState.selectedPartId === id);
          const isHovered = (bimState.hoveredPartId === id);

          // Highlight selected / hovered part border in Yamashi Gold (#C5A059)
          if (lineSeg && lineSeg.material) {
            if (isSelected || isHovered) {
              lineSeg.material.color.setHex(0xC5A059);
              lineSeg.material.opacity = 1.0;
            } else {
              lineSeg.material.color.setHex(0x1F242D);
              lineSeg.material.opacity = 0.35;
            }
          }

          if (boxData.isOuterWall && mesh.material) {
            if (isInside) {
              // Inside room 360° mode: all 4 walls solid so user is surrounded by room
              mesh.material.opacity = (bimState.renderMode === 'xray') ? 0.25 : 0.98;
              if (lineSeg) lineSeg.visible = true;
            } else {
              // Orbit 360° cutaway mode: hide walls facing the camera
              let hideWall = false;
              if (boxData.wallSide === 'south' && camPos.z > 0.8) hideWall = true;
              if (boxData.wallSide === 'north' && camPos.z < -0.8) hideWall = true;
              if (boxData.wallSide === 'east'  && camPos.x > 0.8) hideWall = true;
              if (boxData.wallSide === 'west'  && camPos.x < -0.8) hideWall = true;

              mesh.material.opacity = hideWall ? 0.06 : ((bimState.renderMode === 'xray') ? 0.22 : 0.94);
              mesh.material.depthWrite = !hideWall;
              if (lineSeg) lineSeg.visible = !hideWall;
            }
          }
        });
      }

      function renderBim3DCanvas() {
        const canvas = document.getElementById('bim3dCanvas');
        if (!canvas) return;

        const boxes = buildBimSceneBoxes();
        threeCtx.boxList = boxes;

        if (initThreeEngine(canvas)) {
          const w = canvas.clientWidth || 760;
          const h = canvas.clientHeight || 390;
          if (canvas.width !== w || canvas.height !== h) {
            threeCtx.renderer.setSize(w, h, false);
            threeCtx.camera.aspect = w / Math.max(1, h);
            threeCtx.camera.updateProjectionMatrix();
          }

          const sig = getSceneSignature(boxes);
          if (sig !== threeCtx.lastSignature) {
            rebuildThreeSceneGraph(boxes);
            threeCtx.lastSignature = sig;
          }

          // Position Camera based on cameraMode
          if (bimState.cameraMode === 'inside360') {
            const eyeY = 1.48;
            threeCtx.camera.fov = Math.max(48, Math.min(82, 68 / bimState.zoom));
            threeCtx.camera.updateProjectionMatrix();
            threeCtx.camera.position.set(0, eyeY, 0.25);
            const lookDist = 4.0;
            const targetX = Math.sin(bimState.yaw) * Math.cos(bimState.pitch) * lookDist;
            const targetY = eyeY + Math.sin(bimState.pitch) * lookDist;
            const targetZ = 0.25 - Math.cos(bimState.yaw) * Math.cos(bimState.pitch) * lookDist;
            threeCtx.camera.lookAt(targetX, targetY, targetZ);
          } else {
            threeCtx.camera.fov = 42;
            threeCtx.camera.updateProjectionMatrix();
            const baseDist = bimState.scene === 'apartment' ? 9.2 : (bimState.scene === 'bathroom' ? 5.6 : 6.8);
            const dist = baseDist / Math.max(0.65, Math.min(1.65, bimState.zoom));
            const pitchClamped = Math.max(0.12, Math.min(1.38, bimState.pitch));
            const camX = Math.sin(bimState.yaw) * Math.cos(pitchClamped) * dist;
            const camY = Math.sin(pitchClamped) * dist + 0.6;
            const camZ = Math.cos(bimState.yaw) * Math.cos(pitchClamped) * dist;
            threeCtx.camera.position.set(camX, camY, camZ);
            threeCtx.camera.lookAt(0, 0.75, -0.15);
          }

          updateSmartWallCutawayAndSelection();
          threeCtx.renderer.render(threeCtx.scene, threeCtx.camera);
        }

        // Keep selected part inspector updated
        const activeBox = boxes.find(b => b.id === bimState.selectedPartId) || boxes[0];
        if (activeBox) {
          const pozEl = document.getElementById('bimPartPozCode');
          const titleEl = document.getElementById('bimPartTitle');
          const specEl = document.getElementById('bimPartSpec');
          const costEl = document.getElementById('bimPartCostBadge');
          if (pozEl) pozEl.textContent = activeBox.poz;
          if (titleEl) titleEl.textContent = activeBox.title;
          if (specEl) specEl.textContent = activeBox.spec;
          if (costEl) costEl.textContent = activeBox.cost > 0 ? formatMoney(activeBox.cost) : 'Standart Dahil';
        }
      }

      function getCompassHeadingText(yawRad) {
        let deg = Math.round(((yawRad * 180) / Math.PI) % 360);
        if (deg < 0) deg += 360;
        let wallLabel = 'Kuzey Cephe';
        if (deg >= 45 && deg < 135) wallLabel = 'Doğu Cephe';
        else if (deg >= 135 && deg < 225) wallLabel = 'Güney Cephe';
        else if (deg >= 225 && deg < 315) wallLabel = 'Batı Cephe';
        return { deg, wallLabel };
      }

      function updateBimStudioMetrics() {
        syncQuick360CockpitUI();
        const calc = calculateEstimate();
        const distInfo = IZMIR_DISTRICTS[bimState.izmirDistrict] || IZMIR_DISTRICTS.karsiyaka;

        const leadBadge = document.getElementById('bimLeadTimeBadge');
        if (leadBadge) leadBadge.textContent = `Teslim: ${distInfo.lead}`;

        const sceneTitles = {
          kitchen: 'SAHNE: 3D MUTFAK İMALATI (360° CANLI)',
          bathroom: 'SAHNE: 3D BANYO & İZOLASYON (360° CANLI)',
          apartment: 'SAHNE: 3D KOMPLE DAİRE BIM (360° CANLI)'
        };
        const hudTitle = document.getElementById('bimHudSceneTitle');
        if (hudTitle) hudTitle.textContent = sceneTitles[bimState.scene] || sceneTitles.kitchen;

        const hudDim = document.getElementById('bimHudDimensions');
        if (hudDim) {
          hudDim.textContent = `${state.area} m² • Mutfak: ${state.kitchenLength} mtül • Banyo: ${state.bathroomCount} Adet`;
        }

        const heading = getCompassHeadingText(bimState.yaw);
        const hudCam = document.getElementById('bimHudCameraInfo');
        if (hudCam) {
          hudCam.textContent = `360° AÇI: ${heading.deg}° (${heading.wallLabel})`;
        }

        // Calculate İzmir Atölye Direct Range (Başlangıç vs Lüks Sınır)
        let baseEstimate = calc.grandTotalTRY;
        if (bimState.scene === 'kitchen') {
          const kItem = calc.lineItems.find(li => li.id === 'kitchen');
          const doorInfo = DOOR_FINISH_PALETTES[bimState.cabinetDoor] || DOOR_FINISH_PALETTES.lak_silk;
          baseEstimate = (kItem ? kItem.totalTRY : (state.kitchenLength * doorInfo.rate)) + (state.subOptions.kitchenIsland ? 42000 : 0);
        } else if (bimState.scene === 'bathroom') {
          const bItem = calc.lineItems.find(li => li.id === 'bathroom');
          baseEstimate = bItem ? bItem.totalTRY : (state.bathroomCount * 95000);
        }

        const lowRange = baseEstimate * 0.88;
        const highRange = baseEstimate * 1.18;
        const directSaving = baseEstimate * 0.30;

        const lowEl = document.getElementById('bimRangeLowText');
        const highEl = document.getElementById('bimRangeHighText');
        const savEl = document.getElementById('bimDirectSavingText');
        if (lowEl) lowEl.textContent = formatMoney(lowRange);
        if (highEl) highEl.textContent = formatMoney(highRange);
        if (savEl) savEl.textContent = `Atölye Avantajı: ~${formatMoney(directSaving)}`;

        renderBim3DCanvas();
      }

      // =========================================================================
      // INTERACTIVE 3D CANVAS EVENTS (DRAG TO ROTATE 360°, WHEEL ZOOM, CLICK PICK)
      // =========================================================================
      const bimCanvasEl = document.getElementById('bim3dCanvas');
      if (bimCanvasEl) {
        let downX = 0, downY = 0;

        bimCanvasEl.addEventListener('pointerdown', (e) => {
          bimState.isDragging = true;
          bimState.lastX = e.clientX;
          bimState.lastY = e.clientY;
          downX = e.clientX;
          downY = e.clientY;
          bimCanvasEl.setPointerCapture?.(e.pointerId);
        });

        bimCanvasEl.addEventListener('pointermove', (e) => {
          if (bimState.isDragging) {
            const dx = e.clientX - bimState.lastX;
            const dy = e.clientY - bimState.lastY;
            bimState.lastX = e.clientX;
            bimState.lastY = e.clientY;

            bimState.yaw -= dx * 0.0085;
            if (bimState.cameraMode === 'inside360') {
              bimState.pitch = Math.max(-0.65, Math.min(0.65, bimState.pitch - dy * 0.0065));
            } else {
              bimState.pitch = Math.max(0.14, Math.min(1.35, bimState.pitch + dy * 0.0065));
            }

            const heading = getCompassHeadingText(bimState.yaw);
            const hudCam = document.getElementById('bimHudCameraInfo');
            if (hudCam) hudCam.textContent = `360° AÇI: ${heading.deg}° (${heading.wallLabel})`;
            renderBim3DCanvas();
            return;
          }

          // Hover raycast
          if (threeCtx.renderer && threeCtx.raycaster && threeCtx.camera) {
            const rect = bimCanvasEl.getBoundingClientRect();
            const mouse = new THREE.Vector2(
              ((e.clientX - rect.left) / rect.width) * 2 - 1,
              -((e.clientY - rect.top) / rect.height) * 2 + 1
            );
            threeCtx.raycaster.setFromCamera(mouse, threeCtx.camera);
            const meshes = [];
            threeCtx.meshMap.forEach(({ mesh, boxData }) => {
              if (!boxData.isOuterWall || mesh.material.opacity > 0.25) meshes.push(mesh);
            });
            const hits = threeCtx.raycaster.intersectObjects(meshes, false);
            const hitId = hits.length > 0 ? hits[0].object.userData.partId : null;
            if (hitId !== bimState.hoveredPartId) {
              bimState.hoveredPartId = hitId;
              renderBim3DCanvas();
            }
          }
        });

        bimCanvasEl.addEventListener('pointerup', (e) => {
          bimState.isDragging = false;
          const moved = Math.hypot(e.clientX - downX, e.clientY - downY);
          if (moved < 6 && threeCtx.renderer && threeCtx.raycaster && threeCtx.camera) {
            const rect = bimCanvasEl.getBoundingClientRect();
            const mouse = new THREE.Vector2(
              ((e.clientX - rect.left) / rect.width) * 2 - 1,
              -((e.clientY - rect.top) / rect.height) * 2 + 1
            );
            threeCtx.raycaster.setFromCamera(mouse, threeCtx.camera);
            const meshes = [];
            threeCtx.meshMap.forEach(({ mesh, boxData }) => {
              if (!boxData.isOuterWall || mesh.material.opacity > 0.25) meshes.push(mesh);
            });
            const hits = threeCtx.raycaster.intersectObjects(meshes, false);
            if (hits.length > 0) {
              bimState.selectedPartId = hits[0].object.userData.partId;
              renderBim3DCanvas();
            }
          }
        });

        bimCanvasEl.addEventListener('wheel', (e) => {
          e.preventDefault();
          const delta = e.deltaY > 0 ? -0.08 : 0.08;
          bimState.zoom = Math.max(0.68, Math.min(1.65, bimState.zoom + delta));
          renderBim3DCanvas();
        }, { passive: false });
      }

      // Scene Mode Switchers (Mutfak / Banyo / Komple Daire)
      ['bimSceneKitchen', 'bimSceneBathroom', 'bimSceneApartment'].forEach(btnId => {
        document.getElementById(btnId)?.addEventListener('click', (e) => {
          const scene = e.currentTarget.dataset.scene;
          bimState.scene = scene;
          document.querySelectorAll('.bim-mode-btn').forEach(b => b.classList.remove('active'));
          e.currentTarget.classList.add('active');
          if (scene === 'kitchen') bimState.selectedPartId = 'cab_upper';
          if (scene === 'bathroom') bimState.selectedPartId = 'bath_vanity';
          if (scene === 'apartment') bimState.selectedPartId = 'apt_kitchen_zone';
          notify360SelectionChange(`3D Sahne Değiştirildi → ${e.currentTarget.textContent.trim()}`);
          updateBimStudioMetrics();
        });
      });

      // Render Mode Switchers (Solid / Exploded / X-Ray / Wireframe)
      ['bimRenderSolid', 'bimRenderExploded', 'bimRenderXray', 'bimRenderWire'].forEach(btnId => {
        document.getElementById(btnId)?.addEventListener('click', (e) => {
          const mode = e.currentTarget.dataset.render;
          bimState.renderMode = mode;
          document.querySelectorAll('.bim-render-btn').forEach(b => b.classList.remove('active'));
          e.currentTarget.classList.add('active');

          const slider = document.getElementById('bimExplodeSlider');
          const pct = document.getElementById('bimExplodePct');
          if (mode === 'exploded' && bimState.explode < 0.35) {
            bimState.explode = 0.55;
            if (slider) slider.value = '55';
            if (pct) pct.textContent = '55%';
          } else if (mode !== 'exploded' && bimState.explode > 0) {
            bimState.explode = 0;
            if (slider) slider.value = '0';
            if (pct) pct.textContent = '0%';
          }
          threeCtx.lastSignature = '';
          renderBim3DCanvas();
        });
      });

      // Camera Angle Buttons
      function setActiveCamBtn(activeId) {
        ['bimCamIso', 'bimCamInside360', 'bimCamFront', 'bimCamTop'].forEach(id => {
          document.getElementById(id)?.classList.toggle('active', id === activeId);
        });
      }

      document.getElementById('bimCamIso')?.addEventListener('click', () => {
        bimState.cameraMode = 'orbit360';
        bimState.yaw = 0.62;
        bimState.pitch = 0.42;
        bimState.zoom = 1.05;
        setActiveCamBtn('bimCamIso');
        notify360SelectionChange('Kamera → 360° Perspektif Kesit Görünümü');
        updateBimStudioMetrics();
      });

      document.getElementById('bimCamInside360')?.addEventListener('click', () => {
        bimState.cameraMode = 'inside360';
        bimState.yaw = 0.0;
        bimState.pitch = -0.05;
        bimState.zoom = 1.0;
        setActiveCamBtn('bimCamInside360');
        notify360SelectionChange('Kamera → 360° Oda İçi Panoramik Bakış');
        updateBimStudioMetrics();
      });

      document.getElementById('bimCamFront')?.addEventListener('click', () => {
        bimState.cameraMode = 'orbit360';
        bimState.yaw = 0.0;
