      // AI Target Budget Optimizer
      document.getElementById('btnRunAiOptimizer')?.addEventListener('click', () => {
        const targetTRY = Math.max(200000, parseFloat(document.getElementById('aiTargetBudgetInput').value) || 850000);
        const beforeCalc = calculateEstimate();
        const initialTotal = beforeCalc.grandTotalTRY;
        const changes = [];

        // Protect life-safety infrastructure
        state.items.plumbing = true;
        state.items.electrical = true;

        let currentTotal = calculateEstimate().grandTotalTRY;

        if (currentTotal > targetTRY) {
          if (state.tier === 'luxury') {
            state.tier = 'standard';
            document.querySelectorAll('input[name="qualityTier"]').forEach(r => { r.checked = (r.value === 'standard'); });
            changes.push('Kalite segmenti "Modern Konfor (1.0x)" seviyesine dengelendi');
            currentTotal = calculateEstimate().grandTotalTRY;
          }
          if (currentTotal > targetTRY && state.subOptions.glassBalcony) {
            state.subOptions.glassBalcony = false;
            document.getElementById('opt_glassBalcony').checked = false;
            changes.push('Katlanır cam balkon opsiyonu 2. etaba ertelendi');
            currentTotal = calculateEstimate().grandTotalTRY;
