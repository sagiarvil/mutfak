  <!-- MOBILE FLOATING SUMMARY BAR -->
  <div class="no-print lg:hidden fixed bottom-0 left-0 right-0 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 p-3 px-4 z-40 flex items-center justify-between shadow-2xl">
    <div>
      <span class="text-[10px] text-slate-400 font-bold uppercase block">Canlı Anahtar Teslim</span>
      <span id="mobileBottomPrice" class="text-lg font-extrabold font-mono text-emerald-600 dark:text-emerald-400">₺ 0</span>
    </div>
    <button id="btnMobileGoSummary" type="button" class="px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-xs shadow-md flex items-center gap-1.5">
      <span>Keşif Dökümü</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </button>
  </div>

  <!-- SHARE / WHATSAPP EXPORT MODAL -->
  <div id="shareModal" class="no-print fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm hidden p-4">
    <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
          Resmi Keşif ve Teklif Özeti
        </h3>
        <button id="btnCloseShareModal" type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg font-bold">✕</button>
      </div>
      <p class="text-xs text-slate-500">
        Hazırlanan bu teknik keşif dökümünü kopyalayabilir veya doğrudan WhatsApp üzerinden mimarınızla/ustanızla paylaşabilirsiniz.
      </p>
      <textarea id="shareSummaryTextarea" readonly rows="10" class="w-full text-xs font-mono p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 focus:outline-none select-all"></textarea>
      <div class="grid grid-cols-2 gap-3 pt-2">
        <button id="btnModalCopy" type="button" class="py-2.5 px-4 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          Panoya Kopyala
        </button>
        <button id="btnModalWhatsapp" type="button" class="py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md transition-colors flex items-center justify-center gap-1.5">
          WhatsApp ile Aç
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST CONTAINER -->
  <div id="toastContainer" class="fixed top-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- APPLICATION LOGIC -->
  <script is:inline>
    const PRICING_DB = {
      currencies: {
        TRY: { symbol: '₺ ', rate: 1.0, code: 'TRY' },
        USD: { symbol: '$ ', rate: 0.0275, code: 'USD' },
        EUR: { symbol: '€ ', rate: 0.0252, code: 'EUR' }
      },
      cities: {
        istanbul_avrupa: { label: 'İstanbul (Avrupa)', factor: 1.15 },
        istanbul_anadolu: { label: 'İstanbul (Anadolu)', factor: 1.10 },
        izmir: { label: 'İzmir', factor: 1.05 },
        ankara: { label: 'Ankara', factor: 1.00 },
        antalya: { label: 'Antalya / Bodrum', factor: 1.12 },
        bursa: { label: 'Bursa / Kocaeli', factor: 1.02 },
        diger: { label: 'Diğer İller', factor: 0.92 }
      },
      propertyTypes: {
        apartment: { label: 'Apartman Dairesi', factor: 1.00 },
        villa: { label: 'Villa / Müstakil', factor: 1.22 },
        residence: { label: 'Rezidans / Site', factor: 1.14 },
        historic: { label: 'Tarihi / Eski Yapı', factor: 1.35 }
      },
      tiers: {
        economic: { label: 'İskandinav Pratik (Ekonomik)', factor: 0.72, variance: 0.11 },
        standard: { label: 'Modern Konfor (Standart)', factor: 1.00, variance: 0.14 },
        luxury: { label: 'Mimari Prestij & Lüks', factor: 1.75, variance: 0.18 }
      },
      buildingAge: {
        new: { label: '0-10 Yıl', factor: 0.90 },
        mid: { label: '11-25 Yıl', factor: 1.00 },
        old: { label: '25+ Yıl', factor: 1.22 }
      }
    };

    const state = {
      currentStep: 1,
      mode: 'wizard',
      currency: 'TRY',
      city: 'izmir',
      propertyType: 'apartment',
      sqm: 110,
      ceilingHeight: 2.85,
      roomConfig: '3+1',
      bathrooms: 2,
      buildingAge: 'mid',
      tier: 'standard',
      hardwareFinish: 'chrome',
      bufferEnabled: true,
      customQuantities: {
        kitchenMtul: 7.0,
        flooringSqm: 83,
        paintingSqm: 308,
        doorsCount: 6,
        userEditedFloor: false,
        userEditedPaint: false,
        userEditedDoors: false
      },
      items: {
        kitchen: true,
        bathroom: true,
        flooring: true,
        painting: true,
        electrical: true,
        plumbing: true,
        doors: true,
        windows: true,
        carpentry: true,
        hvac: false,
        architecture: true,
        demolition: true
      },
      subOptions: {
        kitchenCounter: 'cimstone',
        kitchenIsland: false,
        bathroomFixture: 'embedded',
        flooringType: 'laminate_ac4',
        paintBrand: 'jotun',
        doorModel: 'lake',
        windowType: 'pvc_white',
        glassBalcony: true,
        carpentryScope: 'entry_laundry',
        hvacOption: 'piping_only',
        archService: 'supervision',
        falseCeiling: true,
        underfloorHeating: false,
        newBoiler: false,
        wallRemoval: false
      },
      savedScenario: null
    };

    let doughnutChart = null;

    function formatMoney(tryAmount) {
      const curr = PRICING_DB.currencies[state.currency];
      const converted = Math.round(tryAmount * curr.rate);
      return curr.symbol + converted.toLocaleString('tr-TR');
    }

    function showToast(message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'px-4 py-3 rounded-xl shadow-xl text-xs font-bold bg-slate-900 dark:bg-emerald-600 text-white flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0 pointer-events-auto';
      toast.innerHTML = `<span>✓</span><span>${message}</span>`;
      container.appendChild(toast);
      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    function recalculateAutoQuantities() {
      const heightRatio = state.ceilingHeight / 2.80;
      if (!state.customQuantities.userEditedFloor) {
        state.customQuantities.flooringSqm = Math.round(state.sqm * 0.75);
        const flInput = document.getElementById('qty_flooring');
        if (flInput) flInput.value = state.customQuantities.flooringSqm;
      }
      if (!state.customQuantities.userEditedPaint) {
        state.customQuantities.paintingSqm = Math.round(state.sqm * 2.8 * heightRatio);
        const ptInput = document.getElementById('qty_painting');
        if (ptInput) ptInput.value = state.customQuantities.paintingSqm;
      }
      if (!state.customQuantities.userEditedDoors) {
        state.customQuantities.doorsCount = Math.max(3, Math.round(state.sqm / 18));
        const drInput = document.getElementById('qty_doors');
        if (drInput) drInput.value = state.customQuantities.doorsCount;
      }
    }

    function calculateEstimate() {
      const cityF = PRICING_DB.cities[state.city].factor;
      const propF = PRICING_DB.propertyTypes[state.propertyType].factor;
      const tierCfg = PRICING_DB.tiers[state.tier];
      const tierF = tierCfg.factor;
      const ageF = PRICING_DB.buildingAge[state.buildingAge].factor;
      const finishF = state.hardwareFinish === 'brushed_gold' ? 1.04 : (state.hardwareFinish === 'matte_black' ? 1.015 : 1.0);

      let totalMaterial = 0;
      let totalLabor = 0;
      let totalDemolition = 0;
      const boqRows = [];
      const itemCosts = {};

      // 1. Kitchen
      if (state.items.kitchen) {
        let kMult = 1.0;
        if (state.subOptions.kitchenCounter === 'porcelain') kMult += 0.26;
        if (state.subOptions.kitchenCounter === 'granite') kMult += 0.08;
        if (state.subOptions.kitchenCounter === 'acrylic') kMult -= 0.12;

        const mtul = state.customQuantities.kitchenMtul;
        const islandAdd = state.subOptions.kitchenIsland ? 35000 * tierF : 0;
        const mat = ((mtul * 14500 * kMult * tierF) + islandAdd) * cityF * finishF;
        const lab = (mtul * 5200) * cityF;
        const dem = 14000 * cityF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.kitchen = tot;
        boqRows.push({
          cat: 'Mutfak',
          title: 'Mutfak Dolabı, Tezgah & Evye İmalatı',
          desc: `${mtul} mtul dolap, ${state.subOptions.kitchenCounter.toUpperCase()} tezgah${state.subOptions.kitchenIsland ? ' + Ada Mutfak' : ''}`,
          unit: `${mtul} mtul`,
          split: '%68 Malz. / %32 İşç.',
          total: tot
        });
      } else { itemCosts.kitchen = 0; }

      // 2. Bathroom
      if (state.items.bathroom) {
        let bMult = 1.0;
        if (state.subOptions.bathroomFixture === 'luxury') bMult = 1.35;
        if (state.subOptions.bathroomFixture === 'standard') bMult = 0.85;
        const bCount = state.bathrooms;
        const mat = (68000 * bCount) * tierF * cityF * bMult * finishF;
        const lab = (36000 * bCount) * cityF * ageF;
        const dem = (16000 * bCount) * cityF * ageF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.bathroom = tot;
        boqRows.push({
          cat: 'Banyo',
          title: `Banyo & Islak Hacim Yenileme (${bCount} Adet)`,
          desc: 'Sürme izolasyon, rektifiye seramik, gömme rezervuar, duşakabin & vitrifiye',
          unit: `${bCount} Banyo`,
          split: '%58 Malz. / %42 İşç.',
          total: tot
        });
      } else { itemCosts.bathroom = 0; }

      // 3. Flooring
      if (state.items.flooring) {
        let fMult = 1.0;
        if (state.subOptions.flooringType === 'parquet_herringbone') fMult = 1.85;
        if (state.subOptions.flooringType === 'vinyl') fMult = 1.25;
        if (state.subOptions.flooringType === 'laminate_ac3') fMult = 0.80;
        const fArea = state.customQuantities.flooringSqm;
        const mat = fArea * 620 * tierF * cityF * fMult;
        const lab = fArea * 310 * cityF;
        const dem = fArea * 95 * cityF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.flooring = tot;
        boqRows.push({
          cat: 'Zemin',
          title: 'Zemin Parke, Tesviye Şapı & Süpürgelik',
          desc: `${fArea} m² zemin kaplama ve 8-10cm lake süpürgelik montajı`,
          unit: `${fArea} m²`,
          split: '%62 Malz. / %38 İşç.',
          total: tot
        });
      } else { itemCosts.flooring = 0; }

      // 4. Painting
      if (state.items.painting) {
        let pMult = 1.0;
        if (state.subOptions.paintBrand === 'decorative') pMult = 1.65;
        if (state.subOptions.paintBrand === 'marshall') pMult = 0.88;
        const wArea = state.customQuantities.paintingSqm;
        const mat = wArea * 210 * tierF * cityF * pMult;
        const lab = wArea * 320 * cityF;
        const dem = wArea * 35 * cityF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.painting = tot;
        boqRows.push({
          cat: 'Boya & Alçı',
          title: 'Duvar & Tavan Saten Alçı, Astar ve Boya',
          desc: `${wArea} m² yüzey hazırlığı ve 2 kat silinebilir boya (${state.subOptions.paintBrand.toUpperCase()})`,
          unit: `${wArea} m²`,
          split: '%40 Malz. / %60 İşç.',
          total: tot
        });
      } else { itemCosts.painting = 0; }

      // 5. Electrical & Ceiling
      if (state.items.electrical) {
        const eMult = state.subOptions.falseCeiling ? 1.42 : 1.0;
        const mat = state.sqm * 270 * tierF * cityF * ageF * eMult;
        const lab = state.sqm * 300 * cityF * ageF * eMult;
        const dem = state.sqm * 45 * cityF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.electrical = tot;
        boqRows.push({
          cat: 'Elektrik',
          title: 'Elektrik Altyapısı, Pano & Aydınlatma',
          desc: state.subOptions.falseCeiling ? 'Yanmaz kablo, sigorta panosu, prizler + Alçıpan Havuz LED Tavan' : 'Kablo hatları, sigorta panosu ve anahtar/priz montajı',
          unit: `${state.sqm} m²`,
          split: '%48 Malz. / %52 İşç.',
          total: tot
        });
      } else { itemCosts.electrical = 0; }

      // 6. Plumbing & Heating
      if (state.items.plumbing) {
        let plMult = state.subOptions.underfloorHeating ? 1.95 : 1.0;
        const boilerAdd = state.subOptions.newBoiler ? 68000 * tierF : 0;
        const mat = ((state.sqm * 290 * tierF * ageF * plMult) + boilerAdd) * cityF;
        const lab = state.sqm * 320 * cityF * ageF * plMult;
        const dem = state.sqm * 65 * cityF * ageF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.plumbing = tot;
        boqRows.push({
          cat: 'Mekanik',
          title: 'Sıhhi Tesisat & Isıtma Altyapısı',
          desc: `${state.subOptions.underfloorHeating ? 'Yerden ısıtma dönüşümü' : 'PPRC temiz/pis su borulama'}${state.subOptions.newBoiler ? ' + Yoğuşmalı Kombi & Petek' : ''}`,
          unit: `${state.sqm} m²`,
          split: '%52 Malz. / %48 İşç.',
          total: tot
        });
      } else { itemCosts.plumbing = 0; }

      // 7. Doors
      if (state.items.doors) {
        let dMult = 1.0;
        if (state.subOptions.doorModel === 'invisible') dMult = 1.80;
        if (state.subOptions.doorModel === 'melamin') dMult = 0.72;
        const dCount = state.customQuantities.doorsCount;
        const mat = ((dCount * 9200 * dMult) + 26000) * tierF * cityF * finishF;
        const lab = ((dCount * 2400) + 4500) * cityF;
        const dem = (dCount * 800) * cityF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.doors = tot;
        boqRows.push({
          cat: 'Kapılar',
          title: `İç Oda Kapıları (${dCount} Adet) & Çelik Kapı`,
          desc: `${state.subOptions.doorModel.toUpperCase()} iç kapılar ve monoblok çelik kapı`,
          unit: `${dCount + 1} Adet`,
          split: '%76 Malz. / %24 İşç.',
          total: tot
        });
      } else { itemCosts.doors = 0; }

      // 8. Windows & Glass Balcony
      if (state.items.windows) {
        let wMult = 1.0;
        if (state.subOptions.windowType === 'pvc_anthracite') wMult = 1.25;
        if (state.subOptions.windowType === 'aluminum') wMult = 1.75;
        const winCount = Math.max(4, Math.round(state.sqm / 15));
        const balconyAdd = state.subOptions.glassBalcony ? 42000 * tierF : 0;
        const mat = ((winCount * 9800 * wMult * tierF) + balconyAdd) * cityF;
        const lab = (winCount * 2600 + (state.subOptions.glassBalcony ? 8000 : 0)) * cityF;
        const dem = (winCount * 900) * cityF;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.windows = tot;
        boqRows.push({
          cat: 'Doğrama',
          title: 'PVC / Alüminyum Doğrama & Cam Balkon',
          desc: `${winCount} pencere modülü (${state.subOptions.windowType})${state.subOptions.glassBalcony ? ' + Katlanır Cam Balkon' : ''}`,
          unit: `${winCount} Modül`,
          split: '%75 Malz. / %25 İşç.',
          total: tot
        });
      } else { itemCosts.windows = 0; }

      // 9. Custom Carpentry (Vestiyer / Wardrobe / TV)
      if (state.items.carpentry) {
        const cMult = state.subOptions.carpentryScope === 'full_wardrobe' ? 2.1 : 1.0;
        const mat = 44000 * cMult * tierF * cityF;
        const lab = 16000 * cMult * cityF;
        const tot = (mat + lab) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF;
        itemCosts.carpentry = tot;
        boqRows.push({
          cat: 'Sabit Mobilya',
          title: 'Özel Ölçü Vestiyer, Çamaşır & Giyinme Dolabı',
          desc: state.subOptions.carpentryScope === 'full_wardrobe' ? 'Antre vestiyer + Çamaşır dolabı + TV Ünitesi + Giyinme Odası' : 'Antre portmanto & çamaşır/kurutma makinesi kabini',
          unit: 'Özel İmalat',
          split: '%73 Malz. / %27 İşç.',
          total: tot
        });
      } else { itemCosts.carpentry = 0; }

      // 10. HVAC & Smart Home
      if (state.items.hvac) {
        let hMat = 18000;
        let hLab = 12000;
        if (state.subOptions.hvacOption === 'ac_included') { hMat = 76000; hLab = 18000; }
        if (state.subOptions.hvacOption === 'smart_home') { hMat = 135000; hLab = 35000; }
        const mat = hMat * tierF * cityF;
        const lab = hLab * cityF;
        const tot = (mat + lab) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF;
        itemCosts.hvac = tot;
        boqRows.push({
          cat: 'İklimlendirme',
          title: 'Klima Altyapısı & Akıllı Ev Otomasyonu',
          desc: `Seçim: ${state.subOptions.hvacOption.toUpperCase()}`,
          unit: '1 Sistem',
          split: '%78 Malz. / %22 İşç.',
          total: tot
        });
      } else { itemCosts.hvac = 0; }

      // 11. Architectural Design & Site Supervision
      if (state.items.architecture) {
        const aMult = state.subOptions.archService === 'supervision' ? 1.0 : 0.45;
        const lab = state.sqm * 520 * aMult * cityF * tierF;
        const tot = lab * propF;
        totalLabor += tot;
        itemCosts.architecture = tot;
        boqRows.push({
          cat: 'Mimari & Kontrol',
          title: 'İç Mimari Proje, 3D Render & Şantiye Şefliği',
          desc: state.subOptions.archService === 'supervision' ? '3D görselleştirme, uygulama projeleri ve günlük şantiye kalite kontrolü' : '2D/3D iç mimari tasarım ve malzeme seçimi danışmanlığı',
          unit: `${state.sqm} m²`,
          split: '%100 Hizmet',
          total: tot
        });
      } else { itemCosts.architecture = 0; }

      // 12. Demolition & Debris
      if (state.items.demolition) {
        const demMult = state.subOptions.wallRemoval ? 1.38 : 1.0;
        const mat = state.sqm * 75 * cityF;
        const lab = state.sqm * 310 * cityF * demMult * ageF;
        const dem = state.sqm * 240 * cityF * demMult;
        const tot = (mat + lab + dem) * propF;
        totalMaterial += mat * propF; totalLabor += lab * propF; totalDemolition += dem * propF;
        itemCosts.demolition = tot;
        boqRows.push({
          cat: 'Yıkım & Moloz',
          title: 'Yıkım, Kırım, Çuvallama & Moloz Nakliyesi',
          desc: state.subOptions.wallRemoval ? 'Açık mutfak duvar yıkımı, lento, moloz atımı ve belediye harcı' : 'Eski seramik/parke sökümü, çuvallama ve döküm sahası nakliyesi',
          unit: 'Proje Geneli',
          split: '%15 Malz. / %85 İşç.',
          total: tot
        });
      } else { itemCosts.demolition = 0; }

      const subtotal = totalMaterial + totalLabor + totalDemolition;
      const buffer = state.bufferEnabled ? subtotal * 0.10 : 0;
      const grandTotal = subtotal + buffer;

      const minTotal = grandTotal * (1 - tierCfg.variance);
      const maxTotal = grandTotal * (1 + tierCfg.variance);

      let days = 18;
      if (state.items.kitchen) days += 7;
      if (state.items.bathroom) days += 5 * state.bathrooms;
      if (state.items.plumbing) days += 5;
      if (state.items.windows) days += 4;
      if (state.subOptions.wallRemoval) days += 3;
      days = Math.max(12, Math.min(75, Math.round(days * (state.sqm / 100) * 0.85)));

      const lineItems = boqRows.map((r, i) => ({
        code: `POZ ${String(i + 1).padStart(2, '0')}.100`,
        title: r.title,
        qtyText: r.unit,
        cost: r.total
      }));
      return {
        material: totalMaterial,
        labor: totalLabor,
        demolition: totalDemolition,
        subtotal,
        buffer,
        grandTotal,
        grandTotalTRY: grandTotal,
        minTotal,
        maxTotal,
        unitCost: Math.round(grandTotal / state.sqm),
        days,
        minDays: days,
        maxDays: days + 7,
        boqRows,
        lineItems,
        itemCosts
      };
    }

    function updateChart(boqRows) {
      const ctx = document.getElementById('costDoughnutChart');
      if (!ctx || typeof Chart === 'undefined') return;

      const labels = boqRows.map(r => r.cat);
      const data = boqRows.map(r => Math.round(r.total));
      const palette = [
        '#0f766e', '#1e293b', '#0d9488', '#334155',
        '#14b8a6', '#475569', '#b45309', '#64748b',
        '#047857', '#78716c', '#94a3b8', '#a16207'
      ];

      if (doughnutChart) {
        doughnutChart.data.labels = labels;
        doughnutChart.data.datasets[0].data = data;
        doughnutChart.update();
      } else {
        doughnutChart = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: labels,
            datasets: [{
              data: data,
              backgroundColor: palette,
              borderWidth: 0,
              hoverOffset: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '66%',
            plugins: {
              legend: {
                position: 'right',
                labels: {
                  boxWidth: 10,
                  font: { size: 10, family: 'Plus Jakarta Sans' },
                  color: '#64748b'
                }
              }
            }
          }
        });
      }
    }

