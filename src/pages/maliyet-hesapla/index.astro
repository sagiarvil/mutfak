---
import Layout from "../../layouts/Layout.astro";

const pageSeo = {
  title: "2026 Mutfak, Banyo ve Komple Ev Tadilatı Maliyet Hesaplama | İzmir Mutfak Banyo",
  description: "İzmir mutfak dolabı, lüks banyo yenileme ve komple daire tadilatı maliyetlerini canlı hesaplayın. 2026 güncel malzeme, işçilik ve anahtar teslim atölye fiyatları.",
  canonical: "https://izmirmutfakbanyo.com.tr/maliyet-hesapla/",
  ogType: "website"
};
---

<Layout seo={pageSeo}>
  <div class="bg-[#FBFBFC] text-slate-800 min-h-screen py-10 sm:py-16">
    
    <!-- BAŞLIK & MİMARİ AÇIKLAMA -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 mb-12 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 text-[11px] font-bold tracking-wider uppercase mb-4">
        <span>2026 İzmir Atölye ve Şantiye Metraj Standardı</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-serif">
        Tadilat &amp; İmalat Maliyet Hesaplama
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Ankara ve İzmir piyasasındaki reel usta işçilikleri, E1 MDF-Lam, akrilik, lake dolap imalatı, porselen tezgah ve anahtar teslim şantiye giderlerini baz alan şeffaf metraj motoru.
      </p>

      <!-- 3 ANA SEKME (MINIMALIST KURUMSAL KONTROL) -->
      <div class="mt-8 inline-flex p-1.5 bg-slate-200/70 rounded-xl border border-slate-300/80 max-w-xl w-full">
        <button 
          type="button" 
          id="tabBtnMutfak" 
          class="calc-tab-btn flex-1 py-2.5 px-4 rounded-lg text-xs font-bold transition-all duration-150 bg-white text-slate-900 shadow-xs"
          data-target="panelMutfak"
        >
          Mutfak Tadilatı
        </button>
        <button 
          type="button" 
          id="tabBtnBanyo" 
          class="calc-tab-btn flex-1 py-2.5 px-4 rounded-lg text-xs font-semibold transition-all duration-150 text-slate-600 hover:text-slate-900"
          data-target="panelBanyo"
        >
          Banyo Yenileme
        </button>
        <button 
          type="button" 
          id="tabBtnKomple" 
          class="calc-tab-btn flex-1 py-2.5 px-4 rounded-lg text-xs font-semibold transition-all duration-150 text-slate-600 hover:text-slate-900"
          data-target="panelKomple"
        >
          Komple Ev Tadilatı
        </button>
      </div>
    </div>

    <!-- HESAPLAMA GÖVDESİ -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- ============================================================== -->
      <!-- 1. MUTFAK PANELİ                                               -->
      <!-- ============================================================== -->
      <div id="panelMutfak" class="calc-panel block">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Sol Parametreler -->
          <div class="lg:col-span-8 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-xs space-y-7">
            
            <!-- Alan Slider -->
            <div class="space-y-3 pb-6 border-b border-slate-100">
              <div class="flex justify-between items-center">
                <span class="text-xs uppercase tracking-wider font-bold text-slate-900">Mutfak Taban Alanı</span>
                <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1 rounded-lg">
                  <input type="number" id="m_alan_input" min="5" max="40" value="12" class="w-12 bg-transparent text-center font-bold text-slate-900 text-sm focus:outline-none" />
                  <span class="text-xs text-slate-500 font-medium">m²</span>
                </div>
              </div>
              <input type="range" id="m_alan_slider" min="5" max="40" value="12" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-slate-900" />
              <div class="flex justify-between text-[11px] text-slate-400 font-medium">
                <span>5 m² (Kompakt)</span>
                <span>12 m² (Standart Daire)</span>
                <span>20 m² (Ada Mutfak)</span>
                <span>40 m² (Büyük Villa)</span>
              </div>
            </div>

            <!-- Bina Yaşı -->
            <div class="space-y-2.5">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Bina Yaşı (Altyapı Riski)</span>
              <div class="grid grid-cols-3 gap-3">
                <button type="button" class="opt-btn active p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_bina" data-val="yeni">
                  0 - 10 Yıl
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Standart Altyapı</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_bina" data-val="orta">
                  11 - 20 Yıl
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Kısmi Yenileme (+%20)</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_bina" data-val="eski">
                  20+ Yıl
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Eski Tesisat (+%30)</span>
                </button>
              </div>
            </div>

            <!-- Dolap Kapak Malzemesi -->
            <div class="space-y-2.5">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Dolap Gövde &amp; Kapak Standardı</span>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button type="button" class="opt-btn p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="m_dolap" data-val="mdf">
                  MDF-Lam Kapak
                  <span class="block text-[10px] text-slate-500 font-normal mt-1">Dayanıklı &amp; Ekonomik Çözüm</span>
                </button>
                <button type="button" class="opt-btn active p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="m_dolap" data-val="akrilik">
                  Çizilmez Akrilik / Membran
                  <span class="block text-[10px] text-slate-500 font-normal mt-1">İpeksi Mat veya Yüksek Parlak</span>
                </button>
                <button type="button" class="opt-btn p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="m_dolap" data-val="lake">
                  İpek Mat Fırın Lake / Meşe
                  <span class="block text-[10px] text-slate-500 font-normal mt-1">Özel İmalat Prestij Zanaatı</span>
                </button>
              </div>
            </div>

            <!-- Tezgah Malzemesi -->
            <div class="space-y-2.5">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Mutfak Tezgahı</span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="laminat">
                  Laminat
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Giriş Seviye</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="granit">
                  Doğal Granit
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Klasik Taş</span>
                </button>
                <button type="button" class="opt-btn active p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="kuvars">
                  Kuvars (Çimstone)
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Leke Tutmaz</span>
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="m_tezgah" data-val="porselen">
                  Lamar Porselen
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Isıya %100 Direnç</span>
                </button>
              </div>
            </div>

            <!-- Ek Yapısal İmalatlar -->
            <div class="space-y-3 pt-2">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Şantiye &amp; Tesisat Kalemleri</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <label class="p-3.5 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Kırım &amp; Moloz Tahliyesi</span>
                    <span class="text-[11px] text-slate-500">Mevcut dolap ve fayans sökümü</span>
                  </div>
                  <input type="checkbox" id="m_chk_yikim" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Zemin Seramik / Granit</span>
                    <span class="text-[11px] text-slate-500">60x120 lazer kesim döşeme</span>
                  </div>
                  <input type="checkbox" id="m_chk_zemin" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Sıhhi Tesisat Yenileme</span>
                    <span class="text-[11px] text-slate-500">PPRC temiz su ve atık giderleri</span>
                  </div>
                  <input type="checkbox" id="m_chk_su" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Elektrik Hattı &amp; Prizler</span>
                    <span class="text-[11px] text-slate-500">Ankastre ve tezgah priz hatları</span>
                  </div>
                  <input type="checkbox" id="m_chk_elektrik" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Tavan &amp; Duvar Boya</span>
                    <span class="text-[11px] text-slate-500">Silinebilir su bazlı boya</span>
                  </div>
                  <input type="checkbox" id="m_chk_boya" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 hover:border-slate-300 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Gizli LED &amp; Aydınlatma</span>
                    <span class="text-[11px] text-slate-500">Tezgah altı lineer alüminyum profil</span>
                  </div>
                  <input type="checkbox" id="m_chk_aydinlatma" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>
              </div>
            </div>

          </div>

          <!-- Sağ Bütçe Kartı (Monokrom Mat Antrasit / Mimari Rapor) -->
          <div class="lg:col-span-4 sticky top-24 space-y-4">
            <div class="bg-slate-900 text-white p-7 rounded-2xl border border-slate-800 shadow-xl">
              <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <span class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">MUTFAK MALİYET RAPORU</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">2026</span>
              </div>

              <div class="my-6 text-center">
                <span class="text-[11px] text-slate-400 block mb-1">Tahmini Yaklaşık Bütçe</span>
                <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight" id="m_total_display">
                  ₺ 125.000 – ₺ 185.000
                </div>
                <span class="text-[11px] text-emerald-400 block mt-1.5 font-medium">Doğrudan Atölye İmalatı (%30 Aracı Komisyonsuz)</span>
              </div>

              <!-- Kalem Dağılımı -->
              <div class="space-y-2 py-4 border-t border-b border-slate-800 text-xs" id="m_breakdown_list"></div>

              <!-- Aksiyon Butonları -->
              <div class="mt-6 space-y-2.5">
                <a 
                  id="m_btn_whatsapp" 
                  href="#" 
                  target="_blank" 
                  class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-center block text-xs tracking-wider uppercase transition"
                >
                  Bu Hesabı WhatsApp'a Gönder →
                </a>
                <a 
                  href="tel:02324411060" 
                  class="w-full py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-center block text-xs transition border border-slate-700"
                >
                  0232 441 1060 - Bize Danışın
                </a>
              </div>
              <p class="text-[10px] text-slate-500 text-center mt-3 leading-relaxed">
                * Kesin bütçe, atölye ustamızın yerinde lazer rölöve alımı ve seçilecek aksesuar/fren mekanizması detayına göre netleştirilir.
              </p>
            </div>
          </div>

        </div>
      </div>


      <!-- ============================================================== -->
      <!-- 2. BANYO PANELİ                                                -->
      <!-- ============================================================== -->
      <div id="panelBanyo" class="calc-panel hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <div class="lg:col-span-8 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-xs space-y-7">
            
            <div class="space-y-3 pb-6 border-b border-slate-100">
              <div class="flex justify-between items-center">
                <span class="text-xs uppercase tracking-wider font-bold text-slate-900">Banyo Taban Alanı</span>
                <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1 rounded-lg">
                  <input type="number" id="b_alan_input" min="3" max="25" value="6" class="w-12 bg-transparent text-center font-bold text-slate-900 text-sm focus:outline-none" />
                  <span class="text-xs text-slate-500 font-medium">m²</span>
                </div>
              </div>
              <input type="range" id="b_alan_slider" min="3" max="25" value="6" class="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-slate-900" />
              <div class="flex justify-between text-[11px] text-slate-400 font-medium">
                <span>3 m² (Misafir Banyo)</span>
                <span>6 m² (Standart Ebeveyn)</span>
                <span>12 m² (Lüks Geniş)</span>
                <span>25 m² (Villa SPA)</span>
              </div>
            </div>

            <div class="space-y-2.5">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Bina Yaşı</span>
              <div class="grid grid-cols-3 gap-3">
                <button type="button" class="opt-btn active p-3 rounded-xl border text-center text-xs font-bold transition" data-group="b_bina" data-val="yeni">
                  0 - 10 Yıl
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="b_bina" data-val="orta">
                  11 - 20 Yıl (+%20)
                </button>
                <button type="button" class="opt-btn p-3 rounded-xl border text-center text-xs font-bold transition" data-group="b_bina" data-val="eski">
                  20+ Yıl (+%30)
                </button>
              </div>
            </div>

            <div class="space-y-2.5">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Seramik &amp; Fayans Kalitesi</span>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" class="opt-btn active p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="b_seramik" data-val="standart">
                  Standart 60x60 Seramik
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Çanakkale / VitrA Kalitesi</span>
                </button>
                <button type="button" class="opt-btn p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="b_seramik" data-val="premium">
                  60x120 / 120x240 Porselen Granit
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Lazer Kesim Derzsiz Lüks</span>
                </button>
              </div>
            </div>

            <div class="space-y-2.5">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Gömme Rezervuar &amp; Vitrifiye</span>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" class="opt-btn active p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="b_klozet" data-val="standart">
                  Standart Takım Klozet
                </button>
                <button type="button" class="opt-btn p-3.5 rounded-xl border text-left text-xs font-bold transition" data-group="b_klozet" data-val="asma">
                  Geberit / VitrA Gömme Rezervuar
                  <span class="block text-[10px] text-slate-500 font-normal mt-0.5">Asma Sessiz Klozet</span>
                </button>
              </div>
            </div>

            <div class="space-y-3 pt-2">
              <span class="text-xs uppercase tracking-wider font-bold text-slate-900 block">Banyo Kapsam Kalemleri</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <label class="p-3.5 rounded-xl border border-slate-200 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Kırım &amp; Moloz Atımı</span>
                    <span class="text-[11px] text-slate-500">Eski küvet ve fayans sökümü</span>
                  </div>
                  <input type="checkbox" id="b_chk_yikim" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Çift Kat İzolasyon (Membran)</span>
                    <span class="text-[11px] text-slate-500">Sızdırmazlık yalıtım garantisi</span>
                  </div>
                  <input type="checkbox" id="b_chk_izolasyon" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Marin Banyo Dolabı &amp; Ayna</span>
                    <span class="text-[11px] text-slate-500">Suya mukavim lake dolap</span>
                  </div>
                  <input type="checkbox" id="b_chk_dolap" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Temperli Duşakabin &amp; Gider</span>
                    <span class="text-[11px] text-slate-500">Paslanmaz duş kanalı</span>
                  </div>
                  <input type="checkbox" id="b_chk_dus" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Su &amp; Gider Tesisatı</span>
                    <span class="text-[11px] text-slate-500">PPRC borulama ve test</span>
                  </div>
                  <input type="checkbox" id="b_chk_su" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>

                <label class="p-3.5 rounded-xl border border-slate-200 flex items-center justify-between cursor-pointer bg-slate-50/50">
                  <div>
                    <span class="font-bold text-slate-900 block">Havlupan Radyatör</span>
                    <span class="text-[11px] text-slate-500">Antrasit / krom havlupan</span>
                  </div>
                  <input type="checkbox" id="b_chk_havlupan" class="w-4 h-4 rounded text-slate-900 focus:ring-0 cursor-pointer" checked />
                </label>
              </div>
            </div>

          </div>

          <div class="lg:col-span-4 sticky top-24 space-y-4">
            <div class="bg-slate-900 text-white p-7 rounded-2xl border border-slate-800 shadow-xl">
              <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <span class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">BANYO MALİYET RAPORU</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">2026</span>
              </div>

              <div class="my-6 text-center">
                <span class="text-[11px] text-slate-400 block mb-1">Tahmini Banyo Bütçesi</span>
                <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight" id="b_total_display">
                  ₺ 65.000 – ₺ 110.000
                </div>
                <span class="text-[11px] text-emerald-400 block mt-1.5 font-medium">Taşeronsuz Usta Kadrosu &amp; Çift Kat İzolasyon</span>
              </div>

              <div class="space-y-2 py-4 border-t border-b border-slate-800 text-xs" id="b_breakdown_list"></div>

              <div class="mt-6 space-y-2.5">
                <a 
                  id="b_btn_whatsapp" 
                  href="#" 
                  target="_blank" 
                  class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-center block text-xs tracking-wider uppercase transition"
                >
                  Bu Banyo İçin Teklif Al →
                </a>
                <a 
                  href="tel:02324411060" 
                  class="w-full py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-center block text-xs transition border border-slate-700"
                >
                  0232 441 1060 - Bize Danışın
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>


      <!-- ============================================================== -->
      <!-- 3. KOMPLE EV PANELİ                                            -->
      <!-- ============================================================== -->
      <div id="panelKomple" class="calc-panel hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
