---
import Layout from "../../layouts/Layout.astro";

const pageSeo = {
  title: "Tadilat ve Özel İmalat Maliyet Hesaplama Motoru 2026 | İzmir Mutfak Banyo",
  description: "İzmir mutfak dolabı, lüks banyo renovasyonu ve anahtar teslim daire tadilatı maliyetlerini canlı hesaplayın. 2026 doğrudan atölye imalat ve montaj cetveli.",
  canonical: "https://izmirmutfakbanyo.com.tr/maliyet-hesapla/",
  ogType: "website"
};
---

<Layout seo={pageSeo}>
  <!-- MİLANO ATÖLYE MİMARİ DOKUSU -->
  <div class="bg-[#F8F9FA] text-[#172127] min-h-screen selection:bg-[#23323A] selection:text-white font-['Montserrat',sans-serif]">
    
    <!-- ÜST EDİTORYAL MİMARİ BAŞLIK -->
    <section class="border-b border-[#E2E8F0] bg-white pt-12 pb-10 sm:pt-16 sm:pb-12">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-4">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#F4F6F8] border border-[#E2E8F0] text-[11px] font-bold tracking-[0.16em] text-[#23323A] uppercase">
          <span class="w-2 h-2 rounded-full bg-[#CB000F] animate-pulse"></span>
          <span>İZMİR ATÖLYE İMALAT CETVELİ • 2026</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#172127]">
          Tadilat &amp; İmalat <span class="text-[#CB000F]">Maliyet Simülatörü</span>
        </h1>

        <p class="text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto font-normal leading-relaxed">
          Kişiye özel mutfak dolabı, lüks banyo dönüşümü ve anahtar teslim mimari renovasyon projeleriniz için doğrudan atölye maliyetini anlık simüle edin.
        </p>

        <!-- ÜST SEGMENT SEÇİM SEKMELERİ (TABS) -->
        <div class="pt-4 max-w-xl mx-auto">
          <div class="grid grid-cols-3 p-1.5 bg-[#EFEFEA] rounded-2xl border border-[#DFDFD8] shadow-inner gap-1">
            <button 
              type="button" 
              id="tabBtnMutfak" 
              class="calc-tab-btn py-3 px-3 rounded-xl text-xs font-bold transition-all duration-200 bg-[#23323A] text-white shadow-md flex items-center justify-center gap-1.5"
              data-target="panelMutfak"
            >
              <span>Mutfak İmalatı</span>
            </button>
            <button 
              type="button" 
              id="tabBtnBanyo" 
              class="calc-tab-btn py-3 px-3 rounded-xl text-xs font-semibold transition-all duration-200 text-neutral-600 hover:text-neutral-900 flex items-center justify-center gap-1.5"
              data-target="panelBanyo"
            >
              <span>Banyo Renovasyonu</span>
            </button>
            <button 
              type="button" 
              id="tabBtnKomple" 
              class="calc-tab-btn py-3 px-3 rounded-xl text-xs font-semibold transition-all duration-200 text-neutral-600 hover:text-neutral-900 flex items-center justify-center gap-1.5"
              data-target="panelKomple"
            >
              <span>Komple Daire</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- ANA KONFİGÜRASYON ALANI: KOMPAKT VE BÜTÜNSEL MİMARİ KONSOL -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
      
      <!-- ============================================================== -->
      <!-- 1. MUTFAK PANELİ                                               -->
      <!-- ============================================================== -->
      <div id="panelMutfak" class="calc-panel block">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          
          <!-- SOL KONSOL: ENTEGRE, DÜZENLİ VE ZARİF FORM KONSOLU (7 SÜTUN) -->
          <div class="lg:col-span-7 bg-white rounded-3xl border border-[#E2E8F0] shadow-sm divide-y divide-[#F1F5F9] overflow-hidden">
            
            <!-- BLOK 1: MEKÂN ÖLÇÜSÜ VE BİNA YAŞI (KOMPAKT İKİLİ) -->
            <div class="p-6 sm:p-8 space-y-6">
              <div class="flex items-center justify-between border-b border-[#F1F5F9] pb-3">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-[#23323A] text-white text-[11px] font-bold flex items-center justify-center">1</span>
                  <h3 class="text-sm uppercase tracking-wider font-bold text-[#172127]">Mekân Ölçüsü &amp; Altyapı</h3>
                </div>
                <div class="flex items-center gap-2 bg-[#F8F9FA] border border-[#E2E8F0] px-3.5 py-1.5 rounded-xl">
                  <span class="text-xs text-neutral-500 font-medium">Taban:</span>
                  <input type="number" id="m_alan_input" min="5" max="40" value="12" class="w-10 bg-transparent text-center text-base font-bold text-[#172127] focus:outline-none" />
                  <span class="text-xs font-bold text-neutral-600">m²</span>
                </div>
              </div>

              <!-- SLIDER VE ETİKETLER -->
              <div class="space-y-3">
                <input type="range" id="m_alan_slider" min="5" max="40" value="12" class="w-full h-2 bg-[#E2E8F0] rounded-lg appearance-none cursor-pointer accent-[#23323A]" />
                <div class="flex justify-between text-[11px] text-neutral-400 font-medium">
                  <span>5 m² (Kompakt)</span>
                  <span class="text-[#23323A] font-bold">12 m² (Standart)</span>
                  <span>20 m² (Ada)</span>
                  <span>40 m² (Lüks Villa)</span>
                </div>
                <div class="flex items-center justify-between text-xs text-neutral-600 bg-[#F8F9FA] px-4 py-2.5 rounded-xl border border-[#E2E8F0]">
                  <span class="font-medium">Tahmini Dolap Metrajı:</span>
                  <span class="font-bold text-[#172127]" id="m_calc_mtul">4.6 Metretül (mtül)</span>
                </div>
              </div>

              <!-- BİNA YAŞI (3'LÜ MİKRO BUTON) -->
              <div class="pt-2">
                <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider block mb-2.5">Bina Yaşı &amp; Tesisat Durumu</label>
                <div class="grid grid-cols-3 gap-2.5">
                  <button type="button" class="opt-card active p-3 rounded-xl border text-center transition" data-group="m_bina" data-val="yeni">
                    <div class="text-xs font-bold text-neutral-900">0 – 10 Yıl</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Standart</div>
                  </button>
                  <button type="button" class="opt-card p-3 rounded-xl border text-center transition" data-group="m_bina" data-val="orta">
                    <div class="text-xs font-bold text-neutral-900">11 – 20 Yıl</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Kısmi (+%15)</div>
                  </button>
                  <button type="button" class="opt-card p-3 rounded-xl border text-center transition" data-group="m_bina" data-val="eski">
                    <div class="text-xs font-bold text-neutral-900">20+ Yıl</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Eski (+%25)</div>
                  </button>
                </div>
              </div>
            </div>

            <!-- BLOK 2: DOLAP VE TEZGAH MALZEME SEÇİMİ -->
            <div class="p-6 sm:p-8 space-y-6">
              <div class="flex items-center gap-2 border-b border-[#F1F5F9] pb-3">
                <span class="w-6 h-6 rounded-full bg-[#23323A] text-white text-[11px] font-bold flex items-center justify-center">2</span>
                <h3 class="text-sm uppercase tracking-wider font-bold text-[#172127]">Atölye İmalat Malzemesi</h3>
              </div>

              <!-- DOLAP KAPAKLARI -->
              <div>
                <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider block mb-2.5">Dolap Kapak &amp; Gövde Standardı</label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <button type="button" class="opt-card p-3.5 rounded-2xl border text-left transition relative flex flex-col justify-between" data-group="m_dolap" data-val="mdf">
                    <div>
                      <div class="text-xs font-bold text-neutral-900">MDF-Lam Kapak</div>
                      <div class="text-[11px] text-neutral-500 mt-0.5">Ekonomik, dayanıklı.</div>
                    </div>
                    <div class="text-[11px] font-bold text-[#23323A] mt-2">₺8.500 / mtül</div>
                  </button>

                  <button type="button" class="opt-card active p-3.5 rounded-2xl border text-left transition relative flex flex-col justify-between" data-group="m_dolap" data-val="akrilik">
                    <div class="absolute -top-2 right-2 bg-[#CB000F] text-white text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full font-bold">Popüler</div>
                    <div>
                      <div class="text-xs font-bold text-neutral-900">Çizilmez Akrilik</div>
                      <div class="text-[11px] text-neutral-500 mt-0.5">Ayna parlak / mat ipeksi.</div>
                    </div>
                    <div class="text-[11px] font-bold text-[#23323A] mt-2">₺12.500 / mtül</div>
                  </button>

                  <button type="button" class="opt-card p-3.5 rounded-2xl border text-left transition relative flex flex-col justify-between" data-group="m_dolap" data-val="lake">
                    <div>
                      <div class="text-xs font-bold text-neutral-900">İpek Mat Lake</div>
                      <div class="text-[11px] text-neutral-500 mt-0.5">Fırın poliüretan boya.</div>
                    </div>
                    <div class="text-[11px] font-bold text-[#23323A] mt-2">₺19.500 / mtül</div>
                  </button>
                </div>
              </div>

              <!-- MUTFAK TEZGAHI -->
              <div>
                <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider block mb-2.5">Mutfak Tezgahı Malzemesi</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                  <button type="button" class="opt-card p-3 rounded-xl border text-center transition" data-group="m_tezgah" data-val="laminat">
                    <div class="text-xs font-bold text-neutral-900">Laminat</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Ekonomik</div>
                  </button>
                  <button type="button" class="opt-card p-3 rounded-xl border text-center transition" data-group="m_tezgah" data-val="granit">
                    <div class="text-xs font-bold text-neutral-900">Doğal Granit</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Doğal Taş</div>
                  </button>
                  <button type="button" class="opt-card active p-3 rounded-xl border text-center transition" data-group="m_tezgah" data-val="kuvars">
                    <div class="text-xs font-bold text-neutral-900">Kuvars Çimstone</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Leke Tutmaz</div>
                  </button>
                  <button type="button" class="opt-card p-3 rounded-xl border text-center transition" data-group="m_tezgah" data-val="porselen">
                    <div class="text-xs font-bold text-neutral-900">Lamar Porselen</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Sıfır Çizilme</div>
                  </button>
                </div>
              </div>
            </div>

            <!-- BLOK 3: ŞANTİYE VE UYGULAMA KALEMLERİ (MİNİMALIST 2 SÜTUN) -->
            <div class="p-6 sm:p-8 space-y-4 bg-[#FAFAFA]">
              <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-3">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-[#23323A] text-white text-[11px] font-bold flex items-center justify-center">3</span>
                  <h3 class="text-sm uppercase tracking-wider font-bold text-[#172127]">Uygulama &amp; Şantiye Kapsamı</h3>
                </div>
                <span class="text-[11px] text-neutral-500">İhtiyacınıza göre seçin</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1 text-xs">
                <label class="p-3 rounded-xl border border-[#E2E8F0] hover:border-neutral-400 flex items-center justify-between cursor-pointer bg-white transition">
                  <div class="pr-2">
                    <span class="font-bold text-neutral-900 block text-xs">Kırım &amp; Moloz Atımı</span>
                    <span class="text-[10px] text-neutral-500">Eski dolap sökümü ve nakliyesi</span>
                  </div>
                  <input type="checkbox" id="m_chk_yikim" class="w-4 h-4 rounded text-[#23323A] accent-[#23323A] cursor-pointer" checked />
                </label>

                <label class="p-3 rounded-xl border border-[#E2E8F0] hover:border-neutral-400 flex items-center justify-between cursor-pointer bg-white transition">
                  <div class="pr-2">
                    <span class="font-bold text-neutral-900 block text-xs">Zemin Seramik / Granit</span>
                    <span class="text-[10px] text-neutral-500">60x120 derzsiz porselen döşeme</span>
                  </div>
                  <input type="checkbox" id="m_chk_zemin" class="w-4 h-4 rounded text-[#23323A] accent-[#23323A] cursor-pointer" checked />
                </label>

                <label class="p-3 rounded-xl border border-[#E2E8F0] hover:border-neutral-400 flex items-center justify-between cursor-pointer bg-white transition">
                  <div class="pr-2">
                    <span class="font-bold text-neutral-900 block text-xs">Sıhhi Su Tesisatı</span>
                    <span class="text-[10px] text-neutral-500">PPRC temiz su ve gider hattı</span>
                  </div>
                  <input type="checkbox" id="m_chk_su" class="w-4 h-4 rounded text-[#23323A] accent-[#23323A] cursor-pointer" checked />
                </label>

                <label class="p-3 rounded-xl border border-[#E2E8F0] hover:border-neutral-400 flex items-center justify-between cursor-pointer bg-white transition">
                  <div class="pr-2">
                    <span class="font-bold text-neutral-900 block text-xs">Elektrik &amp; Priz Altyapısı</span>
                    <span class="text-[10px] text-neutral-500">Ankastre ve tezgah hatları</span>
                  </div>
                  <input type="checkbox" id="m_chk_elektrik" class="w-4 h-4 rounded text-[#23323A] accent-[#23323A] cursor-pointer" checked />
                </label>

                <label class="p-3 rounded-xl border border-[#E2E8F0] hover:border-neutral-400 flex items-center justify-between cursor-pointer bg-white transition">
                  <div class="pr-2">
                    <span class="font-bold text-neutral-900 block text-xs">Boya Badana</span>
                    <span class="text-[10px] text-neutral-500">Tavan ve duvar silinebilir boya</span>
                  </div>
                  <input type="checkbox" id="m_chk_boya" class="w-4 h-4 rounded text-[#23323A] accent-[#23323A] cursor-pointer" checked />
                </label>

                <label class="p-3 rounded-xl border border-[#E2E8F0] hover:border-neutral-400 flex items-center justify-between cursor-pointer bg-white transition">
                  <div class="pr-2">
                    <span class="font-bold text-neutral-900 block text-xs">Lineer Gizli LED Profil</span>
                    <span class="text-[10px] text-neutral-500">Tezgah altı alüminyum profil</span>
                  </div>
                  <input type="checkbox" id="m_chk_aydinlatma" class="w-4 h-4 rounded text-[#23323A] accent-[#23323A] cursor-pointer" checked />
                </label>
              </div>
            </div>

          </div>

          <!-- SAĞ SÜTUN: PREMİUM KOYU ATÖLYE HESAP KARTI (5 SÜTUN - STICKY) -->
          <div class="lg:col-span-5 sticky top-24 space-y-4">
            <div class="bg-[#172127] text-white p-7 sm:p-8 rounded-3xl shadow-xl border border-[#23323A] space-y-6">
              
              <div class="flex items-center justify-between border-b border-neutral-700/60 pb-4">
                <div>
                  <span class="text-[10px] uppercase tracking-[0.2em] text-[#CB000F] font-bold block">İZMİR ATÖLYE CETVELİ</span>
                  <span class="text-xs text-white font-semibold">Mutfak İmalat Özeti</span>
                </div>
                <div class="px-2.5 py-1 rounded-full bg-[#23323A] border border-neutral-600 text-[10px] font-mono text-white">
                  ARACISIZ ATÖLYE
                </div>
              </div>

              <!-- FİYAT ALANI -->
              <div class="py-1 text-center">
                <span class="text-[11px] text-neutral-300 font-bold block mb-1.5 uppercase tracking-wider">Tahmini Bütçe Aralığı</span>
                <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight" id="m_total_display" style="font-variant-numeric: tabular-nums;">
                  ₺ 85.000 – ₺ 120.000
                </div>
                <div class="inline-flex items-center gap-1.5 mt-3 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-[11px] font-bold">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>%30 Doğrudan Atölye İmalat Avantajı</span>
                </div>
              </div>

              <!-- KALEM DÖKÜMÜ -->
              <div class="border-t border-b border-neutral-700/60 py-3.5 space-y-2 text-xs" id="m_breakdown_list"></div>

              <!-- GARANTİ MADDELERİ -->
              <div class="space-y-1.5 text-[11px] text-neutral-300">
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span> E1 Sertifikalı Neme Dayanıklı MDF-Lam Gövde
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span> Blum &amp; Häfele Frenli Sessiz Menteşeler
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span> 3D Fotogerçekçi Mimari Çizim Ücretsiz
                </div>
              </div>

              <!-- AKSİYON BUTONLARI -->
              <div class="pt-2 space-y-2.5">
                <a 
                  id="m_btn_whatsapp" 
                  href="#" 
                  target="_blank" 
                  class="w-full py-4 px-5 bg-[#CB000F] hover:bg-[#a6000c] text-white font-bold rounded-2xl text-center block text-xs tracking-wider uppercase transition shadow-lg flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/></svg>
                  <span>Bu Hesabı WhatsApp'a Gönder →</span>
                </a>
                <a 
                  href="tel:05393333303" 
                  class="w-full py-3 px-4 bg-[#23323A] hover:bg-[#2c3d47] text-white font-semibold rounded-2xl text-center block text-xs transition border border-neutral-700"
                >
                  Mimarımızla Görüşün: 0539 333 33 03
                </a>
              </div>

              <p class="text-[10px] text-neutral-400 text-center leading-relaxed">
                * Kesin bütçe, atölye mimarımızın adresinizde yapacağı lazer keşif ve seçilecek ray/kulp mekanizmaları ile sabitlenir.
              </p>
            </div>
          </div>

        </div>
      </div>


      <!-- ============================================================== -->
      <!-- 2. BANYO PANELİ                                                -->
      <!-- ============================================================== -->
      <div id="panelBanyo" class="calc-panel hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          
          <div class="lg:col-span-7 bg-white rounded-3xl border border-[#E2E8F0] shadow-sm divide-y divide-[#F1F5F9] overflow-hidden">
            
            <!-- BLOK 1: BANYO ÖLÇÜSÜ VE BİNA YAŞI -->
            <div class="p-6 sm:p-8 space-y-6">
              <div class="flex items-center justify-between border-b border-[#F1F5F9] pb-3">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-[#23323A] text-white text-[11px] font-bold flex items-center justify-center">1</span>
                  <h3 class="text-sm uppercase tracking-wider font-bold text-[#172127]">Banyo Alanı &amp; Altyapı</h3>
                </div>
                <div class="flex items-center gap-2 bg-[#F8F9FA] border border-[#E2E8F0] px-3.5 py-1.5 rounded-xl">
                  <span class="text-xs text-neutral-500 font-medium">Alan:</span>
                  <input type="number" id="b_alan_input" min="3" max="25" value="6" class="w-10 bg-transparent text-center text-base font-bold text-[#172127] focus:outline-none" />
                  <span class="text-xs font-bold text-neutral-600">m²</span>
                </div>
              </div>

              <div class="space-y-3">
                <input type="range" id="b_alan_slider" min="3" max="25" value="6" class="w-full h-2 bg-[#E2E8F0] rounded-lg appearance-none cursor-pointer accent-[#23323A]" />
                <div class="flex justify-between text-[11px] text-neutral-400 font-medium">
                  <span>3 m² (Misafir)</span>
                  <span class="text-[#23323A] font-bold">6 m² (Standart)</span>
                  <span>12 m² (Lüks Geniş)</span>
                  <span>25 m² (Villa SPA)</span>
                </div>
              </div>

              <div class="pt-2">
                <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider block mb-2.5">Bina Tesisat Durumu</label>
                <div class="grid grid-cols-3 gap-2.5">
                  <button type="button" class="opt-card active p-3 rounded-xl border text-center transition" data-group="b_bina" data-val="yeni">
                    <div class="text-xs font-bold text-neutral-900">0 – 10 Yıl</div>
                    <div class="text-[10px] text-neutral-500 mt-0.5">Standart</div>
                  </button>
                  <button type="button" class="opt-card p-3 rounded-xl border text-center transition" data-group="b_bina" data-val="orta">
                    <div class="text-xs font-bold text-neutral-900">11 – 20 Yıl</div>
