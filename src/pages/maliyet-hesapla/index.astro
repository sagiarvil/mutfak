    function render() {
      recalculateAutoQuantities();
      const res = calculateEstimate();

      // Main price displays
      const avgFormatted = formatMoney(res.grandTotal);
      document.getElementById('mainAveragePrice').textContent = avgFormatted;
      document.getElementById('mainMinPrice').textContent = formatMoney(res.minTotal);
      document.getElementById('mainMaxPrice').textContent = formatMoney(res.maxTotal);
      document.getElementById('topTotalBadge').textContent = avgFormatted;
      document.getElementById('mobileBottomPrice').textContent = avgFormatted;

      // Per-card badges
      for (const [cat, val] of Object.entries(res.itemCosts)) {
        const badge = document.getElementById('badgeCost_' + cat);
        if (badge) badge.textContent = val > 0 ? formatMoney(val) : 'Kapalı';
      }

      const activeCount = Object.values(state.items).filter(Boolean).length;
      document.getElementById('activeCategoryCountBadge').textContent = `${activeCount} / 12 Kalem Aktif`;

      const unitFormatted = `${formatMoney(res.unitCost)} / m²`;
      document.getElementById('panelUnitCost').textContent = unitFormatted;
      document.getElementById('panelTimeline').textContent = `~${res.days}-${res.days + 7} İş Günü`;

      // Progress bars
      const total = res.material + res.labor + res.demolition || 1;
      const pctMat = Math.round((res.material / total) * 100);
      const pctLab = Math.round((res.labor / total) * 100);
      const pctDem = Math.max(0, 100 - pctMat - pctLab);

      document.getElementById('barMaterial').style.width = pctMat + '%';
      document.getElementById('barLabor').style.width = pctLab + '%';
      document.getElementById('barDemolition').style.width = pctDem + '%';
