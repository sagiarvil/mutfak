<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // TAB KONTROLÜ
    const tabs = document.querySelectorAll(".calc-tab-btn");
    const panels = document.querySelectorAll(".calc-panel");

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const targetId = tab.dataset.target;
        tabs.forEach(t => {
          t.classList.remove("bg-neutral-900", "text-white", "shadow-md", "font-bold");
          t.classList.add("text-neutral-600", "font-semibold");
        });
        tab.classList.add("bg-neutral-900", "text-white", "shadow-md", "font-bold");
        tab.classList.remove("text-neutral-600", "font-semibold");

        panels.forEach(p => p.classList.add("hidden"));
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.remove("hidden");
      });
    });

    const fmt = (num) => "₺ " + Math.round(num).toLocaleString("tr-TR");

    // 1. MUTFAK
    const mState = {
      alan: 12,
      bina: "yeni",
      dolap: "akrilik",
      tezgah: "kuvars",
      yikim: true,
      zemin: true,
      su: true,
      elektrik: true,
      boya: true,
      aydinlatma: true
    };

    const mPrices = {
      binaMultiplier: { yeni: 1.0, orta: 1.15, eski: 1.25 },
      iscilikM2: { min: 1100, max: 1650 },
      dolap: {
        mdf: { min: 8500, max: 11000 },
        akrilik: { min: 12500, max: 16500 },
        lake: { min: 19500, max: 28500 }
      },
      tezgah: {
        laminat: { min: 1400, max: 2800 },
        granit: { min: 3800, max: 6500 },
        kuvars: { min: 8500, max: 13500 },
        porselen: { min: 14500, max: 22000 }
      },
      yikim: { min: 3000, max: 6000 },
      zeminM2: { min: 1400, max: 2400 },
      su: { min: 5500, max: 9500 },
      elektrik: { min: 4000, max: 7500 },
      boya: { min: 3500, max: 6000 },
      aydinlatma: { min: 2500, max: 4500 }
    };

    function calcMutfak() {
      const mult = mPrices.binaMultiplier[mState.bina];
      const m2 = mState.alan;
      const dolapMetre = Math.max(3, m2 * 0.38);

      const mtulEl = document.getElementById("m_calc_mtul");
      if (mtulEl) mtulEl.textContent = `${dolapMetre.toFixed(1)} Metretül (mtül)`;

      let totalMin = 0; let totalMax = 0;
      const breakdown = [];

      const iscMin = mPrices.iscilikM2.min * m2 * mult;
      const iscMax = mPrices.iscilikM2.max * m2 * mult;
      totalMin += iscMin; totalMax += iscMax;
      breakdown.push({ name: "Usta & Şantiye İşçiliği", min: iscMin, max: iscMax });

      const dMin = mPrices.dolap[mState.dolap].min * dolapMetre;
      const dMax = mPrices.dolap[mState.dolap].max * dolapMetre;
      totalMin += dMin; totalMax += dMax;
      breakdown.push({ name: `Dolap (${dolapMetre.toFixed(1)} mtül)`, min: dMin, max: dMax });

