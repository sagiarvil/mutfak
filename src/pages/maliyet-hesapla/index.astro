        bimState.yaw = 0.0;
        bimState.pitch = 1.32;
        bimState.zoom = 1.05;
        setActiveCamBtn('bimCamTop');
        notify360SelectionChange('Kamera → Üst Mimari Kat Planı Görünümü');
        updateBimStudioMetrics();
      });

      document.getElementById('bimAutoRotateBtn')?.addEventListener('click', (e) => {
        bimState.autoRotate = !bimState.autoRotate;
        e.currentTarget.textContent = bimState.autoRotate ? 'Oto-Döndür: Açık' : 'Oto-Döndür: Kapalı';
        e.currentTarget.classList.toggle('active', bimState.autoRotate);
      });

      document.querySelectorAll('.bim-compass-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const deg = btn.dataset.lookDeg;
          if (deg === 'up') {
