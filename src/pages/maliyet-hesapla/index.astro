      // Bottom Feature Toggle Pills
      document.querySelectorAll('.quick360-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.toggle360;
          const mapId = {
            kitchenIsland: 'opt_kitchenIsland',
            openKitchen: 'opt_wallRemoval',
            falseCeiling: 'opt_falseCeiling',
            underfloorHeating: 'opt_underfloorHeating',
            glassBalcony: 'opt_glassBalcony',
            item_hvac: 'item_hvac',
            item_carpentry: 'item_carpentry',
            item_doors: 'item_doors'
          };
          const targetEl = document.getElementById(mapId[key]);
          if (targetEl) {
            targetEl.checked = !targetEl.checked;
            targetEl.dispatchEvent(new Event('change', { bubbles: true }));
          }
          render();
          updateBimStudioMetrics();
        });
      });

      // Optional Turntable Animation (only runs when user explicitly enables Oto-Döndür)
      setInterval(() => {
        if (bimState.autoRotate && !bimState.isDragging) {
          bimState.yaw += 0.006;
          const heading = getCompassHeadingText(bimState.yaw);
          const hudCam = document.getElementById('bimHudCameraInfo');
          if (hudCam) hudCam.textContent = `360° AÇI: ${heading.deg}° (${heading.wallLabel})`;
          renderBim3DCanvas();
        }
      }, 40);

      window.addEventListener('resize', () => {
        renderBim3DCanvas();
      });

      update3dStudio();
      updateContractDraft();
      updateBimStudioMetrics();

      setStep(1);
      syncItemCheckboxes();
      render();
    });
  </script>
</body>
</html>