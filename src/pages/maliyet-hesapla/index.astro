    function syncItemCheckboxes() {
      for (const [key, val] of Object.entries(state.items)) {
        const chk = document.getElementById('item_' + key);
        if (chk) {
          chk.checked = val;
          const card = chk.closest('.work-card');
          if (card) {
            if (val) {
              card.classList.remove('opacity-60', 'border-slate-200', 'dark:border-slate-800');
              card.classList.add('border-emerald-500/80');
            } else {
              card.classList.add('opacity-60', 'border-slate-200', 'dark:border-slate-800');
              card.classList.remove('border-emerald-500/80');
            }
          }
        }
      }
    }

    function setStep(stepNum) {
      state.currentStep = stepNum;
      const steps = [
        document.getElementById('sectionStep1'),
        document.getElementById('sectionStep2'),
        document.getElementById('sectionStep3'),
        document.getElementById('sectionStep4')
      ];

      if (state.mode === 'wizard') {
        steps.forEach((sec, idx) => {
          if (idx + 1 === stepNum) sec.classList.remove('hidden');
          else sec.classList.add('hidden');
        });
        const pct = stepNum * 25;
        document.getElementById('progressBarFill').style.width = pct + '%';
        document.getElementById('progressPercentage').textContent = pct + '% Tamamlandı';
        const titles = [
          'Adım 1 / 4: Konut, Kat Planı ve Metraj',
          'Adım 2 / 4: Görsel Atmosfer & Kalite Seviyesi',
          'Adım 3 / 4: 12 İş Kalemi & Hassas Metraj',
          'Adım 4 / 4: Resmi Keşif, Ödeme Takvimi & ROI'
        ];
        document.getElementById('stepCounterText').textContent = titles[stepNum - 1];

        for (let i = 1; i <= 4; i++) {
          const tab = document.getElementById('stepTab' + i);
          if (i === stepNum) {
            tab.className = 'wizard-step-tab py-2.5 px-2 text-xs font-bold rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-sm';
          } else {
            tab.className = 'wizard-step-tab py-2.5 px-2 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white';
          }
        }
      } else {
        steps.forEach(sec => sec.classList.remove('hidden'));
      }
    }

    function setMode(modeName) {
      state.mode = modeName;
      const wizardBtn = document.getElementById('viewModeWizard');
      const expertBtn = document.getElementById('viewModeExpert');
      const wizardProgress = document.getElementById('wizardProgressWrapper');

      if (modeName === 'expert') {
        wizardBtn.classList.remove('tab-active', 'shadow-sm');
        expertBtn.classList.add('tab-active', 'shadow-sm');
        wizardProgress.classList.add('hidden');
        setStep(1);
      } else {
        expertBtn.classList.remove('tab-active', 'shadow-sm');
        wizardBtn.classList.add('tab-active', 'shadow-sm');
        wizardProgress.classList.remove('hidden');
        setStep(state.currentStep);
      }
    }

    function applyPreset(preset) {
      if (preset === 'cosmetic') {
        state.tier = 'economic';
        state.items = {
          kitchen: false, bathroom: false, flooring: true, painting: true,
          electrical: false, plumbing: false, doors: true, windows: false,
          carpentry: false, hvac: false, architecture: false, demolition: false
        };
        showToast('Kiralama & Satış Öncesi Kozmetik Paketi yüklendi.');
      } else if (preset === 'wet') {
        state.tier = 'standard';
        state.items = {
          kitchen: true, bathroom: true, flooring: false, painting: false,
          electrical: false, plumbing: true, doors: false, windows: false,
          carpentry: false, hvac: false, architecture: false, demolition: true
        };
        showToast('Sadece Mutfak, Banyo & Su Tesisatı Paketi yüklendi.');
      } else if (preset === 'complete') {
        state.tier = 'standard';
        state.items = {
          kitchen: true, bathroom: true, flooring: true, painting: true,
          electrical: true, plumbing: true, doors: true, windows: true,
          carpentry: true, hvac: false, architecture: true, demolition: true
        };
        showToast('Komple Anahtar Teslim Aile Evi Paketi yüklendi.');
      } else if (preset === 'luxury') {
        state.tier = 'luxury';
        state.hardwareFinish = 'brushed_gold';
        state.subOptions.kitchenCounter = 'porcelain';
        state.subOptions.kitchenIsland = true;
        state.subOptions.bathroomFixture = 'luxury';
        state.subOptions.flooringType = 'parquet_herringbone';
        state.subOptions.doorModel = 'invisible';
        state.subOptions.underfloorHeating = true;
        state.subOptions.wallRemoval = true;
        state.items = {
          kitchen: true, bathroom: true, flooring: true, painting: true,
          electrical: true, plumbing: true, doors: true, windows: true,
          carpentry: true, hvac: true, architecture: true, demolition: true
        };
        showToast('VIP Mimari Dönüşüm & Lüks Tasarım Paketi yüklendi.');
      }

      document.querySelectorAll('input[name="qualityTier"]').forEach(r => {
        r.checked = (r.value === state.tier);
      });
      syncItemCheckboxes();
      render();
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Theme Toggle
      document.getElementById('themeToggleBtn').addEventListener('click', () => {
        const htmlEl = document.documentElement;
        const isDark = htmlEl.classList.toggle('dark');
        document.getElementById('themeIconSun').classList.toggle('hidden', !isDark);
        document.getElementById('themeIconMoon').classList.toggle('hidden', isDark);
        document.getElementById('themeText').textContent = isDark ? 'Açık Mod' : 'Koyu Mod';
      });

      // Currency Switcher
      document.querySelectorAll('.currency-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.currency-btn').forEach(b => {
            b.className = 'currency-btn px-2 py-0.5 rounded-md text-[11px] font-semibold text-slate-400 hover:text-white transition-all';
          });
          btn.className = 'currency-btn px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-600 text-white transition-all';
          state.currency = btn.dataset.currency;
          render();
        });
      });

      // City Select
      document.getElementById('citySelect').addEventListener('change', e => {
        state.city = e.target.value;
        render();
      });

      // Save Scenario
      document.getElementById('btnSaveScenario').addEventListener('click', () => {
        const res = calculateEstimate();
        state.savedScenario = {
          title: `${state.sqm}m² • ${PRICING_DB.tiers[state.tier].label}`,
          total: res.grandTotal
        };
        document.getElementById('saveScenarioText').textContent = 'Senaryo A Kaydedildi ✓';
        showToast('Mevcut hesap "Senaryo A" olarak kaydedildi! Şimdi değişiklik yaparak farkı görebilirsiniz.');
        render();
      });

      document.getElementById('btnClearSavedScenario').addEventListener('click', () => {
        state.savedScenario = null;
        document.getElementById('scenarioComparisonCard').classList.add('hidden');
        document.getElementById('saveScenarioText').textContent = 'Senaryo Kaydet';
      });

      // Property Type
      document.querySelectorAll('input[name="propertyType"]').forEach(r => {
        r.addEventListener('change', e => { state.propertyType = e.target.value; render(); });
      });

      // SQM & Ceiling Height
      const sqmRange = document.getElementById('sqmRange');
      const sqmInput = document.getElementById('sqmInput');
      sqmRange.addEventListener('input', e => {
        state.sqm = parseInt(e.target.value, 10);
        sqmInput.value = state.sqm;
        state.customQuantities.userEditedFloor = false;
        state.customQuantities.userEditedPaint = false;
        state.customQuantities.userEditedDoors = false;
        render();
      });
      sqmInput.addEventListener('input', e => {
        let v = parseInt(e.target.value, 10) || 50;
        v = Math.max(25, Math.min(600, v));
        state.sqm = v;
        sqmRange.value = Math.min(350, v);
        state.customQuantities.userEditedFloor = false;
        state.customQuantities.userEditedPaint = false;
        state.customQuantities.userEditedDoors = false;
        render();
      });

      document.getElementById('ceilingHeightSelect').addEventListener('change', e => {
        state.ceilingHeight = parseFloat(e.target.value);
        state.customQuantities.userEditedPaint = false;
        render();
      });

      // Room & Bath Pills
      document.querySelectorAll('.room-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.room-pill').forEach(b => b.className = 'room-pill py-2.5 text-xs font-bold rounded-xl border border-slate-200 dark:border-slate-700 hover:border-emerald-500 transition-all');
          btn.className = 'room-pill py-2.5 text-xs font-bold rounded-xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 transition-all';
          state.roomConfig = btn.dataset.room;
          render();
        });
      });

      document.querySelectorAll('.bath-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bath-pill').forEach(b => b.className = 'bath-pill py-2.5 text-xs font-bold rounded-xl border border-slate-200 dark:border-slate-700 hover:border-emerald-500 transition-all');
          btn.className = 'bath-pill py-2.5 text-xs font-bold rounded-xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 transition-all';
          state.bathrooms = parseInt(btn.dataset.bath, 10);
          render();
        });
      });

      // Interactive SVG Floorplan Click to Toggle
      document.querySelectorAll('.fp-room').forEach(roomGroup => {
        roomGroup.addEventListener('click', () => {
          const targetCat = roomGroup.dataset.target;
          if (targetCat && targetCat in state.items) {
            state.items[targetCat] = !state.items[targetCat];
            syncItemCheckboxes();
            render();
            showToast(`Kat planından "${targetCat.toUpperCase()}" kalemi ${state.items[targetCat] ? 'açıldı' : 'kapatıldı'}.`);
          }
        });
      });

