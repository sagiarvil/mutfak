        bimState.wallColorKey = wallSel;
        bimState.floorTypeKey = floorSel;
        bimState.cabinetColorKey = cabSel;
        bimState.lightingKey = lightSel;

        const qWall = document.getElementById('quick360Wall');
        if (qWall && qWall.value !== wallSel) qWall.value = wallSel;
        const qFloor = document.getElementById('quick360Floor');
        if (qFloor && qFloor.value !== floorSel) qFloor.value = floorSel;
