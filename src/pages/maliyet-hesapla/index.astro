      document.getElementById('repSummaryUnitCost').textContent = unitFormatted;
      document.getElementById('repSummaryDuration').textContent = `${res.days} - ${res.days + 7} Gün`;

      // BOQ Table
      const tableBody = document.getElementById('boqTableBody');
      tableBody.innerHTML = '';
      res.boqRows.forEach((row, idx) => {
        const div = document.createElement('div');
        div.className = 'px-4 py-3 grid grid-cols-12 gap-2 items-center hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors';
        div.innerHTML = `
          <div class="col-span-5">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">POZ ${String(idx + 1).padStart(2, '0')}.100</span>
              <span class="font-bold text-slate-900 dark:text-white">${row.title}</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">${row.desc}</div>
          </div>
          <div class="col-span-2 text-center font-mono font-semibold text-slate-600 dark:text-slate-300">${row.unit}</div>
          <div class="hidden sm:block sm:col-span-2 text-right font-mono text-[11px] text-slate-500">${row.split}</div>
          <div class="col-span-5 sm:col-span-3 text-right font-mono font-extrabold text-slate-900 dark:text-white">${formatMoney(row.total)}</div>
        `;
        tableBody.appendChild(div);
      });

      document.getElementById('tableSubtotalText').textContent = formatMoney(res.subtotal);
      document.getElementById('tableBufferText').textContent = formatMoney(res.buffer);
      document.getElementById('tableGrandTotalText').textContent = avgFormatted;

      // Payment Plan Stages
      document.getElementById('payStage1').textContent = formatMoney(res.grandTotal * 0.30);
      document.getElementById('payStage2').textContent = formatMoney(res.grandTotal * 0.35);
      document.getElementById('payStage3').textContent = formatMoney(res.grandTotal * 0.25);
      document.getElementById('payStage4').textContent = formatMoney(res.grandTotal * 0.10);

      // ROI & Value Uplift
      const upliftMultiplier = state.tier === 'luxury' ? 1.68 : (state.tier === 'standard' ? 1.55 : 1.42);
      const valueUplift = res.grandTotal * upliftMultiplier;
      const rentUplift = (res.grandTotal * 0.012);
      document.getElementById('roiValueUplift').textContent = '+ ' + formatMoney(valueUplift);
      document.getElementById('roiRentUplift').textContent = '+ ' + formatMoney(rentUplift) + ' / ay';
      document.getElementById('monthlyInstallmentText').textContent = formatMoney(res.grandTotal / 12) + ' / ay';

      // Contextual helper labels
      document.getElementById('cityBadge').textContent = PRICING_DB.cities[state.city].label;
      document.getElementById('calculatedWallSurfaceBadge').textContent = `Duvar Yüzeyi: ~${state.customQuantities.paintingSqm} m²`;
      document.getElementById('kitchenCabinetMtr').textContent = `${state.customQuantities.kitchenMtul} mtul`;
      document.getElementById('flooringAreaText').textContent = `~${state.customQuantities.flooringSqm} m²`;
      document.getElementById('paintWallAreaText').textContent = `~${state.customQuantities.paintingSqm} m²`;
      document.getElementById('socketCountText').textContent = `~${Math.round(state.sqm * 0.45)} Nokta`;
      document.getElementById('bathroomCalculatedArea').textContent = `${state.bathrooms} Banyo (~${state.bathrooms * 6} m²)`;
      document.getElementById('doorCountText').textContent = `${state.customQuantities.doorsCount} Oda + 1 Çelik`;
      document.getElementById('debrisBagsText').textContent = `~${Math.round(state.sqm * 1.8)} - ${Math.round(state.sqm * 2.5)} Çuval`;

      // Scenario Comparison Update
      if (state.savedScenario) {
        document.getElementById('scenarioComparisonCard').classList.remove('hidden');
        document.getElementById('savedScenarioTitle').textContent = state.savedScenario.title;
        document.getElementById('savedScenarioPrice').textContent = formatMoney(state.savedScenario.total);
        document.getElementById('currentScenarioTitle').textContent = `${state.sqm}m² • ${PRICING_DB.tiers[state.tier].label}`;
        document.getElementById('currentScenarioPrice').textContent = avgFormatted;
        const diff = res.grandTotal - state.savedScenario.total;
        const diffEl = document.getElementById('scenarioDiffText');
        diffEl.textContent = diff >= 0 ? `Fark: +${formatMoney(diff)}` : `Tasarruf: ${formatMoney(diff)}`;
        diffEl.className = diff >= 0 ? 'text-[11px] font-mono text-amber-600 mt-0.5' : 'text-[11px] font-mono text-emerald-600 mt-0.5';
      }

      updateFloorplanSVG();
      updateChart(res.boqRows);
      updateShareModalText(res);
    }

