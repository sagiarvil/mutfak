        else state.tier = 'luxury';
        document.querySelectorAll('input[name="qualityTier"]').forEach(r => { r.checked = (r.value === state.tier); });
        notify360SelectionChange(`Dolap Kapağı → ${e.target.selectedOptions?.[0]?.text}`);
        render();
        updateBimStudioMetrics();
      });

      document.getElementById('bimCountertopSelect')?.addEventListener('change', (e) => {
        bimState.countertop = e.target.value;
        state.subOptions.kitchenCounter = e.target.value;
        const step3Sel = document.getElementById('kitchenCounterOption');
        if (step3Sel) step3Sel.value = e.target.value;
        notify360SelectionChange(`Tezgah Plakası → ${e.target.selectedOptions?.[0]?.text}`);
