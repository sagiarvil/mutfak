        if (pct) pct.textContent = `${Math.round(val)}%`;
        threeCtx.lastSignature = '';
        renderBim3DCanvas();
      });

      // Right-Panel Selectors Synced with Main Calculator
      document.getElementById('bimKitchenLayoutSelect')?.addEventListener('change', (e) => {
        bimState.kitchenLayout = e.target.value;
        const hasIsland = (e.target.value === 'l_island');
