  <title>RenovaIQ Studio Pro | 2026 Mimari Tadilat, Metraj & Yatırım Hesaplama Motoru</title>
  <meta name="description" content="Evinizin tadilat bütçesini interaktif kat planı, malzeme moodboard'u, 12 detaylı iş kalemi, ödeme takvimi ve değer artışı (ROI) analiziyle kuruşu kuruşuna hesaplayın.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Inter"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          },
          colors: {
            brand: {
              50: '#FAF8F5',
              100: '#F3EFE6',
              200: '#E6DEC8',
              400: '#D4AF37',
              500: '#C5A059',
              600: '#B48327',
              700: '#9A6F1A',
              800: '#1F2937',
              900: '#111827',
            },
            slate: {
              850: '#131c2e',
              900: '#0f172a',
              950: '#070b14',
            }
          },
          boxShadow: {
            'glow': '0 0 30px -5px rgba(16, 185, 129, 0.35)',
            'glow-amber': '0 0 30px -5px rgba(245, 158, 11, 0.3)',
            'premium': '0 24px 48px -12px rgba(15, 23, 42, 0.08), 0 0 1px 1px rgba(15, 23, 42, 0.05)',
            'card': '0 10px 30px -10px rgba(15, 23, 42, 0.06)'
          }
        }
      }
    }
  </script>
  <style is:inline>
    @media print {
      body { background: white !important; color: #0f172a !important; }
      .no-print { display: none !important; }
      .print-only { display: block !important; }
      .step-container { display: block !important; border: 1px solid #cbd5e1 !important; box-shadow: none !important; margin-bottom: 16px !important; break-inside: avoid; }
      #sectionStep1, #sectionStep2, #sectionStep3 { display: none !important; }
      #sectionStep4 { display: block !important; }
    }
    .print-only { display: none; }

    /* Custom modern range slider */
    input[type=range] {
      -webkit-appearance: none;
      background: transparent;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 22px;
      width: 22px;
      border-radius: 50%;
      background: #059669;
      border: 3px solid #ffffff;
      box-shadow: 0 4px 12px rgba(5, 150, 105, 0.45);
      cursor: pointer;
      margin-top: -7px;
      transition: transform 0.15s ease, background-color 0.15s ease;
    }
    input[type=range]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
      background: #047857;
    }
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 8px;
      cursor: pointer;
      background: #e2e8f0;
      border-radius: 9999px;
    }
    .dark input[type=range]::-webkit-slider-runnable-track {
      background: #334155;
    }

    .tab-active {
      border-color: #059669;
      color: #059669;
      background-color: rgba(16, 185, 129, 0.1);
    }
    .dark .tab-active {
      color: #34d399;
      background-color: rgba(16, 185, 129, 0.18);
    }

    /* Blueprint interactive room hover */
    .fp-room {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }
    .fp-room:hover {
      filter: brightness(1.08);
    }
    .blueprint-grid {
      background-size: 20px 20px;
      background-image: 
        linear-gradient(to right, rgba(16, 185, 129, 0.07) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.07) 1px, transparent 1px);
    }

    /* ==========================================================================
       İZMİR MUTFAK BANYO (YAMASHI MUTFAK LUXURY) — ORIGINAL BRAND COLOR SYSTEM
       Anthracite Charcoal (#111827) • Warm Gold/Bronze (#C5A059) • Alabaster (#FAF8F5)
       ========================================================================== */
    :root {
      --arch-bg: #FAF8F5;
      --arch-surface: #FFFFFF;
      --arch-border: #E6E1D6;
      --arch-ink: #111827;
      --arch-muted: #57534E;
      --arch-accent: #B48327;
      --yamashi-gold: #C5A059;
      --yamashi-gold-dark: #9A6F1A;
      --yamashi-charcoal: #111827;
      --yamashi-dark: #18181B;
    }
    html:not(.dark) body {
      background-color: #FAF8F5 !important;
      color: #111827 !important;
      background-image:
        linear-gradient(to right, rgba(17, 24, 39, 0.024) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(17, 24, 39, 0.024) 1px, transparent 1px);
      background-size: 28px 28px;
    }
    html.dark body {
      background-color: #0C0D10 !important;
      background-image:
        linear-gradient(to right, rgba(197, 160, 89, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(197, 160, 89, 0.03) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* Black slider thumb as explicitly stated on izmirmutfakbanyo.com.tr/maliyet-hesapla/
       ("Aşağıdaki siyah düğmeyi sağa-sola kaydırarak...") */
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 22px !important;
      width: 22px !important;
      border-radius: 50% !important;
      background: #111827 !important;
      border: 3px solid #C5A059 !important;
      box-shadow: 0 4px 12px rgba(17, 24, 39, 0.35) !important;
      cursor: pointer;
      margin-top: -7px;
      transition: transform 0.15s ease, background-color 0.15s ease;
    }
    input[type=range]::-webkit-slider-thumb:hover {
      transform: scale(1.13);
      background: #000000 !important;
    }
    input[type=range]::-webkit-slider-runnable-track {
      background: #E5E0D5 !important;
      height: 8px !important;
      border-radius: 9999px !important;
    }
    .dark input[type=range]::-webkit-slider-runnable-track {
      background: #27272A !important;
    }

    /* Harmonize generic emerald/teal accents to Yamashi Mutfak Luxury Charcoal & Warm Gold */
    .tab-active {
      border-color: #111827 !important;
      color: #111827 !important;
      background-color: rgba(197, 160, 89, 0.15) !important;
    }
    .dark .tab-active {
      border-color: #C5A059 !important;
      color: #F3E5C8 !important;
      background-color: rgba(197, 160, 89, 0.18) !important;
    }
    .from-emerald-600.via-emerald-500.to-teal-700,
    .from-emerald-600.via-emerald-500.to-teal-400 {
      background-image: linear-gradient(135deg, #111827 0%, #27272A 55%, #B48327 100%) !important;
    }
    .bg-emerald-600, .bg-teal-600 {
      background-color: #111827 !important;
    }
    .hover\:bg-emerald-700:hover, .hover\:bg-teal-700:hover {
      background-color: #B48327 !important;
    }
    .text-emerald-600, .text-teal-600, .text-teal-700 {
      color: #9A6F1A !important;
    }
    .dark .text-emerald-400, .dark .text-teal-400, .dark .text-teal-300 {
      color: #D4AF37 !important;
    }
    .border-emerald-500, .border-teal-600, .border-teal-500 {
      border-color: #C5A059 !important;
    }

    /* Crisp architectural cards & hairline borders */
    .step-container {
      border-radius: 16px !important;
      border-color: #E6E1D6 !important;
      box-shadow: 0 4px 20px -4px rgba(17, 24, 39, 0.05) !important;
    }
    .dark .step-container {
      border-color: #27272A !important;
    }
    .work-card {
      border-radius: 12px !important;
      border-width: 1px !important;
      padding: 14px 16px !important;
      box-shadow: 0 1px 2px rgba(17, 24, 39, 0.03) !important;
    }
    .work-card.border-emerald-500\/80 {
      border-color: #111827 !important;
      border-left: 4px solid #C5A059 !important;
    }
    .poz-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 4px 7px;
      border-radius: 6px;
      background: #F4F1EA;
      color: #111827;
      border: 1px solid #DED8CA;
      white-space: nowrap;
    }
    .dark .poz-badge {
      background: #18181B;
      color: #F4F1EA;
      border-color: #3F3F46;
    }
    .sub-toggle-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 4px;
      background: rgba(197, 160, 89, 0.12);
      color: #855D14;
      border: 1px solid rgba(197, 160, 89, 0.35);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .dark .sub-toggle-pill {
      background: rgba(197, 160, 89, 0.16);
      color: #E5C158;
      border-color: rgba(197, 160, 89, 0.35);
    }

    /* ==========================================================================
       YAMASHI 3D STUDIO v7.0 — SIMPLE, STABLE, CLEAN ARCHITECTURAL STYLING
       ========================================================================== */
    #bim3dCanvas {
      cursor: grab;
      touch-action: none;
    }
    #bim3dCanvas:active {
      cursor: grabbing;
    }
    .bim-mode-btn {
      transition: all 0.18s ease;
    }
    .bim-mode-btn.active {
      background-color: #C5A059 !important;
      color: #111827 !important;
      border-color: #D4AF37 !important;
      font-weight: 800 !important;
      box-shadow: 0 2px 10px rgba(197, 160, 89, 0.35);
    }
    .bim-render-btn.active {
      background-color: #111827 !important;
      color: #F5E6C8 !important;
      border-color: #C5A059 !important;
    }
    .bim-cam-btn.active {
      background-color: #C5A059 !important;
      color: #111827 !important;
      border-color: #D4AF37 !important;
      font-weight: 700 !important;
    }
    .yamashi-swatch-btn {
      transition: all 0.15s ease;
    }
    .yamashi-swatch-btn.active {
      outline: 2px solid #C5A059;
      outline-offset: 2px;
      transform: scale(1.06);
    }
  </style>
  <!-- Three.js r128 WebGL 360° Real-Time Architectural Engine -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-white">

  <!-- TOP EXECUTIVE STATUS BAR -->
  <div class="no-print bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center space-x-2.5">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          ÇŞB 2026/Q4 BİRİM FİYAT ENDEKSİ
        </span>
        <span class="hidden md:inline text-slate-400">TS 825 & DIN 276 Standartlarında Mimari Rölöve, Poz Bazlı Metraj ve Yaklaşık Maliyet Sistemi</span>
      </div>
      <div class="flex items-center space-x-4 text-xs font-medium">
        <!-- Currency Switcher -->
        <div class="flex items-center bg-slate-800 rounded-lg p-0.5 border border-slate-700">
          <button type="button" data-currency="TRY" class="currency-btn px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-600 text-white transition-all">₺ TRY</button>
          <button type="button" data-currency="USD" class="currency-btn px-2 py-0.5 rounded-md text-[11px] font-semibold text-slate-400 hover:text-white transition-all">$ USD</button>
          <button type="button" data-currency="EUR" class="currency-btn px-2 py-0.5 rounded-md text-[11px] font-semibold text-slate-400 hover:text-white transition-all">€ EUR</button>
        </div>

        <button id="themeToggleBtn" type="button" aria-label="Tema Değiştir" class="hover:text-white text-slate-300 transition-colors flex items-center gap-1.5 bg-slate-800/80 px-2.5 py-1 rounded-lg border border-slate-700">
          <svg id="themeIconSun" class="w-3.5 h-3.5 hidden text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg id="themeIconMoon" class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          <span id="themeText">Koyu Mod</span>
        </button>
      </div>
    </div>
  </div>

  <!-- STICKY ARCHITECTURAL HEADER -->
  <header class="no-print sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800 transition-colors shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20 gap-3">
        
        <!-- Ana Siteye Dönüş Butonu -->
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition shadow-xs">
          <span>←</span>
          <span>Ana Sayfa</span>
        </a>

        <!-- Brand Logo -->
        <div class="flex items-center space-x-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-emerald-600 via-emerald-500 to-teal-700 flex items-center justify-center text-white shadow-glow shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">Renova<span class="text-emerald-500">IQ</span></span>
              <span class="text-[10px] font-extrabold tracking-wider uppercase px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">ENGINEERING STUDIO v4.0</span>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block">Mimari Rölöve, Metraj Cetveli & Hakediş Mühendislik Platformu</p>
          </div>
        </div>

        <!-- View Mode Switcher -->
        <nav class="hidden md:flex items-center bg-slate-100 dark:bg-slate-800/90 p-1 rounded-xl border border-slate-200/70 dark:border-slate-700">
          <button id="viewModeWizard" type="button" class="tab-btn px-3.5 py-2 text-xs font-bold rounded-lg transition-all flex items-center gap-1.5 tab-active shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            Adım Adım Rehber (Sihirbaz)
          </button>
          <button id="viewModeExpert" type="button" class="tab-btn px-3.5 py-2 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
            Tüm Kalemler & Uzman Modu
          </button>
        </nav>

        <!-- City Selector & Live Header Pill -->
        <div class="flex items-center space-x-2.5">
          <div class="relative">
            <label for="citySelect" class="sr-only">Şehir Seçimi</label>
            <select id="citySelect" class="bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-bold rounded-xl border border-slate-200 dark:border-slate-700 py-2.5 pl-3 pr-8 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
              <option value="istanbul_avrupa">İstanbul (Avrupa) +15%</option>
              <option value="istanbul_anadolu">İstanbul (Anadolu) +10%</option>
              <option value="izmir" selected>İzmir (Merkez & Çeşme) +5%</option>
              <option value="ankara">Ankara (Baz Endeks)</option>
              <option value="antalya">Antalya / Bodrum +12%</option>
              <option value="bursa">Bursa / Kocaeli +2%</option>
              <option value="diger">Diğer İller -8%</option>
            </select>
          </div>

          <button id="btnSaveScenario" type="button" title="Mevcut Hesabı Karşılaştırmak İçin Kaydet" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-bold transition-all">
            <span class="sr-only">📌</span><svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
            <span id="saveScenarioText">Senaryo Kaydet</span>
          </button>

          <div class="hidden xl:flex items-center bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/70 rounded-xl px-3.5 py-1.5">
            <div class="text-right">
              <div class="text-[10px] uppercase font-extrabold text-emerald-600 dark:text-emerald-400 tracking-wider">Canlı Keşif</div>
              <div id="topTotalBadge" class="text-sm font-extrabold text-slate-900 dark:text-white font-mono">₺ 0</div>
            </div>
          </div>
        </div>
      </div>
