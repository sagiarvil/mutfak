---
import Layout from "../../layouts/Layout.astro";

const pageSeo = {
  title: "Tadilat ve Özel İmalat Maliyet Hesaplama Motoru 2026 | İzmir Mutfak Banyo",
  description: "İzmir mutfak dolabı, lüks banyo renovasyonu ve anahtar teslim daire tadilatı maliyetlerini canlı hesaplayın. 2026 doğrudan atölye imalat ve montaj cetveli.",
  canonical: "https://izmirmutfakbanyo.com.tr/maliyet-hesapla/",
  ogType: "website"
};
---

<Layout seo={pageSeo}>
  <!-- ULTRA PREMİUM EDİTORYAL MİMARİ SAYFA DOKUSU -->
  <div class="bg-[#FBFBFA] text-[#1A1A1A] min-h-screen selection:bg-neutral-900 selection:text-white">
    
    <!-- ÜST EDİTORYAL GİRİŞ -->
    <section class="border-b border-[#EBEBE8] pt-14 pb-12 sm:pt-20 sm:pb-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-4">
        
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white border border-[#E2E2DC] shadow-[0_2px_8px_rgba(0,0,0,0.03)] text-[11px] font-bold tracking-[0.18em] text-neutral-800 uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>İZMİR ATÖLYE METRAJ STANDARDI • 2026</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light tracking-[-0.03em] text-[#111111] font-serif">
          Tadilat &amp; İmalat <span class="italic font-normal">Maliyet Hesaplayıcı</span>
        </h1>

        <p class="text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto font-light leading-relaxed">
          Kişiye ve mekânın karakterine özel mutfak dolapları, lüks banyo dönüşümleri ve anahtar teslim mimari renovasyon projeleriniz için doğrudan atölye maliyetini şeffaf olarak simüle edin.
        </p>

        <!-- PREMİUM SEGMENTLİ KONTROL ÇUBUĞU (MILANO MİMARİ TABS) -->
        <div class="pt-6">
          <div class="inline-flex p-1.5 bg-[#EFEFEA] rounded-2xl border border-[#DFDFD8] shadow-inner max-w-xl w-full">
            <button 
              type="button" 
              id="tabBtnMutfak" 
              class="calc-tab-btn flex-1 py-3 px-5 rounded-xl text-xs font-bold transition-all duration-200 bg-neutral-900 text-white shadow-md flex items-center justify-center gap-2"
              data-target="panelMutfak"
            >
              <span>Mutfak İmalatı</span>
            </button>
            <button 
              type="button" 
              id="tabBtnBanyo" 
              class="calc-tab-btn flex-1 py-3 px-5 rounded-xl text-xs font-semibold transition-all duration-200 text-neutral-600 hover:text-neutral-900 flex items-center justify-center gap-2"
              data-target="panelBanyo"
            >
              <span>Banyo Renovasyonu</span>
            </button>
            <button 
              type="button" 
              id="tabBtnKomple" 
              class="calc-tab-btn flex-1 py-3 px-5 rounded-xl text-xs font-semibold transition-all duration-200 text-neutral-600 hover:text-neutral-900 flex items-center justify-center gap-2"
              data-target="panelKomple"
            >
              <span>Komple Daire</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- ANA GÖVDE (İKİ KOLON: FORM + MİMARİ RAPOR KARTI) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      
      <!-- ============================================================== -->
      <!-- 1. MUTFAK PANELİ                                               -->
      <!-- ============================================================== -->
      <div id="panelMutfak" class="calc-panel block">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          
          <!-- SOL FORM BÖLÜMÜ (7 SÜTUN) -->
          <div class="lg:col-span-7 space-y-10">
            
            <!-- 1. ALAN AYARI -->
            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block mb-1">01 / MEKÂN ÖLÇÜSÜ</span>
                  <h3 class="text-base font-serif font-bold text-neutral-900">Mutfak Taban Alanı</h3>
                </div>
                <div class="flex items-center gap-2 bg-[#F7F7F4] border border-[#E5E5DE] px-4 py-2 rounded-xl">
                  <input type="number" id="m_alan_input" min="5" max="40" value="12" class="w-12 bg-transparent text-center font-serif text-lg font-bold text-neutral-900 focus:outline-none" />
                  <span class="text-xs font-bold text-neutral-500 uppercase">m²</span>
                </div>
              </div>

              <div class="pt-2">
                <input type="range" id="m_alan_slider" min="5" max="40" value="12" class="w-full h-1.5 bg-[#E8E8E3] rounded-lg appearance-none cursor-pointer accent-neutral-900" />
                <div class="flex justify-between text-[11px] text-neutral-400 font-medium pt-2">
                  <span>5 m² (Kompakt Daire)</span>
                  <span class="text-neutral-700 font-bold">12 m² (Standart)</span>
                  <span>20 m² (Ada Mutfak)</span>
                  <span>40 m² (Lüks Villa)</span>
                </div>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs text-neutral-500 bg-[#FAFAF8] p-3 rounded-xl border border-[#EDEDE8]">
                <span>📐 Hesaplanan Tahmini Dolap Boyu:</span>
                <span class="font-bold text-neutral-900 font-mono" id="m_calc_mtul">4.6 Metretül (mtül)</span>
              </div>
            </div>

            <!-- 2. BİNA YAŞI -->
            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
              <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">02 / YAPI ALTYAPISI</span>
              <h3 class="text-base font-serif font-bold text-neutral-900">Bina Yaşı &amp; Tesisat Durumu</h3>
              
              <div class="grid grid-cols-3 gap-3 pt-1">
                <button type="button" class="opt-card active p-4 rounded-2xl border text-left transition relative" data-group="m_bina" data-val="yeni">
                  <div class="text-xs font-bold text-neutral-900">0 – 10 Yıl</div>
                  <div class="text-[11px] text-neutral-500 font-normal mt-0.5">Standart Altyapı</div>
                </button>
                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition relative" data-group="m_bina" data-val="orta">
                  <div class="text-xs font-bold text-neutral-900">11 – 20 Yıl</div>
                  <div class="text-[11px] text-neutral-500 font-normal mt-0.5">Kısmi Revizyon (+%15)</div>
                </button>
                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition relative" data-group="m_bina" data-val="eski">
                  <div class="text-xs font-bold text-neutral-900">20+ Yıl</div>
                  <div class="text-[11px] text-neutral-500 font-normal mt-0.5">Eski Tesisat (+%25)</div>
                </button>
              </div>
            </div>

            <!-- 3. DOLAP KAPAK & GÖVDE -->
            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
              <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">03 / ATÖLYE İMALAT MALZEMESİ</span>
              <h3 class="text-base font-serif font-bold text-neutral-900">Kapak ve Gövde Standardı</h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition relative flex flex-col justify-between" data-group="m_dolap" data-val="mdf">
                  <div>
                    <div class="text-xs font-bold text-neutral-900">MDF-Lam Kapak</div>
                    <div class="text-[11px] text-neutral-500 font-normal mt-1 leading-relaxed">Ekonomik, çizilmeye dirençli ve uzun ömürlü.</div>
                  </div>
                  <div class="text-[11px] font-mono text-neutral-700 font-bold mt-3">₺8.500 / mtül'den</div>
                </button>

                <button type="button" class="opt-card active p-4 rounded-2xl border text-left transition relative flex flex-col justify-between" data-group="m_dolap" data-val="akrilik">
                  <div class="absolute -top-2.5 right-3 bg-neutral-900 text-white text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-full font-bold">Popüler</div>
                  <div>
                    <div class="text-xs font-bold text-neutral-900">Çizilmez Akrilik</div>
                    <div class="text-[11px] text-neutral-500 font-normal mt-1 leading-relaxed">Ayna parlaklığı veya mat doku, kolay temizlenir.</div>
                  </div>
                  <div class="text-[11px] font-mono text-neutral-700 font-bold mt-3">₺12.500 / mtül'den</div>
                </button>

                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition relative flex flex-col justify-between" data-group="m_dolap" data-val="lake">
                  <div>
                    <div class="text-xs font-bold text-neutral-900">İpek Mat Fırın Lake</div>
                    <div class="text-[11px] text-neutral-500 font-normal mt-1 leading-relaxed">Poliüretan kabin boyası, sınırsız renk seçeneği.</div>
                  </div>
                  <div class="text-[11px] font-mono text-neutral-700 font-bold mt-3">₺19.500 / mtül'den</div>
                </button>
              </div>
            </div>

            <!-- 4. TEZGAH -->
            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
              <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">04 / TEZGAH SEÇİMİ</span>
              <h3 class="text-base font-serif font-bold text-neutral-900">Mutfak Tezgahı Malzemesi</h3>
              
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                <button type="button" class="opt-card p-3.5 rounded-2xl border text-center transition" data-group="m_tezgah" data-val="laminat">
                  <div class="text-xs font-bold text-neutral-900">Laminat</div>
                  <div class="text-[10px] text-neutral-400 mt-0.5">Ekonomik</div>
                </button>
                <button type="button" class="opt-card p-3.5 rounded-2xl border text-center transition" data-group="m_tezgah" data-val="granit">
                  <div class="text-xs font-bold text-neutral-900">Doğal Granit</div>
                  <div class="text-[10px] text-neutral-400 mt-0.5">Doğal Taş</div>
                </button>
                <button type="button" class="opt-card active p-3.5 rounded-2xl border text-center transition" data-group="m_tezgah" data-val="kuvars">
                  <div class="text-xs font-bold text-neutral-900">Kuvars (Çimstone)</div>
                  <div class="text-[10px] text-neutral-400 mt-0.5">Leke Tutmaz</div>
                </button>
                <button type="button" class="opt-card p-3.5 rounded-2xl border text-center transition" data-group="m_tezgah" data-val="porselen">
                  <div class="text-xs font-bold text-neutral-900">Lamar Porselen</div>
                  <div class="text-[10px] text-neutral-400 mt-0.5">Isıya %100 Direnç</div>
                </button>
              </div>
            </div>

            <!-- 5. ŞANTİYE VE TESİSAT -->
            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
              <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">05 / UYGULAMA VE ŞANTİYE KAPSAMI</span>
              <h3 class="text-base font-serif font-bold text-neutral-900">İlave Şantiye &amp; Tesisat Kalemleri</h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 text-xs">
                <label class="p-4 rounded-2xl border border-[#E8E8E3] hover:border-neutral-300 flex items-center justify-between cursor-pointer bg-[#FDFDFD] transition">
                  <div>
                    <span class="font-bold text-neutral-900 block">Kırım &amp; Moloz Tahliyesi</span>
                    <span class="text-[11px] text-neutral-500">Eski dolap ve fayansların sökülmesi</span>
                  </div>
                  <input type="checkbox" id="m_chk_yikim" class="w-4 h-4 rounded text-neutral-900 accent-neutral-900 cursor-pointer" checked />
                </label>

                <label class="p-4 rounded-2xl border border-[#E8E8E3] hover:border-neutral-300 flex items-center justify-between cursor-pointer bg-[#FDFDFD] transition">
                  <div>
                    <span class="font-bold text-neutral-900 block">Zemin Granit / Seramik</span>
                    <span class="text-[11px] text-neutral-500">60x120 derzsiz porselen döşeme</span>
                  </div>
                  <input type="checkbox" id="m_chk_zemin" class="w-4 h-4 rounded text-neutral-900 accent-neutral-900 cursor-pointer" checked />
                </label>

                <label class="p-4 rounded-2xl border border-[#E8E8E3] hover:border-neutral-300 flex items-center justify-between cursor-pointer bg-[#FDFDFD] transition">
                  <div>
                    <span class="font-bold text-neutral-900 block">Sıhhi Su Tesisatı</span>
                    <span class="text-[11px] text-neutral-500">PPRC temiz su ve atık giderleri</span>
                  </div>
                  <input type="checkbox" id="m_chk_su" class="w-4 h-4 rounded text-neutral-900 accent-neutral-900 cursor-pointer" checked />
                </label>

                <label class="p-4 rounded-2xl border border-[#E8E8E3] hover:border-neutral-300 flex items-center justify-between cursor-pointer bg-[#FDFDFD] transition">
                  <div>
                    <span class="font-bold text-neutral-900 block">Elektrik Altyapısı</span>
                    <span class="text-[11px] text-neutral-500">Ankastre ve tezgah priz hatları</span>
                  </div>
                  <input type="checkbox" id="m_chk_elektrik" class="w-4 h-4 rounded text-neutral-900 accent-neutral-900 cursor-pointer" checked />
                </label>

                <label class="p-4 rounded-2xl border border-[#E8E8E3] hover:border-neutral-300 flex items-center justify-between cursor-pointer bg-[#FDFDFD] transition">
                  <div>
                    <span class="font-bold text-neutral-900 block">Boya Badana</span>
                    <span class="text-[11px] text-neutral-500">Tavan ve duvar silinebilir boya</span>
                  </div>
                  <input type="checkbox" id="m_chk_boya" class="w-4 h-4 rounded text-neutral-900 accent-neutral-900 cursor-pointer" checked />
                </label>

                <label class="p-4 rounded-2xl border border-[#E8E8E3] hover:border-neutral-300 flex items-center justify-between cursor-pointer bg-[#FDFDFD] transition">
                  <div>
                    <span class="font-bold text-neutral-900 block">Lineer Gizli LED</span>
                    <span class="text-[11px] text-neutral-500">Tezgah altı alüminyum profil</span>
                  </div>
                  <input type="checkbox" id="m_chk_aydinlatma" class="w-4 h-4 rounded text-neutral-900 accent-neutral-900 cursor-pointer" checked />
                </label>
              </div>
            </div>

          </div>

          <!-- SAĞ SÜTUN: MİMARİ BÜTÇE KARTI (5 SÜTUN - STICKY) -->
          <div class="lg:col-span-5 sticky top-28 space-y-5">
            <div class="bg-neutral-900 text-white p-8 sm:p-9 rounded-3xl shadow-2xl border border-neutral-800 space-y-6">
              
              <div class="flex items-center justify-between border-b border-neutral-800 pb-4">
                <div>
                  <span class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">İZMİR ATÖLYE HESABI</span>
                  <span class="text-xs text-neutral-200 font-medium">Mutfak İmalat Özeti</span>
                </div>
                <div class="px-2.5 py-1 rounded-full bg-neutral-800 border border-neutral-700 text-[10px] font-mono text-emerald-400">
                  ARACISIZ ATÖLYE
                </div>
              </div>

              <!-- FİYAT ALANI -->
              <div class="py-2 text-center">
                <span class="text-xs text-neutral-400 font-light block mb-2">Tahmini Bütçe Aralığı</span>
                <div class="text-3xl sm:text-4xl font-serif font-bold text-white tracking-tight" id="m_total_display">
                  ₺ 85.000 – ₺ 120.000
                </div>
                <div class="inline-flex items-center gap-1.5 mt-3 px-3 py-1 rounded-full bg-emerald-950/60 border border-emerald-800/80 text-emerald-400 text-[11px] font-medium">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>%30 Doğrudan Atölye İmalat Avantajı</span>
                </div>
              </div>

              <!-- KALEM DÖKÜMÜ -->
              <div class="border-t border-b border-neutral-800 py-4 space-y-2.5 text-xs" id="m_breakdown_list"></div>

              <!-- GARANTİ MADDELERİ -->
              <div class="space-y-1.5 text-[11px] text-neutral-400 pt-1">
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400">✓</span> E1 Sertifikalı Neme Dayanıklı MDF-Lam Gövde
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400">✓</span> Blum &amp; Häfele Frenli Sessiz Menteşeler
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-400">✓</span> 3D Fotogerçekçi Mimari Çizim Ücretsiz
                </div>
              </div>

              <!-- AKSİYON BUTONLARI -->
              <div class="pt-2 space-y-3">
                <a 
                  id="m_btn_whatsapp" 
                  href="#" 
                  target="_blank" 
                  class="w-full py-4 px-5 bg-white hover:bg-neutral-100 text-neutral-900 font-bold rounded-2xl text-center block text-xs tracking-wider uppercase transition shadow-lg"
                >
                  Bu Hesabı WhatsApp'a Gönder →
                </a>
                <a 
                  href="tel:05393333303" 
                  class="w-full py-3 px-4 bg-neutral-800/80 hover:bg-neutral-800 text-neutral-200 font-semibold rounded-2xl text-center block text-xs transition border border-neutral-700"
                >
                  Mimarımızla Görüşün: 0539 333 33 03
                </a>
              </div>

              <p class="text-[10px] text-neutral-500 text-center leading-relaxed">
                * Kesin bütçe, atölye mimarımızın evinizde yapacağı lazer rölöve keşfi ve seçilecek ray/kulp mekanizmaları ile sabitlenir.
              </p>
            </div>
          </div>

        </div>
      </div>


      <!-- ============================================================== -->
      <!-- 2. BANYO PANELİ                                                -->
      <!-- ============================================================== -->
      <div id="panelBanyo" class="calc-panel hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          
          <div class="lg:col-span-7 space-y-10">
            
            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-5">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block mb-1">01 / BANYO ÖLÇÜSÜ</span>
                  <h3 class="text-base font-serif font-bold text-neutral-900">Banyo Taban Alanı</h3>
                </div>
                <div class="flex items-center gap-2 bg-[#F7F7F4] border border-[#E5E5DE] px-4 py-2 rounded-xl">
                  <input type="number" id="b_alan_input" min="3" max="25" value="6" class="w-12 bg-transparent text-center font-serif text-lg font-bold text-neutral-900 focus:outline-none" />
                  <span class="text-xs font-bold text-neutral-500 uppercase">m²</span>
                </div>
              </div>
              <input type="range" id="b_alan_slider" min="3" max="25" value="6" class="w-full h-1.5 bg-[#E8E8E3] rounded-lg appearance-none cursor-pointer accent-neutral-900" />
              <div class="flex justify-between text-[11px] text-neutral-400 font-medium">
                <span>3 m² (Misafir Banyo)</span>
                <span class="text-neutral-700 font-bold">6 m² (Standart)</span>
                <span>12 m² (Lüks Geniş)</span>
                <span>25 m² (Villa SPA)</span>
              </div>
            </div>

            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
              <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">02 / BİNA YAŞI</span>
              <h3 class="text-base font-serif font-bold text-neutral-900">Altyapı Durumu</h3>
              <div class="grid grid-cols-3 gap-3 pt-1">
                <button type="button" class="opt-card active p-4 rounded-2xl border text-left transition" data-group="b_bina" data-val="yeni">
                  <div class="text-xs font-bold text-neutral-900">0 – 10 Yıl</div>
                  <div class="text-[11px] text-neutral-500 mt-0.5">Standart</div>
                </button>
                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition" data-group="b_bina" data-val="orta">
                  <div class="text-xs font-bold text-neutral-900">11 – 20 Yıl</div>
                  <div class="text-[11px] text-neutral-500 mt-0.5">Kısmi Yenileme (+%15)</div>
                </button>
                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition" data-group="b_bina" data-val="eski">
                  <div class="text-xs font-bold text-neutral-900">20+ Yıl</div>
                  <div class="text-[11px] text-neutral-500 mt-0.5">Eski Tesisat (+%25)</div>
                </button>
              </div>
            </div>

            <div class="bg-white p-7 sm:p-9 rounded-3xl border border-[#E8E8E3] shadow-[0_4px_24px_rgba(0,0,0,0.02)] space-y-4">
              <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-bold block">03 / SERAMİK TERCİHİ</span>
              <h3 class="text-base font-serif font-bold text-neutral-900">Fayans &amp; Porselen Kalitesi</h3>
              <div class="grid grid-cols-2 gap-3.5 pt-1">
                <button type="button" class="opt-card active p-4 rounded-2xl border text-left transition" data-group="b_seramik" data-val="standart">
                  <div class="text-xs font-bold text-neutral-900">Standart 60x60 Seramik</div>
                  <div class="text-[11px] text-neutral-500 mt-1">Çanakkale / VitrA Kalitesi</div>
                </button>
                <button type="button" class="opt-card p-4 rounded-2xl border text-left transition" data-group="b_seramik" data-val="premium">
                  <div class="text-xs font-bold text-neutral-900">60x120 Derzsiz Porselen</div>
                  <div class="text-[11px] text-neutral-500 mt-1">Lazer Kesim Prestij Karolar</div>
                </button>
              </div>
            </div>

