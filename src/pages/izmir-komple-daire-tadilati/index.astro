---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Komple Ev Tadilatı | Mimari Proje & Uygulama",
  description: "İzmir komple daire ve ev tadilatı. Elektrik, su tesisatı, parke, boya, alçı tavan, lake kapı, mutfak ve banyo yenileme. Kadrolu mimarımızla 3D sanal simülasyon ve anahtar teslim güvence.",
  canonical: "https://yesilaymutfak.com/izmir-komple-daire-tadilati/",
  serviceName: "Komple Daire ve Ev Tadilatı",
  breadcrumbs: [
    { name: "Komple Daire Tadilatı", url: "/izmir-komple-daire-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de eski daireyi baştan sona komple yenileme adımları ve mimari işçilik nasıl yürütülür?",
      answer: "Önce mimarımız yerinde rölöve alıp 3D sanal canlandırmayı hazırlar. Onayın ardından kırım-hafriyat, su ve elektrik tesisatı, şap, alçıpan asma tavan, boya, seramik, lamine parke ve dolap montajları sırayla tek elden tamamlanır."
    },
    {
      question: "3+1 daire komple tadilatı kaç iş günü sürer?",
      answer: "Kapsamına bağlı olarak standart bir 3+1 daire komple tadilatı 20 ila 30 iş günü içerisinde temizliği yapılmış halde oturuma hazır teslim edilir."
    },
    {
      question: "Tadilat sürecinde şantiye takibi nasıl yapılır?",
      answer: "Kadrolu iç mimarımız şantiyeyi her gün denetler. WhatsApp üzerinden günlük fotoğraflı ve videolu şantiye raporu iletilir."
    }
  ]
};
---

<Layout seo={seo} activeService="Komple Daire Tadilatı">
  
  <!-- HERO BÖLÜMÜ (AYDINLIK, FERAH & CANLI DAİRE TADİLATI VİTRİNİ) -->
  <section class="relative py-20 sm:py-28 overflow-hidden bg-[#041F14]">
    <div class="absolute inset-0 bg-cover bg-center opacity-75 scale-105 transition-transform duration-1000" style="background-image: url('/media/projeler/proje-05.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#02130C]/90 via-[#041F14]/60 to-black/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#02130C] via-transparent to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6 z-10 [text-shadow:_0_2px_12px_rgba(0,0,0,0.8)]">
      <nav class="flex items-center gap-2 text-xs font-semibold text-[#D8D2C7] uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-[#C5A880]">Komple Daire Tadilatı</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-black/40 backdrop-blur-md border border-[#C5A880]/50 text-[#C5A880] text-[11px] font-bold tracking-[0.2em] uppercase rounded-full shadow-lg">
        <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
        <span>1998'DEN BUGÜNE 28 YILLIK TECRÜBE • 2.850+ TESLİM EDİLMİŞ PROJE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.12] drop-shadow-xl">
        İzmir Komple Daire ve Ev Tadilatı: <br /><span class="text-[#C5A880] font-serif font-normal italic">Elektrik-Su Tesisatı, Parke, Boya ve Alçı Çözümleri</span>
      </h1>

      <p class="text-base sm:text-lg text-[#F0EAE1] font-light leading-relaxed max-w-2xl drop-shadow-md">
        1998'den bu yana İzmir Buca merkez imalat atölyemizle daireleri A'dan Z'ye yeniliyoruz. Kadrolu mimar ve iç mimarlarımızla 3D sanal canlandırma simülasyonu sunuyor, resmi sözleşmeli mimar onaylı sözleşme garantisiyle teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-3">
        <a 
          href="https://wa.me/905324261788?text=Merhaba,%20komple%20daire%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-8 py-3.5 bg-[#C5A880] hover:bg-[#D4AF37] text-[#041F14] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded border border-[#E5C378] shadow-2xl transition-all duration-300 flex items-center gap-2 hover:scale-[1.02]"
        >
          <span>WhatsApp ile Keşif İste</span>
          <span>→</span>
        </a>
        <a 
          href="tel:02324411060" 
          class="px-8 py-3.5 bg-black/40 hover:bg-black/60 border border-white/30 text-white text-xs sm:text-sm font-semibold uppercase tracking-wider rounded backdrop-blur-md transition duration-300 hover:scale-[1.02]"
        >
          0232 441 1060
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-[#F8F9FA] border-b border-[#E5DFD5] py-16" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-[#006039] pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880]">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#041F14]">Komple Ev Tadilatı Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Tesisat &amp; Elektrik</strong>
          <p class="text-stone-600">Siemens/Schneider Sigortalar, Yanmaz Kablo, Kompozit Boru Altyapısı.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Zemin &amp; Duvar</strong>
          <p class="text-stone-600">60x120 Granit Seramik, AGT / Çamsan Derzli Parke, Jotun / Filli Boya Alçı Uygulaması.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Mobilya &amp; Kapı</strong>
          <p class="text-stone-600">Özel İmalat Lake İç Kapılar, MDF-Lam Mutfak/Banyo Dolapları, Blum Frenli Raylar.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Komple Daire Tadilatı 20-30 İş Günü (Taahhütlü ve Gecikme Cezalı Sözleşme).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-[#041F14] block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1998</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">28 Yıllık Tecrübe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.850+ tamamlanmış daire ve villa projesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tek Muhatap Mimari Yönetim</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta aramak yok; tüm şantiyeyi kadrolu mimarımız yönetir.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizi üretime girmeden önce 3 boyutlu simülasyonla yaşayın.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden tüm İzmir geneline yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Komple Daire Tadilatı Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-[#041F14]">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Evinizi Yenilemek İçin Ücretsiz Keşif Randevusu Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp üzerinden iletişime geçin; mimarımız adresinizde keşif randevusu oluştursun.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905324261788?text=Merhaba,%20komple%20daire%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0532 426 17 88)
        </a>
      </div>
    </div>
  </section>

</Layout>