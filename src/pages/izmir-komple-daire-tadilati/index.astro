---
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../data/siteConfig";

const seo = {
  title: "İzmir Komple Ev Tadilatı | Mimari Proje & Uygulama",
  description: "İzmir komple daire ve ev tadilatı. Elektrik, su tesisatı, parke, boya, alçı tavan, lake kapı, mutfak ve banyo yenileme. Kadrolu mimarımızla 3D sanal simülasyon ve anahtar teslim güvence.",
  canonical: "https://izmirmutfakbanyo.com.tr/izmir-komple-daire-tadilati/",
  serviceName: "Komple Daire ve Ev Tadilatı",
  breadcrumbs: [
    { name: "Komple Daire Tadilatı", url: "/izmir-komple-daire-tadilati/" }
  ],
  faqList: [
    {
      question: "İzmir'de eski daireyi baştan sona komple yenileme adımları ve mimari işçilik nasıl yürütülür?",
      answer: "Önce mimarımız yerinde rölöve alıp 3D sanal canlandırmayı hazırlar. Onayın ardından kırım-hafriyat, su ve elektrik tesisatı, şap, alçıpan asma tavan, boya, seramik, lamine parke ve dolap montajları sırayla tek elden tamamlanır."
    },
    {
      question: "3+1 daire komple tadilatı kaç iş günü sürer?",
      answer: "Kapsamına bağlı olarak standart bir 3+1 daire komple tadilatı 20 ila 30 iş günü içerisinde temizliği yapılmış halde oturuma hazır teslim edilir."
    },
    {
      question: "Tadilat sürecinde şantiye takibi nasıl yapılır?",
      answer: "Kadrolu iç mimarımız şantiyeyi her gün denetler. WhatsApp üzerinden günlük fotoğraflı ve videolu şantiye raporu iletilir."
    }
  ]
};
---

<Layout seo={seo} activeService="Komple Daire Tadilatı">
  
  <!-- HERO BÖLÜMÜ -->
  <section class="relative bg-stone-950 text-white py-20 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=75&fm=webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/80 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 uppercase tracking-widest" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition">Ana Sayfa</a>
        <span>/</span>
        <span class="text-emerald-400">Komple Daire Tadilatı</span>
      </nav>

      <span class="inline-block px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-400/40 text-emerald-300 text-[11px] font-black tracking-[0.2em] uppercase shadow-lg">
        1984'TEN BUGÜNE 42 YILLIK TECRÜBE • 2.463+ TESLİM EDİLMİŞ PROJE
      </span>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.15]" style="font-family: 'Playfair Display', Georgia, serif;">
        İzmir Komple Daire ve Ev Tadilatı: <br /><span class="font-normal italic">Elektrik-Su Tesisatı, Parke, Boya ve Alçı Çözümleri</span>
      </h1>

      <p class="text-sm sm:text-base text-stone-300 font-light leading-relaxed max-w-2xl">
        1984'ten bu yana İzmir Buca merkez atölyeumuz ve imalat atölyemizle daireleri A'dan Z'ye yeniliyoruz. Kadrolu mimar ve iç mimarlarımızla 3D sanal canlandırma simülasyonu sunuyor, resmi sözleşmeli sabit fiyat garantisiyle teslim ediyoruz.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20komple%20daire%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg inline-flex items-center gap-2">
          <span>💬</span> <span>WhatsApp ile Keşif İste</span>
        </a>
        <a href="tel:05393333303" class="px-8 py-3.5 bg-transparent border border-stone-400 text-white text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-stone-950 transition">
          📞 0539 333 33 03
        </a>
      </div>
    </div>
  </section>

  <!-- AEO / LLM GROUNDING -->
  <section class="bg-stone-100 border-b border-stone-200 py-10" id="teknik-standartlar">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <div class="border-l-4 border-emerald-600 pl-4 space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-800">AEO &amp; MÜHENDİSLİK SPESİFİKASYONU</span>
        <h2 class="text-xl sm:text-2xl font-bold text-stone-900">Komple Ev Tadilatı Teknik Özellikler ve Standartlar Tablosu</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Tesisat &amp; Elektrik</strong>
          <p class="text-stone-600">Siemens/Schneider Sigortalar, Yanmaz Kablo, Kompozit Boru Altyapısı.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Zemin &amp; Duvar</strong>
          <p class="text-stone-600">60x120 Granit Seramik, AGT / Çamsan Derzli Parke, Jotun / Filli Boya Alçı Uygulaması.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Mobilya &amp; Kapı</strong>
          <p class="text-stone-600">Özel İmalat Lake İç Kapılar, MDF-Lam Mutfak/Banyo Dolapları, Blum Frenli Raylar.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Hizmet Bölgesi</strong>
          <p class="text-stone-600">Konak, Karşıyaka, Bornova, Çiğli, Urla, Çeşme, Güzelbahçe, Narlıdere, Gaziemir, Buca.</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Ortalama Teslimat Süresi</strong>
          <p class="text-stone-600">Komple Daire Tadilatı 20-30 İş Günü (Taahhütlü ve Gecikme Cezalı Sözleşme).</p>
        </div>
        <div class="bg-white p-4 border border-stone-200 shadow-2xs space-y-1">
          <strong class="text-stone-900 block text-xs uppercase tracking-wider text-emerald-700">Projelendirme</strong>
          <p class="text-stone-600">Ücretsiz Yerinde Lazer Ölçü ve 3D Render Modelleme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 SÜTUN GÜVEN ŞERİDİ -->
  <section class="bg-[#121212] text-white border-b border-stone-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-start gap-4">
          <span class="text-3xl text-emerald-400 font-editorial shrink-0">1984</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">42 Yıllık Tecrübe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">2.463+ tamamlanmış daire ve villa projesi.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">🏛️</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Tek Muhatap Mimari Yönetim</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Usta aramak yok; tüm şantiyeyi kadrolu mimarımız yönetir.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">✨</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">3D Sanal Canlandırma</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Evinizi üretime girmeden önce 3 boyutlu simülasyonla yaşayın.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <span class="text-2xl text-emerald-400 shrink-0">📍</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Buca Mağaza &amp; 30 İlçe</h4>
            <p class="text-xs text-stone-400 font-light leading-relaxed">Atölyemizden tüm İzmir geneline yerinde ücretsiz keşif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SSS BÖLÜMÜ -->
  <section class="py-20 sm:py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">MERAK EDİLENLER</span>
        <h2 class="text-2xl sm:text-3xl font-light text-stone-950 font-editorial">Komple Daire Tadilatı Hakkında Sorularınız</h2>
      </div>

      <div class="space-y-4">
        {seo.faqList.map((faq) => (
          <div class="bg-white border border-stone-200 p-6 space-y-2 shadow-2xs">
            <h3 class="font-bold text-sm text-stone-900">{faq.question}</h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ÇAĞRI BÖLÜMÜ -->
  <section class="py-16 bg-stone-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-light font-editorial">Evinizi Yenilemek İçin Ücretsiz Keşif Randevusu Alın</h2>
      <p class="text-xs sm:text-sm text-stone-300 font-light">
        İletişime geçin veya WhatsApp üzerinden iletişime geçin; mimarımız adresinizde keşif randevusu oluştursun.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="https://wa.me/905393333303?text=Merhaba,%20komple%20daire%20tadilatı%20için%20ücretsiz%20keşif%20istiyorum." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-emerald-500 text-stone-950 text-xs font-bold uppercase tracking-widest hover:bg-emerald-400 transition shadow-lg">
          💬 WhatsApp ile Keşif İste (0539 333 33 03)
        </a>
      </div>
    </div>
  </section>

</Layout>
